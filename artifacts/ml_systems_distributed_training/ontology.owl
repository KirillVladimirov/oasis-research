    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Limits on GPU memory capacity that necessitate efficient management of model states and activations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0194</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0227</hasCQ>
