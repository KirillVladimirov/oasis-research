    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the NVLink ring connects all 8 GPUs, and the NVLink ring has much higher bandwidth than PCIe bridges</hasEvidenceText>
  </rdf:Description>
