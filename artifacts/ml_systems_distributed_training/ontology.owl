    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2410.19367_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The activations memory consumption ( M a ) of the 1F1B schedule exhibits better efficiency</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#railoptimizedtopology">
