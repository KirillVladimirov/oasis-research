    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A partitioned segment of model or optimizer state that needs to be flushed to storage.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2406.10707v1_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">each of these shards needs to be flushed to persistent storage, typically as a separate file</hasEvidenceText>
  </rdf:Description>
