    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0176</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZO5cn4IfaN_rag::chunk_026</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">its staleness is not punished, which will leads unsatisfactory convergence performances.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#utilizesparallelism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
