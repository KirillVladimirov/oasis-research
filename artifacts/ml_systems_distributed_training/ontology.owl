    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ratio of pipeline bubble time to total compute time, used to assess performance efficiency.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0183</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0183</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2308.15762_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we factor in the impact of remaining communication time after overlap when calculating the bubble ratio</hasEvidenceText>
  </rdf:Description>
