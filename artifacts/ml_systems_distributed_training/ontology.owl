    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2412.21124_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enables large batch training for BERT and ResNet50 models</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">large-batch training improves training efficiency in terms of memory utilization</hasEvidenceText>
