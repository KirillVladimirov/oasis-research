    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An algorithm that effectively reduces the overhead of dispatchers by overlapping computation and communication overhead.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0045</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0045</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.23830_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Node-wise Rearrange Algorithm effectively reduces the overhead of dispatchers, because the communication overhead constitutes the majority of the total overhead through computation overhead overlapping.</hasEvidenceText>
  </rdf:Description>
