    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">min execution time s.t. memory constraint</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Efficient management of these states is critical to scaling up LLM training without exceeding memory constraints.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#nccl">
