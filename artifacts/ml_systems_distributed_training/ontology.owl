    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2510.05112_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2510.05112_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2408.03505_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleaved 1F1B demonstrates superior performance over 1F1B at small batch sizes.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interleaved 1F1B [ 25 ], Hanayo [ 23 ] and Chimera [ 18 ] propose the circular, V-shape, and bidirectional stage placement strategies</hasEvidenceText>
