    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parallelism form that partitions parameter matrices along columns or rows and introduces collective communication to fit models into multiple GPUs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0003</hasCQ>
