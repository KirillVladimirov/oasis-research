    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship where the choice of a communication algorithm is determined by the underlying network structure.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0051</hasCQ>
