    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A combination of data parallelism, pipeline parallelism, and tensor parallelism used to mitigate communication overheads in training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0007</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0097</hasCQ>
