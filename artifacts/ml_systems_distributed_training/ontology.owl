    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tuzTN0eIO5_rag::chunk_009</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2311.15269_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Throughput (words per second)</hasEvidenceText>
