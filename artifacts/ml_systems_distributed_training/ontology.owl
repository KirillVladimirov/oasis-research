    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1807.05358_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1807.05358_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the simulator rst builds a task graph , which includes all tasks derived from operations and dependencies between tasks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starts from a previous task graph and only re-simulates tasks involved in the portion of the execution timeline that changes</hasEvidenceText>
  </rdf:Description>
