    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The computational cycle of a model including forward pass, backward pass, and parameter updates.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</hasCQ>
