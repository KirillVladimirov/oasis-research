    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all reduce-scatter operations are performed using the float32 data type.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#parameter_sharding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
