    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2405.12079_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saves wasted GPU time due to recomputation</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
