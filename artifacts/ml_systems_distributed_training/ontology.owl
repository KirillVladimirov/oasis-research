    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Components of a model, like frozen encoders, that do not undergo gradient updates but require computation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0117</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0117</prov:wasDerivedFrom>
