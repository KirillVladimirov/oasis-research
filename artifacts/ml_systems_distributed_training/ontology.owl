    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2505.12242_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the update interval for CPUside gradient handling. By assigning longer update intervals to less important gradients, ZenFlow further reduces GPUside stalls.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">update interval for CPUside gradient handling. By assigning longer update intervals to less important gradients, ZenFlow further reduces GPUside stalls.</hasEvidenceText>
  </rdf:Description>
