    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2406.10707v1_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The combination of data parallelism, pipeline parallelism, and tensor parallelism is often called 3D parallelism .</hasEvidenceText>
  </rdf:Description>
