    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2407.20018_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2307.02031_rag::chunk_000</hasEvidenceChunk>
