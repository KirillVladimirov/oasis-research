    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A condition in asynchronous or delayed training where updates are based on outdated parameter values.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0221</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0221</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2505.12242_rag::chunk_019</hasEvidenceChunk>
