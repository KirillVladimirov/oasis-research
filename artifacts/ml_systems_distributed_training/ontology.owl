    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The frequency or number of iterations over which gradients are accumulated before being applied to parameters.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0085</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0221</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0085</prov:wasDerivedFrom>
