    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The communication across devices is peer-to-peer send/receive.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peer-to-peer (P2P) communication is required to send activations and gradients during forward and backward passes</hasEvidenceText>
  </rdf:Description>
