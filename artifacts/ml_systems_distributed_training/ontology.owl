    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Simulators that model system behavior as a sequence of events in time, often used for packet-level whole-stack network simulation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0042</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0042</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2412.12487_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discrete event simulators like ns-3 [ 36 ] and OMNeT++ [ 41 ] are well-known to have high overheads due to their packet-level whole-stack simulation.</hasEvidenceText>
  </rdf:Description>
