    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A structure used to decompose the search space and perform pruning to remove inefficient parallelism combinations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0138</hasCQ>
