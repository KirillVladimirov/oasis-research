    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MegaScale [ 71 ] shows that a rail-optimized topology can also mitigate ECMP hashing conflicts.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a rail-optimized topology can also mitigate ECMP hashing conflicts</hasEvidenceText>
  </rdf:Description>
