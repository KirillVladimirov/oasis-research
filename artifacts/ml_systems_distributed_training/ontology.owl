    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1807.05358_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To support parallelizing DNN models using any strategy dened in our parallelization space (see Section 4), we implemented the FlexFlow distributed runtime</hasEvidenceText>
  </rdf:Description>
