    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measure of the efficiency or performance of GPUs during training, often expressed as throughput or Model Flops Utilization (MFU).</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0081</hasCQ>
