:asynchronous_sgd a owl:Class ;
    rdfs:label "Asynchronous SGD"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0053"^^xsd:string,
        "CQ_S0_R1_0055"^^xsd:string,
        "CQ_S0_R1_0147"^^xsd:string ;
    :hasEvidenceChunk "2401.16265_rag::chunk_003"^^xsd:string,
        "2401.16265_rag::chunk_015"^^xsd:string,
        "2401.16265_rag::chunk_025"^^xsd:string ;
    :hasEvidenceText "Koloskova et al. (2022) provided enhanced convergence guarantees for asynchronous SGD in the context of distributed federated learning."^^xsd:string,
        "Sharper convergence guarantees for asynchronous sgd for distributed and federated learning."^^xsd:string,
        "The stale-synchronous parallel (SSP) framework (Ho et al., 2013; Tang et al., 2020) aims to mitigate the straggler problem with relaxed synchronization."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "AsynchronousSGD"^^xsd:string ;
    skos:skos_definition "A variant of Stochastic Gradient Descent used in distributed learning where updates are applied without strict synchronization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0053"^^xsd:string,
        "CQ_S0_R1_0055"^^xsd:string,
        "CQ_S0_R1_0147"^^xsd:string .

:backwardpass a owl:Class ;
    rdfs:label "BackwardPass"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0098"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0108"^^xsd:string ;
