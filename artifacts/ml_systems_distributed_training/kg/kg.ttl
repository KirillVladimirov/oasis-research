:large_language_model a owl:Class ;
    rdfs:label "Large Language Model"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0032"^^xsd:string,
        "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string ;
    :hasEvidenceChunk "2307.02031_rag::chunk_000"^^xsd:string,
        "2312.12391_rag::chunk_001"^^xsd:string,
        "2401.13920_rag::chunk_001"^^xsd:string,
        "2407.20018_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Such large amounts of parameters also incur high computational and memory costs even for emerging accelerators like GPUs."^^xsd:string,
        "Transformer-based [73] large language models (LLMs) like ChatGPT [50], Gemini [70], LLaMA [72], and PaLM [9]"^^xsd:string,
        "integrated learning method for large language models (LLM)"^^xsd:string,
        "unprecedented scale of transformer-based LLMs like GPT [ 5 ], LLaMA [ 6 ], Gemini [ 7 ]"^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:altLabel "LargeLanguageModel"^^xsd:string ;
    skos:skos_definition "A neural network with a high number of parameters, often requiring distributed training strategies due to memory and computational costs."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0032"^^xsd:string,
        "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string .

