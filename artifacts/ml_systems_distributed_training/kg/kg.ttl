        "2510.20111_rag::chunk_005"^^xsd:string,
        "tuzTN0eIO5_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Backward Pass : The backward pass similarly requires all-gather operations to reconstruct model parameters needed for gradient computation."^^xsd:string,
        "each worker processes the backward passes for the outstanding in-flight microbatches"^^xsd:string,
        "recomputes them during the backward pass, reducing peak memory usage at the cost of increased computational overhead."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The phase of neural network training where gradients are computed and activations are recomputed if they were discarded during the forward pass."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0098"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0108"^^xsd:string .

:batchsize a owl:Class ;
