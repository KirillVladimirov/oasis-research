    :hasEvidenceText "Dean et al. ( Dean et al. , 2012 ) used hybrid parallelism to train models which would not t in a single GPUs memory."^^xsd:string,
        "Hybrid Parallelism combines multiple handcrafted parallelization strategies, such as data parallelism, tensor parallelism, pipeline parallelism"^^xsd:string,
        "Hybrid Parallelism combines multiple handcrafted parallelization strategies, such as data parallelism, tensor parallelism, pipeline parallelism, sequence"^^xsd:string,
        "a hybrid (2-way DP, 2-MP) approach performs better than both MP-only and DP-only"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "HybridParallelism"^^xsd:string ;
    skos:skos_definition "A training approach that combines different parallelization techniques, such as data parallelism and model parallelism, to train models that exceed single device memory."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0001"^^xsd:string,
