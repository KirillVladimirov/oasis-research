    :hasEvidenceText "O [ i ] represent whether to employ activation checkpointing"^^xsd:string,
        "To reduce memory consumption during training, researchers have developed techniques such as activation checkpointing"^^xsd:string,
        "activation checkpointing (or recomputation) [ 4 , 16 ] is a critical technique that trades computation for memory. It frees activations after the forward pass and recomputes them during the backward pass"^^xsd:string,
        "activation checkpointing distributes the memory burden across time dimension by delaying the memory"^^xsd:string,
        "checkpointing (CKPT) as a special parallelism dimension, which distributes the training memory workload to the backward computation through checkpoints."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Activation checkpointing"^^xsd:string ;
    skos:skos_definition "A strategy that distributes the memory burden across the time dimension by delaying memory usage, often used to manage memory constraints during model training."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0071"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0133"^^xsd:string,
        "CQ_S0_R1_0138"^^xsd:string,
        "CQ_S0_R1_0149"^^xsd:string,
        "CQ_S0_R1_0227"^^xsd:string .

