    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we optionally compute the consistency regularization loss function L c based on f LAGNN ( A , X , X ( k ) , ) for specic tasks.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#heterophilicgraph">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
