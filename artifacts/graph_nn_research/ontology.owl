    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fixed distance formulation used to measure the similarity or distribution of embeddings.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0127</hasCQ>
