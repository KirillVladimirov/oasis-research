    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GNNs are known to distinguish neighborhoods up to the rooted aggregation tree , which can be obtained by unrolling the neighborhood aggregation steps</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#neighborhoodsampler">
