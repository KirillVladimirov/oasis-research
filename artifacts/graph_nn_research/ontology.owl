  <rdf:Description rdf:about="http://example.org/S0/R1#in_batch_negative_sampling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#acquisitionfunction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In-batch Negative Sampling</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sampling method used during training to maximize scores for linked nodes while minimizing scores of other nodes in a batch to increase training speed.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0044</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0044</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2112.01035_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Therefore, we implement an improved version that uses in-batch negative sampling. We maximize the scores for linked nodes while minimizing the scores of other nodes in a batch.</hasEvidenceText>
  </rdf:Description>
