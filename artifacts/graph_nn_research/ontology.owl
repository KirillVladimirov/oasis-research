    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mechanism or layer used to shrink a graph hierarchically or generate a coarsened graph.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0075</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0075</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2005.12386_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">learning hierarchical graph representations, such as DiffPool (Ying et al. 2018). MuchGNN (Zhou et al. 2019) proposed to learn a set of graph channels at each layer to shrink the graph hierarchically.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_14">
