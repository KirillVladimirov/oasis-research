    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A task involving the maximization of mutual information or identification of correspondences by contrasting positive and negative pairs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.04964_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We formulate G-CRD as a node-level contrastive learning task</hasEvidenceText>
  </rdf:Description>
