    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A clustering method advocated for use in the decomposition procedure of GIST.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0165</hasCQ>
