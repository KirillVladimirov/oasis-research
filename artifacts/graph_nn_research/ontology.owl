    <rdfs:range rdf:resource="http://example.org/S0/R1#convergence"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supportsConvergence</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship where an optimizer's update rule enables the model to reach a state of convergence.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</hasCQ>
