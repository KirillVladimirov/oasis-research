    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003.10477_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2005.14612v1_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2002.06755_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAMLP denes three principled attention mechanisms</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">efcient attention-guided sorting for GNNs</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Each node in a GAT layer learns to weighted combine the embedding (or feature) of its neighborhoods with an attention mechanism</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAT [35] introduces the attention mechanism to GCN to make it possible to learn the weight for each neighbors automatically.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">existing GNNs usually use the attention mechanism for local aggregation</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attention Mechanism on Graphs Our method is also conceptually connected to attention mechanism on graphs</hasEvidenceText>
  </rdf:Description>
