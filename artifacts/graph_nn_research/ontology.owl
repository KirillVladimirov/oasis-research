    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For node-level classification, we select two simple and famous GNNs as the student models.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_191">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
