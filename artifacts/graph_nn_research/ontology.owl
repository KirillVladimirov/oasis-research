    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of graph dataset representing citations between documents, used for evaluating graph models.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0074</hasCQ>
