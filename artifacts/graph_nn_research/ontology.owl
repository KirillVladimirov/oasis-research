  <rdf:Description rdf:about="http://example.org/S0/R1#learnsweightfor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#attentionmechanism"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#neighbor"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">learnsWeightFor</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process by which an attention mechanism assigns a specific weight to a neighboring node.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003.10477_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">introduces the attention mechanism to GCN to make it possible to learn the weight for each neighbors automatically.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#node_wise_sampling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
