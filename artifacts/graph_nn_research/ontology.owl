    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.04840_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strict Cold Start ( SCS ) (Li et al., 2019b; Ding et al., 2021), wherein some nodes have no edges connected.</hasEvidenceText>
  </rdf:Description>
