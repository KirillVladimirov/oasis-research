    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2108.10097_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All these methods adopt a layerwise propagation mechanism and consider the features after different layers of propagation.</hasEvidenceText>
  </rdf:Description>
