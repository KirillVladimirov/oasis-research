    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of transmitting data or features across a graph structure, which can be limited by graph sparsity.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0057</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0057</prov:wasDerivedFrom>
