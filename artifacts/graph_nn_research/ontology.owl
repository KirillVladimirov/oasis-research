    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StandardTraining</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conventional process of training a model on a specific property group or dataset without explicit domain shift compensation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0124</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0124</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2005.12386_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">models trained on one property group (e.g., L-training) cannot perform well on the other property group (e.g., S-test).</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#server">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
