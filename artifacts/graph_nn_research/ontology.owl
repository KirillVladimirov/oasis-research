    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard GNN Training</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of training Graph Neural Networks, often involving techniques to improve generalization or reduce over-smoothing.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0010</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0180</hasCQ>
