    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2102.10424_rag::chunk_015</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GIST reduces communication by only communicating sub-GCN parameters.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GIST , a distributed training approach for GCNs that enables the exploration of larger models and datasets.</hasEvidenceText>
  </rdf:Description>
