    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1607.00653_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predict whether a pair of nodes in a network should have an edge connecting them</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#meanpooling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#aggregator"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MeanPooling</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aggregator variant that uses element-wise mean to combine neighbor features.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0049</hasCQ>
