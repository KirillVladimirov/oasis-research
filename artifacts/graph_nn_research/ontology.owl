    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neighborhood extending beyond a single hop, potentially leading to noise or over-smoothing.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0230</hasCQ>
