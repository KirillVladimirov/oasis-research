    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strict Cold Start Node</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A node in a graph that has no edges connected to it, making prediction challenging due to the absence of a neighborhood.</skos:skos_definition>
