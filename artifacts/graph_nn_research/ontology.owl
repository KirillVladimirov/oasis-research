    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limited memory capacity/bandwidth of current servers</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#outperforms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#mlp"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#gnn"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outperforms</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship where one model achieves higher classification accuracy than another on specific datasets.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0194</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0194</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2005.14612v1_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We nd that MLP consistently outperforms Geom-GCN-s by large margins.</hasEvidenceText>
  </rdf:Description>
