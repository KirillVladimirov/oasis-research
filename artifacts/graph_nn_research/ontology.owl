    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2104.13215_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.08202_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">it relies on one server to carry out all the communications and aggregations.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limited memory capacity/bandwidth of current servers</hasEvidenceText>
  </rdf:Description>
