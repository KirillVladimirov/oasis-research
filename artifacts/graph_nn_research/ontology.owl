    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type of Graph Neural Network that incorporates local privacy mechanisms to protect sensitive node information.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0019</hasCQ>
