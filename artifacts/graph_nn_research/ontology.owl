    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2109.08907_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.04964_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PrivGnn leverages the paradigm of knowledge distillation. The knowledge of the teacher model trained on the private graph is trans</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Knowledge distillation is a learning paradigm for boosting resource-efcient graph neural networks (GNNs) using more expressive yet cumbersome teacher models.</hasEvidenceText>
  </rdf:Description>
