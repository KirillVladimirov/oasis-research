    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of principled attention mechanism defined within the GAMLP framework for graph learning.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2108.10097_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAMLP denes three principled attention mechanisms, i.e., smoothing attention, recursive attention, and JK attention</hasEvidenceText>
  </rdf:Description>
