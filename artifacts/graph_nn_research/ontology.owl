    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smaller graphs or models constructed through a decomposition procedure to handle large-scale training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0016</hasCQ>
