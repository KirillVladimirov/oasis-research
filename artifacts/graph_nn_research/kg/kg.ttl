    :hasEvidenceText "The neighborhood N S is restricted to nodes which are immediate neighbors of the source."^^xsd:string,
        "Transformer performs message propagation between all nodes and encodes the given graph structure as a soft inductive bias"^^xsd:string,
        "V is a set of | V | = n nodes and E V V is a set of | E | edges between nodes."^^xsd:string,
        "every node propagates its message to hops further"^^xsd:string,
        "learned representations for the nodes in the same class"^^xsd:string,
        "nodes with edge connection have similar node embeddings."^^xsd:string,
        "only a small set of nodes are labeled"^^xsd:string,
        "other node types like author, eld, venue"^^xsd:string,
        "predictions of the nodes in the batch contribute to the loss computation"^^xsd:string,
        "represent nodes as high-dimensional feature vectors."^^xsd:string,
        "there are two types of nodes, i.e., user node and item node"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An entity within a graph, which in a heterogeneous context can represent different types such as users, items, papers, or authors."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0006"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
