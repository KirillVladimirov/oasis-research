:deepgnn a owl:Class ;
    rdfs:label "DeepGNN"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0079"^^xsd:string,
