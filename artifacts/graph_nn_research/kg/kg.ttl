        "2103.03036_rag::chunk_002"^^xsd:string,
        "2112.10063_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "Different graph representation approaches may be used to generate the r"^^xsd:string,
        "Modern GNNs typically adopt a neighborhood aggregation strategy by using 2322 the features and graph structures to learn discriminative node or graph representations."^^xsd:string,
        "encode essential structural and semantic information into the representation, which improves the quality of embeddings"^^xsd:string,
        "the second term imposes prior constraints on the learned graph and its representations"^^xsd:string,
        "use widely-used graph convolutional network (GCN) to learn node and graph representations"^^xsd:string ;
    rdfs:subClassOf :representation,
        owl:Thing ;
    skos:altLabel "Graph Representation"^^xsd:string ;
    skos:skos_definition "The learned embedding or feature representation of graph elements (nodes or global topology)."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0047"^^xsd:string,
        "CQ_S0_R1_0065"^^xsd:string,
        "CQ_S0_R1_0081"^^xsd:string,
        "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string .

:graphsage a owl:Class ;
    rdfs:label "GraphSAGE"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0044"^^xsd:string,
        "CQ_S0_R1_0053"^^xsd:string,
