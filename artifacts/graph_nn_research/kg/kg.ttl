        "2109.03856_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "The neighborhood N S is restricted to nodes which are immediate neighbors of the source."^^xsd:string,
        "The neighborhood consists of nodes sequentially sampled at increasing distances from the source node."^^xsd:string,
        "features in the local neighborhood to enhance the expressive power of existing GNNs"^^xsd:string,
        "local information within the 1-hop neighborhood."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Local Neighborhood"^^xsd:string ;
    skos:skos_definition "The set of nodes in close proximity to a target node used for local feature enhancement."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0115"^^xsd:string,
        "CQ_S0_R1_0230"^^xsd:string,
