    :hasEvidenceText "we propose a privacy-preserving framework, PrivGnn , for releasing GNN models with differential privacy guarantees."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A graph neural network framework designed to release models with differential privacy guarantees."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0201"^^xsd:string .

