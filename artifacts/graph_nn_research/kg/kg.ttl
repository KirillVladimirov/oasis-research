    prov:wasDerivedFrom "CQ_S0_R1_0146"^^xsd:string .

:appliedto a owl:ObjectProperty ;
    rdfs:label "appliedTo"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0211"^^xsd:string ;
    :hasEvidenceChunk "2005.11079_rag::chunk_010"^^xsd:string,
        "2104.07145_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "In G RAND _dropout and G RAND _DropEdge, we use dropout and DropEdge as the perturbation method respectively"^^xsd:string,
        "method_sider_bace=0.7714; c_lintox_bbbp_t_ox_21=0.9129"^^xsd:string ;
    rdfs:domain :dropedge ;
    rdfs:range :deepgnn ;
    skos:skos_definition "The application of edge dropout as a perturbation or regularization method within deep graph architectures."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0211"^^xsd:string .

:appliestransformation a owl:ObjectProperty ;
    rdfs:label "appliesTransformation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0067"^^xsd:string ;
    :hasEvidenceChunk "2011.09679_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Standard GCNs extend naturally to heterogeneous (aka relational) graphs by applying relation-specic learned transformations"^^xsd:string ;
    rdfs:domain :gnn ;
    rdfs:range :relation ;
    skos:skos_definition "The process where a GNN applies specific learned transformations to handle different relations in a heterogeneous graph."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0067"^^xsd:string .

:augmented_graph a owl:Class ;
    rdfs:label "Augmented Graph"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0167"^^xsd:string ;
    :hasEvidenceChunk "2202.08235_rag::chunk_012"^^xsd:string ;
    :hasEvidenceText "leverages graph diffusion , edge perturbation (dropping) , subgraph sampling , and feature masking to generate augmented graphs."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The output of a graph data augmentation strategy, such as edge perturbation or node dropping."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0167"^^xsd:string .

:augmenter a owl:Class ;
