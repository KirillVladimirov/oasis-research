:gnn_model a owl:Class ;
    rdfs:label "GNN Model"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0015"^^xsd:string,
        "CQ_S0_R1_0138"^^xsd:string,
        "CQ_S0_R1_0142"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string,
        "CQ_S0_R1_0181"^^xsd:string,
        "CQ_S0_R1_0192"^^xsd:string ;
    :hasEvidenceChunk "2010.07565_rag::chunk_001"^^xsd:string,
        "2102.04925_rag::chunk_000"^^xsd:string,
