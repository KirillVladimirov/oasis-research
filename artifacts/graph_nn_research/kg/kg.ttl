    prov:wasDerivedFrom "CQ_S0_R1_0230"^^xsd:string .

:alleviates a owl:ObjectProperty ;
    rdfs:label "alleviates"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0066"^^xsd:string ;
    :hasEvidenceChunk "2202.08235_rag::chunk_018"^^xsd:string ;
    :hasEvidenceText "DropEdge [85] randomly removes graph edges during message passing to alleviate over-smoothing."^^xsd:string ;
    rdfs:domain :dropedge ;
    rdfs:range :oversmoothing ;
    skos:skos_definition "The action of reducing the impact of over-smoothing in graph learning tasks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0066"^^xsd:string .

:appliedin a owl:ObjectProperty ;
    rdfs:label "appliedIn"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0146"^^xsd:string ;
    :hasEvidenceChunk "1706.02216v2_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "To extend Algorithm 1 to the minibatch setting, given a set of input nodes, we rst forward sample the required neighborhood sets"^^xsd:string ;
    rdfs:domain :acquisitionfunction ;
    rdfs:range :minibatchsetting ;
