    skos:skos_definition "A loss function that aims to minimize the difference of nodes in positive edges and maximize it in negative samples."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0156"^^xsd:string .

:graphrepresentation a owl:Class ;
    rdfs:label "GraphRepresentation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0047"^^xsd:string,
        "CQ_S0_R1_0065"^^xsd:string,
        "CQ_S0_R1_0081"^^xsd:string,
