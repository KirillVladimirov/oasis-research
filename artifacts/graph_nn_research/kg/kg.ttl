    :hasCQ "CQ_S0_R1_0167"^^xsd:string ;
    :hasEvidenceChunk "2202.08235_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "the augmenter f and the predictor p are alternatively updated"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
