        "SIGMOD20_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "over-smoothing problem [ 35 ], which means back-propagation through the network eventually leads to the convergence of the features of nodes to the same value."^^xsd:string,
        "so-called over-smoothing phenomenon generally leads to failure in the graph learning tasks"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A phenomenon in deep GNNs that leads to failure in graph learning tasks, often mitigated by graph rewiring or edge removal."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string .

:studentmodel a owl:Class ;
