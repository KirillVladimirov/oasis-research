:aggregatesfor a owl:ObjectProperty ;
    rdfs:label "aggregatesFor"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0166"^^xsd:string ;
    :hasEvidenceChunk "2005.14612v1_rag::chunk_004"^^xsd:string ;
