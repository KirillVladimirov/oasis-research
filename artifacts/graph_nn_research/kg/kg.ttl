    :hasEvidenceChunk "2206.04361_rag::chunk_000"^^xsd:string,
        "2206.04361_rag::chunk_001"^^xsd:string,
        "2206.04361_rag::chunk_014"^^xsd:string,
        "2206.07743_rag::chunk_013"^^xsd:string,
        "2206.07743_rag::chunk_016"^^xsd:string ;
    :hasEvidenceText "Deep Graph Neural Networks"^^xsd:string,
        "deeper GNNs"^^xsd:string,
        "the performance degradation of deep GNNs is observed far Graph Neural Networks (GNNs) have achieved great success in various graph mining tasks."^^xsd:string,
        "the root cause for the performance degradation of deep GNNs: the model degradation issue introduced by large transformation depth"^^xsd:string,
        "when GNNs are very deep, explicit feature decorrelation ( L ) is of more significance than the implicit method"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Deep GNN"^^xsd:string ;
    skos:skos_definition "Graph Neural Networks characterized by multiple layers or operations, which may experience performance degradation as depth increases."^^xsd:string ;
