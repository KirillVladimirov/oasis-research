    rdfs:label "affectsPerformanceOf"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0057"^^xsd:string ;
    :hasEvidenceChunk "2107.11789_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Such graph sparsity inherently limits the effective information propagation and the performance of GNNs"^^xsd:string ;
