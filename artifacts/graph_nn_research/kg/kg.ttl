    :hasEvidenceText "The student model is built with two simple prediction mechanisms, i.e. , label propagation and feature transformation"^^xsd:string,
        "Then a student model g s is trained using a weighted combination of the standard supervised loss l sup and a distillation loss l dis"^^xsd:string,
        "knowledge distillations aims to learn a compact student model, which is expected to master the expertise of the teacher"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Student Model"^^xsd:string ;
    skos:skos_definition "A model, often simpler than a GNN, designed to simulate the soft predictions and knowledge of a teacher model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0033"^^xsd:string,
        "CQ_S0_R1_0085"^^xsd:string,
        "CQ_S0_R1_0188"^^xsd:string .

