:activelearningstrategy a owl:Class ;
    rdfs:label "ActiveLearningStrategy"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0218"^^xsd:string ;
    :hasEvidenceChunk "nodeaug_kdd20_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "at each training step, we extract the receptive field subgraphs of a batch of the augmented nodes for the consistency loss"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A method or process used to select data points for labeling to improve model performance efficiently."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0218"^^xsd:string .

:adaedge a owl:Class ;
    rdfs:label "AdaEdge"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0032"^^xsd:string ;
    :hasEvidenceChunk "2011.02255_rag::chunk_003"^^xsd:string,
        "2202.08235_rag::chunk_018"^^xsd:string ;
    :hasEvidenceText "AdaEdge [9] iteratively adds or removes edges to the graph topology based on the cl"^^xsd:string,
        "Chen et al. [ 2020a ] proposed a regularizer to the training loss"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A method that iteratively adds or removes edges to the graph topology based on classification results, acting as a regularizer or data augmentation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0032"^^xsd:string .

:adaptive_augmentation a owl:Class ;
    rdfs:label "Adaptive Augmentation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0149"^^xsd:string ;
    :hasEvidenceChunk "2010.14945_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "Graph Contrastive Learning with Adaptive Augmentation"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A specific stage or technique in graph contrastive learning involving the modification of graph data to create different views."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0149"^^xsd:string .

:adaptornetwork a owl:Class ;
    rdfs:label "AdaptorNetwork"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0176"^^xsd:string ;
    :hasEvidenceChunk "2005.12386_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "it generates customized adaptor parameters for each graph sample g i via an adaptor network with the graph structure properties as input."^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:skos_definition "A network that generates customized adaptor parameters for each graph sample based on graph structure properties."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0176"^^xsd:string .

:adapts a owl:ObjectProperty ;
    rdfs:label "adapts"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0176"^^xsd:string ;
    :hasEvidenceChunk "2005.12386_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "These generated adaptor parameters are used to adapt a shared GNN model"^^xsd:string ;
    rdfs:domain :model ;
    rdfs:range :gnn ;
    skos:skos_definition "The process where an adaptor network modifies a shared GNN model into a sample-specific model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0176"^^xsd:string .

:addressessparsityin a owl:ObjectProperty ;
    rdfs:label "addressesSparsityIn"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0058"^^xsd:string ;
    :hasEvidenceChunk "2107.11789_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "The most promising direction to address the sparse issues faced by GNNs is to adopt self-supervising strategies"^^xsd:string ;
    rdfs:domain :selfsupervisingstrategy ;
    rdfs:range :gnn ;
    skos:skos_definition "The relationship where self-supervised strategies are used to mitigate performance limitations in Graph Neural Networks caused by data sparsity."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0058"^^xsd:string .

:adjacencymatrix a owl:Class ;
    rdfs:label "AdjacencyMatrix"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0233"^^xsd:string ;
    :hasEvidenceChunk "2107.11789_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Edge sparsity : real-world graphs that often have the skewed degree distribution, suffering from the severe sparsity problem"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A matrix representation of a graph structure, often characterized by its sparsity in real-world applications."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0233"^^xsd:string .

:adversarial_perturbation a owl:Class ;
    rdfs:label "Adversarial Perturbation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0208"^^xsd:string ;
    :hasEvidenceChunk "Kong_Robust_Optimization_As_Data_Augmentation_for_Large-Scale_Graphs_CVPR_2022_paper_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "practice of using weighted perturbation to promote multi-scale augmentations."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Modifications applied to graph data, such as node features or structure, to test or improve model robustness."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0208"^^xsd:string .

:adversarial_training a owl:Class ;
    rdfs:label "Adversarial Training"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0240"^^xsd:string ;
    :hasEvidenceChunk "Kong_Robust_Optimization_As_Data_Augmentation_for_Large-Scale_Graphs_CVPR_2022_paper_rag::chunk_011"^^xsd:string ;
    :hasEvidenceText "heuristics like early stopping and cyclic learning rates can further accelerate the adversarial training process"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A process of training models using perturbed data to improve robustness, often involving iterative steps."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0240"^^xsd:string .

