:differential_privacy a owl:Class ;
    rdfs:label "Differential Privacy"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0019"^^xsd:string,
        "CQ_S0_R1_0070"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string ;
    :hasEvidenceChunk "2104.13215_rag::chunk_000"^^xsd:string,
        "2109.08907_rag::chunk_001"^^xsd:string,
        "2109.08907_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "DP is one of the most popular approaches for releasing data statistics or trained models while concealing the information about individuals present in the dataset"^^xsd:string,
        "Multiple solutions exist to privatize distributed learning algorithms. They can be split into two frameworks: differential privacy [7][15], and cryptography [16][20]."^^xsd:string,
        "we propose a privacy-preserving framework, PrivGnn , for releasing GNN models with differential privacy guarantees."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "DifferentialPrivacy"^^xsd:string ;
    skos:skos_definition "A framework used to privatize distributed learning algorithms by adding noise or perturbations to stop information leakage."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0019"^^xsd:string,
        "CQ_S0_R1_0070"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string .

