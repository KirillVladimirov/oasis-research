    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lower bit-widths (8 or 4-bits).</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantized to 2 and 4 bits</hasEvidenceText>
  </rdf:Description>
