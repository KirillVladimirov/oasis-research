    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.17985_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We focus on weight-only quantization to accelerate memory I/O rather than compute</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When only weight is quantized and activation is floating-point</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extends OBQ [ 10 , 16 , 21 ] on LLMs for INT4 weight-only quantization and shows great efficiency on quantization and latency</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">focuses on 4 or 3-bit quantization of weights</hasEvidenceText>
  </rdf:Description>
