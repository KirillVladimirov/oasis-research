    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The teacher model provides guidance (such as posterior or activations) to the student during training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0137</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0137</prov:wasDerivedFrom>
