    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small number of samples used as input in Post-Training Quantization to determine quantization parameters.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0039</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0100</hasCQ>
