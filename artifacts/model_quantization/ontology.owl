    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.13630_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">other metrics such as entropy [ 189 ], although MSE is the most common method used.</hasEvidenceText>
  </rdf:Description>
