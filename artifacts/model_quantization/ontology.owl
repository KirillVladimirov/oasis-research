    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quantization Format</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The numerical representation format (e.g., INT or FP) used to represent weights and activations in a quantized model.</skos:skos_definition>
