  <rdf:Description rdf:about="http://example.org/S0/R1#applied_together_with">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">applied together with</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The simultaneous application of pruning and quantization to a model to reduce overhead.</skos:skos_definition>
