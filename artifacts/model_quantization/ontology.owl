    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2201.08442_rag::chunk_018</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AdaRound optimizes a local loss function using the unlabeled training or calibration data to adaptively decide whether to quantize a specic weight to the integer value below or above.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#deterministic_rounding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
