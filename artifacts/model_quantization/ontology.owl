    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process where weights and input activations are quantized and de-quantized before convolution to simulate quantization effects using floating-point arithmetic.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0014</hasCQ>
