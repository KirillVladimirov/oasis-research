    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActivationQuantizer</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuantizationOperation</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0032</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0032</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1911.12491_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to quantize the activations, we use an quantization function with the range [0 , 2 k 1] . The activation quantizer Q X can be obtained as</hasEvidenceText>
  </rdf:Description>
