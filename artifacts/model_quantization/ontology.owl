  <rdf:Description rdf:about="http://example.org/S0/R1#clippingstrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#quantizationrangesetting"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClippingStrategy</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An outlier mitigation strategy that involves clipping weights and activations to improve precision for intermediate values.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0103</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0103</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2310.08041_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adopting strategies like clipping ( Banner et al. , 2019 ; McKinstry et al. , 2019 ; Choukroun et al. , 2019 ) or value splitting</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_296">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
