    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Large Language Models designed to support extensive context windows, often leading to inflated memory consumption.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0046</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0046</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.18096_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the current trend towards supporting longer contexts exacerbates the issue as the inflated KV cache due to increased context length cannot be contained within the GPU memory.</hasEvidenceText>
  </rdf:Description>
