    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003.03603_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.10787_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.04902_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a generator that generated articial data points</hasEvidenceText>
