    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The hardware limitation, often related to GPU memory, that acts as a bottleneck for model deployment.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0146</hasCQ>
