    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0100</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shang_Post-Training_Quantization_on_Diffusion_Models_CVPR_2023_paper_rag::chunk_005</hasEvidenceChunk>
