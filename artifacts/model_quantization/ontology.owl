    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2403.05527_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The outlier extraction technique has been applied by Kim et al. ( 2023 ) to augment trainingdependent non-uniform weight quantization.</hasEvidenceText>
  </rdf:Description>
