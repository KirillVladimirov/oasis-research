    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2307.13304_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proposes a novel rounding method that can work on the largest OPT and BLOOM models.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#binary_neural_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
