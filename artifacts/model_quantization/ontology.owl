    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A data format used for post-training quantization to meet computational demands while maintaining accuracy.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0066</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0107</hasCQ>
