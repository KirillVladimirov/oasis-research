  <rdf:Description rdf:about="http://example.org/S0/R1#usesapproximation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#softmax"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#polynomialapproximation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">usesApproximation</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates the Softmax implementation to the polynomial approximation used for integer-only arithmetic.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</prov:wasDerivedFrom>
