    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.04902_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2308.06744_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nagel22a_rag::chunk_000</hasEvidenceChunk>
