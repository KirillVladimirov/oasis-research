    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced quantization schemes designed to be more robust and efficient against perturbations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0138</hasCQ>
