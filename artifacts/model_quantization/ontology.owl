    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calibration Phase</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A phase where the histogram of possible numeric ranges in each layer of the neural network is captured for activation quantization.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0023</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0023</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2202.05048_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calibration Phase. The dashed-lines indicate the whole procedure of the calibration phase in Fig. 1. In this phase, the histogram of possible numeric ranges in each layer of the neural network is captured</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In this phase, the histogram of possible numeric ranges in each layer of the neural network is captured for the activation of the quantization</hasEvidenceText>
  </rdf:Description>
