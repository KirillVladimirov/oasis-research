    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method that jointly optimizes the clipping range and the weights in a neural network during training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0058</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0058</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.13630_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Notable work here are LQNets [ 276 ], PACT [ 36 ], LSQ [ 56 ], and LSQ+ [ 15 ] which jointly optimizes the clipping range and the weights in NN during training.</hasEvidenceText>
  </rdf:Description>
