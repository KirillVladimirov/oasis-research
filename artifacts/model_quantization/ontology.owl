    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LayerNorm magnifies the outlier (Xiao et al. 2023) and no measure is taken to deal with this effect.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#roundingoperator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
