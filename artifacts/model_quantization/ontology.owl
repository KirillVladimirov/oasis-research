    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An outlier mitigation strategy that improves precision by allocating more bits to intermediate values, though it may discard critical outliers.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0205</hasCQ>
