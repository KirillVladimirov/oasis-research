    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.03759_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For fake quantization, the weights and input activations are quantized and de-quantized before convolution.</hasEvidenceText>
  </rdf:Description>
