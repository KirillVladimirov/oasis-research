    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method proposed to minimize output error in ultra-low-precision quantization without model fine-tuning.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0020</hasCQ>
