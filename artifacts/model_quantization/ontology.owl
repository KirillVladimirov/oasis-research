    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The capability of hardware to process multiple bits in parallel, often used for BNN acceleration.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0152</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0152</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2006.16578_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">leverage bit-level-parallelism with a word-based architecture</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#augments">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
