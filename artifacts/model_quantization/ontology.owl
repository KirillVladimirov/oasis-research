    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2209.15317_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.14866_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2201.08442_rag::chunk_020</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2202.05048_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The commonly used solution is to approximate the quantization operation to a straight-through estimator (STE)</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hessian-Attention-based quantization strategically refines weight precision within attention layers to maintain model accuracy</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">by-pass the quantization operation, if possible, and check that the accuracy matches that of the FP32 model.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The overall process of quantization goes through two phases: calibration and conguration search.</hasEvidenceText>
  </rdf:Description>
