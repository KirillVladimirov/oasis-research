    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biggest BLOOM ( Scao et al. , 2022 ) and BLOOMZ ( Muennighoff et al. , 2022 ) boasting 176 billion parameters</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#mixed_precision_quantization_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
