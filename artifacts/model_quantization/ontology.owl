    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source of large quantization error in a heavy-tailed distribution</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the source of large quantization error in a heavy-tailed distribution.</hasEvidenceText>
  </rdf:Description>
