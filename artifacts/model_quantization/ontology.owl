    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a specific layer to its contribution or sensitivity to the overall quantization error/loss.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0108</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0108</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.13630_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Different layers in a Neural Net have different impact on the loss function, and this motivates a mixed-precision approach to quantization.</hasEvidenceText>
  </rdf:Description>
