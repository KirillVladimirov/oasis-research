    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deterministic Rounding</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rounding operation where small weight updates may not lead to any weight change because the operation consistently returns the same weights.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.13630_rag::chunk_017</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">small weight updates may not lead to any weight change, as the rounding operation may always return the same weights.</hasEvidenceText>
  </rdf:Description>
