    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HardwareConstraint</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0179</hasCQ>
