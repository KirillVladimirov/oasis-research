    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A family of massive open-access multilingual language models targeted for compression and evaluation in quantization studies.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</prov:wasDerivedFrom>
