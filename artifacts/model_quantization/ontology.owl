    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the activations are hard to quantize</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FP8 Activation is much better than INT8.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The number of weights and activations across layers and the on-chip capacity on different hardware platforms.</hasEvidenceText>
  </rdf:Description>
