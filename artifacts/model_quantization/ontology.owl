    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.12356_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2308.09723_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As for hardware efciency, FP operations generally incur higher costs and lower performance than INT operations.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For the sake of efficient computation and reduced memory</hasEvidenceText>
  </rdf:Description>
