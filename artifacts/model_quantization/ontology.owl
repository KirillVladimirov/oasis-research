    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">usesMethod</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The specific methodology employed by zero-shot quantization to handle the absence of real data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0153</hasCQ>
