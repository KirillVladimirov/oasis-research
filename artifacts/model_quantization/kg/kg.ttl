    :hasCQ "CQ_S0_R1_0176"^^xsd:string,
        "CQ_S0_R1_0206"^^xsd:string ;
    :hasEvidenceChunk "2307.03712_rag::chunk_007"^^xsd:string,
        "2307.09782_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "FP8 activations (in E4M3 format)"^^xsd:string,
