        "CQ_S0_R1_0205"^^xsd:string ;
    :hasEvidenceChunk "2310.08041_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "into outlier mitigation, adopting strategies like clipping"^^xsd:string,
        "outlier mitigation, adopting strategies like clipping ( Banner et al. , 2019 ; McKinstry et al. , 2019 ; Choukroun et al. , 2019 ) or value splitting"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Outlier Mitigation Strategy"^^xsd:string ;
    skos:skos_definition "Strategies such as clipping, value splitting, or isolation used to handle the impact of outliers during quantization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string,
        "CQ_S0_R1_0205"^^xsd:string .

:straightthroughestimator a owl:Class ;
    rdfs:label "StraightThroughEstimator"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0006"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0093"^^xsd:string,
        "CQ_S0_R1_0119"^^xsd:string,
        "CQ_S0_R1_0154"^^xsd:string,
        "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0187"^^xsd:string,
        "CQ_S0_R1_0223"^^xsd:string ;
    :hasEvidenceChunk "1908.05033_rag::chunk_001"^^xsd:string,
        "2111.14826_rag::chunk_006"^^xsd:string,
        "2201.08442_rag::chunk_022"^^xsd:string,
        "2203.05025_rag::chunk_005"^^xsd:string,
        "2206.07741_rag::chunk_006"^^xsd:string,
        "MetaQuant_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "It is reasonable to state that STE is more suitable than ALR for complex problems."^^xsd:string,
        "STE methods contain a non-differentiable discrete quantization function, connecting the full-precision weights and quantized weights."^^xsd:string,
        "The STE operator is the de facto standard for enabling backpropagation through non-differentiable functions."^^xsd:string,
        "approximate the gradient using the straight-through estimator (STE, Bengio et al. 2013 ), which approximates the gradient of the rounding operator"^^xsd:string,
        "previous quantization works adopt straight-through estimator (STE) to approximate the backward gradients in the quantization functions"^^xsd:string,
        "straight through estimation (STE) [ 4 ] has been widely used for approximation."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Straight through estimation"^^xsd:string,
        "Straight-Through Estimator"^^xsd:string ;
    skos:skos_definition "An operator used to approximate backward gradients in quantization functions to enable backpropagation through non-differentiable functions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0006"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0093"^^xsd:string,
        "CQ_S0_R1_0119"^^xsd:string,
        "CQ_S0_R1_0154"^^xsd:string,
        "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0187"^^xsd:string,
        "CQ_S0_R1_0223"^^xsd:string .

