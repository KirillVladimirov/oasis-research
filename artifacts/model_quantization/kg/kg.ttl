    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The primary resource constraint (memory or compute) that limits the performance of a system during inference."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0139"^^xsd:string .

