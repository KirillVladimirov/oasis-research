    :hasCQ "CQ_S0_R1_0014"^^xsd:string ;
    :hasEvidenceChunk "2111.03759_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "For fake quantization, the weights and input activations are quantized and de-quantized before convolution."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A process where weights and input activations are quantized and de-quantized before convolution to simulate quantization effects using floating-point arithmetic."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0014"^^xsd:string .

:floating_point_format a owl:Class ;
    rdfs:label "Floating-Point Format"^^xsd:string ;
