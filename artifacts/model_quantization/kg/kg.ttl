:symmetric_quantization a owl:Class ;
    rdfs:label "Symmetric Quantization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0042"^^xsd:string,
        "CQ_S0_R1_0062"^^xsd:string,
        "CQ_S0_R1_0080"^^xsd:string,
        "CQ_S0_R1_0121"^^xsd:string,
        "CQ_S0_R1_0166"^^xsd:string,
        "CQ_S0_R1_0173"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string ;
    :hasEvidenceChunk "2103.13630_rag::chunk_009"^^xsd:string,
        "2202.05048_rag::chunk_008"^^xsd:string,
        "2206.07527_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Symmetric : The real zero directly maps to the quantized zero."^^xsd:string,
        "Symmetric : The real zero directly maps to the quantized zero. It does not convert the min and max of the fp32 range 5 to the quantized range ( int8 )."^^xsd:string,
        "Symmetric : The real zero directly maps to the quantized zero. It does not convert the min and max of the fp32 range 5 to the quantized range ( int8 ). Instead, the absolute maximum value between the min and max of the fp32 range is used"^^xsd:string,
        "The case where z = 0 is commonly referred to as symmetric quantization"^^xsd:string,
        "Using the min/max of the signal for both symmetric and asymmetric quantization is a popular method."^^xsd:string ;
    rdfs:subClassOf :metric,
        owl:Thing ;
    skos:altLabel "SymmetricQuantization"^^xsd:string ;
    skos:skos_definition "A uniform quantization scheme where the scaling factor is chosen based on the range of real values, often using the min/max of the signal."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0042"^^xsd:string,
        "CQ_S0_R1_0062"^^xsd:string,
        "CQ_S0_R1_0080"^^xsd:string,
        "CQ_S0_R1_0121"^^xsd:string,
        "CQ_S0_R1_0166"^^xsd:string,
        "CQ_S0_R1_0173"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string .

