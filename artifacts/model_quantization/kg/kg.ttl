:dynamic_quantization a owl:Class ;
    rdfs:label "Dynamic Quantization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0058"^^xsd:string,
        "CQ_S0_R1_0062"^^xsd:string,
        "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0131"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string,
        "CQ_S0_R1_0197"^^xsd:string ;
    :hasEvidenceChunk "123700562_rag::chunk_004"^^xsd:string,
        "2103.13630_rag::chunk_010"^^xsd:string,
        "2304.01089_rag::chunk_004"^^xsd:string,
        "Liu_Instance-Aware_Dynamic_Neural_Network_Quantization_CVPR_2022_paper_rag::chunk_002"^^xsd:string,
        "Liu_Instance-Aware_Dynamic_Neural_Network_Quantization_CVPR_2022_paper_rag::chunk_008"^^xsd:string,
        "emc2-neurips19-paper-31_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Dynamic quantization dynamically computes the clipping range of each activation"^^xsd:string,
        "Dynamic quantization dynamically computes the clipping range of each activation and often achieves the highest accuracy."^^xsd:string,
        "Dynamic quantization, on the other hand, set the quantization parameters during runtime"^^xsd:string,
        "The dynamic computation resource allocation can achieve a better trade-off between computational cost and accuracy than those of conventional static quantization methods."^^xsd:string,
        "We quantized our baseline models using Dynamic Quantization (DQ)."^^xsd:string,
        "more exible than conventional quantization methods."^^xsd:string,
        "the activation range is more dynamic of SR model (EDSR) than that in classi- cation model"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "DynamicQuantization"^^xsd:string ;
    skos:skos_definition "A quantization method where the activation range is more flexible than conventional static methods, often used to handle varying statistics in layers."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0058"^^xsd:string,
        "CQ_S0_R1_0062"^^xsd:string,
        "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0131"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string,
        "CQ_S0_R1_0197"^^xsd:string .

