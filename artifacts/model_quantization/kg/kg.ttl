:asymmetric_quantization a owl:Class ;
    rdfs:label "Asymmetric Quantization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0042"^^xsd:string,
        "CQ_S0_R1_0062"^^xsd:string,
