:hessianmatrix a owl:Class ;
    rdfs:label "HessianMatrix"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0235"^^xsd:string ;
    :hasEvidenceChunk "2402.04291_rag::chunk_002"^^xsd:string,
        "2402.14866_rag::chunk_003"^^xsd:string,
        "2402.14866_rag::chunk_006"^^xsd:string,
        "POWv6hDd9XH_rag::chunk_013"^^xsd:string ;
    :hasEvidenceText "The Hessian matrix = 2 guides the selection of the quantization candidate from the full-precision weights"^^xsd:string,
        "The Hessian matrix is essential for pruning and qu"^^xsd:string,
        "The second-order Hessian matrix of weights demonstrates an exceptionally long-tail distribution and is often used to measure the importance of weight elements in neural networks"^^xsd:string,
        "layers is informed by their respective Hessian matrices, ensuring that quantization is precisely targeted"^^xsd:string ;
    rdfs:subClassOf :secondorderinformation,
        owl:Thing ;
    skos:skos_definition "A square matrix of second-order partial derivatives of a scalar-valued function, essential for perturbation analysis and optimization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0235"^^xsd:string .

:longtaileddistribution a owl:Class ;
    rdfs:label "LongTailedDistribution"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0143"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string ;
    :hasEvidenceChunk "Tu_Toward_Accurate_Post-Training_Quantization_for_Image_Super_Resolution_CVPR_2023_paper_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Long-tailed. all the distributions show dense in the middle yet sparse in the"^^xsd:string ;
    rdfs:subClassOf :activationdistribution,
        owl:Thing ;
    skos:skos_definition "A data distribution characterized by being dense in the middle yet sparse in the tails, often detrimental to quantization accuracy."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0143"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string .

:outlier a owl:Class ;
    rdfs:label "Outlier"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0009"^^xsd:string,
        "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0036"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string ;
    :hasEvidenceChunk "2306.12929_rag::chunk_002"^^xsd:string,
        "2310.08041_rag::chunk_004"^^xsd:string,
        "2401.18079_rag::chunk_002"^^xsd:string,
        "2403.02775_rag::chunk_004"^^xsd:string,
        "2403.02775_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "modern transformer-based language models tend to learn outliers in weights and activations"^^xsd:string,
        "outlier values in cached KV activations can significantly degrade quantization resolution."^^xsd:string,
        "outliers are critical to the performance"^^xsd:string,
        "outliers behave like a gating mechanism"^^xsd:string,
        "those outliers are way more important than the normal elements for the models performance."^^xsd:string,
        "those outliers play a crucial role in the model pre"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Outlier Value"^^xsd:string ;
    skos:skos_definition "Critical values in weights or activations that are essential to model performance and often require isolation or high-precision maintenance."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0009"^^xsd:string,
        "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0036"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string .

:outlierfeature a owl:Class ;
    rdfs:label "OutlierFeature"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0150"^^xsd:string ;
    :hasEvidenceChunk "2208.07339_rag::chunk_001"^^xsd:string ;
