    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Sparse but systematic large magnitude features that emerge in transformer layers and can ruin quantization precision."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0150"^^xsd:string .

:perchannelscale a owl:Class ;
    rdfs:label "PerChannelScale"^^xsd:string ;
