:kv_cache a owl:Class ;
    rdfs:label "KV Cache"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0009"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0063"^^xsd:string,
        "CQ_S0_R1_0091"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string ;
    :hasEvidenceChunk "2401.18079_rag::chunk_000"^^xsd:string,
        "2402.12065_rag::chunk_003"^^xsd:string,
        "2403.04643_rag::chunk_000"^^xsd:string,
        "2403.04643_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "For auto-regressive LLMs, caching key and value activations (KV cache) into memory is necessary for subsequent token generation."^^xsd:string,
        "KV cache activations surface as the dominant contributor to memory consumption during in"^^xsd:string,
        "linear expansion of the Key-Value (KV) cache with the context length."^^xsd:string,
        "the generative inference of these LLMs typically incorporates the KV cache mechanism to improve the efficiency of computation resour"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "KV cache"^^xsd:string ;
    skos:skos_definition "A mechanism used in generative inference of LLMs to improve computation efficiency by storing previously generated tokens."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0009"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0063"^^xsd:string,
        "CQ_S0_R1_0091"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string .

:large_language_model a owl:Class ;
    rdfs:label "Large Language Model"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0045"^^xsd:string,
        "CQ_S0_R1_0087"^^xsd:string,
        "CQ_S0_R1_0175"^^xsd:string,
        "CQ_S0_R1_0195"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string,
        "CQ_S0_R1_0211"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string,
        "CQ_S0_R1_0233"^^xsd:string ;
    :hasEvidenceChunk "2308.13137_rag::chunk_001"^^xsd:string,
        "2309.05210_rag::chunk_000"^^xsd:string,
        "2310.00034_rag::chunk_003"^^xsd:string,
        "2311.01305_rag::chunk_000"^^xsd:string,
        "2402.12065_rag::chunk_000"^^xsd:string,
        "2402.18158_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Large Language Models (LLMs) face significant deployment challenges due to their substantial memory requirements and the computational demands of auto-regressive text generation process."^^xsd:string,
        "Large language models(LLMs) excellent performance across a variety of tasks, but they come with significant computational and storage costs."^^xsd:string,
        "We investigate binarization for LLMs comprehensively in this paper and propose PB-LLM , which is an attempt to compress LLMs using binarization."^^xsd:string,
        "current LLMs are serving as general solvers applicable to vastly different tasks"^^xsd:string,
        "large transformer language models with 7 billion parameters and beyond"^^xsd:string,
        "large transformer language models with 7 billion parameters and beyond demands a considerable amount of GPU computation"^^xsd:string,
        "significant demand for computational resources and associated communication overheads impedes the practical deployment of LLMs"^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:altLabel "LargeLanguageModel"^^xsd:string ;
    skos:skos_definition "A type of model that exhibits excellent performance across a variety of tasks but comes with significant computational and storage costs."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0045"^^xsd:string,
        "CQ_S0_R1_0087"^^xsd:string,
        "CQ_S0_R1_0175"^^xsd:string,
        "CQ_S0_R1_0195"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string,
        "CQ_S0_R1_0211"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string,
        "CQ_S0_R1_0233"^^xsd:string .

