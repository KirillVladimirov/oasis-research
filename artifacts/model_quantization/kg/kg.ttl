:quantizedllm a owl:Class ;
    rdfs:label "QuantizedLLM"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0063"^^xsd:string,
        "CQ_S0_R1_0221"^^xsd:string,
        "CQ_S0_R1_0233"^^xsd:string,
        "CQ_S0_R1_0238"^^xsd:string,
        "CQ_S0_R1_0240"^^xsd:string ;
    :hasEvidenceChunk "2308.13137_rag::chunk_001"^^xsd:string,
        "2402.12065_rag::chunk_000"^^xsd:string,
        "2402.16775_rag::chunk_012"^^xsd:string,
        "2402.18158_rag::chunk_001"^^xsd:string,
        "2402.18158_rag::chunk_006"^^xsd:string,
        "2403.02775_rag::chunk_008"^^xsd:string,
        "2403.06408_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "LLMs quantized to lower bit precision with a larger parameter scale"^^xsd:string,
        "Performances of the quantized LLMs with respect to their parameter scales."^^xsd:string,
        "Quantization has shown to be promising to mitigate both computational and memory overhead in LLMs."^^xsd:string,
        "Since quantization is a lossy compression technique, alterations in design choices for efficiency considerations will also yield distinct impacts on task performances."^^xsd:string,
        "WKVQuant: Quantizing Weight and Key/Value Cache for Large Language Models"^^xsd:string,
        "quantizing large language models to reduce the deployment cost"^^xsd:string,
        "the quantized LLM attains a continuously decreased ppl"^^xsd:string ;
    rdfs:subClassOf :llm,
        owl:Thing ;
