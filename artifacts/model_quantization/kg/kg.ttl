    prov:wasDerivedFrom "CQ_S0_R1_0042"^^xsd:string,
        "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0080"^^xsd:string,
        "CQ_S0_R1_0173"^^xsd:string .

:zero_shot_quantization a owl:Class ;
    rdfs:label "Zero-shot quantization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0153"^^xsd:string ;
    :hasEvidenceChunk "2203.17008_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Zero-shot quantization (or data-free quantization) [ 3 , 4 , 9 , 10 , 44 , 61 , 66 , 67 , 70 ] is therefore a necessary technique for quantization. It assumes that only the architecture and the pre-trained weights are available"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A quantization technique that assumes only the architecture and the pre-trained weights are available, without access to calibration data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0153"^^xsd:string .

