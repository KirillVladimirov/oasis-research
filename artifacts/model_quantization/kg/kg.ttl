:zero_point a owl:Class ;
    rdfs:label "Zero Point"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0042"^^xsd:string,
        "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0080"^^xsd:string,
        "CQ_S0_R1_0173"^^xsd:string ;
    :hasEvidenceChunk "2111.03759_rag::chunk_003"^^xsd:string,
        "2201.08442_rag::chunk_007"^^xsd:string,
        "2202.05048_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "For symmetric quantization the zero-point is xed to 0, while the asymmetric quantization has an adjustable zero-point to adapt different range"^^xsd:string,
        "the zero-point z and the bit-width b . These quantization parameters are also sometimes referred to as quantization encodings"^^xsd:string,
        "zero point = ROUND ( min f p 32 scale ) 2 n 1"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Zero-point"^^xsd:string,
        "ZeroPoint"^^xsd:string ;
