:algorithm a owl:Class ;
    rdfs:label "Algorithm"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing .

:block_size a owl:Class ;
    rdfs:label "Block Size"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0134"^^xsd:string ;
    :hasEvidenceChunk "2308.09723_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "each contiguous block of B elements in a given column has its own scaling factor."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The number of contiguous elements in a column that share a single scaling factor in fine-grained quantization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0134"^^xsd:string .

:compressiontechnique a owl:Class ;
    rdfs:label "CompressionTechnique"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0224"^^xsd:string ;
    :hasEvidenceChunk "2301.12017_rag::chunk_011"^^xsd:string ;
    :hasEvidenceText "combining INT4 quantization with other compression techniques, such as pruning and layer reduction."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Methods used to accelerate inference or reduce model footprint, including quantization and pruning."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0224"^^xsd:string .

:contextlength a owl:Class ;
    rdfs:label "ContextLength"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0110"^^xsd:string ;
    :hasEvidenceChunk "2403.04643_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "linear expansion of the Key-Value (KV) cache with the context length."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The size of the sequence or window processed by the model, which is linearly related to the KV cache size."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0110"^^xsd:string .

:deployment_stack a owl:Class ;
    rdfs:label "Deployment Stack"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0067"^^xsd:string ;
    :hasEvidenceChunk "2202.05048_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Quantune is compared with mature tools such as TensorRT and TVM, which support the PTQ on the GPU and integer-only accelerator (VTA), respectively."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Software tools or frameworks, such as TensorRT or TVM, used to support and execute quantized models on specific hardware accelerators."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0067"^^xsd:string .

:dynamicrange a owl:Class ;
    rdfs:label "DynamicRange"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0109"^^xsd:string ;
    :hasEvidenceChunk "123700562_rag::chunk_004"^^xsd:string,
        "123700562_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "As for activations, the quantization range depends on the inputs, which leads to a dynamic range."^^xsd:string,
        "the activation range is more dynamic of SR model (EDSR) than that in classi- cation model (ResNet-18)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The span of values covered by activations, which can be influenced by model architecture and normalization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0109"^^xsd:string .

:e4m3 a owl:Class ;
