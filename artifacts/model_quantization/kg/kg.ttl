    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Weight-Only Quantization"^^xsd:string ;
    skos:skos_definition "A quantization approach that leaves activations in high precision while pushing weights to lower precision to accelerate memory I/O."^^xsd:string ;
