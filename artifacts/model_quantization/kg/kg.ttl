    :hasEvidenceChunk "2310.18313_rag::chunk_017"^^xsd:string,
        "2311.12359_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "FP8 is a natural progression from 16-bit data formats to further reducing computing cost."^^xsd:string,
        "accurate floating-point MACs for FP32 or FP64 operands"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A data format used for representing numerical values with a dynamic range, often used in low-precision arithmetic for model compression."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0066"^^xsd:string .

:fp8 a owl:Class ;
    rdfs:label "FP8"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0176"^^xsd:string,
        "CQ_S0_R1_0206"^^xsd:string ;
    :hasEvidenceChunk "2307.09782_rag::chunk_008"^^xsd:string,
        "2309.14592_rag::chunk_000"^^xsd:string,
        "2310.18313_rag::chunk_017"^^xsd:string ;
    :hasEvidenceText "FP8 is a natural progression from 16-bit data formats to further reducing computing cost."^^xsd:string,
        "We find that FP8 and FP4, the configurations E4M3 and E2M1 respectively outperform E5M2 and E3M0"^^xsd:string,
        "we study the advantages of FP8 data formats for post-training quantization"^^xsd:string,
        "we study the advantages of FP8 data formats for post-training quantization across 75 unique network architectures"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "FP8Format"^^xsd:string ;
    skos:skos_definition "A data format used for post-training quantization to meet computational demands while maintaining accuracy."^^xsd:string ;
