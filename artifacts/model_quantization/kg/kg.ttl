:quantizationprocess a owl:Class ;
    rdfs:label "QuantizationProcess"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0023"^^xsd:string,
        "CQ_S0_R1_0031"^^xsd:string,
        "CQ_S0_R1_0032"^^xsd:string ;
    :hasEvidenceChunk "2201.08442_rag::chunk_020"^^xsd:string,
        "2202.05048_rag::chunk_005"^^xsd:string,
        "2209.15317_rag::chunk_002"^^xsd:string,
        "2402.14866_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "Hessian-Attention-based quantization strategically refines weight precision within attention layers to maintain model accuracy"^^xsd:string,
        "The commonly used solution is to approximate the quantization operation to a straight-through estimator (STE)"^^xsd:string,
        "The overall process of quantization goes through two phases: calibration and conguration search."^^xsd:string,
        "by-pass the quantization operation, if possible, and check that the accuracy matches that of the FP32 model."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "QuantizationOperation"^^xsd:string ;
    skos:skos_definition "An operation that restricts values to a specific number of available levels, often approximated using a straight-through estimator."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0023"^^xsd:string,
        "CQ_S0_R1_0031"^^xsd:string,
        "CQ_S0_R1_0032"^^xsd:string .

:representation a owl:Class ;
    rdfs:label "Representation"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing .

