:acquisitionfunction a owl:Class ;
    rdfs:label "AcquisitionFunction"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0017"^^xsd:string,
        "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0077"^^xsd:string,
