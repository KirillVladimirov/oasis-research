    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reinforcement learning is a subset of machine learning</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_43">
