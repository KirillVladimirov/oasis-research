    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1601.07925_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feature importance scores are determined by the features Gini importance</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#multiobjectivesearch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
