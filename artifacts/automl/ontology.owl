    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A category of criteria highlighting user-experience beyond predictive performance, focusing on understanding how the final model functions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0108</hasCQ>
