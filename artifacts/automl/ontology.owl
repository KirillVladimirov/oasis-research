    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surrogate model observation acquisition function</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surrogate models are meta-models that map dataset and machine learning model properties to quantities that characterize performance or informativeness.</hasEvidenceText>
