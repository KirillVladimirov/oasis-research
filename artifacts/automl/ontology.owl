    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1707.07012_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1611.01578_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1802.03268_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In ENAS, a controller discovers neural network architectures by searching for an optimal subgraph within a large computational graph.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the controller contains 5 B softmax layers for predicting the architecture of a convolutional cell.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The list of tokens that the controller predicts can be viewed as a list of actions a 1: T to design an architecture for a child network.</hasEvidenceText>
