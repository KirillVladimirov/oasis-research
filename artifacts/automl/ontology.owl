    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1906.02287_rag::chunk_024</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pipeline here follows the traditional machine learning work process: from data preprocessing, feature engineering to</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automatically creating and optimizing machine learning pipelines, tree-based pipeline optimization</hasEvidenceText>
