    <rdfs:range rdf:resource="http://example.org/S0/R1#weightsharingmethod"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">usesSetting</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The association between a search process and the specific weight-sharing configuration it employs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0207</hasCQ>
