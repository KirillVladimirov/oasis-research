    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A resource allocation, often represented as a multiple of a value R, used to differentiate between configurations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0084</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0188</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0204</hasCQ>
