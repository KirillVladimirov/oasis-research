    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2007.15745_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hyper-parameter may need to be used or tuned depending on the value of another hyperparameter, called a conditional hyper-parameter</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
