    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ETMLP5_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AutoML aims to fully automate the machine learning process end-to-end</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">comparing AutoML services</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we consider seven current AutoML service platforms</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is to provide a user-centric framework for comparing AutoML services. We define a set of qualitative criteria, spanning across six categories (Estimates, Scope, Productivity, Interpretability, Customizability, and Connectivity)</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a user-centric framework for comparing AutoML services.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">highlight user-experience beyond predictive performance when selecting or evaluating AutoML services.</hasEvidenceText>
  </rdf:Description>
