        "osdi21-wang-yuke_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "Each layer of GNNs generates the intermediate embedding by aggregating the information of target nodes in-edge neighbors."^^xsd:string,
        "Graph Isomorphism Network (GIN)"^^xsd:string,
        "a GNN layer first aggregates all vertices, placing little pressure on compute hardware but a lot on the memory hierarchy, and then updates the vertices"^^xsd:string,
        "inputting the transferred data into the GNN layer"^^xsd:string,
        "representative 2-layer Graph Convolutional Network (GCN)"^^xsd:string,
        "several GNN layers), we will get the output embedding of each node, which can usually be used for various downstream graph-based deep learning tasks"^^xsd:string,
        "subsequent layers use the output of the preceding layer. The nal layer produces the output graph."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "GNN layer"^^xsd:string,
        "GNNLayer"^^xsd:string ;
    skos:skos_definition "A layer within a GNN that generates intermediate embeddings by aggregating information from neighbors."^^xsd:string ;
