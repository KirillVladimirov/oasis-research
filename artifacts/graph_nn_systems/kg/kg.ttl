    kg:docId "2106.06150_rag" ;
    kg:inPaper <http://example.org/kg/paper/2106_06150_rag> ;
    kg:textSpan "with hidden state dimension as 512 on Yelp and Amazon dataset, and 256 on the rest, using four methods. We update the model with a mini-batch size of 1000 and ADAM optimizer with a learning rate of 0.003 for all training methods. We use the efficient implementation of node-wise neighbor sampling, LADIES and GNS in DGL, parallelized with multiprocessing. The number of sampling workers is 4 . The column labeled LADIES(512) means sampling 512 nodes at each layer and LADIES(5000) means sampling 5000" .

<http://example.org/kg/chunk/2109_08983_rag__chunk_000> a kg:Chunk ;
    kg:chunkId "2109.08983_rag::chunk_000" ;
