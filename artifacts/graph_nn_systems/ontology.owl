    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GNNSys21_paper_8_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Parallel Training and Partition</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#performs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#edge_computation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">performs</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The execution of edge-specific calculations within the GAT architecture.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0189</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0189</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2105.10554_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For a GAT, the values of exp( e ik ) are also added over the neighborhood to create the denominator for the softmax.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#vr_gcn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VR-GCN</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sampling method that utilizes historical embeddings to achieve smaller training variance and requires a smaller sample size.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0004</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0004</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.14052_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VR-GCN can enjoy the advantage of a smaller training variance that accelerates training convergence. In practice, [ 13 ] found that VR-GCN can get a comparable performance of GraphSAGE</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VR-GCN can enjoy the advantage of a smaller training variance that accelerates training convergence.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#managesstalenesswith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#distributed_gnn_training"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#staleness_bound"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">managesStalenessWith</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mechanism of using a specific bound to control the impact of asynchronous updates and historical data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0064</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0064</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p1937-peng_rag::chunk_024</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Choice of Staleness Bound. The tradeobetween the runtime and error is dicult to understand due to the entanglement of model convergence and system performance</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#validatedby">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#graphpartitioningstrategy"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#metric"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">validatedBy</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship where a strategy's effectiveness is confirmed through specific metrics.</skos:skos_definition>
