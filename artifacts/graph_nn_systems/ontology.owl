    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The statistical variance in estimation during the training process of a graph neural network.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0121</hasCQ>
