    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process targeting graph data, related to graph sparsification, used to reduce computational load or memory overhead.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.14052_rag::chunk_020</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graph pruning is a concept related to graph sparsification</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GNN pruning targets the model and is different from graph pruning which targets the graph data.</hasEvidenceText>
  </rdf:Description>
