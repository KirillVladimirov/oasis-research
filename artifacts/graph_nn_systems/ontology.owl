    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fundamental operator in GNNs which performs a multiplication operation between a sparse matrix and a dense matrix.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0208</hasCQ>
