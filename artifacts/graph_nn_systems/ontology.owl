    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GraphStorageFormat</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0115</hasCQ>
