    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1909.01315_rag::chunk_020</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">edge parallel on COO outperforms CSR</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#gnnoperator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
