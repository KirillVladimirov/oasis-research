    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Average Edge Span; a metric used to determine if graph reordering is likely to improve runtime performance.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0066</hasCQ>
