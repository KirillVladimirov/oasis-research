    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of improving a partitioning approach online by incorporating overhead metrics.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0118</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0175</hasCQ>
