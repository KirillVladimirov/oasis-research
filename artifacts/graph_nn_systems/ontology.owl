    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data associated with graph nodes that are reused across mini-batches in feature aggregation processes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0147</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0147</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.16384v2_rag::chunk_016</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">node features that will be reused in future mini-batches to avoid evicting reusable cache-lines</hasEvidenceText>
  </rdf:Description>
