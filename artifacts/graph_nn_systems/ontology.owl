    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2007.03179_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DGL implements all graph-related operations in C++/CUDA and exposes to DL frameworks as shared lib. We also follow this method to accelerate GNN application with a highperformance CUDA kernel.</hasEvidenceText>
  </rdf:Description>
