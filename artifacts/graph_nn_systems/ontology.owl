    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2109.08983_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pruning methods have been proposed for accelerating GNN inference</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To tackle GNNs prohibitive inference cost, various ef- cient GNN inference techniques have been developed.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#graph_attention_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
