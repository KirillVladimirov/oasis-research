    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2412.20379_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2412.20379_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we explore tensor parallelism throughout the entire training process, vertically partitioning both features and embeddings across all layers</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GNN tensor parallelism achieves a well-balanced computation and communication load by evenly partitioning vertex features along dimensions.</hasEvidenceText>
  </rdf:Description>
