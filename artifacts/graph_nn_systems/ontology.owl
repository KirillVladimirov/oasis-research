    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DGL and PyG both implement custom SpMM kernel instead of using sparse matrix operators provided by Pytorch.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hasmemoryconsumption">
