    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fast25-chen-weijian-leap_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reduces the transmission of vertex features between servers through strategic model migration (8 features in Figure 3 vs. 6 in Figure 9 )</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#formedfrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
