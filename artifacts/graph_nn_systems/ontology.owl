    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GNNInference</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of using a trained Graph Neural Network to make predictions, which can be accelerated by pruning methods.</skos:skos_definition>
