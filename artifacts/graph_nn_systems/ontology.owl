    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hardware components that are kept available for other tasks while data transfers occur behind the scenes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0183</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0183</prov:wasDerivedFrom>
