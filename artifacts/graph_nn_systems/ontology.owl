    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that we only need to obtain such subgraphs or clusters once as a preprocessing step.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#featurecollection">
