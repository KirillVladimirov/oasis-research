    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.14052_rag::chunk_038</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The graph is a large and ultra-sparse matrix and poses challenges to the memory design. For instance, a graph such as Orkut [ 92 ] comprises over 3 million nodes and more than 223 million edges, yet the density is only 2 . 5 10 5 .</hasEvidenceText>
  </rdf:Description>
