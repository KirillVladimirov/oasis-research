    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cache hit ratio over different proportions (a) and cache size (KB)(b).</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the cache hit ratio keeps decreasing with the increasing number of GPUs.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hastransmissionvolume">
