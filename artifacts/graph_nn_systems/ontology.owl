    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of executing a trained Graph Neural Network to make predictions, often characterized by dynamic and irregular data accesses.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0162</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0162</prov:wasDerivedFrom>
