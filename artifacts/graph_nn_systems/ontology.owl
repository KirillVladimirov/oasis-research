    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A representation that supports adaptivity in the structure of the graph itself, allowing for modifications during computation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1806.01261_rag::chunk_016</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graph networks support highly exible graph representations in two ways: rst, in terms of the representation of the attributes; and second, in terms of the structure of the graph itself.</hasEvidenceText>
  </rdf:Description>
