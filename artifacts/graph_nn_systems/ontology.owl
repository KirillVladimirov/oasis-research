    <rdfs:range rdf:resource="http://example.org/S0/R1#communicationoverhead"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hides</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of overlapping communication with computation to mask latency.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0170</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0170</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.14052_rag::chunk_032</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pipelines communication and computation across mini-batches for hiding the communication overhead.</hasEvidenceText>
  </rdf:Description>
