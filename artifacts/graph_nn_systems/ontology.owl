    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sequence of operations involved in moving and preparing graph data for training, often involving data movement between CPU and GPU.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0159</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0159</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">osdi21-gandhi_rag::chunk_024</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PaGraph reports data copy to be a major bottleneck and focuses on reducing data movement between CPU and GPU</hasEvidenceText>
  </rdf:Description>
