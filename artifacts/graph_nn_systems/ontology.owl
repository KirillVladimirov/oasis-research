    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">this is not feasible in large-scale graphs due to GPU memory limitations</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#spmm_kernel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
