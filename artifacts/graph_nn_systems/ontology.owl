    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system level intervention providing execution support, parameter management, and input adaptability for GNN models.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0034</hasCQ>
