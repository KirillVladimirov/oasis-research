    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">it still follows the conventional message passing paradigm for vertex-centric computation.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#edgetype">
