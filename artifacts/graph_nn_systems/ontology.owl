    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2112.08541_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">select training nodes from different sequences in a roundrobin manner to form a training batch</hasEvidenceText>
  </rdf:Description>
