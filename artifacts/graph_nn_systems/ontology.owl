    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An efficient system of memory levels used to connect specialized blocks in training accelerators.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0163</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0163</prov:wasDerivedFrom>
