    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Initially, GPUs 0 and 2 load vertex data chunk V 0 from the host memory.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#isscheduledon">
