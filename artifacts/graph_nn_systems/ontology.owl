    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A category of GNN models that utilize convolutional operators or layers for graph representation learning.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0008</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0037</hasCQ>
