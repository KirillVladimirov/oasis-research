    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conventional computational model for vertex-centric computation in GNNs involving scatter operations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0238</hasCQ>
