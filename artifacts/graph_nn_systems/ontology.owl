    <rdfs:range rdf:resource="http://example.org/S0/R1#localitycentricscheme"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">addressesSkewIn</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dynamic load balancing is used to mitigate the skewed loading issues found in locality-centric schemes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0169</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0169</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">seastar_eurosys21_rag::chunk_015</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We propose dynamic load balancing to address the problem of skewed loading as follows.</hasEvidenceText>
  </rdf:Description>
