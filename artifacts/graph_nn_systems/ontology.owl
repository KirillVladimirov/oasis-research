    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2112.15345_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2106.06150_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we only move one mini-batch ahead of time to GPUs because of the scarceness of GPU memory.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Due to the small GPU memory size</hasEvidenceText>
  </rdf:Description>
