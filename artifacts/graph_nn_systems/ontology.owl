    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A high-performance kernel implemented in C++/CUDA to accelerate graph-related operations in deep learning frameworks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0018</hasCQ>
