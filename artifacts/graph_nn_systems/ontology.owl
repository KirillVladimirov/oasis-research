    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A computational kernel designed to perform Sparse Matrix-Matrix multiplication, often requiring careful design to enable coalesced access patterns on GPUs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0018</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0119</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0018</prov:wasDerivedFrom>
