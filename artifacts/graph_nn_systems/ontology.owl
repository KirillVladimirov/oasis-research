    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SpMM is a critical operation in many GNN models</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#tensorflow_package">
