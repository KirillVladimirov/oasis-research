    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loading rich vertex features from CPU to GPU through a limited bandwidth link usually dominates the training cycle.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hascachehitratio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
