    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">computation and memory access patterns are very different</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#processing_unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
