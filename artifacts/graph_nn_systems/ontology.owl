    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A storage component where messages from neighbors are retrieved during the aggregation phase.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0061</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0061</prov:wasDerivedFrom>
