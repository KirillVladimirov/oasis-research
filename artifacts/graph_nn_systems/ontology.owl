    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">boasting a substantial throughput increase of 1.7x to 16.8x</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#implementsoperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#spmm_kernel"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#sparse_matrix_matrix_multiplication"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">implementsOperation</rdfs:label>
