    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific category or classification of an edge within a heterogeneous graph.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0191</hasCQ>
