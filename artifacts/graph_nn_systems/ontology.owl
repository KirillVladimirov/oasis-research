    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a GNN computational phase to the specific memory access behavior it generates.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0187</hasCQ>
