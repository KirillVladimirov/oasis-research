    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system architecture used for large-scale GNN training that typically offers higher throughput than single-machine out-of-core systems.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0133</hasCQ>
