    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entity</axiomRhs>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#trains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#mixedcpugputraining"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#gnn_model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trains</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship where a specific training strategy is used to train a GNN model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0143</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0143</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2106.06150_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mixed CPU-GPU training . The main bottleneck of mixed CPU-GPU training is data copy between CPUs and GPUs (cf. Figure 1). Because mini-batch sampling occurs in CPU, we need a low-overhead sampling algorithm to enable efficient training.</hasEvidenceText>
  </rdf:Description>
