  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#a100_80gb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#gpu"/>
