    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the messages from its neighbors obtained in the previous layer are retrieved from a message buffer.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#parallelization_strategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
