  <rdf:Description rdf:about="http://example.org/S0/R1#executedon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#gpu"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">executedOn</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates the training pipeline or its components to the hardware it utilizes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0092</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0117</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0092</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0117</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2007.03179_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.16384v2_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SpMM kernel needs to be carefully designed to enable a coalesced access pattern for data loading.</hasEvidenceText>
