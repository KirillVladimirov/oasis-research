    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A customized operation that replaces standard scatter/gather stages to update vertex data in a single pass.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">atc19-ma_0_rag::chunk_016</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">replaces the whole SAG stages using a specially customized operation called Fused-Gather . This operation processes each edge chunk</hasEvidenceText>
  </rdf:Description>
