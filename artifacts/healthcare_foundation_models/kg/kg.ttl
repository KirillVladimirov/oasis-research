:medicalknowledge a owl:Class ;
    rdfs:label "MedicalKnowledge"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0071"^^xsd:string,
        "CQ_S0_R1_0085"^^xsd:string,
        "CQ_S0_R1_0165"^^xsd:string,
        "CQ_S0_R1_0176"^^xsd:string ;
