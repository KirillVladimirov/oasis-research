        "CQ_S0_R1_0081"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0118"^^xsd:string,
        "CQ_S0_R1_0119"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
