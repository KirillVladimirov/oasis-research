        "Transformer-based Architecture"^^xsd:string ;
    skos:skos_definition "A neural network architecture, specifically BERT or large sequence models, used to learn flexible and high-quality representations."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0108"^^xsd:string,
        "CQ_S0_R1_0121"^^xsd:string,
        "CQ_S0_R1_0230"^^xsd:string .

