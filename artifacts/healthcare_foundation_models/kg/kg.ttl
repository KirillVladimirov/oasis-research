    :hasCQ "CQ_S0_R1_0024"^^xsd:string ;
    :hasEvidenceChunk "2306.16741_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "we apply temporally consistent spatial augmentations [ 28 ] to all frames within a single view. Our augmentation approach includes random horizontal flips, color jitter, Gaussian blur, solarization"^^xsd:string ;
