    :hasCQ "CQ_S0_R1_0059"^^xsd:string,
        "CQ_S0_R1_0129"^^xsd:string ;
    :hasEvidenceChunk "2212.13138_rag::chunk_031"^^xsd:string,
        "2303.13375_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "sophisticated prompting methods"^^xsd:string,
        "sophisticated prompting methods like chain of thought prompting [WWS + 22b, KGR + 22], ensemble approaches like self-consistency prompting"^^xsd:string,
        "the impact of this strategy on LL"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Prompting Strategy"^^xsd:string ;
    skos:skos_definition "A method or pattern used to guide a language model's response, such as few-shot or chain-of-thought prompting."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0059"^^xsd:string,
        "CQ_S0_R1_0129"^^xsd:string .

