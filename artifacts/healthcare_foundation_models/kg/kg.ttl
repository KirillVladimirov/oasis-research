:Cls_3d_medical_image a owl:Class ;
    rdfs:label "3D Medical Image"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0105"^^xsd:string ;
    :hasEvidenceChunk "1904.00625_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "models based on large dataset are important for the development of deep learning in 3D medical images."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A type of medical imaging data used for analysis in deep learning models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0105"^^xsd:string .

:accesses a owl:ObjectProperty ;
    rdfs:label "accesses"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0156"^^xsd:string ;
    :hasEvidenceChunk "2112.04426_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "equip models with the ability to directly access a large database"^^xsd:string ;
    rdfs:domain :model ;
    rdfs:range :large_database ;
    skos:skos_definition "The action of a model retrieving information from an external data source to perform predictions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0156"^^xsd:string .

:accountability_and_governance a owl:Class ;
    rdfs:label "Accountability and Governance"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0048"^^xsd:string ;
    :hasEvidenceChunk "a_pro-innovation_approach_to_AI_regulation_rag::chunk_026"^^xsd:string ;
    :hasEvidenceText "Governance measures should be in place to ensure effective oversight of the supply and use of AI systems, with clear lines of accountability established across the AI life cycle."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Measures to ensure effective oversight and clear lines of responsibility across the AI life cycle."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0048"^^xsd:string .

:activelearning a owl:Class ;
    rdfs:label "ActiveLearning"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0214"^^xsd:string ;
    :hasEvidenceChunk "2203.02155_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "human-in-theloop data collection"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Active Learning"^^xsd:string ;
    skos:skos_definition "A process involving human-in-the-loop data collection and iterative model improvement."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0214"^^xsd:string .

:adapted_product a owl:Class ;
    rdfs:label "Adapted Product"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0056"^^xsd:string ;
    :hasEvidenceChunk "a_pro-innovation_approach_to_AI_regulation_rag::chunk_046"^^xsd:string ;
    :hasEvidenceText "any improvements or defects in a foundation model could quickly affect all adapted products."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A product or application derived from the adaptation of a foundation model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0056"^^xsd:string .

