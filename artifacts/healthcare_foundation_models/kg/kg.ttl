        "2101.05224_rag::chunk_002"^^xsd:string,
        "2101.05224_rag::chunk_004"^^xsd:string,
        "cpDhcsEDC2_rag::chunk_023"^^xsd:string ;
    :hasEvidenceText "CLIP rep is our reproduced CLIP version with the original contrastive loss"^^xsd:string,
        "Contrastive learning is a form of self-supervision that can leverage unlabeled data to produce pretrained models."^^xsd:string,
        "Contrastive self-supervised methods such as instance discrimination [ 44 ], CPC [ 20 , 35 ], Deep InfoMax [ 21 ]"^^xsd:string,
        "other works concentrate on tailoring contrastive learning to medical data"^^xsd:string ;
