    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss function using modern implicit maximum likelihood estimation techniques</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#pool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
