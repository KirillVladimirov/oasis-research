  <rdf:Description rdf:about="http://example.org/S0/R1#modelslongrangedependency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#attentionmechanism"/>
