    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Models that typically produce medical advice based solely on their encoded knowledge without specific domain consideration.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0097</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0097</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.15964_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general LLMs typically produce medical advice based solely on their encoded knowledge, without considering specific knowledge in the medical domain</hasEvidenceText>
  </rdf:Description>
