    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Benchmarks used for learning to predict molecular properties such as binding affinity to a target of interest.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0039</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0039</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2011.13230_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alternatively, in QSAR we are interested in learning to predict a given molecular property, such as the binding afnity to a target of interest.</hasEvidenceText>
