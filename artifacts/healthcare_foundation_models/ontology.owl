    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The smaller models followed similar schedules.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#gradient_accumulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
