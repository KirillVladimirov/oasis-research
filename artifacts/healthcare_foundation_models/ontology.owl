    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model capable of processing and generating content across multiple modalities, such as text and images, often adapted for specific domains like biomedicine.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0062</hasCQ>
