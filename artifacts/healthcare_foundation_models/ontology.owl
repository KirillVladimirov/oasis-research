    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">its dual-branch nature limits its application to cross-modal generative tasks.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#ai_life_cycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
