    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical diagnostic or classification tasks involving medical imaging modalities.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0049</hasCQ>
