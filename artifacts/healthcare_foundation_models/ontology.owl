    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The generated responses or reports produced by a Large Language Model in response to medical queries.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0085</hasCQ>
