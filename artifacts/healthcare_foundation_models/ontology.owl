    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.13375_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2212.04356_rag::chunk_008</hasEvidenceChunk>
