    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medical answering performance (requiring recall, reading comprehension, and reasoning skills) improves with LLM scale</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#ccnet_pipeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
