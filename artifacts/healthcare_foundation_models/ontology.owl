    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2203.03540v2_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.06716_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2309.11295_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2204.02311_rag::chunk_043</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We perform our ablation studies on the following downstream tasks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For the clinical prediction downstream task, we performed fine-tuning</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GatorTron models scale for canonical clinical downstream tasks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">investigating a single model to simultaneously handle various medical segmentation tasks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We propose a method called Clinical Prediction with Large Language Models (CPLLM).</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GatorTron-large demonstrated remarkable improvements for all 5 tasks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In summarization, the 540B netuned PaLM closely matches or exceeds the best reported prior results</hasEvidenceText>
  </rdf:Description>
