    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sensitive data including clinical notes, physician consultations, and nursing assessments that frequently incorporate identifiable patient information.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0122</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0122</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.11032_rag::chunk_001</hasEvidenceChunk>
