    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intra-view tasks 2 create input and target from the same view, which includes auto-encoder [ 34 , 76 ], global/dense distillation [ 33 , 80 ] and masked image modeling (MIM)</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hassharedcomponentwith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
