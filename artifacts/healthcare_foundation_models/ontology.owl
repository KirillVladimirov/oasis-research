    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collection of medical data used for training or evaluating AI systems, such as clinical text or multi-organ segmentation data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0022</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0125</hasCQ>
