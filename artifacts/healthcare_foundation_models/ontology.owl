    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A foundation model applied to medical imaging modalities to achieve performance through fine-tuning.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0063</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0203</hasCQ>
