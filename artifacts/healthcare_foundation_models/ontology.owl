    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#dataset"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Benchmark</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standardized tests used to evaluate models, which may have inherent limitations in covering the full scope of medical knowledge.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0176</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0176</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2212.13138_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Existing benchmarks are inherently limited and only provide partial coverage of the space of medical knowledge.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#requiresskill">
