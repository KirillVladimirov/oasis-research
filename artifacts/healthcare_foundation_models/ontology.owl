    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021.bionlp-1.16_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.01988_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">train ELECTRA-BASE and ELECTRA-LARGE mod- 150 els on MIMIC III ( Johnson et al. , 2016 ) clinical notes</hasEvidenceText>
