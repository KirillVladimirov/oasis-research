    <rdfs:range rdf:resource="http://example.org/S0/R1#positivesample"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSharedComponentWith</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship where a negative sample is selected because its drug or target is present in the set of positive samples.</skos:skos_definition>
