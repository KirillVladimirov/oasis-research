    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A distribution strategy for training on large datasets using many hardware accelerators.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0204</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0204</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">123500477_rag::chunk_009</hasEvidenceChunk>
