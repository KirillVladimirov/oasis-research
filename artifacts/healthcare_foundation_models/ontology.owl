    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient privacy is always the top concern when sharing, uploading, and processing health information.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#adversarial_testing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
