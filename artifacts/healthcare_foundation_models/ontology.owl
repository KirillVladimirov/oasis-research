    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loss L = L w IoU + L w bce , where boundary pixTransFuse: Fusing Transformers and CNNs for Medical Image Segmentation 5 els receive larger weights</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#dataparallelism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
