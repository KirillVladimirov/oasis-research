    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specialized for downstream applications using two established benchmarks: Virtual Screening: we use the ltered virtual scr</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#followsschedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
