    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2403.05795_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This limitation arises because these models were trained on contexts not exceeding 4k, impairing their accuracy</hasEvidenceText>
  </rdf:Description>
