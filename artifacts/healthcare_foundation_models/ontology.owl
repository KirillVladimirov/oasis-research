    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instruction Tuning</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fine-tuning strategy, such as multi-task instruction finetuning, used to achieve state-of-the-art performance on benchmarks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0102</hasCQ>
