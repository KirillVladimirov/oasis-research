    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limitsApplicationTo</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The constraint where certain contrastive frameworks are restricted in their utility for generative objectives.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0063</hasCQ>
