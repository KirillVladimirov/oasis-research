    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A task involving health events, diagnoses, treatment plans, or patient monitoring.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0096</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0164</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0096</prov:wasDerivedFrom>
