    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A non-expert evaluator without a medical background used to assess the helpfulness and utility of answers.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0135</hasCQ>
