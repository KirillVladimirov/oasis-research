    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SupervisedFineTuning</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific method for training models that is often used but may omit other vital procedures.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0229</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0229</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2311.06025_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">these models predominantly rely on the supervised fine-tuning (SFT) method and omit other vital procedures for training LLMs</hasEvidenceText>
  </rdf:Description>
