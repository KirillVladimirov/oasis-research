    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of loss function where boundary pixels receive larger weights, often used in medical image segmentation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0035</hasCQ>
