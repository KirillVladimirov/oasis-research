    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has entropy</rdfs:label>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0222</hasCQ>
