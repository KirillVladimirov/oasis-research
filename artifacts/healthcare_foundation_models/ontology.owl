    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2101.05224_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.11925_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.12637_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tailoring contrastive learning to medical data</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effectiveness in the medical domain still remains unclear. A recent work SAM [ 6 ] trains large vision models</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vision foundation models on medical imaging, and their great potential to achieve desired performance through fine-turning</hasEvidenceText>
