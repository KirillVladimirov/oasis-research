    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The historical medical data of a patient used as input for predictive modeling.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0079</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0079</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2309.11295_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fine-tuning prompts consist of a general description, the patients diagnosis history, and a label.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#utilizes_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#task"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#fine_tuning_method"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">utilizes method</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The application of a specific training procedure to a large language model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0052</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0052</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2311.06025_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">these models predominantly rely on the supervised fine-tuning (SFT) method</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#affectedby">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#deeplearningperformance"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#trainingdatavolume"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">affectedBy</rdfs:label>
