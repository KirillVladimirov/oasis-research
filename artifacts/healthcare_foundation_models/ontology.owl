    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A class of data augmentation techniques applied to frames to enhance robustness and generalizability, including operations like flips, jitter, and blur.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0024</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0024</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.16741_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we apply temporally consistent spatial augmentations [ 28 ] to all frames within a single view. Our augmentation approach includes random horizontal flips, color jitter, Gaussian blur, solarization</hasEvidenceText>
  </rdf:Description>
