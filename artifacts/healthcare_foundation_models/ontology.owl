    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process by which pretraining methods extract embeddings or representations from unlabeled data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0053</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0082</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0230</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0053</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0082</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0230</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2101.05224_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.11432_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2011.13230_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use of unlabeled domain-specic images during pretraining to learn more relevant representations.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">architectures that learn joint, fundamental representations</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply a Transformer architecture, specically BERT, to learn exible and high quality molecular representations</hasEvidenceText>
  </rdf:Description>
