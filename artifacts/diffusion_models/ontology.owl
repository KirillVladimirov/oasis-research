    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component used to encode concept information from images, which can be combined with text embeddings.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0080</hasCQ>
