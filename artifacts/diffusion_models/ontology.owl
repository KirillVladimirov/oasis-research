  <rdf:Description rdf:about="http://example.org/S0/R1#improvesstabilityover">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#vprediction"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#epsilonprediction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improvesStabilityOver</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that v-prediction resolves sampling instabilities inherent in epsilon-prediction.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0111</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0111</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.11093_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The problem with the epsilon parametrization is that it gives unstable sampling near t = 1 . An alternative parametrization without this issue is called v prediction</hasEvidenceText>
  </rdf:Description>
