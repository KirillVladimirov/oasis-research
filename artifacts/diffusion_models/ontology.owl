    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unconditional diffusion models generate images and videos by taking the noises sampled from Gaussian distributions [ 15 ] as input.</hasEvidenceText>
  </rdf:Description>
