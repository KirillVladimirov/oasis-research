    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.04542_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p ( x t 1 | x t ) is the sampling transition</hasEvidenceText>
  </rdf:Description>
