    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Many samplers for diffusion models rely on discretizing either the reverse-time SDE</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#sigmoidschedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#noiseschedule"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SigmoidSchedule</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of noise schedule adopted for effectiveness in practice.</skos:skos_definition>
