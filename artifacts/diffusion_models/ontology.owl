    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.01469_rag::chunk_015</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consistency distillation on LSUN Bedroom 256 256</hasEvidenceText>
  </rdf:Description>
