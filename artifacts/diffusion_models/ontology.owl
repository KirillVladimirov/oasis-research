    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">learning fully discrete vector-quantized auto-encoders [ 61 ], which builds the foundations for many follow-up methods</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#scorebasedgenerativemodel">
