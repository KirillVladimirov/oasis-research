    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2209.04747_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2309.17074_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we learn a function s ( x , t ) parameterized by a neural network to estimate its values.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stochastic Weight Averaging (SWA) has been used to improve the performance of neural networks trained for DDPMs</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To approximate these steps, we can train a neural network</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The backbone network is utilized to denoise from noised images.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improve the performance of neural networks trained for DDPMs</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#explicit_adams_method">
