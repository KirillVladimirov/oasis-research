  <rdf:Description rdf:about="http://example.org/S0/R1#affectsgenerationof">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#noiseschedule"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#lowfrequencycomponent"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">affectsGenerationOf</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship describing how the noise schedule configuration impacts the model's ability to produce specific frequency signals.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0114</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0114</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.04542_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">t and t are the scaling factor and noise schedule respectively. It has better stability [89], avoids noise existing in x ( x t , t ) [90] and achieves higher likelihood</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#nullprompt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
