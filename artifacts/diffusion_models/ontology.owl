    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A classification of diffusion models within the generative learning landscape focusing on score-based modeling.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0084</hasCQ>
