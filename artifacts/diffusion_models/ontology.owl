    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Efficient sampling methods that require an additional learning process after the diffusion model has been trained.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0058</hasCQ>
