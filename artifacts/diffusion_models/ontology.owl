    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">include DDIM (Song et al., 2021a) with = 0 as the first-order case. Below we show that the first-order case for DPM-Solver++ is also DDIM.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#tf32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TF32</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A TensorFloat-32 precision format used to accelerate training speed on compatible hardware.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.09305_rag::chunk_009</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ours_tf32</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#conditioning_modality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conditioning Modality</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of input data, such as text or masks, used to influence the output of a generative model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0032</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0032</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.06464_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific classifier-free guidance format is introduced for each modality to independently influence the output.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#masktoimagemodel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MaskToImageModel</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A generative model initialized to produce images from conditioning masks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0216</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0216</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2302.08908_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mask-to-image model is initialized from an unconditional facial model pretrained on CelebA-Mask</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#binary_latent_representation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#discrete_representation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Binary Latent Representation</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A compact latent space representation where data is mapped to binary bits.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0096</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0096</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.04820_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we show that a binary latent space can be explored for compact yet expressive image representations. We model the bi-directional mappings between an image and the corresponding latent binary representation</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#stf_objective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#lossfunction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STF Objective</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A training objective for diffusion models characterized by diminishing bias and increased stability during training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0209</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0209</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2302.00670_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the STF targets have diminishing bias (Theorem 1 ) and are much more stable during training (Theorem 2 ). These properties make the STF objective more favorable for diffusion models training</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#operateson">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#latent_diffusion_model"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#latent_space"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operatesOn</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process where diffusion models perform denoising or reverse diffusion on latent representations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0160</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0160</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.09508_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">denoising U-Net that performs reverse diffusion on latent representations</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_154">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/S0/R1#OntologyAxiom"/>
    <axiomType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subclass</axiomType>
    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human-labeled Data</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Label</axiomRhs>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#small_dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#dataset"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Small Dataset</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Datasets with a limited number of images, such as AFHQv2 subsets, used to evaluate model performance on smaller scales.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0068</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0068</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.12526_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AFHQv2-Cat/Dog/Wild ( 5k images in each of them) [7] as our small datasets.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#non_markovian_diffusion_process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Markovian Diffusion Process</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A family of diffusion processes that maintains training objectives while allowing for faster sampling via sub-sequences of timesteps.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0055</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0055</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.07969_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dene a new family of non-Markovian diffusion processes that maintains the same training objectives as a traditional DDPM.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#videooutpainting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VideoOutpainting</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A task that requires modeling motion information to ensure temporal consistency among video frames.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0141</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0141</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2309.02119_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">video outpainting requires the modeling of motion information to ensure temporal consistency among video frames.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#betadistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BetaDistribution</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A distribution followed by the marginal at any discrete time step in the beta diffusion process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2309.07867_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the marginal at any discrete time step t j follows a beta distribution</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/S0/R1#OntologyAxiom"/>
    <axiomType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subclass</axiomType>
    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deterministic Sampler</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sampling Algorithm</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0055</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0055</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.04262_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DDIM is a deterministic sampling strategy that has been shown to signicantly reduce the number of NFEs required for generating samples</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_379">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/S0/R1#OntologyAxiom"/>
    <axiomType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subclass</axiomType>
    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reverse SDE</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entity</axiomRhs>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#prompt_tuning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prompt Tuning</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter-efficient fine-tuning method used to ease the storage burden of large pretrained models.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0071</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0071</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2310.03270_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prompt Tuning ( Lester et al. , 2021 ; Wang et al. , 2022 )</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hascomparablefid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasComparableFID</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that the distilled model achieves a similar Fréchet Inception Distance score to its teacher model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0151</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0151</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2210.03142_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">our distilled model is able to match the performance of the teacher model (originally trained on 1000 steps) in terms of FID scores</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#affectsfidelity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#guidance_weight"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#sample_fidelity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">affectsFidelity</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship where the magnitude of the guidance weight impacts the resulting quality of the generated image.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0100</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0100</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.04740_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">our method retains fidelity under high guidance weight</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#recall">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recall</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metric specifically used to evaluate the diversity of generated samples.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0061</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0061</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.07969_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In particular Recall is used to evaluate the diversity of generated samples.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hasgeneralizabilityissue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#adversarial_training"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGeneralizabilityIssue</rdfs:label>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0167</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0167</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.15241_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">although adversarial training methods using data generated by diffusion models achieve excellent performance, they are usually not generalizable across different threats</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#fp32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#precision"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FP32</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 32-bit floating-point precision format used as a standard baseline for model performance.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0090</prov:wasDerivedFrom>
