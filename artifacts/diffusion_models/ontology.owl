    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2310.04378_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we use the DDIM (Song et al., 2020a), DPM-Solver (Lu et al., 2022a) and DPM-Solver++ (Lu et al., 2022b) as the PF-ODE solvers.</hasEvidenceText>
  </rdf:Description>
