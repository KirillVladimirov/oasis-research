    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2210.03142_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the Spatial FID [46] , i.e. the FID evaluated using the rst 7 channels from the intermediate mixed 6/conv feature maps</hasEvidenceText>
