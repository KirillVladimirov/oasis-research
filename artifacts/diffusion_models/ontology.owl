    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2210.03142_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">comparable to that of the teacher using only 4 steps and is able to achieve comparable FID/IS scores as the teacher model</hasEvidenceText>
