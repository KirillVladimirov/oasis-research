    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cascaded pipeline</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in the super-resolution stages, the low-resolution condition greatly ease the difficulty of the early steps</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#discrete_timestep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
