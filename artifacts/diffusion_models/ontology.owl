    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that one solver is a first-order discretization or specific instance of a more general solver.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0113</hasCQ>
