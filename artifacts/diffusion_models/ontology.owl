    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The property describing the presence of sequential generation limitations in autoregressive architectures.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0179</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0179</prov:wasDerivedFrom>
