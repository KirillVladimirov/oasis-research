    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we select CelebA ( 200k images) [ 34 ], FFHQ (70k images) [ 20 ], LSUN ( 200k images) [ 63 ], and ImageNet ( 1.2 million images) [ 9 ] as our large datasets</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageNet ( 1.2 million images) [ 9 ] as our large datasets</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#sharesmarginaldistributionwith">
