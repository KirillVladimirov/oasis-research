    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diffusion models that generate images and videos by taking noises sampled from Gaussian distributions as input without external conditioning.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0075</hasCQ>
