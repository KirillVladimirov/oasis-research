    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">using their variational lower bound estimates of the data likelihood</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#denoisingmodel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
