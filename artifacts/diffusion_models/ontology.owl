    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The task of synthesizing video content consisting of a large number of frames, often exceeding one thousand.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0177</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0177</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.12346_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">viewing long video generation as a novel coarse-to-ne process. To the best of our knowledge, NUWA-XL is the rst model directly trained on long videos (3376 frames)</hasEvidenceText>
  </rdf:Description>
