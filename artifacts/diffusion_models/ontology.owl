    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technique to guide the iterative sampling process of a DM towards a conditioning signal c</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#generates_embedding_in">
