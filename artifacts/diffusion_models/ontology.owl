    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.18900_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we adopt a sigmoid schedule [ 31 ], which has recently been shown to be more effective in practice</hasEvidenceText>
  </rdf:Description>
