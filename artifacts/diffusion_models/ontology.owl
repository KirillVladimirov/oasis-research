    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discrete diffusion extensions mainly focus on the design of forward corruption kernels.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_51">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
