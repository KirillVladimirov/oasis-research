    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2209.02646_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.14849_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the discrete formulation for diffusion model is generalized by defining transition kernels among diffusion and denoising processes.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In discrete timestep t , Gaussian noises are injected into real or generated images by the equation.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#layoutcondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
