    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adopt a sigmoid schedule [ 31 ], which has recently been shown to be more effective in practice compared to other choices such as linear [ 25 ] or cosine schedules</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#noiselevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NoiseLevel</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific scale or value within a range of noise added to data during a diffusion or perturbation process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0140</hasCQ>
