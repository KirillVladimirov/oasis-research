    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A timestep representation used in continuous time diffusion sampling schemes or numerical integration of diffusion processes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0070</hasCQ>
