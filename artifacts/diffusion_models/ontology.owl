    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deterministic Sampling</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sampling strategy that sequentially updates variables without stochastic noise, often reducing the number of function evaluations required.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0005</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0055</hasCQ>
