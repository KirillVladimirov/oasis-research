    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we can think of the matrix A as a diagonal matrix with ones in the entries that correspond to the preserved pixels and zeros in the erased pixels.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#weightingscheme">
