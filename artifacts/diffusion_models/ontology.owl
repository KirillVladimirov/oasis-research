    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teacher Model</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The original pre-trained diffusion model used as a target or reference for the distillation process.</skos:skos_definition>
