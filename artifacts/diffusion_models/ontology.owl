    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the diffusion model is fine-tuned to accommodate this new condition</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#f_divergence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
