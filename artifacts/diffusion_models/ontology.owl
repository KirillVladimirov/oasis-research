    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feedsInto</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of passing purified data into a classification model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0167</hasCQ>
