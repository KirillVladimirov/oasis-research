    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Operations applied during the forward process to transform data into a reference distribution.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0069</hasCQ>
