    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The procedure by which a model produces an output, such as an image, potentially guided by specific information.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0038</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0038</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2308.13142_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carries valuable information that can guide the generation process, potentially resulting in the appearance of specific objects</hasEvidenceText>
  </rdf:Description>
