    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DistillationTechnique</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A network compression or acceleration method applied to diffusion models to learn a new sampling process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0107</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0107</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.04542_rag::chunk_018</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Knowledge distillation is a network compression technique. In terms of di ff usion models, it involves the original sampling process as the teacher model and a new one with fewer timesteps as the student model</hasEvidenceText>
  </rdf:Description>
