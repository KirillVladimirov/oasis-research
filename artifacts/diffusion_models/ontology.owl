    <rdfs:domain rdf:resource="http://example.org/S0/R1#sde"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#noise_scale_function"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isDeterminedBy</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The specific solution or behavior of the SDE process is dictated by the noise scale function.</skos:skos_definition>
