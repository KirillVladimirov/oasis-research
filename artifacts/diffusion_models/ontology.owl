    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.04248_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high momentum yields high-quality results but leads to over-regularized models if the training length is too short.</hasEvidenceText>
  </rdf:Description>
