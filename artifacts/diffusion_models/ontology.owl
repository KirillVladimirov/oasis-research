    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a sampling procedure to the temperature setting used to influence its output distribution.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0185</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0185</prov:wasDerivedFrom>
