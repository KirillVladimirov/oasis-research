    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model that processes input at any time step t to generate an output for the diffusion process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2302.04304_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In the case of diffusion models, at any time step t , the input of the denoising model (denoted as x t ) is derived by x t +1</hasEvidenceText>
  </rdf:Description>
