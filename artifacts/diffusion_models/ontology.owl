    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.04262_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Denoising Diffusion Probabilistic Models (DDPM)</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">denoising diusion probabilistic models (DDPM) ( Ho et al. , 2020a ). The DDPM implements a discretized version of VP diusion and uses a discretized sampling scheme</hasEvidenceText>
  </rdf:Description>
