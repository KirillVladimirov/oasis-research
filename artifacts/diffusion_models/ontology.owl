    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A likelihood lower bound used in variational inference to approximate intractable marginal likelihoods.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0144</hasCQ>
