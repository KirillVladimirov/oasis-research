  <rdf:Description rdf:about="http://example.org/S0/R1#isfirstordercaseof">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#acquisitionfunction"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#model"/>
