    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A design component in discrete diffusion models involving operations like multinomial or masking operations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0159</hasCQ>
