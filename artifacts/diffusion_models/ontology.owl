    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A high-order solver for diffusion ODEs that encapsulates DDIM as a first-order case.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0113</hasCQ>
