    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A layer normalization technique used for processing timestep embeddings in diffusion models.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0088</hasCQ>
