    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Score-based generative models (SGMs) consist of two modules, including score matching</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#sigmoid_schedule">
