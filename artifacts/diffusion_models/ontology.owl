    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2101.03288_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.18900_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">both the high and low likelihood regions of the data distribution via the progressive estimation of noise-perturbed data distributions.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">suppose p data ( x ) = p 0 ( x ) + (1 ) p 1 ( x ) . Let S 0 := { x | p 0 ( x ) &gt; 0 } and S 1 := { x | p 1 ( x ) &gt; 0 } be the supports of p 0 ( x ) and p 1 ( x ) respectively.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gradually reducing its variance, until recovering the original data distribution p data ( x )</hasEvidenceText>
  </rdf:Description>
