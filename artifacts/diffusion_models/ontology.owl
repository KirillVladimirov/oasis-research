    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2303.09508_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An autoencoder model, say E , is used in the perceptual compression process. It compresses the input image x R H W 3 to a smaller 2D latent vector</hasEvidenceText>
