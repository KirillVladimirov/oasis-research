    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A generative model that operates directly in the pixel space, typically requiring more computation than latent-space models.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0147</hasCQ>
