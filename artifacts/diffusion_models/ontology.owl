    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A connector used to align text and images, often employed to transfer concept images to the text domain.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0080</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0080</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2308.13142_rag::chunk_009</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">well-known for its Q-former connector used to align text and images. Blip-diffusion also employs this Qformer to transfer concept images to the text domain.</hasEvidenceText>
  </rdf:Description>
