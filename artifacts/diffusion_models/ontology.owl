    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2302.07261_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2209.02646_rag::chunk_040</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describing its likelihood lower bound ( Sohl-Dickstein et al. , 2015 ; Huang et al. , 2021 ; Kingma et al. , 2021 ).</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DPM ELBO</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#clip_distance">
