    skos:skos_definition "A numerical algorithm used to approximate the solution to a Stochastic Differential Equation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0105"^^xsd:string,
        "CQ_S0_R1_0149"^^xsd:string .

:secondorderodesolver a owl:Class ;
    rdfs:label "SecondOrderODESolver"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0221"^^xsd:string ;
    :hasEvidenceChunk "2210.05475_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "we rigorously derive a novel second-order ODE solver using truncated Taylor methods [ 59 ]. These higher-order methods require higher-order gradients of the ODE"^^xsd:string ;
    rdfs:subClassOf :firstordersolver,
        owl:Thing ;
    skos:skos_definition "A higher-order differential equation solver derived using truncated Taylor methods to solve generative ODEs."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0221"^^xsd:string .

:solver a owl:Class ;
    rdfs:label "Solver"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0025"^^xsd:string ;
    :hasEvidenceChunk "2302.10688_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "with DPM-Solvers. We conduct a systematical study with varying NFE (i.e., number of function evaluations) and solver order."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A numerical method or algorithm, such as DPM-Solver or DEIS, used for sampling in diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0025"^^xsd:string .

:superresolutionstage a owl:Class ;
    rdfs:label "SuperResolutionStage"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0017"^^xsd:string ;
    :hasEvidenceChunk "2309.03350_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "in the super-resolution stages, the low-resolution condition greatly ease the difficulty of the early steps"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A specific phase within a cascaded pipeline that increases the resolution of an image or video based on a low-resolution condition."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0017"^^xsd:string .

:training_phase a owl:Class ;
    rdfs:label "Training Phase"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0099"^^xsd:string ;
    :hasEvidenceChunk "2304.12526_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "diffusion models are also notoriously expensive and data-hungry to train. They require large datasets and many iterations to capture the high-dimensional and complex data distributions."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The stage of model development involving iterations over datasets to capture data distributions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0099"^^xsd:string .

:trainingprocedure a owl:Class ;
    rdfs:label "TrainingProcedure"^^xsd:string ;
    rdfs:subClassOf :method,
        owl:Thing .

:u_net a owl:Class ;
    rdfs:label "U-Net"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0112"^^xsd:string,
        "CQ_S0_R1_0176"^^xsd:string ;
    :hasEvidenceChunk "2209.12152_rag::chunk_001"^^xsd:string,
        "2306.09305_rag::chunk_003"^^xsd:string,
        "2307.14648_rag::chunk_007"^^xsd:string,
        "2310.07204_rag::chunk_008"^^xsd:string,
        "2310.07204_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "A representative example is U-Net based on a convolutional neural network"^^xsd:string,
        "Rombach et al. [ RBL 22 ] modifies the U-Net architecture [ RFB15 ] for conditioning control with crossattenti"^^xsd:string,
        "Text Denoising U-Net Repres entations Images Pixel Space crossattention denoising step"^^xsd:string,
        "the convolutional U-Net architecture (Ronneberger et al., 2015) has become the standard choice of diffusion backbone"^^xsd:string,
        "the default DDPM U-Net architecture in pixel space is a natural and trivial baseline."^^xsd:string ;
    rdfs:subClassOf :backbone_architecture,
        owl:Thing ;
    skos:skos_definition "A convolutional neural network architecture characterized by down-sampling blocks, up-sampling blocks, and long skip connections, serving as a standard backbone for diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0112"^^xsd:string,
        "CQ_S0_R1_0176"^^xsd:string .

:vprediction a owl:Class ;
    rdfs:label "VPrediction"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0036"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0163"^^xsd:string ;
    :hasEvidenceChunk "2301.11093_rag::chunk_002"^^xsd:string,
        "2303.18242_rag::chunk_022"^^xsd:string ;
    :hasEvidenceText "An alternative parameterisation which can train more reliably is v -prediction"^^xsd:string,
        "An alternative parametrization without this issue is called v prediction and was proposed in (Salimans & Ho, 2022)"^^xsd:string,
        "An alternative parametrization without this issue is called v prediction and was proposed in (Salimans & Ho, 2022), it is defined as v t = t t t x"^^xsd:string,
        "An alternative parametrization without this issue is called v prediction and was proposed in (Salimans & Ho, 2022), it is defined as v t = t t t x ."^^xsd:string ;
    rdfs:subClassOf :parameterization,
        owl:Thing ;
    skos:altLabel "V Prediction"^^xsd:string ;
    skos:skos_definition "An alternative parameterization defined as v_t = alpha_t * epsilon - sigma_t * x, designed to avoid instability at high noise levels."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0036"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0163"^^xsd:string .

:weightdecay a owl:Class ;
    rdfs:label "WeightDecay"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0231"^^xsd:string ;
    :hasEvidenceChunk "2310.02664_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "models on CIFAR-10 under different ( left ) weight decay values"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A regularization parameter used during model training to influence memorization ratios."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0231"^^xsd:string .

:weightingstrategy a owl:Class ;
    rdfs:label "WeightingStrategy"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0018"^^xsd:string,
        "CQ_S0_R1_0119"^^xsd:string ;
    :hasEvidenceChunk "2303.09556_rag::chunk_008"^^xsd:string,
        "2305.18455_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Min-SNR- weighting strategy in balancing diverse noise levels."^^xsd:string,
        "the weighting function w ( t ) controls the importance of the learning at different time levels"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A function or method that controls the importance of learning at different noise or time levels during training."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0018"^^xsd:string,
