:samplingmethod a owl:Class ;
    rdfs:label "SamplingMethod"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0078"^^xsd:string,
        "CQ_S0_R1_0118"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string ;
    :hasEvidenceChunk "2211.01095_rag::chunk_014"^^xsd:string,
        "2304.04262_rag::chunk_018"^^xsd:string,
        "2304.04262_rag::chunk_019"^^xsd:string,
        "2305.10769_rag::chunk_007"^^xsd:string,
        "2305.15583_rag::chunk_010"^^xsd:string,
        "2308.13712_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "between different sampling methods and 1000 -step DDIM"^^xsd:string,
        "sampling algorithms with no training of new parametric models but only inferencing by querying pre-trained DMs. Most of such algorithms center around dierent numerical solvers of generative SDE or ODE."^^xsd:string,
        "the most naive simulation of reversed SDE uses an Euler-Maruyama discretization with a formula X t +1 = X t F ( X t , t ) G 2 ( t ) S ( X t , t ) t + G ( t ) t"^^xsd:string,
        "we apply Runge-Kutta methods to model catch-up sampling on a generic perspective."^^xsd:string,
        "we compare four sampling methods, namely DDIM, DDPM, S-PNDM and F-PNDM"^^xsd:string,
        "we propose three sampling methods, i.e., residual prediction (SM-Res), noise prediction (SM-N), and residual and noise prediction (SM-Res-N)"^^xsd:string ;
    rdfs:subClassOf :acquisitionfunction,
        owl:Thing ;
    skos:altLabel "Sampling Method"^^xsd:string ;
    skos:skos_definition "A numerical simulation or discretization technique, such as Euler-Maruyama, used to generate samples from the reverse process of a diffusion model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0078"^^xsd:string,
        "CQ_S0_R1_0118"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string .

