:samplingstep a owl:Class ;
    rdfs:label "SamplingStep"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0078"^^xsd:string,
        "CQ_S0_R1_0127"^^xsd:string ;
    :hasEvidenceChunk "2305.15583_rag::chunk_010"^^xsd:string,
        "2305.16317_rag::chunk_011"^^xsd:string,
        "2305.19693_rag::chunk_011"^^xsd:string ;
    :hasEvidenceText "500-step DDIM gives a noticeably worse FID score than 1000-step DDPM"^^xsd:string,
        "DDIM denoising steps"^^xsd:string,
        "the number of time steps we take"^^xsd:string,
        "we vary the time steps and the time step selection procedures. We take larger window sizes for fewer sampling steps."^^xsd:string ;
    rdfs:subClassOf :acquisitionfunction,
        owl:Thing ;
    skos:skos_definition "A discrete unit of time or iteration within a sampling procedure, often varied to analyze the trade-off between image quality and computational speed."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0078"^^xsd:string,
        "CQ_S0_R1_0127"^^xsd:string .

:samplingtransition a owl:Class ;
    rdfs:label "SamplingTransition"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0028"^^xsd:string ;
    :hasEvidenceChunk "2306.04542_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "p ( x t 1 | x t ) is the sampling transition"^^xsd:string ;
    rdfs:subClassOf :acquisitionfunction,
        owl:Thing ;
    skos:skos_definition "A step in the chain of transitions used to generate samples from a terminal distribution."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0028"^^xsd:string .

:score_matching_objective a owl:Class ;
    rdfs:label "Score-Matching Objective"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0073"^^xsd:string,
        "CQ_S0_R1_0153"^^xsd:string ;
    :hasEvidenceChunk "2302.00670_rag::chunk_002"^^xsd:string,
        "2302.10907_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "characterizing a region in the forward process, termed the intermediate phase , where the score-learning targets are most variable"^^xsd:string,
        "the objective function of the scoring network can be defined as: 2 (7) Even though the problem is well defined, optimizing Equation 7 is almost impossible numerically"^^xsd:string ;
    rdfs:subClassOf :metric,
        owl:Thing ;
    skos:altLabel "Score-matching objective"^^xsd:string ;
    skos:skos_definition "A training objective used to train neural networks to estimate the score function of a data distribution."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0073"^^xsd:string,
        "CQ_S0_R1_0153"^^xsd:string .

:sde_formulation a owl:Class ;
    rdfs:label "SDE Formulation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0118"^^xsd:string ;
    :hasEvidenceChunk "2305.19947_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "With the tool of stochastic differential equations (SDEs), the data perturbation in diffusion models is modeled as a continuous stochastic process"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A continuous stochastic process used to model data perturbation in diffusion models, typically defined by drift and diffusion coefficients."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0118"^^xsd:string .

:semantic_image_editing a owl:Class ;
    rdfs:label "Semantic Image Editing"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0081"^^xsd:string ;
    :hasEvidenceChunk "2211.13227_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "utilize semantic mask to control the editing. Yet most existing methods are limited to specic image genres"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A category of image editing that utilizes semantic masks or textual guidance to control the manipulation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0081"^^xsd:string .

:semantic_space a owl:Class ;
    rdfs:label "Semantic Space"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0117"^^xsd:string ;
    :hasEvidenceChunk "2305.11675_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "shared CLIP space containing rich semantic information."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A shared representation space containing rich semantic information for aligning different modalities."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0117"^^xsd:string .

:solverorder a owl:Class ;
    rdfs:label "SolverOrder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0025"^^xsd:string ;
    :hasEvidenceChunk "2302.10688_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "the number of steps required to achieve convergence for a 3 -order DPM-Solver"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The mathematical order of the solver which influences the convergence and required NFE."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0025"^^xsd:string .

:stochastic_differential_equation a owl:Class ;
    rdfs:label "Stochastic Differential Equation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0060"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string ;
    :hasEvidenceChunk "2211.16750_rag::chunk_000"^^xsd:string,
        "2305.19947_rag::chunk_000"^^xsd:string,
        "2305.19947_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Score-based modeling through stochastic differential equations (SDEs)"^^xsd:string,
        "With the tool of stochastic differential equations (SDEs), the data perturbation in diffusion models is modeled as a continuous stochastic process"^^xsd:string,
        "stochastic differential equations (SDEs) and their marginal-preserving ordinary differential equations (ODEs) to describe data perturbation and generative modeling in a unified framework."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "StochasticDifferentialEquation"^^xsd:string ;
    skos:skos_definition "A mathematical framework used to describe data perturbation and generative modeling in a unified framework for diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0060"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string .

:temperature a owl:Class ;
    rdfs:label "Temperature"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0185"^^xsd:string ;
    :hasEvidenceChunk "2211.12039_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "aligning feature distributions and prediction distributions achieve better performance than PD, but fails to outperform the original L CFD which only uses temperature for the teacher."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A hyperparameter used during the sampling or distillation process to adjust the distribution of predictions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0185"^^xsd:string .

:temporalconsistency a owl:Class ;
    rdfs:label "TemporalConsistency"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0141"^^xsd:string ;
    :hasEvidenceChunk "2309.02119_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "ensure temporal consistency among video frames."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The property of maintaining coherent motion and visual stability across a sequence of video frames."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0141"^^xsd:string .

:text_encoder a owl:Class ;
    rdfs:label "Text Encoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0080"^^xsd:string,
        "CQ_S0_R1_0170"^^xsd:string ;
    :hasEvidenceChunk "2209.04747_rag::chunk_026"^^xsd:string,
        "2308.13142_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "Improve from the Text Encoder"^^xsd:string,
        "one encoder for the text sequence and a cascade of diffusion models"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A component or method used to process text input into embeddings or representations for use within a model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0080"^^xsd:string,
        "CQ_S0_R1_0170"^^xsd:string .

:text_image_alignment a owl:Class ;
    rdfs:label "Text-Image Alignment"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0062"^^xsd:string ;
    :hasEvidenceChunk "2310.13102_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "assess the text-image alignment/visual quality, respectively"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The degree of correspondence or semantic consistency between a text prompt and a generated image."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0062"^^xsd:string .

:textencoder a owl:Class ;
    rdfs:label "TextEncoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0211"^^xsd:string ;
    :hasEvidenceChunk "2307.01952_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "The text encoders have a total size of 817M parameters."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A component used to process text conditioning, often characterized by its parameter size."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0211"^^xsd:string .

:threshold a owl:Class ;
    rdfs:label "Threshold"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0224"^^xsd:string ;
    :hasEvidenceChunk "2306.17046_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "a crucial parameter in the SNN is the spike threshold V th , which influences the SNNs output."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A specific value or constraint used to guide or limit the output of a model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0224"^^xsd:string .

:training_target a owl:Class ;
    rdfs:label "Training Target"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0126"^^xsd:string ;
    :hasEvidenceChunk "2302.04265_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "using a more stable training target ( Xu et al. , 2023 ) to mitigate the variations between different runs and checkpoints."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The objective function or goal used during the training process of a neural network."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0126"^^xsd:string .

:transformer a owl:Class ;
    rdfs:label "Transformer"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string ;
    :hasEvidenceChunk "2212.09748_rag::chunk_001"^^xsd:string,
        "2212.14678_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Comparison for UNet & Transformer architectures for Latent Diffusion"^^xsd:string,
        "they can be readily replaced with standard designs such as transformers."^^xsd:string ;
    rdfs:subClassOf :backbone_architecture,
        owl:Thing ;
    skos:skos_definition "A neural network architecture that can replace the U-Net inductive bias in diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string .

:unet a owl:Class ;
    rdfs:label "UNet"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0210"^^xsd:string ;
    :hasEvidenceChunk "2306.00914_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "Denoising process, that is implemented with a UNet [24] backbone."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A backbone architecture used in diffusion models for the denoising process."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0210"^^xsd:string .

:unetarchitecture a owl:Class ;
    rdfs:label "UNetArchitecture"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0122"^^xsd:string ;
    :hasEvidenceChunk "2310.06389_rag::chunk_019"^^xsd:string ;
    :hasEvidenceText "the U-Net design incorporates both a progressive downsampling path and a progressive upsampling path"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A network design incorporating progressive downsampling and upsampling paths, originally for biomedical image segmentation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0122"^^xsd:string .

:unetbackbone a owl:Class ;
    rdfs:label "UNetBackbone"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0152"^^xsd:string ;
    :hasEvidenceChunk "2212.09748_rag::chunk_001"^^xsd:string,
        "2306.09305_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "the U-Net inductive bias is not crucial to the performance of diffusion models"^^xsd:string,
        "the convolutional U-Net architecture (Ronneberger et al., 2015) has become the standard choice of diffusion backbone"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A convolutional architecture characterized by inductive bias and commonly used as the standard choice for diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0152"^^xsd:string .

:unidirectional_bias a owl:Class ;
    rdfs:label "Unidirectional Bias"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0179"^^xsd:string ;
    :hasEvidenceChunk "2209.04747_rag::chunk_011"^^xsd:string ;
    :hasEvidenceText "This approach implies a unidirectional bias that clearly represents a limitation of this class of generative models."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A limitation inherent to the generative process of autoregressive models due to their sequential pixel-by-pixel generation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0179"^^xsd:string .

:unmaskedtoken a owl:Class ;
    rdfs:label "UnmaskedToken"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0129"^^xsd:string ;
    :hasEvidenceChunk "2306.09305_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "the score estimation task on unmasked tokens"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Tokens or pixels in an image that are not covered by a mask and are used as input for score estimation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0129"^^xsd:string .

:update_rule a owl:Class ;
    rdfs:label "Update Rule"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0005"^^xsd:string ;
    :hasEvidenceChunk "2210.03142_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "we can perform sampling via the DDIM update rule in Eq. ( 2 )"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An iterative rule used to perform sampling in diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0005"^^xsd:string .

:videooutpainting a owl:Class ;
    rdfs:label "VideoOutpainting"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0141"^^xsd:string ;
    :hasEvidenceChunk "2309.02119_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "video outpainting requires the modeling of motion information to ensure temporal consistency among video frames."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A task that requires modeling motion information to ensure temporal consistency among video frames."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0141"^^xsd:string .

:warmup a owl:Class ;
    rdfs:label "Warmup"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0220"^^xsd:string ;
    :hasEvidenceChunk "2211.12039_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "warmup for 5000 iterations"^^xsd:string ;
    rdfs:subClassOf :learningrateschedule,
        owl:Thing ;
    skos:skos_definition "A specific phase in the learning rate schedule, typically at the start of training, to stabilize the optimization process."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0220"^^xsd:string .

:weightedmixture a owl:Class ;
    rdfs:label "WeightedMixture"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0035"^^xsd:string ;
    :hasEvidenceChunk "2305.16269_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "weighted mixture of their latent noises"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A combination of latent noises used to create interpolated samples."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0035"^^xsd:string .

