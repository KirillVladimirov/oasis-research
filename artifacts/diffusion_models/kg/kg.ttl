:controlnet a owl:Class ;
    rdfs:label "ControlNet"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0039"^^xsd:string,
        "CQ_S0_R1_0123"^^xsd:string,
        "CQ_S0_R1_0162"^^xsd:string ;
    :hasEvidenceChunk "2304.06648_rag::chunk_012"^^xsd:string,
        "2306.04542_rag::chunk_017"^^xsd:string ;
    :hasEvidenceText "ControlNet [ 84 ] enhances the original Stable Diffusion (SD) by incorporating a conditioning network comprising two parts: a set of zero convolutional layers initialized to zero and a trainable copy of 13 layers of SD"^^xsd:string,
        "ControlNet [110] is a pioneering method to fine-tune an extra copied model. This idea for conditional generation has been popular"^^xsd:string ;
    rdfs:subClassOf :adapter,
        owl:Thing ;
    skos:skos_definition "A conditioning network that enhances a pre-trained diffusion model by incorporating zero convolutional layers and a trainable copy of the model layers."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0039"^^xsd:string,
        "CQ_S0_R1_0123"^^xsd:string,
        "CQ_S0_R1_0162"^^xsd:string .

:exponentialmovingaverage a owl:Class ;
    rdfs:label "ExponentialMovingAverage"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0019"^^xsd:string,
        "CQ_S0_R1_0131"^^xsd:string ;
    :hasEvidenceChunk "2303.04248_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "With Exponential Moving Average (EMA), the momentum parameter is limited by the training length"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Exponential Moving Average"^^xsd:string ;
    skos:skos_definition "A technique where the momentum parameter is used to average model weights, often used to improve performance in neural networks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0019"^^xsd:string,
        "CQ_S0_R1_0131"^^xsd:string .

:inpaintingtask a owl:Class ;
    rdfs:label "InpaintingTask"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0129"^^xsd:string ;
    :hasEvidenceChunk "2209.04747_rag::chunk_018"^^xsd:string,
        "2302.10781_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "Inpainting aims to ll missing regions in images"^^xsd:string,
        "multi-task (image generation, inpainting)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Inpainting Task"^^xsd:string ;
    skos:skos_definition "A multi-task image processing operation involving the restoration of missing or erased pixels."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0129"^^xsd:string .

:latent_space a owl:Class ;
    rdfs:label "Latent Space"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0160"^^xsd:string,
        "CQ_S0_R1_0182"^^xsd:string,
        "CQ_S0_R1_0205"^^xsd:string,
        "CQ_S0_R1_0234"^^xsd:string ;
    :hasEvidenceChunk "2210.11058_rag::chunk_010"^^xsd:string,
        "2302.08908_rag::chunk_001"^^xsd:string,
        "2307.08283_rag::chunk_000"^^xsd:string,
        "2307.08283_rag::chunk_011"^^xsd:string,
        "2309.06642_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "Latent Diffusion Model (LDM), which applies DM in the latent space of a Vector-Quantized Variational Auto-Encoder (VQ-VAE)"^^xsd:string,
        "image reconstruction in the latent space of the autoencoder"^^xsd:string,
        "numerous successful approaches leverage a lowdimensional latent space, e.g., Stable Diffusion [ 68 ] models the latent space induced by an encoder"^^xsd:string,
        "they can be trained in the latent space of an autoencoder"^^xsd:string,
        "utilized a standard autoencoder to embed data into the latent space"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The compressed representational space where the diffusion process occurs, often derived from a VQ-VAE."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0076"^^xsd:string,
        "CQ_S0_R1_0160"^^xsd:string,
        "CQ_S0_R1_0182"^^xsd:string,
        "CQ_S0_R1_0205"^^xsd:string,
        "CQ_S0_R1_0234"^^xsd:string .

:signaltonoiseratio a owl:Class ;
    rdfs:label "SignalToNoiseRatio"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0009"^^xsd:string,
        "CQ_S0_R1_0018"^^xsd:string,
        "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0214"^^xsd:string ;
    :hasEvidenceChunk "2208.11970_rag::chunk_019"^^xsd:string,
        "2209.00796_rag::chunk_015"^^xsd:string,
        "2301.11093_rag::chunk_004"^^xsd:string,
        "2301.11093_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "meaning that the signal to noise ratio is 2 2 as high. And so SNR 64 64 ( t ) = SNR 128 128 ( t ) 2 2"^^xsd:string,
        "the SNR represents the ratio between the original signal and the amount of noise present"^^xsd:string,
        "the VLB for data point x can be simplified to a form that only depends on the signal-to-noise ratio"^^xsd:string,
        "the signal-to-noise ratio at our base resolution is held constant."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A metric (SNR) that may be held constant or weighted during training to manage noise levels at specific resolutions or timesteps."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0009"^^xsd:string,
        "CQ_S0_R1_0018"^^xsd:string,
        "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0214"^^xsd:string .

