:cascadedpipeline a owl:Class ;
    rdfs:label "CascadedPipeline"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0017"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string ;
    :hasEvidenceChunk "2309.03350_rag::chunk_001"^^xsd:string,
        "2309.03350_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "cascaded pipeline"^^xsd:string,
        "in the super-resolution stages, the low-resolution condition greatly ease the difficulty of the early steps"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A multi-stage generation process where models are executed in sequence, often involving super-resolution stages."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0017"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string .

:conditioning_modality a owl:Class ;
    rdfs:label "Conditioning Modality"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0032"^^xsd:string ;
    :hasEvidenceChunk "2303.06464_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "A specific classifier-free guidance format is introduced for each modality to independently influence the output."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A specific type of input data, such as text or masks, used to influence the output of a generative model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0032"^^xsd:string .

