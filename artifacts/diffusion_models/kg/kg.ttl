:backbone_architecture a owl:Class ;
    rdfs:label "Backbone Architecture"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0052"^^xsd:string ;
    :hasEvidenceChunk "2209.12152_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "the revolution of backbones plays a central role in diffusion models."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The central neural network architecture used as the core of a diffusion model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0052"^^xsd:string .

:conditioning_signal a owl:Class ;
    rdfs:label "Conditioning Signal"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0004"^^xsd:string,
        "CQ_S0_R1_0007"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0123"^^xsd:string,
        "CQ_S0_R1_0132"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string,
        "CQ_S0_R1_0200"^^xsd:string ;
    :hasEvidenceChunk "2302.08908_rag::chunk_006"^^xsd:string,
        "2307.01952_rag::chunk_011"^^xsd:string,
        "2310.07204_rag::chunk_009"^^xsd:string,
        "2310.07204_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "Controlling the strength of the conditional signal leads to a tradeoff between diversity and sample quality"^^xsd:string,
        "c is an arbitrary conditioning signal, e.g., a class label, a text prompt, or a combination thereof."^^xsd:string,
        "inject conditioning signals through cross-attention"^^xsd:string,
        "positive condition ( e.g ., text prompt) and negative condition ( e.g ., an empty string for text prompt)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Conditional Signal"^^xsd:string,
        "ConditioningSignal"^^xsd:string ;
    skos:skos_definition "A signal used to guide the generation process, where its strength affects the balance between diversity and sample quality."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0004"^^xsd:string,
        "CQ_S0_R1_0007"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0123"^^xsd:string,
        "CQ_S0_R1_0132"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string,
        "CQ_S0_R1_0200"^^xsd:string .

:distillationtechnique a owl:Class ;
    rdfs:label "DistillationTechnique"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0107"^^xsd:string ;
    :hasEvidenceChunk "2306.04542_rag::chunk_018"^^xsd:string ;
    :hasEvidenceText "Knowledge distillation is a network compression technique. In terms of di ff usion models, it involves the original sampling process as the teacher model and a new one with fewer timesteps as the student model"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A network compression or acceleration method applied to diffusion models to learn a new sampling process."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0107"^^xsd:string .

:forwardprocess a owl:Class ;
    rdfs:label "ForwardProcess"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0047"^^xsd:string,
        "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string ;
    :hasEvidenceChunk "2209.02646_rag::chunk_003"^^xsd:string,
        "2309.14068_rag::chunk_002"^^xsd:string,
        "2309.17074_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "The forward process is a Gaussian transition, which gradually adds noise to the original image following a predefined noise scheduler."^^xsd:string,
        "forward processalso known as the diffusion processwhich incrementally adds Gaussian noises to the real sample"^^xsd:string,
        "the forward process transforms the starting state into prior Gaussian noise"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Forward Process"^^xsd:string ;
    skos:skos_definition "A process that transforms the starting state into prior Gaussian noise by incrementally adding noise to a real sample."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0047"^^xsd:string,
        "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string .

:generativemodel a owl:Class ;
