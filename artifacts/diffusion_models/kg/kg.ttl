:scorefunction a owl:Class ;
    rdfs:label "ScoreFunction"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0115"^^xsd:string,
        "CQ_S0_R1_0125"^^xsd:string,
        "CQ_S0_R1_0140"^^xsd:string,
        "CQ_S0_R1_0203"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string ;
    :hasEvidenceChunk "2302.09057_rag::chunk_002"^^xsd:string,
        "2304.12526_rag::chunk_005"^^xsd:string,
        "2305.19693_rag::chunk_003"^^xsd:string,
        "2306.01900_rag::chunk_003"^^xsd:string,
        "2306.04139_rag::chunk_005"^^xsd:string,
        "2310.07204_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "A denoiser ( x t , t ) can be interpreted as a learned score function of the noise-perturbed x t"^^xsd:string,
        "The score function x log p ( x , T t ) directs the dynamics towards the target distribution"^^xsd:string,
        "The score function, x log p ( x ) , is defined as the gradient of the logarithm of the probabilistic density with respect to the input x ."^^xsd:string,
        "we do not have direct access to the values of the true score function s ( x, t ). This motivates us to propose a novel training method to mitigate sampling drift by enforcing that the learned score function satises an invariant"^^xsd:string,
        "we learn a function s ( x , t ) parameterized by a neural network to estimate its values."^^xsd:string,
        "x log p ( x ; ( t )) is known as the score function , a vector field that points towards regions of higher data likelihood."^^xsd:string ;
    rdfs:subClassOf :metric,
        owl:Thing ;
    skos:altLabel "Score Function"^^xsd:string ;
    skos:skos_definition "A vector field that points towards regions of higher data likelihood, often estimated by a neural network in diffusion models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0115"^^xsd:string,
        "CQ_S0_R1_0125"^^xsd:string,
        "CQ_S0_R1_0140"^^xsd:string,
        "CQ_S0_R1_0203"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string .

