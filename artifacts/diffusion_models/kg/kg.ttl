:samplingprocess a owl:Class ;
    rdfs:label "SamplingProcess"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0074"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0142"^^xsd:string ;
    :hasEvidenceChunk "2306.04542_rag::chunk_018"^^xsd:string,
        "2310.13102_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "The technique can also be applied to learn a new sampling process with fewer timesteps."^^xsd:string,
        "define a sampling process that promotes the diversity of a finite number of samples while retaining the advantages and flexibility that characterize diffusion models."^^xsd:string,
        "it involves the original sampling process as the teacher model and a new one with fewer timesteps as the student model"^^xsd:string ;
    rdfs:subClassOf :acquisitionfunction,
        owl:Thing ;
    skos:altLabel "Sampling Process"^^xsd:string ;
    skos:skos_definition "A procedure that promotes the diversity of samples while retaining the flexibility of diffusion models, often modified by guidance."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0074"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0142"^^xsd:string .

