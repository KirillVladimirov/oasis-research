  <rdf:Description rdf:about="http://example.org/S0/R1#causalrepresentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#representation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CausalRepresentation</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representations learned based on the assumption that causal relationships between features and the class variable are robust across domains.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0039</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0039</prov:wasDerivedFrom>
