  <rdf:Description rdf:about="http://example.org/S0/R1#covariate_shift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Covariate Shift</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scenario in machine learning and causal inference where the distribution of covariates changes, potentially leading to uninformed recommendations.</skos:skos_definition>
