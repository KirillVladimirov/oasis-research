    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A property or feature that remains unchanged under certain transformations or interventions, used to inform causal queries.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0047</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0047</prov:wasDerivedFrom>
