    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Targeted Maximum Likelihood Estimation, an iterative procedure that uses a targeting step to update an initial estimator of the outcome model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0115</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0115</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1903.00402_rag::chunk_021</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the targeting step to update the initial estimator of the outcome model. If the resulting TMLE does not improve upon the empirical t of the initial outcome regression, then this TMLE is not included in the sequence of TMLEs.</hasEvidenceText>
  </rdf:Description>
