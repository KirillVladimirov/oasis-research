    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disentangling Observed Causal Effects from Latent Confounders</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hastimeconstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#randomizedcontrolledtrial"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasTimeConstraint</rdfs:label>
