    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some methods focus on learning a balanced covariate representation, e.g., BLR/BNN (Johansson et al., 2016), and TARnet/CFR (Shalit et al., 2017).</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#verifiesdistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
