    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alternative approach to overcome the instability of IPW under small propensity scores is to redesign the sample weight so that the weight is bounded.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To mitigate the lack of overlap, matching as weighting methods are proposed</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#selection_bias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Selection Bias</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A conceptual problem in observational data settings that can make causal effects unidentifiable.</skos:skos_definition>
