    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of calculating error using the withheld group.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0167</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0167</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1903.00402_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finally, the MSE is calculated using the test data, thus evaluating the performance of the algorithm.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#usedwith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
