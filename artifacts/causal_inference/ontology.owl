    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A theoretical or modeled entity capable of providing conditional independence information for causal discovery.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0214</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0214</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2102.03274_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a CI oracle. When domain expertise or other a priori knowledge can be modeled with a partial CI oracle</hasEvidenceText>
  </rdf:Description>
