  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#counterfactual_representation_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#representation_learning_model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Counterfactual Representation Model</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model that employs counterfactual fine-tuning to compute individual treatment effects or deconfound feature representations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0072</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0072</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2005.13407_rag::chunk_020</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2004.09466_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we can now use the resulting counterfactual representation model and compute the individual treatment effect (ITE)</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deconfound the feature representations learned by deep neural network (DNN) models.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_39">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
