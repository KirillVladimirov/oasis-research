  <rdf:Description rdf:about="http://example.org/S0/R1#causal_inference_algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#algorithm"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Causal Inference Algorithm</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A computational procedure designed to search for correlation patterns to identify faithful causal models.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0172</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0172</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">226922_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An important number of causal inference algorithms are designed to search for this correlation pattern, since it leads to an identiable faithful causal model.</hasEvidenceText>
  </rdf:Description>
