    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantity Q(M) derived from a causal model, such as a causal effect, which may or may not be identifiable from observational data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0110</hasCQ>
