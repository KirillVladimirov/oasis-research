    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An estimator that combines outcome regression and propensity weighting to achieve unbiasedness if either model is correctly specified.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0028</hasCQ>
