    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weighting method designed to mitigate the lack of overlap by redesigning sample weights to be bounded.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0170</hasCQ>
