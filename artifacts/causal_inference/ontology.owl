    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D3TNqCspFpM_rag::chunk_022</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Random variable x is a noiseless proxy of random variable z if z is a function of x ( z = ( x ) ).</hasEvidenceText>
  </rdf:Description>
