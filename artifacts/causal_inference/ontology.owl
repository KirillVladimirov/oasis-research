    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship between the specification of the propensity score model and the statistical efficiency of the resulting estimator.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0046</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0046</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.04086_rag::chunk_019</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">this approach provides locally ecient estimation of under the assumption that the PS model is correctly specied</hasEvidenceText>
  </rdf:Description>
