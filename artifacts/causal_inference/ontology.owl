    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the causality-aware approach generates predictions that are considerably more stable</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#implies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#d_separation"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#conditional_independence"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">implies</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation where a graphical d-separation property allows for the inference of statistical conditional independence in a compatible distribution.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0008</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0008</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1912.09104_rag::chunk_009</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">d-separation ( d stands for directional) holds for any distribution P ( v ) over the variables in the model that is compatible with the causal assumptions encoded in the graph.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#causal_disentangled_representation_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#disentangled_representation_learning"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Causal Disentangled Representation Learning</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A framework for learning representations that correspond to causal concepts and allow for the manipulation of the causal system to generate counterfactual data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0096</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0096</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2004.08697_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Through causal disentangled representation learning, we aim at learning representations that correspond to the above four concepts.</hasEvidenceText>
  </rdf:Description>
