    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RCTs come with practical drawbacks such as cost and time</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_138">
