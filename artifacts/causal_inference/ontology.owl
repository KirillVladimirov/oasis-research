    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Noisy Measurements</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A problem arising in observational data settings that complicates the estimation of causal effects.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0071</hasCQ>
