    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IndirectEffect</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The effect of all mediators considered jointly, representing the portion of the total effect regulated by mediators.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0007</hasCQ>
