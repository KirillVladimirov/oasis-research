    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In this work, we take a critical perspective of the univariate SCM.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#counterfactual_language_model">
