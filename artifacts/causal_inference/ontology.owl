    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short-term outcomes are measured at each discrete timestep 1 , 2 , ..., 0</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#predictsoutcome">
