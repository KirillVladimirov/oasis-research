    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sequential Deconfounder</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method used in conjunction with outcome models to handle confounding in longitudinal settings.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0192</hasCQ>
