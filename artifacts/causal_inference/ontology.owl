    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CATE is unobserved in nature, as opposed to prediction problems where labels are given. 1. Introduction Estimating individualized treatment effects</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#propensityscore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
