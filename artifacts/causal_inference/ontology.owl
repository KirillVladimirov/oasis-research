    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chakrabortty et al. (2018) specied the individual mediation effect in a sparse high-dimensional causal graphical model.</hasEvidenceText>
  </rdf:Description>
