    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of intervention that changes either the parent-child functional relationship or the distribution of noise terms.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0087</hasCQ>
