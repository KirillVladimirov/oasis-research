    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A variable that is a common child of two or more parents, often associated with selection bias when conditioned upon.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0016</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0016</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010.05375_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activating the collider in V. Furthermore, as we will see in Section 6, in the presence of selection bias</hasEvidenceText>
  </rdf:Description>
