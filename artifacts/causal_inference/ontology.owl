    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A systematic procedure or technique used for analysis or estimation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0119</hasCQ>
