    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Models that use causal methods to enable risk estimation of outcomes under hypothetical interventions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0093</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0093</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2011.09815_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">causal prediction models that use causal methods to enable risk estimation of outcomes under hypothetical interventions</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#initial_estimator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
