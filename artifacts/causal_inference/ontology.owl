    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NoiselessProxy</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A special case of a proxy where the target variable is a deterministic function of the proxy variable.</skos:skos_definition>
