    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StratificationMatching</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PropensityScoreMatching</axiomRhs>
