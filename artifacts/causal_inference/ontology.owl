    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plug-in estimation strategy relying on modeling the response using observations to estimate treatment effects.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0099</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0099</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2011.08047_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the plug-in g-formula (Denition 4) strategy, relying on modeling the response using the RCT observations.</hasEvidenceText>
  </rdf:Description>
