    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metric</axiomRhs>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#mitigateslackof">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#weighting_method"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#common_support_condition"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mitigatesLackOf</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weighting methods are used to address situations where perfect overlap (common support) is difficult to achieve.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1809.09337_rag::chunk_015</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To mitigate the lack of overlap, matching as weighting methods are proposed, side-stepping the need for perfect matchings</hasEvidenceText>
  </rdf:Description>
