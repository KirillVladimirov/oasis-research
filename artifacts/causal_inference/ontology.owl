    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Simulated data used to remove spurious associations and adjust for confounding in predictive modeling.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</prov:wasDerivedFrom>
