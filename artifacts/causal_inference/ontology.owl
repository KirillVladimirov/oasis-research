    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a causal estimator to its property of being stable or having stability.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0044</hasCQ>
