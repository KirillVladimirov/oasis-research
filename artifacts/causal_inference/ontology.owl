    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The magnitude of a causal relationship estimated from models of the outcome or through de-confounding data.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0085</hasCQ>
