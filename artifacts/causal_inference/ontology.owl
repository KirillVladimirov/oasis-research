    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A graphical criterion of separability between nodes in a graph that is analogous to statistical independence.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0008</hasCQ>
