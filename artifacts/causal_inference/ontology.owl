    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2104.09323_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any outcome model can be used in conjunction with our Sequential Deconfounder.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#causalknowledge">
