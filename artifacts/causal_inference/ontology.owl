    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2008.10706_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We introduce a generalization of causal graphical models, Path Dependent Structural Equation Models (PDSEMs), that can describe such systems.</hasEvidenceText>
  </rdf:Description>
