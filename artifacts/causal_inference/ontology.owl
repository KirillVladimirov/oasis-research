    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">testsRobustnessOf</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of using a placebo variable to verify the stability of a model's causal claims.</skos:skos_definition>
