    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ability of a model to maintain performance across varying levels of bias or violations of assumptions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0108</hasCQ>
