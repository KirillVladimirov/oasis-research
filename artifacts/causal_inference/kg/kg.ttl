:causal_discovery_method a owl:Class ;
    rdfs:label "Causal Discovery Method"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string,
        "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0171"^^xsd:string ;
    :hasEvidenceChunk "2005.08543_rag::chunk_001"^^xsd:string,
        "2006.10833_rag::chunk_009"^^xsd:string,
        "2102.03274_rag::chunk_000"^^xsd:string,
        "2103.02582_rag::chunk_000"^^xsd:string,
        "cae7115f44837c806c9b23ed00a1a28a-Paper_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "A range of approaches to causal discovery in both temporal and non-temporal data exist"^^xsd:string,
        "Causal discovery methods seek to identify causal relations between random variables from purely observational data."^^xsd:string,
        "Granger causality (Wiener, 1956; Granger, 1969, 1980) (see denition Section 1.1. in Appendix) has been the standard approach to causal analysis of time series data"^^xsd:string,
        "In order to discover causal relationships from data, we need structure discovery methods."^^xsd:string,
        "There is a rich literature on learning causal graphs from observational data"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "CausalDiscoveryMethod"^^xsd:string ;
    skos:skos_definition "Methods that seek to identify causal relations between random variables from purely observational data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string,
        "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0171"^^xsd:string .

:intervention a owl:Class ;
    rdfs:label "Intervention"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0087"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string,
        "CQ_S0_R1_0231"^^xsd:string,
        "CQ_S0_R1_0237"^^xsd:string ;
    :hasEvidenceChunk "1912.09104_rag::chunk_020"^^xsd:string,
        "2005.11736_rag::chunk_000"^^xsd:string,
        "2008.10706_rag::chunk_001"^^xsd:string,
        "2010.07167_rag::chunk_000"^^xsd:string,
        "vinh-vo21a_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Estimating the causal eects of an intervention or treatment on an outcome is an important problem"^^xsd:string,
        "causal relationships unlike purely statistical ones remain invariant across environments unless explicitly changed under intervention."^^xsd:string,
        "conducting a randomized control trial (RCT) for the treatment of interest"^^xsd:string,
        "interventions may counterfactually alter the subsequent temporal evolution of the system"^^xsd:string,
        "the cost of an intervention on a subset of variables"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An action that can counterfactually alter the subsequent temporal evolution of a system or change the parent-child functional relationship."^^xsd:string ;
