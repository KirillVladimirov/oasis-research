:back_door_path a owl:Class ;
    rdfs:label "Back-door Path"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0038"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string,
        "CQ_S0_R1_0206"^^xsd:string ;
    :hasEvidenceChunk "1809.09337_rag::chunk_008"^^xsd:string,
        "1809.09337_rag::chunk_009"^^xsd:string,
        "1907.07271_rag::chunk_016"^^xsd:string,
        "r493_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "The existence of a back-door path is a common source of confounding, rendering P ( y | do ( t )) and P ( y | t ) ) di"^^xsd:string,
        "back-door paths from X to Y"^^xsd:string,
        "block the back-door paths that reflect other irrelevant causal effects. A way to eliminate confounding bias"^^xsd:string,
        "opening the back-door path X U 1 Z U 2 Y"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Backdoor Path"^^xsd:string ;
    skos:skos_definition "Paths that create an association between treatment and outcome not due to causal influence, which must be blocked to eliminate confounding bias."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0038"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string,
        "CQ_S0_R1_0206"^^xsd:string .

:causaldiscovery a owl:Class ;
    rdfs:label "CausalDiscovery"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0020"^^xsd:string,
        "CQ_S0_R1_0047"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string,
        "CQ_S0_R1_0231"^^xsd:string,
        "CQ_S0_R1_0234"^^xsd:string ;
    :hasEvidenceChunk "2005.11736_rag::chunk_000"^^xsd:string,
        "2008.05552_rag::chunk_000"^^xsd:string,
        "2010.02247_rag::chunk_001"^^xsd:string,
        "2102.03274_rag::chunk_000"^^xsd:string,
        "phd-budhathoki_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "Causal discovery can be roughly divided in four different tasks: uncovering the causal network"^^xsd:string,
        "Causal discovery estimates the underlying physical process that generates the observed data"^^xsd:string,
        "Causal discovery methods seek to identify causal relations between random variables from purely observational data."^^xsd:string,
        "It is impossible to draw causal conclusions from data alone; we also need to make assumptions on the data generating process."^^xsd:string,
        "recovering a causal graph in presence of latent variables"^^xsd:string,
        "recovering a causal graph in presence of latent variables, where we seek to minimize the cost of interventions used in the recovery process."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Causal Discovery"^^xsd:string ;
    skos:skos_definition "The process of uncovering the causal network or estimating the underlying physical process that generates observed data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0020"^^xsd:string,
        "CQ_S0_R1_0047"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string,
        "CQ_S0_R1_0231"^^xsd:string,
        "CQ_S0_R1_0234"^^xsd:string .

:conditional_average_treatment_effect a owl:Class ;
    rdfs:label "Conditional Average Treatment Effect"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0051"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0121"^^xsd:string,
        "CQ_S0_R1_0138"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string ;
    :hasEvidenceChunk "1809.09337_rag::chunk_011"^^xsd:string,
        "2004.10108_rag::chunk_001"^^xsd:string,
        "2009.13472_rag::chunk_002"^^xsd:string,
        "2103.04850_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "An example is the conditional average treatment effect (CATE) of instances with the same features, i.e., ( x ) = E i : x i = x [ i ] ."^^xsd:string,
        "CATE is closely associated with the optimal individualized treatment rule (ITR)."^^xsd:string,
        "The conditional average treatment effect for an individual with covariates x i may be dened as i ( x i ) = E [ y i | x i , do ( t = 1) y i | x i , do ( t = 0)]"^^xsd:string,
        "conditional average treatment effect (CATE) of instances with the same features"^^xsd:string,
        "estimate the dierence in the conditional mean outcome between the two treatments, given the individuals pre-treatment covariates. This problem is typically known as Conditional Average Treatment Eect (CATE) estimation."^^xsd:string,
        "we can model the Conditional Average Treatment Effect (CATE) ( Abrevaya et al. , 2015 ), ( x ) = E [Y 1 Y 0 | X = x ] = E [Y 1 | X = x ] E [Y 0 | X = x ]"^^xsd:string ;
    rdfs:subClassOf :individual_treatment_effect,
        owl:Thing ;
    skos:skos_definition "The expected difference in outcomes for individuals sharing the same covariates or features, often used to model or estimate treatment effects on subpopulations."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0051"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0121"^^xsd:string,
        "CQ_S0_R1_0138"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string .

:confounding_bias a owl:Class ;
