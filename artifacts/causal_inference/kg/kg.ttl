    :hasEvidenceChunk "a979ca2444b34449a2c80b012749e9cd-Paper_rag::chunk_014"^^xsd:string ;
    :hasEvidenceText "Threshold ( log support) 0.7 0.8 0.85 0.9 1.0 1.2"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A specific value used as a stopping or decision criterion in searching or performance evaluation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0209"^^xsd:string .

:time_series a owl:Class ;
