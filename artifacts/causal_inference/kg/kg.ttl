        "unmeasured variables U capture all common causes of ( A, Z ) and ( Y, W ) not included in X"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "UnmeasuredConfounder"^^xsd:string,
        "Unobserved Confounder"^^xsd:string,
        "Unobserved confounder"^^xsd:string,
        "UnobservedConfounder"^^xsd:string ;
    skos:skos_definition "A variable that creates associations between treatment and outcome but cannot be directly adjusted for, often represented as a latent variable."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0026"^^xsd:string,
        "CQ_S0_R1_0043"^^xsd:string,
