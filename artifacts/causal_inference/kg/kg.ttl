:average_treatment_effect a owl:Class ;
    rdfs:label "Average Treatment Effect"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0045"^^xsd:string,
        "CQ_S0_R1_0051"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string ;
    :hasEvidenceChunk "1809.09337_rag::chunk_011"^^xsd:string,
        "2002.02770_rag::chunk_010"^^xsd:string,
        "2009.13472_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "ATE can be formulated as the expectation of ITEs over the whole population"^^xsd:string,
        "Average Treatment Effect (ATE) is ( x ) = E x [ E [ y | x , do ( t = 1)] E [ y | x , do ( t = 0)]]"^^xsd:string,
        "Empirically, the ATE can be estimated as the average of ITE on the entire population."^^xsd:string,
        "the Average Treatment Effect (ATE) is ( x ) = E x [ E [ y | x , do ( t = 1)] E [ y | x , do ( t = 0)]]"^^xsd:string ;
    rdfs:subClassOf :causal_estimand,
        owl:Thing ;
    skos:skos_definition "The expectation of individual treatment effects over the whole population, often formulated using do-calculus or the potential outcome framework."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0045"^^xsd:string,
        "CQ_S0_R1_0051"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string .

:back_door_criterion a owl:Class ;
    rdfs:label "Back-door Criterion"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0004"^^xsd:string,
        "CQ_S0_R1_0032"^^xsd:string,
        "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0089"^^xsd:string,
        "CQ_S0_R1_0098"^^xsd:string,
        "CQ_S0_R1_0113"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string ;
    :hasEvidenceChunk "1809.09337_rag::chunk_009"^^xsd:string,
        "1912.09104_rag::chunk_014"^^xsd:string ;
    :hasEvidenceText "By adjusting for variables along these paths, this spurious association can be eliminated such that only the causal eect of X on Y remains. In the particular example of Figure 3a, the set Z = { E } satises the backdoor criterion"^^xsd:string,
        "This corresponds to adjustment on variables that satisfy the back-door criterion for causal identification"^^xsd:string,
        "adjustment on variables that satisfy the back-door criterion for causal identification"^^xsd:string,
        "variables that satisfy the back-door criterion for causal identification"^^xsd:string ;
    rdfs:subClassOf :causal_identification_strategy,
        owl:Thing ;
    skos:altLabel "Backdoor Criterion"^^xsd:string,
        "BackdoorCriterion"^^xsd:string ;
    skos:skos_definition "A criterion used for causal identification by blocking back-door paths that reflect irrelevant causal effects through adjustment on a set of variables."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0004"^^xsd:string,
        "CQ_S0_R1_0032"^^xsd:string,
        "CQ_S0_R1_0052"^^xsd:string,
        "CQ_S0_R1_0089"^^xsd:string,
        "CQ_S0_R1_0098"^^xsd:string,
        "CQ_S0_R1_0113"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string .

:causal_estimand a owl:Class ;
    rdfs:label "Causal Estimand"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0051"^^xsd:string ;
    :hasEvidenceChunk "1903.00402_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "A widely considered casual estimand is the ATE, dened as = E [ Y 1 i Y 0 i ] . Further estimands include the average taken over the treated subjects"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A quantity representing a causal effect to be estimated from data, such as the average of individual causal effects over a population."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0051"^^xsd:string .

:causal_graph a owl:Class ;
    rdfs:label "Causal Graph"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0140"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string,
        "CQ_S0_R1_0163"^^xsd:string,
        "CQ_S0_R1_0165"^^xsd:string,
        "CQ_S0_R1_0187"^^xsd:string,
        "CQ_S0_R1_0227"^^xsd:string ;
    :hasEvidenceChunk "1911.10496_rag::chunk_004"^^xsd:string,
        "1912.09104_rag::chunk_012"^^xsd:string,
        "1912.09104_rag::chunk_016"^^xsd:string,
        "2011.05489_rag::chunk_006"^^xsd:string,
        "2101.07086_rag::chunk_004"^^xsd:string,
        "2102.03129_rag::chunk_000"^^xsd:string,
        "2103.02582_rag::chunk_021"^^xsd:string ;
    :hasEvidenceText "Causal graph [ 28 ], as shown in Figure 1 , describes how variables interact with each other, expressed by a directed acyclic graph G = {N , E}"^^xsd:string,
        "These intricacies are hard to spot without the use of a causal diagram. We therefore regard DAGs as a useful complement"^^xsd:string,
        "distribution P ( v ) compatible with a causal graph G"^^xsd:string,
        "from a structural graph (which the authors refer to as a causal graph) at inference time."^^xsd:string,
        "is a DAG, with nodes representing conditions and edges representing causal effects between a pre-existing and an incident condition."^^xsd:string,
        "nding an ancestral acyclic directed mixed graph (ADMG) that represents the causal relationships between a set of variables"^^xsd:string,
        "propose a causal graph describing the generative process of an image as being generated by a domain."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "CausalGraph"^^xsd:string ;
    skos:skos_definition "A graphical representation, often a directed acyclic graph (DAG), where nodes represent conditions or variables and edges represent causal effects."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0140"^^xsd:string,
        "CQ_S0_R1_0146"^^xsd:string,
        "CQ_S0_R1_0163"^^xsd:string,
        "CQ_S0_R1_0165"^^xsd:string,
        "CQ_S0_R1_0187"^^xsd:string,
        "CQ_S0_R1_0227"^^xsd:string .

:causal_identification a owl:Class ;
    rdfs:label "Causal Identification"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0089"^^xsd:string,
        "CQ_S0_R1_0113"^^xsd:string ;
    :hasEvidenceChunk "1907.07271_rag::chunk_016"^^xsd:string,
        "1912.09104_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "this task amounts to transforming P ( y | do ( x )) into an equivalent expression, generally dierent from P ( y | x ), that is nonetheless estimable from the available data."^^xsd:string,
        "two of the most important examples of identication strategie"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Causal Identification Strategy"^^xsd:string ;
    skos:skos_definition "The process of transforming a causal effect expression into an equivalent expression estimable from observational data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0089"^^xsd:string,
        "CQ_S0_R1_0113"^^xsd:string .

:causal_identification_strategy a owl:Class ;
    rdfs:label "Causal Identification Strategy"^^xsd:string ;
    rdfs:subClassOf :causal_identification,
        :trainingprocedure,
        owl:Thing .

:causaleffectestimation a owl:Class ;
    rdfs:label "CausalEffectEstimation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0143"^^xsd:string,
        "CQ_S0_R1_0153"^^xsd:string,
        "CQ_S0_R1_0181"^^xsd:string ;
    :hasEvidenceChunk "2001.10652_rag::chunk_001"^^xsd:string,
        "2008.00357_rag::chunk_016"^^xsd:string,
        "2008.13620_rag::chunk_017"^^xsd:string ;
    :hasEvidenceText "The proposed approach to causal attribution relies on state-of-the-art methods for estimation of causal eects from observational data"^^xsd:string,
        "Tree-based methods are also widely adopted in causal effect estimation."^^xsd:string,
        "both average and conditional average treatment effect estimation"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Causal Effect Estimation"^^xsd:string ;
    skos:skos_definition "The stage of estimating causal effects from observational data using state-of-the-art methods to support causal attribution."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0143"^^xsd:string,
        "CQ_S0_R1_0153"^^xsd:string,
        "CQ_S0_R1_0181"^^xsd:string .

:causalinferencemethod a owl:Class ;
    rdfs:label "CausalInferenceMethod"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0214"^^xsd:string ;
    :hasEvidenceChunk "2007.00163_rag::chunk_014"^^xsd:string ;
    :hasEvidenceText "Causal approaches are therefore advantageous. Observational datasets are typically high-dimensional"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Approaches used to determine causal relations, particularly advantageous in high-dimensional observational data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0214"^^xsd:string .

:causalrelationship a owl:Class ;
    rdfs:label "CausalRelationship"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0175"^^xsd:string,
        "CQ_S0_R1_0237"^^xsd:string ;
    :hasEvidenceChunk "2010.07167_rag::chunk_000"^^xsd:string,
        "8142413a92e7df5fb79598dee863640346d53f5b_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "an edge X i X j means that X i is a direct cause of X j"^^xsd:string,
        "causal relationships unlike purely statistical ones remain invariant across environments unless explicitly changed under intervention."^^xsd:string ;
    rdfs:subClassOf :entity,
