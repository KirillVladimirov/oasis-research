    :hasEvidenceChunk "1903.00402_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "The 6 rst group is withheld from the tting process, and thus referred to as the test data ."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A subset of observations withheld from the fitting process to evaluate the performance of the algorithm."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0167"^^xsd:string .

:testableimplication a owl:Class ;
    rdfs:label "TestableImplication"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0180"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string ;
    :hasEvidenceChunk "1912.09104_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "These independence relations can be checked using statistical hypothesis testing, and if rejected, the hypothesized model could be refuted and/or revised."^^xsd:string,
        "this method provides the analyst with a set of testable implications that can be benchmarked with the available data."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A set of relations, such as conditional independence, that can be benchmarked with available data to verify a model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0180"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string .

:threshold a owl:Class ;
