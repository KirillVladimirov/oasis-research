:acquisitionfunction a owl:Class ;
    rdfs:label "AcquisitionFunction"^^xsd:string ;
    rdfs:subClassOf :method,
        owl:Thing .

:addresses a owl:ObjectProperty ;
    rdfs:label "addresses"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0116"^^xsd:string ;
    :hasEvidenceChunk "r460_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "This work addresses the MAB problem when unobserved confounders are present"^^xsd:string ;
    rdfs:domain :unobserved_confounding ;
    rdfs:range :treatment_effect ;
    skos:skos_definition "The relationship where a causal analysis method attempts to resolve the bias introduced by hidden factors."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0116"^^xsd:string .

:addressescondition a owl:ObjectProperty ;
    rdfs:label "addressesCondition"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0210"^^xsd:string ;
    :hasEvidenceChunk "1912.09104_rag::chunk_029"^^xsd:string ;
    :hasEvidenceText "recovering causal eects from a mix of biased and unbiased data"^^xsd:string ;
    rdfs:range :selectionbias ;
    skos:skos_definition "Transportability techniques are used to recover causal effects in the presence of selection bias."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0210"^^xsd:string .

:addressesinvalidity a owl:ObjectProperty ;
    rdfs:label "addressesInvalidity"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0120"^^xsd:string ;
    :hasEvidenceChunk "2104.06911_rag::chunk_018"^^xsd:string ;
    :hasEvidenceText "uncertainty of detecting locally invalid IVs."^^xsd:string ;
    rdfs:domain :robust_inference_method ;
    rdfs:range :instrumental_variable ;
    skos:skos_definition "The capability of a method to handle locally invalid or incorrectly identified instrumental variables."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0120"^^xsd:string .

:adjustment_variable a owl:Class ;
    rdfs:label "Adjustment Variable"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0056"^^xsd:string ;
    :hasEvidenceChunk "qidong20a_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "making good use of adjustment variables and confounders"^^xsd:string ;
