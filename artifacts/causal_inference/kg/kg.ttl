    :hasCQ "CQ_S0_R1_0171"^^xsd:string ;
    :hasEvidenceChunk "2005.08543_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "causal inference in time series is still challenging despite the fact that the time order"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A sequence of data points indexed in time order used as the basis for causal analysis."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0171"^^xsd:string .

:tmle_update_cycle a owl:Class ;
    rdfs:label "TMLE Update Cycle"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0159"^^xsd:string ;
    :hasEvidenceChunk "1903.00402_rag::chunk_021"^^xsd:string ;
    :hasEvidenceText "This procedure is performed iteratively until all d covariates have been incorporated into the PS model."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An iterative procedure performed to update the initial estimator of the outcome model until specific convergence criteria are met."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0159"^^xsd:string .

:training_data a owl:Class ;
    rdfs:label "Training data"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0167"^^xsd:string ;
    :hasEvidenceChunk "1903.00402_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "The algorithm is then tted using the data in the remaining V 1 folds, called the training data ."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The data in the remaining folds used to fit the algorithm during cross-validation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0167"^^xsd:string .

:treatmentassignment a owl:Class ;
    rdfs:label "TreatmentAssignment"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0043"^^xsd:string,
        "CQ_S0_R1_0083"^^xsd:string ;
    :hasEvidenceChunk "2008.08236_rag::chunk_010"^^xsd:string,
        "2104.09323_rag::chunk_011"^^xsd:string ;
    :hasEvidenceText "The treatment assignments depends on the medical state X t , the unobserved confounder U , and the previous treatment A t 1"^^xsd:string,
        "predict the primary outcomes under two treatment assignments 1 and 0"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Treatment Assignment"^^xsd:string ;
    skos:skos_definition "The specific intervention or action assigned to a subject within a trial or simulation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0043"^^xsd:string,
        "CQ_S0_R1_0083"^^xsd:string .

:treatmentsequence a owl:Class ;
    rdfs:label "TreatmentSequence"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0178"^^xsd:string ;
    :hasEvidenceChunk "2011.09815_rag::chunk_014"^^xsd:string ;
    :hasEvidenceText "planned sequence of treatments (such as statins)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A planned series of medical interventions, such as statins, over time."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0178"^^xsd:string .

:two_stage_least_squares a owl:Class ;
    rdfs:label "Two-Stage Least Squares"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0154"^^xsd:string ;
    :hasEvidenceChunk "1809.09337_rag::chunk_022"^^xsd:string,
        "2104.06911_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "Our proposed procedure consists of two stages as an analogy to TSLS ."^^xsd:string,
        "So we introduce 2SLS [ 5 ]."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An estimation method (2SLS or TSLS) used for instrumental variable analysis, structured into two distinct stages."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0154"^^xsd:string .

:univariate_scm a owl:Class ;
    rdfs:label "Univariate SCM"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0211"^^xsd:string ;
    :hasEvidenceChunk "2002.10007_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "In this work, we take a critical perspective of the univariate SCM."^^xsd:string ;
    rdfs:subClassOf :structural_causal_model,
        owl:Thing ;
    skos:skos_definition "A specific case of structural causal models involving a single cause and effect variable."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0211"^^xsd:string .

:unobserved_confounding a owl:Class ;
    rdfs:label "Unobserved Confounding"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0071"^^xsd:string,
        "CQ_S0_R1_0116"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string ;
    :hasEvidenceChunk "2103.15106_rag::chunk_000"^^xsd:string,
        "2103.16689_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "The problems include unmeasured confounding"^^xsd:string,
        "Unobserved confounding is one of the greatest challenges for causal discovery."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Unmeasured Confounding"^^xsd:string ;
    skos:skos_definition "A condition where variables that influence both treatment and outcome are not recorded in the data, posing a challenge for causal discovery."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0071"^^xsd:string,
        "CQ_S0_R1_0116"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string .

:validationstep a owl:Class ;
    rdfs:label "ValidationStep"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0204"^^xsd:string ;
    :hasEvidenceChunk "2011.09815_rag::chunk_018"^^xsd:string ;
    :hasEvidenceText "Validation is a crucial step in prediction modelling (counterfactual or otherwise)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A crucial step in prediction modelling, including counterfactual space, to ensure model accuracy."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0204"^^xsd:string .

:variance a owl:Class ;
    rdfs:label "Variance"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0042"^^xsd:string ;
    :hasEvidenceChunk "2004.10108_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "RD-Learning also has a smaller variance . This is because in general the variability of the residual term r ( X ) is smaller than that of m ( X )"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A measure of the variability or spread of the estimator's values."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0042"^^xsd:string .

:weighting_method a owl:Class ;
    rdfs:label "Weighting Method"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0112"^^xsd:string ;
    :hasEvidenceChunk "1809.09337_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "To mitigate the lack of overlap, matching as weighting methods are proposed, side-stepping the need for perfect matchings, which are difficult to achieve in practice."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Methods proposed to mitigate the lack of overlap by side-stepping the need for perfect matchings."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0112"^^xsd:string .

