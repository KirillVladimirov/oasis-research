    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The level of detail or bit-width used to represent numerical values during computation, such as FP32 or BF16.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0092</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0092</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2510.13786_rag::chunk_011</hasEvidenceChunk>
