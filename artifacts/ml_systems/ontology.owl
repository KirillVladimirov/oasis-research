    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EmbeddingTable</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A data structure used in Deep Learning Recommendation Models (DLRMs) that often requires model parallelism due to storage capacity demands.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0133</hasCQ>
