    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process or method used to calculate or approximate the gradient, often involving techniques to ensure it remains unbiased.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0045</hasCQ>
