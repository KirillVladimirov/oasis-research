    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Partial Rollout Mechanism</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mechanism where a single trajectory contains tokens generated by different model versions, requiring precise separation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</hasCQ>
