    <rdfs:range rdf:resource="http://example.org/S0/R1#trainingefficiency"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degrades</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The negative impact where offloading overhead causes delays and reduces the speed of training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.10377_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the overhead of CPU offloading grows linearly, causing substantial delays in GPU computation and markedly degrading training efficiency.</hasEvidenceText>
  </rdf:Description>
