    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific type of optimization where adjacent operators are combined based on their dynamics.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0225</hasCQ>
