    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit of work dispatched to agents in a flow-based manner to keep the rollout pipeline saturated.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0022</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0223</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0022</prov:wasDerivedFrom>
