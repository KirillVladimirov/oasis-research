    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component that computes, enqueues, and serves data batches to clients, potentially running as remote or local processes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</hasCQ>
