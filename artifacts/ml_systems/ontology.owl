    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2509.18521v1_rag::chunk_021</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LLM inference server with API backed by an autoregressive inference engine like SGLang ( Zheng et al. , 2024 ) or vLLM ( Kwon et al. , 2023 )</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The inference engine for ParaThinker is built upon the vLLM framework ( Kwon et al. , 2023 ) to leverage its efficient parallel scaling.</hasEvidenceText>
