    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decoding phase is typically bounded by memory bandwidth</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The procedure of an LLM M processing an input can be divided into two stages: prefill and decoding.</hasEvidenceText>
  </rdf:Description>
