    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A performance modeling approach for a fixed model size where validation loss is modeled against training data budget.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0165</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0165</prov:wasDerivedFrom>
