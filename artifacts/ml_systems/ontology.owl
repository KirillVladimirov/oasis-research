  <rdf:Description rdf:about="http://example.org/S0/R1#global_synchronization_bottleneck">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#bottleneck"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Global Synchronization Bottleneck</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bottleneck occurring when system progress is tied to a global synchronization point, particularly problematic with skewed execution times.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0043</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0043</prov:wasDerivedFrom>
