    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A training method used to reduce the memory requirement of training large models by partitioning gradients.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0045</hasCQ>
