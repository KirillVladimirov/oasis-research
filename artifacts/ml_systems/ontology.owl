    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique that quantizes model weights and/or activations to lower bit-widths to reduce memory bandwidth requirements.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0014</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0014</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.16428_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantize model weights and/or activations to lower bit-widths, thereby reducing memory bandwidth requirements and accelerating computation.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#degrades">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
