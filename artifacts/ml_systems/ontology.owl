    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2508.11553_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2501.12407_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The streaming dataloader continuously feeds tasks to agents in a flowbased manner rather than waiting for fixed-size batches.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tasks may produce multiple output partitions; if this was the last, free the tasks resources.</hasEvidenceText>
  </rdf:Description>
