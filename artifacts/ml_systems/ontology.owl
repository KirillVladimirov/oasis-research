    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method of sharing GPU resources that is often less frequently applicable due to the memory and compute-intensive nature of DL training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0187</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0187</prov:wasDerivedFrom>
