    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decomposes KV weight matrices offline, caching lowrank KV projections to achieve a higher compression rate.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#prefixtree">
