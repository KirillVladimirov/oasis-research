    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2505.23884_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Test-Time Training (TTT) models context dependencies by adapting part of the models weights (often referred to as fast weights) at inference time.</hasEvidenceText>
  </rdf:Description>
