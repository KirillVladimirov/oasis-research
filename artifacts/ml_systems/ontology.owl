  <rdf:Description rdf:about="http://example.org/S0/R1#checkpointing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Checkpointing</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mechanism used in distributed training to save the state of the model to minimize work lost due to preemption or resource scaling.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0060</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0060</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2511.16665_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2508.07970_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This mechanism minimizes work lost due to preemption through frequent and efficient checkpointing.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To accommodate elastic resource scaling, we utilize distributed checkpointing</hasEvidenceText>
  </rdf:Description>
