    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A batch of data provided by a producer, typically larger than consumer batches to ensure data availability.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0076</hasCQ>
