    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A service or architecture component that manages model weights and facilitates updates between actors and relays.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0203</hasCQ>
