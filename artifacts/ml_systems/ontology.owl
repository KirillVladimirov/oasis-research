    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standardized tests used to evaluate the quality and performance of models handling extensive input sequences.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0047</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0047</prov:wasDerivedFrom>
