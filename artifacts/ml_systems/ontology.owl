    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actor checkpointing</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A recovery mechanism involving the storage and loading of specific weight versions from files to ensure training continuity.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0025</hasCQ>
