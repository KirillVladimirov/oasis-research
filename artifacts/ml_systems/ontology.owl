    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The prefix cache on each instance is organized as a local prefix tree.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#incurs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
