    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An architecture where components share resources, often characterized by synchronous workflows and potential performance bottlenecks during long-tail effects.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</prov:wasDerivedFrom>
