    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A grouping of sequences of varying lengths that influences the checkpointing setup and recomputation overhead.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0060</hasCQ>
