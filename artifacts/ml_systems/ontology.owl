    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forward and backward passes on the deep learning model are GPU-based</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accelerates data loading for image datasets by moving the image preprocessing workload to GPU</hasEvidenceText>
