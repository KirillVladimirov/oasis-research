    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ring Attention demands inter-node communication during every iteration</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#gradientsharding">
