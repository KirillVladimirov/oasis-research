    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2409.18749_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we recommend having it at least twice as large as the largest consumer batch</hasEvidenceText>
  </rdf:Description>
