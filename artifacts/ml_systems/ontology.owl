  <rdf:Description rdf:about="http://example.org/S0/R1#imagepreprocessing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#datapreprocessing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImagePreprocessing</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preprocessing operations specifically targeting image datasets, often involving GPU acceleration.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0019</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0019</prov:wasDerivedFrom>
