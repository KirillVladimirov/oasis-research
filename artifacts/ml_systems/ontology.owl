    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tfdata_service_SoCC23_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Input-bound jobs are more problematic as they leave valuable ML hardware underutilized</hasEvidenceText>
  </rdf:Description>
