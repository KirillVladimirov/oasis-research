    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Activation checkpoint</rdfs:label>
    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Activation Checkpointing</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy used in large model training to reduce GPU memory pressure by not storing all intermediate activations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0191</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0201</hasCQ>
