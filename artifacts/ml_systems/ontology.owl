    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A smaller, manageable segment of an input sequence used to achieve memory savings and efficiency.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0081</hasCQ>
