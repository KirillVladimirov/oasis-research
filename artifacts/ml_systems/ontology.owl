    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scheme or sequence sharding to approximate these conditions ( Wang et al. , 2025c ), respectively.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#quantization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
