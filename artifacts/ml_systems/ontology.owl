    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To address this, we adopt private key-value storage solutions (e.g. FeatureKV and UnionDB), on top of our private service discovery and distributed file system</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#colocated_architecture">
