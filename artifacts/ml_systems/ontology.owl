    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the generation time of long-tailed samples often exceeds the execution time of inference tasks</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#producerbatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
