    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FP32 precision improves overall scalability</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bfloat16 precision, which attenuates micro-updates</hasEvidenceText>
  </rdf:Description>
