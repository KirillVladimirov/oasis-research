    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">each GPU computes the loss of the sequence it holds</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A100 server is limited to a max of 48 cores to mimic Azure offerings with A100 GPUs</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Figure 8 shows a GPU starving case where the sequence chunk is too short such that the latency in the attention computation is less than the data fetch latency.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rollout and training stages are assigned to separate sets of GPUs.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">denote the available GPUs in the datacenters</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPUs are highly efficient in both training and inference, due to their exceptional parallel processing capabilities.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">producer GPU</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">utilizing all GPU resources</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum supported size in vLLM for CUDA GPUs</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workers (i.e., GPUs cooperating with tensor parallelism)</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all GPUs will share the PCIe bandwidth</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">splitting model parameters of certain layers along certain dimensions across GPUs</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZeRO-Offload focuses on training models with over 13 billion parameters on a single GPU.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kernels on an NVIDIA H200 GPU.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#executor">
