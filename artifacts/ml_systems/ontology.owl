    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy or mechanism to address workload imbalance which can create bottlenecks during training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0004</hasCQ>
