    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A storage solution used to manage large quantities of data more efficiently than standard file systems to avoid metadata bottlenecks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0084</hasCQ>
