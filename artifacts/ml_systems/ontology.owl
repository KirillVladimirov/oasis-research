    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The data components of a machine learning model, such as parameters, gradients, and optimizer states, that consume memory during training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0219</hasCQ>
