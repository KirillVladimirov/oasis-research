    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method that models context dependencies by adapting model weights at inference time to store temporary memories of past tokens.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0074</hasCQ>
