    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">output token throughput is a widely adopted metric for characterizing LLM serving system performance</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#inference_workload">
