        "CQ_S0_R1_0181"^^xsd:string,
        "CQ_S0_R1_0215"^^xsd:string,
        "CQ_S0_R1_0237"^^xsd:string ;
    :hasEvidenceChunk "2405.07719_rag::chunk_001"^^xsd:string,
        "2412.01523_rag::chunk_005"^^xsd:string,
        "2502.21231_rag::chunk_003"^^xsd:string,
        "2504.14519_rag::chunk_000"^^xsd:string,
        "2504.14519_rag::chunk_004"^^xsd:string,
        "2507.00394_rag::chunk_006"^^xsd:string,
        "2507.00394_rag::chunk_018"^^xsd:string ;
    :hasEvidenceText "Existing pipeline parallelisms such as 1F1B or ZB1P partition a model at the layer granularity."^^xsd:string,
        "HelixPipe, a novel pipeline parallelism method for efficient transformer training with long sequences."^^xsd:string,
        "PP employs inter-operation partitioning, segmenting the model layers into different stages."^^xsd:string,
        "Pipeline Parallelism (PP) serves as a crucial technique for training Large Language Models (LLMs), owing to its capability to alleviate memory pressure from model states"^^xsd:string,
        "These approaches divide the model layers into multiple stages placed across different devices"^^xsd:string,
        "Zero Bubble Pipeline Parallelism [ 33 , 34 ] introduces a novel V-shape pipeline schedule that effectively balances memory utilization across pipeline devices."^^xsd:string,
        "analyze the application of SP in conjunction with Tensor Parallelism, ZeRO, and Pipeline Parallelism"^^xsd:string ;
    rdfs:subClassOf :distributed_training,
        owl:Thing ;
    skos:altLabel "PipelineParallelism"^^xsd:string ;
    skos:skos_definition "A technique for training Large Language Models that divides model layers into multiple stages across different devices to alleviate memory pressure."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0067"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0099"^^xsd:string,
        "CQ_S0_R1_0117"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string,
        "CQ_S0_R1_0147"^^xsd:string,
        "CQ_S0_R1_0181"^^xsd:string,
        "CQ_S0_R1_0215"^^xsd:string,
        "CQ_S0_R1_0237"^^xsd:string .

