:Cls_1f1b a owl:Class ;
    rdfs:label "1F1B"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0194"^^xsd:string ;
    :hasEvidenceChunk "2507.00394_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "Existing pipeline parallelisms such as 1F1B or ZB1P partition a model at the layer granularity."^^xsd:string ;
    rdfs:subClassOf :metric,
        owl:Thing ;
    skos:skos_definition "A pipeline parallelism strategy that partitions a model at the layer granularity and manages micro-batch execution."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0194"^^xsd:string .

:Cls_1f1b_schedule a owl:Class ;
    rdfs:label "1F1B Schedule"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0007"^^xsd:string ;
    :hasEvidenceChunk "2504.14519_rag::chunk_004"^^xsd:string,
        "2507.00394_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "Existing pipeline parallelisms such as 1F1B or ZB1P partition a model at the layer granularity."^^xsd:string,
        "the 1F1B schedule eliminates the dependence of activation accumulation on"^^xsd:string ;
    rdfs:subClassOf :pipeline_parallelism_schedule,
        owl:Thing ;
    skos:skos_definition "A pipeline parallelism schedule where one forward pass is followed by one backward pass to manage activation memory."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0007"^^xsd:string .

:accelerates a owl:ObjectProperty ;
