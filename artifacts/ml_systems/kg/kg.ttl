:distributed_training a owl:Class ;
    rdfs:label "Distributed Training"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0004"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string,
        "CQ_S0_R1_0209"^^xsd:string,
