    rdfs:label "Pipeline Parallelism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0067"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
