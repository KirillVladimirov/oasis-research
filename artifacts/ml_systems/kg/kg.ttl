:data_parallelism a owl:Class ;
    rdfs:label "Data Parallelism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0005"^^xsd:string,
        "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string,
        "CQ_S0_R1_0226"^^xsd:string ;
    :hasEvidenceChunk "2405.07719_rag::chunk_006"^^xsd:string,
        "2405.07719_rag::chunk_007"^^xsd:string,
        "2409.13221_rag::chunk_005"^^xsd:string,
        "2502.21231_rag::chunk_008"^^xsd:string,
        "2504.15930_rag::chunk_005"^^xsd:string,
        "2508.07970_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Data Parallelism (DP) involves duplicating the model across devices and splitting the dataset among them, allowing each replica to process different portions of data concurrently."^^xsd:string,
        "Data Parallelism (DP) replicates the model weights and distributes the data among the replicas to execute in parallel."^^xsd:string,
        "In data parallelism, all DP ranks must execute the same number of micro-batches, and then synchronize gradients before the model update."^^xsd:string,
        "The ideal performance is only to reach the performance of DP without communication for attention."^^xsd:string,
        "existing hybrid parallelism framework of Data Parallelism (DP), Tensor Parallelism (TP), and Pipeline Parallelism (PP)"^^xsd:string,
        "partitioning both the model and the data across multiple GPUs or nodes"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A parallelization technique involving duplicating the model across devices and splitting the dataset among them to process data concurrently."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0005"^^xsd:string,
        "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0145"^^xsd:string,
        "CQ_S0_R1_0190"^^xsd:string,
        "CQ_S0_R1_0226"^^xsd:string .

