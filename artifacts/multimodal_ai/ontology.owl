    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">it learns associations between text prompts and video contents as well as temporal correspondence across video frames</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#evaluatedby">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
