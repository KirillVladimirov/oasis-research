    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attention-Based Projector</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A projector that utilizes learnable vectors and attention mechanisms to extract key information from non-linguistic modalities.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0022</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0022</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2412.11694_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">when using an attentionbased projector, typically design multiple modalityspecific learnable vectors to extract key information from various non-linguistic modalities</hasEvidenceText>
  </rdf:Description>
