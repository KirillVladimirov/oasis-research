    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model capable of performing tasks on distributions it was not explicitly trained or fine-tuned on.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0105</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0105</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.00020_rag::chunk_022</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intuitively, a zero-shot model should not be able to exploit spurious correlations or patterns that hold only on a specic distribution</hasEvidenceText>
  </rdf:Description>
