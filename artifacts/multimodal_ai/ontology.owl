    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type of deep learning model based on the Transformer architecture designed to process multiple modalities.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0023</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0131</hasCQ>
