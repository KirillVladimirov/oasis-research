    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2405.14129_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VQA and visual grounding tasks require not only global alignment but also local alignment capabilities between images and text.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
