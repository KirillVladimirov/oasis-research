    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A VLP pipeline that requires an object detector, such as Faster R-CNN.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0004</hasCQ>
