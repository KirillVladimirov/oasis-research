    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModalAwareMaskedContrastiveLearning</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entity</axiomRhs>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
