    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.12226_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">build a dataset comprised of 108k multi-turn conversation samples with generative models.</hasEvidenceText>
  </rdf:Description>
