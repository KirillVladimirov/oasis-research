    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model architecture where additional transformer layers are typically employed to model the deep interaction between image and text representations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0148</hasCQ>
