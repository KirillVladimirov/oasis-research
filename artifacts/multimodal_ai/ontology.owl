    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model capable of performing retrieval tasks across diverse modalities such as text, image, or interleaved formats.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0206</hasCQ>
