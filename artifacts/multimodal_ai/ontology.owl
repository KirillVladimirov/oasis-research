    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FrameFusion adopts a cascaded merging strategy, where merged tokens remain reduced across layers to maximize efficiency.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#vqvae">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
