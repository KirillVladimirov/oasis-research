    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pair of samples used in contrastive learning that are not from the same source or do not match the query.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0061</hasCQ>
