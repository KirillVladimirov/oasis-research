    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2405.15684_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we introduce novel prompt-aware adapters designed to adaptively embed visual inputs based on the given prompt.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hierarchical_attention">
