    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method for supervised fine-tuning where annotators correct errors in trajectories to mitigate off-policy data challenges.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0054</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0081</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0054</prov:wasDerivedFrom>
