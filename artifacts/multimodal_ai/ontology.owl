    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type of autoencoder that learns a discrete representation forming a categorical distribution instead of modeling a continuous distribution.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0174</hasCQ>
