    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pretraining approach that aligns video and text modalities, often used for downstream video understanding tasks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0171</hasCQ>
