    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Existing layers of a model that have already undergone an initial training phase before further integration or adaptation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0048</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0048</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.12451_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integration of dense crossattention blocks among the existing pre-trained layers of the LLM.</hasEvidenceText>
  </rdf:Description>
