    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fusion encoder, where additional transformer layers are typically employed to model the deep interaction between image and text representations.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#local_alignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
