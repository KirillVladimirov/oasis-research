    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tracking the predictions using the Stark [ 52 ] object tracker.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#evaluates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#dataset"/>
