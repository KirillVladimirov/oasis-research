    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A retrieval-augmented generation method within a multimodal empathetic response generation framework designed to provide images.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0014</hasCQ>
