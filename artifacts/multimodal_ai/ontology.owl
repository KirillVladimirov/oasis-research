    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specific spatial or detection-based data used to enhance visual understanding.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0141</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0141</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2202.03052_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incorporating region information might be essential to visual understanding</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#visionencoder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
