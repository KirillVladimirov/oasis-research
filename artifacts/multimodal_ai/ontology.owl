    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process that enables interaction between different modalities by concatenating queries, keys, and values into unified sequences.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0195</hasCQ>
