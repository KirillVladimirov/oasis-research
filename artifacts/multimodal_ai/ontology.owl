    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-modality can be classified into homogeneous modalities</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#cross_attention_to_concatenation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
