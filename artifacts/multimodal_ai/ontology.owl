    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a model to the experimental evaluation method used to assess its robustness.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0131</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0131</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2206.06488_rag::chunk_027</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the common practices to analyse robustness are mainly based on experiment evaluations [ 291 ], e . g ., cross-dataset evaluations, perturbationbased evaluations.</hasEvidenceText>
