    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incorporating both global context and highresolution patches into visual embeddings</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#utilizesembedding">
