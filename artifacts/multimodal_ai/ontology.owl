    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instead of modeling a continuous distribution, VQVAEs [ 47 , 53 ] learn a discrete representation forming a categorical distribution.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#multiway_transformer">
