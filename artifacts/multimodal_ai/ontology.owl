    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2405.14974_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2306.13549_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instruction-tuning data from public sources, emphasizing the importance of distribution balancing.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limited diversity of instruction data</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collects 665K instruction tuning data from present vision-language (VL) datasets</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">utilizes LLMs to generate textual instruction-following data using a few hand-annotated samples</hasEvidenceText>
