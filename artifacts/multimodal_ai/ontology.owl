    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.04856_rag::chunk_148</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This training strategy thereby produces a joint representation</hasEvidenceText>
  </rdf:Description>
