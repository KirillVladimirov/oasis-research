    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2103.00020_rag::chunk_023</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero-shot CLIP is much more robust to distribution shift than standard ImageNet models.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero-shot CLIP models shrink this robustness gap by up to 75%.</hasEvidenceText>
  </rdf:Description>
