    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we construct grounded instruction data by utilizing the pairs of bounding boxes and expressions</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#utilizes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#unifiedframework"/>
