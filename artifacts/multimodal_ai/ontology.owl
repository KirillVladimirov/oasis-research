    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Local Alignment</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alignment strategy focusing on the relationship between specific image regions (patches) and text, often used for fine-grained tasks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0166</hasCQ>
