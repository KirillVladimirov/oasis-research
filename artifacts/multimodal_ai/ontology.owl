    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2403.08857_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">during the inference phase of a given conversation, we fix the random seed of the T2I model.</hasEvidenceText>
