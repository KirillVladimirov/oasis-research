    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2312.17172_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UL2 [ 175 ] proposed the Mixture of Denoisers (MoD), a unified perspective to train LLMs, which combines the span corruption [ 147 ] and causal language modeling [ 19 ] objectives.</hasEvidenceText>
  </rdf:Description>
