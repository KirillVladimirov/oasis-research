    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process used to guide models in retrieving candidates that meet both information needs and preferred modalities.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0056</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0056</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2411.02571_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we propose modality-aware hard negative mining to guide models in retrieving candidates that meet both the users information needs and their preferred modality.</hasEvidenceText>
  </rdf:Description>
