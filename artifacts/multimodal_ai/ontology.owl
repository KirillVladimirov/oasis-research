  <rdf:Description rdf:about="http://example.org/S0/R1#contrastiveobjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#lossfunction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ContrastiveObjective</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A learning approach that aims to identify positive pairs of examples within a set, often requiring fewer data samples to reach specific accuracy scores compared to generative methods.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0145</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0145</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.04856_rag::chunk_115</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.04856_rag::chunk_035</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The contrastive objective reaches similar accuracy scores as the generative approach with only a seventh of the amount of data</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the contrastive prediction task aims to identify x i in { x i } k = i for a given x i</hasEvidenceText>
  </rdf:Description>
