    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Encoder-Only Multimodal Transformer</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A BERT-like architecture used in multimodal contexts that may require separate decoders for generation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0204</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0204</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2206.06488_rag::chunk_024</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the BERT-like encoder-only multimodal Transformers ( e . g ., VideoBERT [ 7 ], CBT [ 107 ]) need separately to train decoders for generation tasks.</hasEvidenceText>
  </rdf:Description>
