    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2402.17723_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The image-toaudio generation requires audio-visual alignment from the semantic level, whereas temporal alignment is additionally needed for video-to-audio generation.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#negativepair">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
