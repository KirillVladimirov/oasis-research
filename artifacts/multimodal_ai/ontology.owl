    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appropriate method for curating modality data during the process of learning unified multimodal embeddings</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#crossmodalretrieval">
