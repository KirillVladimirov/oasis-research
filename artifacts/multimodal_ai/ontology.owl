    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Temporal attention is order-independent</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_279">
