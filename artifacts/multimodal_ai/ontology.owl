    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Image-Text Contrastive Learning (ITC) learns to align image representation and text representation such that their mutual information is maximized.</hasEvidenceText>
  </rdf:Description>
