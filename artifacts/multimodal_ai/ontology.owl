    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0005</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0085</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2206.06488_rag::chunk_023</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2301.04856_rag::chunk_152</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2304.01961_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2405.02246_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prediction ( i . e ., late fusion)</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Late fusion or sometimes also called decision level fusion is the procedure of fusing the predictions of multiple models that have been trained on each data 200 4 Further Topics modality sep</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We use simple late fusion approaches by mixing the r</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modality projection along with learned pooling on the other side</hasEvidenceText>
  </rdf:Description>
