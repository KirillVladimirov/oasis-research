    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A large language model capable of processing multiple modalities, such as text and images, often evaluated on complex cognitive tasks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0044</hasCQ>
