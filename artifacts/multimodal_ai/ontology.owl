    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instruction-tuned large multimodal models (LMMs)</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#discrete_space_generative_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
