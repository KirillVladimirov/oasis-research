    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2404.01322_rag::chunk_018</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Full finetuning involves adjusting all parameters of a pre-trained model</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_303">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
