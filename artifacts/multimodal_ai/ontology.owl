    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Previous methods have suffered from the context capacity of LLMs and have had to specifically fine-tune an LLM to support more tokens</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#interactive_annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
