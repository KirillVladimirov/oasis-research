    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pretraining large-scale video-text models and fine-tuning them for downstream tasks has become the norm</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#llm">
