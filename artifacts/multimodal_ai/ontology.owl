    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mathematical function used to calculate the difference between predicted and actual values during training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0050</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0177</hasCQ>
