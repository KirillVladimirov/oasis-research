    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">During pre-training, the model can take advantages of large-scale, web-crawled noisy data</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#abstractconcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
