    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Homogeneous Modalities</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modalities of the same type, such as images captured from two different cameras.</skos:skos_definition>
