    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of adapting a pre-trained model to specific tasks or data, often involving techniques like LoRA or SFT.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0018</hasCQ>
