    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A training strategy for multimodal models that uses instruction-following data, including negative instructions, to encourage responses faithful to image content.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0150</hasCQ>
