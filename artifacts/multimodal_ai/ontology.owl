    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">for zero-shot, and 62.0 vs 73.8 on fine-tuned.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#vision_model">
