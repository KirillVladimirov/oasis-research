    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero-Shot Transfer</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2406.09412_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M i C o -Chat-7B also delivers significantly impressive performances on both zero-shot caption and QA tasks</hasEvidenceText>
  </rdf:Description>
