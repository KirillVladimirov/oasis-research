    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter that determines the balance between the convergence speed of the model and the consumption of computational resources.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0072</hasCQ>
