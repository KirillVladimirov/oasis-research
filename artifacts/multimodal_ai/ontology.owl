    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dataset containing interleaved or multiple images per sample, used to improve specific model skills.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0199</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0199</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2405.01483_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a model is fully pre-trained on a multi-image dataset, which demonstrates the necessity of learning multi-image skills</hasEvidenceText>
  </rdf:Description>
