    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0202</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2404.07973_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visual embeddings introduces a nuanced complexity. This is because the two types of images exhibit distinct characteristics.</hasEvidenceText>
  </rdf:Description>
