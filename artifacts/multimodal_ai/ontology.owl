    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A self-supervised learning task used during pretraining that is often agnostic to specific downstream applications.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0212</hasCQ>
