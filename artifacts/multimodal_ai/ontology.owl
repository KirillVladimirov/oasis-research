    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2509.02544_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interactive Annotation for Supervised Fine-tuning A key challenge in training agents from human-generated SFT data is that such data is typically off-policy</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#visual_positional_embeddings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
