    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A standard evaluation task or dataset focused on Visual Question Answering, including general, text-oriented, or medical variants.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0184</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2404.13046_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text-oriented Visual Question Answering (VQA) [ 17 , 18 ], general VQA [ 19 ]</hasEvidenceText>
  </rdf:Description>
