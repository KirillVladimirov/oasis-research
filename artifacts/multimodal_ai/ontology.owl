    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Poor Detection Result</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A failure mode where the model fails to accurately identify or extract relevant visual features or seed boxes.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0026</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0026</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2305.13786_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The failures are caused mainly by poor detection results since the tasks are temporal in nature, extracting seed boxes from the middle frame is not sufficient to solve the tasks</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#highresolutionpatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
