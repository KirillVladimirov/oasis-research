    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">for OCR benchmarks like DocVQA, the performance drop for the model with fewer visual tokens is substantial</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#dense_model">
