    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.04812_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the greater the learning difficulty of a negative pair, the more significant its role in the gradient update.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_18">
