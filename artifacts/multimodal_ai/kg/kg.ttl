    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A compression technique that reduces the number of visual tokens by applying a downsampling ratio."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0119"^^xsd:string .

:trainingdata a owl:Class ;
    rdfs:label "TrainingData"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0096"^^xsd:string,
        "CQ_S0_R1_0208"^^xsd:string ;
    :hasEvidenceChunk "2406.03496_rag::chunk_004"^^xsd:string,
        "2408.02629_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "High temporal consistency is a crucial characteristic required for the training data in text-to-video models."^^xsd:string,
        "supplementing additional text-only training data can mitigate this forgetting."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Data used to mitigate forgetting or retain knowledge during the model training process."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0096"^^xsd:string,
