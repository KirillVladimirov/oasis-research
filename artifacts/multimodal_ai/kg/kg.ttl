    :hasCQ "CQ_S0_R1_0077"^^xsd:string,
        "CQ_S0_R1_0174"^^xsd:string ;
    :hasEvidenceChunk "2403.09072_rag::chunk_005"^^xsd:string,
        "2412.03069_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Can one single image tokenizer derive representations suitable for both multimodal understanding and generation?"^^xsd:string,
        "this approach directly links the visual tokenizer with the language vocabulary"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A mechanism that derives representations from images, often used for both multimodal understanding and generation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0077"^^xsd:string,
        "CQ_S0_R1_0174"^^xsd:string .

:vqa_benchmark a owl:Class ;
