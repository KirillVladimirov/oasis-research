    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A standardized dataset or evaluation suite used to measure the performance of models on Visual Question Answering tasks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0152"^^xsd:string .

:zero_shot_transfer a owl:Class ;
    rdfs:label "Zero-Shot Transfer"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0021"^^xsd:string,
        "CQ_S0_R1_0068"^^xsd:string ;
    :hasEvidenceChunk "2103.00020_rag::chunk_009"^^xsd:string,
        "2103.00020_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "studying the task-learning capabilities of language models via zero-shot transfer."^^xsd:string,
        "zero-shot transfer, as opposed to few-shot transfer, is a meaningful evaluation for difcult tasks that a learner has no prior experience with"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A meaningful evaluation for difficult tasks that a learner has no prior experience with, focusing on task-learning capabilities without supervised adaptation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0021"^^xsd:string,
        "CQ_S0_R1_0068"^^xsd:string .

:zeroshotmultimodalclassifier a owl:Class ;
