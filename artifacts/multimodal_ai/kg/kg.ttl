    :hasCQ "CQ_S0_R1_0227"^^xsd:string ;
    :hasEvidenceChunk "2501.08282_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "positional embeddings for the visual feature"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The representation of visual information that is modulated or aligned using embeddings."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0227"^^xsd:string .

:visual_patch a owl:Class ;
    rdfs:label "Visual Patch"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0230"^^xsd:string ;
    :hasEvidenceChunk "2208.06366_rag::chunk_003"^^xsd:string,
        "2309.04669_rag::chunk_011"^^xsd:string ;
    :hasEvidenceText "For the i -th image patch, its quantized code is calculated"^^xsd:string,
        "the most informative patches based on the image content"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A localized segment or embedding of an image used as input for a transformer model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0230"^^xsd:string .

:visual_prompt a owl:Class ;
    rdfs:label "Visual Prompt"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0164"^^xsd:string ;
    :hasEvidenceChunk "2404.16006_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Certain tasks show improved performance with specific prompting methods, such as multi-image and coordinate-related tasks, as well as those involving visual referring prompts."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A prompting method involving images or coordinate-related tasks to improve model performance."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0164"^^xsd:string .

:visual_token a owl:Class ;
    rdfs:label "Visual Token"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0119"^^xsd:string,
        "CQ_S0_R1_0123"^^xsd:string,
        "CQ_S0_R1_0230"^^xsd:string ;
    :hasEvidenceChunk "2309.04669_rag::chunk_011"^^xsd:string,
        "2412.09604_rag::chunk_005"^^xsd:string,
        "2506.07138_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "the original Emu3 [ 91 ] tokenizer produces visual 4096 tokens"^^xsd:string,
        "tokenize all the patch embeddings into the visual tokens"^^xsd:string,
        "we explore the spatial redundancy among vision tokens and shorten the length of vision token"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Vision Token"^^xsd:string ;
    skos:skos_definition "Discrete units of visual information used in multimodal models, often characterized by spatial redundancy."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0119"^^xsd:string,
        "CQ_S0_R1_0123"^^xsd:string,
        "CQ_S0_R1_0230"^^xsd:string .

:weightsharingtransformer a owl:Class ;
    rdfs:label "WeightSharingTransformer"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0175"^^xsd:string ;
    :hasEvidenceChunk "2206.06488_rag::chunk_026"^^xsd:string ;
    :hasEvidenceText "Weight-sharing is also a common practice for simplifying multimodal Transformer models. Wen et al . [ 279 ] present a weight-sharing Transformer"^^xsd:string,
        "present a weight-sharing Transformer on top of the visual and textual encoders to align text and image."^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:altLabel "Weight-sharing Transformer"^^xsd:string ;
    skos:skos_definition "A transformer architecture that utilizes shared weights across different input streams to simplify the model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0175"^^xsd:string .

:well_annotated_data a owl:Class ;
    rdfs:label "Well-annotated Data"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0235"^^xsd:string ;
    :hasEvidenceChunk "2309.10020_rag::chunk_094"^^xsd:string ;
    :hasEvidenceText "requiring similarly smallscale, well-annotated data as the ones used in training task"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Small-scale, high-quality data used for task-specific fine-tuning."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0235"^^xsd:string .

:zero_shot_task a owl:Class ;
    rdfs:label "Zero-Shot Task"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0239"^^xsd:string ;
    :hasEvidenceChunk "2406.09412_rag::chunk_012"^^xsd:string ;
    :hasEvidenceText "zero-shot multimodal QA"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A task performed by a model without specific prior training or fine-tuning on that task's data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0239"^^xsd:string .

:zeroinitializedmechanism a owl:Class ;
    rdfs:label "ZeroInitializedMechanism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0087"^^xsd:string ;
    :hasEvidenceChunk "2402.12451_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "newly added layers are often combined with a zero-initialized tanh-gating mechanism to ensure that, upon initialization, the conditioned model acts as its original version."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A gating or initialization strategy used to ensure a model acts as its original version upon initialization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0087"^^xsd:string .

:zeroshotclipmodel a owl:Class ;
    rdfs:label "ZeroShotCLIPModel"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0149"^^xsd:string ;
    :hasEvidenceChunk "2103.00020_rag::chunk_020"^^xsd:string ;
    :hasEvidenceText "CLIP models, which are trained via natural language supervision on a very large dataset and are capable of high zero-shot performance"^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:skos_definition "CLIP models trained via natural language supervision capable of high zero-shot performance."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0149"^^xsd:string .

:zeroshottask a owl:Class ;
    rdfs:label "ZeroShotTask"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0145"^^xsd:string ;
    :hasEvidenceChunk "2102.12092_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "our model to be capable of zero-shot image-to-image translation controllable by natural language"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A downstream task or capability where a model is applied to data or translations it was not explicitly trained for, such as image-to-image translation via natural language."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0145"^^xsd:string .

