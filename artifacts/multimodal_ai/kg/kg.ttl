    :hasCQ "CQ_S0_R1_0176"^^xsd:string ;
    :hasEvidenceChunk "2103.00020_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "zero-shot transfer, as opposed to few-shot transfer, is a meaningful evaluation for difcult tasks that a learner has no prior experience with"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A classifier that performs zero-shot transfer to tasks without prior experience or labeled examples."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0176"^^xsd:string .

