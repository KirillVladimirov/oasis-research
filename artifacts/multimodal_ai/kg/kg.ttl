:alignmenttask a owl:Class ;
    rdfs:label "AlignmentTask"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0219"^^xsd:string ;
    :hasEvidenceChunk "2206.06488_rag::chunk_025"^^xsd:string ;
    :hasEvidenceText "imposing region (semantic parts such as objects) level alignment."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Tasks involving the mapping or matching of different modalities, such as region-level or image-text alignment."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0219"^^xsd:string .

:batchsize a owl:Class ;
    rdfs:label "BatchSize"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0072"^^xsd:string,
        "CQ_S0_R1_0130"^^xsd:string,
        "CQ_S0_R1_0229"^^xsd:string ;
    :hasEvidenceChunk "2208.10442_rag::chunk_004"^^xsd:string,
        "2404.06395_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Batch size determines the balance between the convergence speed of the model and the consumption of computational resources."^^xsd:string,
        "usually need a very large batch size 2 for pretraining, which brings more engineering challenges"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Batch Size"^^xsd:string ;
    skos:skos_definition "A parameter that determines the balance between the convergence speed of the model and the consumption of computational resources."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0072"^^xsd:string,
        "CQ_S0_R1_0130"^^xsd:string,
        "CQ_S0_R1_0229"^^xsd:string .

:benchmark a owl:Class ;
    rdfs:label "Benchmark"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0074"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0200"^^xsd:string ;
    :hasEvidenceChunk "2412.05271_rag::chunk_030"^^xsd:string,
        "2502.17422_rag::chunk_012"^^xsd:string ;
    :hasEvidenceText "is a benchmark designed to evaluate hallucinations in MLLMs."^^xsd:string,
        "is a benchmark designed to evaluate hallucinations in MLLMs. It includes 96 challenging questions derived from images"^^xsd:string,
        "maintaining the MLLMs performance on benchmarks with larger visual concepts."^^xsd:string ;
    rdfs:subClassOf :dataset,
        owl:Thing ;
    skos:skos_definition "A standardized tool or system designed to evaluate the performance or specific behaviors of models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0074"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0200"^^xsd:string .

:clipimageencoder a owl:Class ;
    rdfs:label "CLIPImageEncoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0186"^^xsd:string ;
    :hasEvidenceChunk "2411.02571_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "integrates a CLIP image encoder, LLM and a vision-language MLP projector"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A component within a multimodal architecture responsible for encoding visual information using CLIP-based weights."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0186"^^xsd:string .

:crossattentionarchitecture a owl:Class ;
    rdfs:label "CrossAttentionArchitecture"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0112"^^xsd:string,
        "CQ_S0_R1_0155"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string ;
    :hasEvidenceChunk "2206.06488_rag::chunk_015"^^xsd:string,
        "2405.02246_rag::chunk_001"^^xsd:string,
        "2405.02246_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "compare the two architectures by freezing the unimodal backbones and training only the newly initialized parameters (cross-attention on one side"^^xsd:string,
        "the cross-attention architecture"^^xsd:string,
        "two-stream crossattention can learn cross-modal interaction"^^xsd:string,
        "use interleaved Transformer-based crossattentions to fuse the image information into the language model"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Cross-Attention Architecture"^^xsd:string ;
    skos:skos_definition "An architecture utilizing cross-attention blocks interleaved with language model layers to learn cross-modal interaction."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0112"^^xsd:string,
        "CQ_S0_R1_0155"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string .

:data_curation_technique a owl:Class ;
    rdfs:label "Data Curation Technique"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0033"^^xsd:string ;
    :hasEvidenceChunk "2311.15127_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "we introduce a systematic approach to curate video data at scale and present an empirical study on the effect of data curation"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A systematic approach or method used to organize, select, or refine data for training models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0033"^^xsd:string .

:dataaugmentation a owl:Class ;
    rdfs:label "DataAugmentation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0188"^^xsd:string,
        "CQ_S0_R1_0215"^^xsd:string ;
    :hasEvidenceChunk "2312.17172_rag::chunk_017"^^xsd:string,
        "2404.05083_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "autoregressive models face similar challenges, which can be improved with extensive data augmentation."^^xsd:string,
        "we utilize data augmentation to enlarge the minor differences between semantically similar data for enhancing the quality of datasets."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A technique used to improve model performance and handle challenges in object detection and image processing."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0188"^^xsd:string,
        "CQ_S0_R1_0215"^^xsd:string .

:description a owl:Class ;
    rdfs:label "Description"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0108"^^xsd:string ;
    :hasEvidenceChunk "2306.13549_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "The descriptions attached to the images thus serve as captions."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The textual component attached to an image serving as a caption in a multimodal pair."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0108"^^xsd:string .

:distributionshift a owl:Class ;
    rdfs:label "DistributionShift"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0105"^^xsd:string,
        "CQ_S0_R1_0149"^^xsd:string ;
    :hasEvidenceChunk "2103.00020_rag::chunk_023"^^xsd:string ;
    :hasEvidenceText "Zero-shot CLIP is much more robust to distribution shift than standard ImageNet models."^^xsd:string,
        "Zero-shot CLIP models shrink this robustness gap by up to 75%."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Variations in data distribution, such as out-of-distribution visual data or natural image distributions different from the training set."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0105"^^xsd:string,
        "CQ_S0_R1_0149"^^xsd:string .

:finetuning a owl:Class ;
    rdfs:label "FineTuning"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0018"^^xsd:string,
        "CQ_S0_R1_0068"^^xsd:string,
        "CQ_S0_R1_0126"^^xsd:string ;
    :hasEvidenceChunk "2403.09611_rag::chunk_015"^^xsd:string,
        "2404.01322_rag::chunk_018"^^xsd:string,
        "2501.15368_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Few-shot Chain-of-Thought Reasoning after SFT. As seen in Section 3.3, MM1 gains few-shot capabilities thanks to interleaved data."^^xsd:string,
        "Full finetuning involves adjusting all parameters of a pre-trained model"^^xsd:string,
        "Med-PaLM fine-tunes the PaLM-E model with millions of samples, optimizing it for medic"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Fine-Tuning"^^xsd:string ;
    skos:skos_definition "The process of adapting a pre-trained model to specific tasks or data, often involving techniques like LoRA or SFT."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0018"^^xsd:string,
        "CQ_S0_R1_0068"^^xsd:string,
        "CQ_S0_R1_0126"^^xsd:string .

:imagecaption a owl:Class ;
    rdfs:label "ImageCaption"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0118"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string ;
    :hasEvidenceChunk "2304.10592_rag::chunk_006"^^xsd:string,
        "2409.15272_rag::chunk_012"^^xsd:string ;
    :hasEvidenceText "potential noise in the generated image captions"^^xsd:string,
        "we manually verify the correctness of each image description to guarantee its high quality."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A textual description of an image, which can be generated automatically or by humans."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0118"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string .

:instruction_tuning_dataset a owl:Class ;
    rdfs:label "Instruction Tuning Dataset"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0029"^^xsd:string,
        "CQ_S0_R1_0064"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string ;
    :hasEvidenceChunk "2306.04387_rag::chunk_002"^^xsd:string,
        "2306.04387_rag::chunk_011"^^xsd:string,
        "2404.09624_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "The column Used indicates whether we use this dataset in the instruction tuning stage."^^xsd:string,
        "The existing instruction tuning datasets are mainly constructed for general visual tasks"^^xsd:string,
        "reformats a series of visual classification tasks into an instruction-tuning format"^^xsd:string,
        "transformed 13 visionlanguage tasks ( e.g. OCR-VQA [ 44 ]) into the instruction-following format for instruction tuning."^^xsd:string ;
    rdfs:subClassOf :multimodal_dataset,
        owl:Thing ;
    skos:skos_definition "A dataset specifically curated for the instruction tuning stage of model training, often characterized by smaller sample sizes compared to pretraining corpora."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0029"^^xsd:string,
        "CQ_S0_R1_0064"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string .

