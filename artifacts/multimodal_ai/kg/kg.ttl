:negativesample a owl:Class ;
    rdfs:label "NegativeSample"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0139"^^xsd:string,
        "CQ_S0_R1_0183"^^xsd:string,
        "CQ_S0_R1_0229"^^xsd:string ;
    :hasEvidenceChunk "2309.10020_rag::chunk_022"^^xsd:string ;
    :hasEvidenceText "These samples can be maintained in a memory bank ( Wu et al. , 2018 ), or directly from the current batch"^^xsd:string,
        "a caveat of contrastive learning is the requirement of a large number of negative samples."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Negative Samples"^^xsd:string ;
    skos:skos_definition "Samples used in contrastive learning that do not originate from the same source as the query, often requiring large quantities for effective training."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0139"^^xsd:string,
        "CQ_S0_R1_0183"^^xsd:string,
        "CQ_S0_R1_0229"^^xsd:string .

:object_hallucination a owl:Class ;
    rdfs:label "Object Hallucination"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0150"^^xsd:string ;
