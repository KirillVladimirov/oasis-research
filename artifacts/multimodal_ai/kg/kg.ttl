    :hasCQ "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0152"^^xsd:string ;
    :hasEvidenceChunk "2308.12966_rag::chunk_006"^^xsd:string,
        "2310.03744_rag::chunk_001"^^xsd:string,
        "2412.05271_rag::chunk_025"^^xsd:string ;
    :hasEvidenceText "InfographicVQA is a dataset aimed at evaluating models ability to interpret and reason"^^xsd:string,
        "InstructBLIP excels in traditional VQA benchmarks that demands singleword or short answers."^^xsd:string,
