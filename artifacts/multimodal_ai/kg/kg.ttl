    :hasCQ "CQ_S0_R1_0061"^^xsd:string ;
    :hasEvidenceChunk "2503.04812_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "the gradients of the negative pairs are proportional to the product r ( q i , t j )"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
