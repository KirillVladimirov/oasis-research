        "2311.11860_rag::chunk_001"^^xsd:string,
        "2412.05271_rag::chunk_031"^^xsd:string ;
    :hasEvidenceText "POPE is a benchmark for evaluating object hallucination in MLLMs"^^xsd:string,
        "conditions LMMs to speculate on uncertain content."^^xsd:string,
        "the insufficient visual information misleads MLLMs to provide erroneous and hallucinated responses."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A category of hallucination specifically concerning the presence or identification of objects, often evaluated by benchmarks like POPE."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0150"^^xsd:string .

