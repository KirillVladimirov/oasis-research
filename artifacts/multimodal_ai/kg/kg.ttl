:annotationbudget a owl:Class ;
    rdfs:label "AnnotationBudget"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing .

:boundingbox a owl:Class ;
    rdfs:label "BoundingBox"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0134"^^xsd:string,
        "CQ_S0_R1_0210"^^xsd:string ;
    :hasEvidenceChunk "2306.14824_rag::chunk_004"^^xsd:string,
        "2306.14824_rag::chunk_006"^^xsd:string,
        "2308.12966_rag::chunk_003"^^xsd:string,
        "2311.11860_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "For any given bounding box, a normalization process is applied (within the range [0, 1000)) and transformed into a specified string format"^^xsd:string,
        "The bounding box can be represented using its top-left point ( x 1 , y 1 ) and bottom-right point ( x 2 , y 2 )."^^xsd:string,
        "the position of an object phrase is presented in the format of bounding box [ x min , y min , x max , y max ]"^^xsd:string,
        "we construct grounded instruction data by utilizing the pairs of bounding boxes and expressions"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Bounding Box"^^xsd:string ;
    skos:skos_definition "A structured signal representing a spatial region, often normalized and transformed into a specified string format for model processing."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0134"^^xsd:string,
        "CQ_S0_R1_0210"^^xsd:string .

