    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2011.06465_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explicit prosody features (e.g., pitch, duration, energy) for variation modeling</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the prosody of an utterance is represented as a sequence of prosody features instead of a single sentencelevel prosody feature.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#stochastic_duration_predictor">
