    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collection of data samples used to train a model, where variety in content affects performance.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0098</hasCQ>
