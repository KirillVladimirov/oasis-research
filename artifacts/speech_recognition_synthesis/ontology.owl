    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incoming audio is processed using energy normalization, spectrogram featurization, log compression</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#vocabulary_size">
