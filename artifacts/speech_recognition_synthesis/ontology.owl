    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A high-dimensional optimization problem characterized by expensive evaluations and a mixture of discrete and continuous variables.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0093</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0093</prov:wasDerivedFrom>
