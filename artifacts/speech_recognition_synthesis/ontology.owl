    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A language characterized by a limited amount of available training data, often less than 1000 hours in large-scale datasets.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0148</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0178</hasCQ>
