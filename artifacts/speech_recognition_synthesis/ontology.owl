    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Models or components that require specific pronunciation or language information tied to a particular identity during inference.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0023</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0023</prov:wasDerivedFrom>
