    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tacotron 2, which combined an attention-based encoder-decoder model predicting a mel-spectrogram given a character sequence</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#streaming_e2e_model">
