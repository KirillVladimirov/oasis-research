    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Speaker diarization is the process of partitioning an input audio stream into homogeneous segments according to the speaker identity.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Speaker diarization is the process of partitioning an input audio stream into homogeneous segments according to the speaker identity. It answers the question who spoke when in a multi-speaker environment.</hasEvidenceText>
  </rdf:Description>
