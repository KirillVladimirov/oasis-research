    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">systems refers to end-to-end differentiable and trainable neural networks, in contrast to modular systems with separate acoustic models, language models and token passing decoders.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#evaluatedby">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
