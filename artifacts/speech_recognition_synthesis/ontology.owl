    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The specific acquisition or adaptation method used by a TTS system to target speaker characteristics.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0084</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0124</hasCQ>
