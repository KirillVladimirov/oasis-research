    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The impact (improvement or worsening) of applying SpecAugment on the model's performance metrics like WER.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0207</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0207</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2111.02674_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chaining VC with SpecAugment, on the other hand, worsens performance.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#rnn_lm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
