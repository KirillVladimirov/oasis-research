    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End-to-end differentiable and trainable neural networks for speech recognition, in contrast to modular systems.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0208</hasCQ>
