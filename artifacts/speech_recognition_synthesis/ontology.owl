    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type of voice conversion that aims to perform conversion on unseen speakers without specific training on those target identities.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0019</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0206</hasCQ>
