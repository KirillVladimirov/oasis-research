    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1711.01694_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1711.01694_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conditioning the joint model on the language ID, there is no confusion between languages. What does the conditioned model output for mismatched language ID?</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For all conditional models, we use a 5-dimensional language embedding.</hasEvidenceText>
  </rdf:Description>
