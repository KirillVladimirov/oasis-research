    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An augmentation technique that converts ASR from an over-fitting to an under-fitting problem by augmenting the training set using handcrafted policies.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0011</hasCQ>
