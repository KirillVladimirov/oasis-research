    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0168</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1803.09017_rag::chunk_009</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p -values are given for both a 3-point and 7-point rating system.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
