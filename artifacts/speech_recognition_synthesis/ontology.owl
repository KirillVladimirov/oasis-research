    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1702.06378_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">train a text prediction (TP) module to generate the prosody embedding</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vocoder generator which generates the waveform.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the latter classies each frame as either an output symbol or a continuation of the previous label</hasEvidenceText>
  </rdf:Description>
