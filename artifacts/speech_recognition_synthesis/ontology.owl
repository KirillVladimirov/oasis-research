    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A model unit obtained by tokenization algorithms like BPE or WordPiece used in speech recognition systems.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0198</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0198</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1807.04978_rag::chunk_005</hasEvidenceChunk>
