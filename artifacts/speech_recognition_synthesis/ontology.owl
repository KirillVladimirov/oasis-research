    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0047</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2204.10749_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WER-relative is rather invariant of utterance length for both test sets, even for utterances with a few hundred words (a few minutes). This suggests that E2E segmentation can be applied more widely to medium-form utterances as well.</hasEvidenceText>
  </rdf:Description>
