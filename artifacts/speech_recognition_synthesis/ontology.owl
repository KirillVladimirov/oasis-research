    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An algorithm that iteratively merges the most frequent pairs of units to create a set of subword units.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0079</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0079</prov:wasDerivedFrom>
