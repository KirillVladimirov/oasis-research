    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a series of models are trained in succession, such that for each model, the preceding model in the series serves as a</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_367">
