    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process where a teacher model provides knowledge to a student model via probability density distillation.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0135</hasCQ>
