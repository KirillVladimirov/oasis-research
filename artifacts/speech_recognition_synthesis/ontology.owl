    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The total number of unique symbols or words that a language model is parameterized to recognize or predict.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0176</hasCQ>
