    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2204.09911_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incurs an algorithmic latency of 32 ms in an online setup</hasEvidenceText>
  </rdf:Description>
