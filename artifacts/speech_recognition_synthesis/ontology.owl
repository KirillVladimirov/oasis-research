    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mechanism used to measure the quality or reliability of model outputs, often evaluated using AUC.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0101</hasCQ>
