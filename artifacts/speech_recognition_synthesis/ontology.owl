    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Most frequent deletion and insertion errors for humans and ASR system</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#matches">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#softalignment"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#hardalignment"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matches</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of minimizing the gap between soft and hard alignment representations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0127</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0127</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2108.10447_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forcing A soft to match A hard as much as possible by minimizing their KL-divergence.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#learningrate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
