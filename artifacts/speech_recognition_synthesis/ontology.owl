    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An attention mechanism enhanced by positional encodings, often used in production-quality TTS systems.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0036</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0036</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1710.07654_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overall, positional encodings improve the convolutional attention mechanism.</hasEvidenceText>
  </rdf:Description>
