    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The inclusion of specific phone types (e.g., vowels, stops) within a broader phonetic class or subset.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0217</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0217</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phdthesis-drew_rag::chunk_105</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">four phone subsets: v o w els/semiv o w els, nasals/aps, stops, and fricativ es/closures.</hasEvidenceText>
  </rdf:Description>
