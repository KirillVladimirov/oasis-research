    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mapping-based methods</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A category of learning models where the target is a representation extracted straightforwardly from clean speech.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0030</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0030</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1705.10874_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the techniques can be categorised into i) mapping-based methods, where x is the representation, straightforwardly extracted from clean speech</hasEvidenceText>
  </rdf:Description>
