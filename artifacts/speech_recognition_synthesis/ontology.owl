    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1412.5567_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1412.5567_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We have presented an end-to-end deep learning-based speech system capable of outperforming existing state-of-the-art recognition pipelines</hasEvidenceText>
