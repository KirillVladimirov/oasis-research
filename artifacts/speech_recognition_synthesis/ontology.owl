    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The performance of the decoding process, often measured by metrics such as Character Error Rate (CER).</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0212</hasCQ>
