    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1812.04342_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2011.06465_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1803.09017_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VAE, which explicitly models latent variables</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VAE has many merits, such as learning disentangled factors</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ne-grained prosody modeling [5], where the prosody of an utterance is represented as a sequence of prosody features</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To deliver true human-like speech, a TTS system must learn to model prosody.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#system_mos">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
