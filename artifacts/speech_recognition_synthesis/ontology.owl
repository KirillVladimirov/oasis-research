    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2204.10020_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Text-to-Speech (TTS) systems have signicantly advanced in recent years with deep learning</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a cross-speaker style transfer method via voice conversion (VC) enables expressive TTS systems to be built</hasEvidenceText>
  </rdf:Description>
