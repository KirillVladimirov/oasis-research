:alignment_mechanism a owl:Class ;
    rdfs:label "Alignment Mechanism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0020"^^xsd:string ;
    :hasEvidenceChunk "1910.10288_rag::chunk_001"^^xsd:string,
        "2108.10447_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "an alignment mechanism or a duration source that maps the encoder states to decoder inputs"^^xsd:string,
        "to align the target text with the output spectrogram."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A component or method used to map text inputs or encoder states to speech outputs, spectrograms, or decoder inputs."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0020"^^xsd:string .

:annotationbudget a owl:Class ;
    rdfs:label "AnnotationBudget"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing .

:attentionslidingwindow a owl:Class ;
    rdfs:label "AttentionSlidingWindow"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0071"^^xsd:string,
        "CQ_S0_R1_0179"^^xsd:string ;
    :hasEvidenceChunk "2006.04664_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "We introduce an attention sliding window in the text side and compute the attention weights only within this window."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A mechanism in the autoregressive generation process that restricts attention weights to a specific range on the text side."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0071"^^xsd:string,
        "CQ_S0_R1_0179"^^xsd:string .

:audio_embedding a owl:Class ;
    rdfs:label "Audio Embedding"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0039"^^xsd:string ;
    :hasEvidenceChunk "1710.10468_rag::chunk_007"^^xsd:string,
        "1904.03479_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "speaker embedding encodes a variable-length utterance into a x-length vector representing the speaker characteristics."^^xsd:string,
        "we combined LSTM-based d-vector audio embeddings with recent work in non-parametric clustering to obtain a state-of-the-art speaker diarization system."^^xsd:string ;
    rdfs:subClassOf :representation,
        owl:Thing ;
    skos:skos_definition "A representation that encodes a variable-length utterance into a fixed-length vector representing speaker characteristics, used as a component in diarization."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0039"^^xsd:string .

:audiopacket a owl:Class ;
    rdfs:label "AudioPacket"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0173"^^xsd:string,
        "CQ_S0_R1_0189"^^xsd:string ;
    :hasEvidenceChunk "1705.04400_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Audio is typically sent over the network in packets of short durations"^^xsd:string,
        "Audio is typically sent over the network in packets of short durations ( e.g., 50 200 ms)."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Audio Packet"^^xsd:string ;
    skos:skos_definition "A short duration segment of audio data sent over a network in streaming conditions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0173"^^xsd:string,
        "CQ_S0_R1_0189"^^xsd:string .

:audiosample a owl:Class ;
    rdfs:label "AudioSample"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0167"^^xsd:string ;
    :hasEvidenceChunk "1612.07837_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "NLL (bits per audio sample) computed on the Blizzard validation set"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A segment or instance of audio data, such as a recording or synthetic generation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0167"^^xsd:string .

:confidenceestimation a owl:Class ;
    rdfs:label "ConfidenceEstimation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0065"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string ;
    :hasEvidenceChunk "1910.11933_rag::chunk_001"^^xsd:string,
        "2010.11428v2_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "To take LM information for condence estimation, the input to the CEM is extended by the LM probability"^^xsd:string,
        "To take LM information for condence estimation, the input to the CEM is extended by the LM probability for the current token."^^xsd:string,
        "condence estimation, a measure commonly used to assess transcription reliability."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Confidence Estimation"^^xsd:string ;
    skos:skos_definition "The process of measuring the certainty of a model's predictions, used to filter or select data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0065"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string .

:decoding a owl:Class ;
    rdfs:label "Decoding"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0007"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string ;
    :hasEvidenceChunk "1706.02737_rag::chunk_001"^^xsd:string,
        "1707.07167_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "During decoding, with the help of a trigram LM that was trained using 4M voice search entries, further gains can be observed."^^xsd:string,
        "Finally, these modules are integrated into a Weighted Finite-State Transducer (WFST) for efcient decoding."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "DecodingProcess"^^xsd:string ;
    skos:skos_definition "The process of integrating modules like language models and pronunciation dictionaries to generate output in ASR."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0007"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string .

:emotiontransfertts a owl:Class ;
    rdfs:label "EmotionTransferTTS"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0133"^^xsd:string ;
    :hasEvidenceChunk "2109.06733_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "emotion transfer task in text-tospeech (TTS) synthesis particularly aims to synthesize speech for a target speaker with the emotion transferred from reference speech recorded by another (source) speaker."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A text-to-speech synthesis task aiming to synthesize speech for a target speaker with the emotion transferred from reference speech recorded by another speaker."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0133"^^xsd:string .

:high_fidelity_neural_vocoder a owl:Class ;
    rdfs:label "High-Fidelity Neural Vocoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0164"^^xsd:string ;
    :hasEvidenceChunk "2210.15533_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "SOURCE-FILTER HIFI-GAN: FAST AND PITCH CONTROLLABLE HIGH-FIDELITY NEURAL VOCODER"^^xsd:string ;
    rdfs:subClassOf :neural_vocoder,
        owl:Thing ;
    skos:skos_definition "A neural vocoder designed to achieve high voice quality, often involving complex architectures like source-filter networks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0164"^^xsd:string .

:hyperparameteroptimization a owl:Class ;
    rdfs:label "HyperParameterOptimization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0093"^^xsd:string ;
    :hasEvidenceChunk "2002.01953_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "a target speaker is a difcult high-dimensional hyper-parameter optimization (HPO) problem. As is common in HPO, this optimization task is characterized by expensive evaluations"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A high-dimensional optimization problem characterized by expensive evaluations and a mixture of discrete and continuous variables."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0093"^^xsd:string .

:neural_vocoder a owl:Class ;
    rdfs:label "Neural Vocoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0169"^^xsd:string ;
    :hasEvidenceChunk "2105.09856_rag::chunk_001"^^xsd:string,
        "2108.04051_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "A neural vocoder [1, 2, 3] utilizes a neural network model to synthesize speech waveform samples from higher-level input conditioning"^^xsd:string,
        "In neural speech coders a generative neural network plays the role of the decoder (i.e., neural vocoder)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A model that utilizes a neural network to synthesize speech waveform samples from higher-level input conditioning."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0164"^^xsd:string,
        "CQ_S0_R1_0169"^^xsd:string .

:phone a owl:Class ;
    rdfs:label "Phone"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string ;
    :hasEvidenceChunk "2002.03785_rag::chunk_007"^^xsd:string,
        "phdthesis-drew_rag::chunk_022"^^xsd:string,
        "phdthesis-drew_rag::chunk_042"^^xsd:string ;
    :hasEvidenceText "a partitioning of the phones in to subsets w as c hosen."^^xsd:string,
        "phone is e . calculated and scaled to lie in a similar range."^^xsd:string,
        "ts of three phones (V{S{V) or four phones (V{F{S{V and V{N{S{V) w ere presen ted to the listener."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Individual speech sounds that form sequences used in training classifiers or evaluating listener perception."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string .

:phonetic_class a owl:Class ;
    rdfs:label "Phonetic Class"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string ;
    :hasEvidenceChunk "phdthesis-drew_rag::chunk_026"^^xsd:string,
        "phdthesis-drew_rag::chunk_105"^^xsd:string ;
    :hasEvidenceText "expanding the usual MAP deco ding o v er a set of phonetic classes"^^xsd:string,
        "w e ha v e partitioned the phones in to three broad classes: sonoran ts (SON), obstruen ts (OBS), and silences (SIL)."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A broad grouping of phones based on shared acoustic or articulatory characteristics, such as sonorants or obstruents."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0027"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string .

:prosodyfeature a owl:Class ;
    rdfs:label "ProsodyFeature"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0051"^^xsd:string,
        "CQ_S0_R1_0239"^^xsd:string ;
    :hasEvidenceChunk "2011.06465_rag::chunk_001"^^xsd:string,
        "2106.15561_rag::chunk_040"^^xsd:string ;
    :hasEvidenceText "explicit prosody features (e.g., pitch, duration, energy) for variation modeling"^^xsd:string,
        "the prosody of an utterance is represented as a sequence of prosody features instead of a single sentencelevel prosody feature."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Prosody Feature"^^xsd:string ;
    skos:skos_definition "A sequence of features representing the prosody of an utterance, often associated with speech segments like phonemes or words."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0051"^^xsd:string,
        "CQ_S0_R1_0239"^^xsd:string .

:selfattentionmechanism a owl:Class ;
    rdfs:label "SelfAttentionMechanism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0231"^^xsd:string ;
    :hasEvidenceChunk "2110.05069_rag::chunk_001"^^xsd:string,
        "2209.03143_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "self-attention [15], which is suitable for modeling rich and complex long-range dependencies"^^xsd:string,
        "selfattention layers [1]. Each layer relies on calculating a distance between each pair of items from the input sequence."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A mechanism suitable for modeling rich and complex long-range dependencies by calculating distances between pairs of items in a sequence."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0231"^^xsd:string .

:speakerembedding a owl:Class ;
