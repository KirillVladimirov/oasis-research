:acoustic_model a owl:Class ;
    rdfs:label "Acoustic Model"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0003"^^xsd:string,
        "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0029"^^xsd:string,
        "CQ_S0_R1_0038"^^xsd:string,
        "CQ_S0_R1_0057"^^xsd:string,
        "CQ_S0_R1_0061"^^xsd:string,
        "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0155"^^xsd:string,
        "CQ_S0_R1_0157"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string,
        "CQ_S0_R1_0214"^^xsd:string ;
    :hasEvidenceChunk "1702.06378_rag::chunk_007"^^xsd:string,
        "1705.10874_rag::chunk_018"^^xsd:string,
        "1707.06065v1_rag::chunk_001"^^xsd:string,
        "1910.05453_rag::chunk_006"^^xsd:string,
        "2106.12896_rag::chunk_002"^^xsd:string,
        "2106.15561_rag::chunk_003"^^xsd:string,
        "2106.15561_rag::chunk_006"^^xsd:string,
        "2106.15561_rag::chunk_012"^^xsd:string,
        "2110.12612_rag::chunk_002"^^xsd:string,
        "2110.12612_rag::chunk_008"^^xsd:string,
        "2204.09934_rag::chunk_005"^^xsd:string,
        "Mon-2-7-1_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "(a.k.a. acoustic model) aims to generate prosodic attributes according to variance prediction"^^xsd:string,
        "Acoustic models generate acoustic features, from either linguistic features or characters/phonemes"^^xsd:string,
        "For decoding the emissions from the acoustic model on WSJ we use a lexicon as well as a separate language model"^^xsd:string,
        "The resulting TTS model is comprised of two main components: 1) an acoustic model"^^xsd:string,
        "We apply our proposed DLN to deep bidirectional LSTM acoustic models"^^xsd:string,
        "We mainly review the acoustic models according to different network structures such as RNN, CNN and Transformer"^^xsd:string,
        "We use wav2letter as accoustic model (Collobert et al., 2016; 2019) and train for 1,000 epochs"^^xsd:string,
        "We use wav2letter as accoustic model (Collobert et al., 2016; 2019) and train for 1,000 epochs on 8 GPUs for both TIMIT and WSJ"^^xsd:string,
        "a good tradeoff of the task difculties between the acoustic model and the HiFiNet vocoder"^^xsd:string,
        "acoustic model needs to close the large gap between text and spectrogram"^^xsd:string,
        "acoustic model needs to close the large gap between text and spectrogram, such as duration, pitch, formant, voiced/unvoiced part, prosody, etc."^^xsd:string,
        "acoustic model) aims to generate prosodic attributes according to variance prediction"^^xsd:string,
        "applied to build the acoustic models for voice conversion"^^xsd:string,
        "employing the enhanced speech obtained in the front end to re-train the pre-trained AM in the back-end"^^xsd:string,
        "multitask learning improves recognition accuracies of both SRNN and CTC acoustic models"^^xsd:string,
        "predict the acoustic features from linguistic features, which follow the paradigm of SPSS."^^xsd:string,
        "the quality of the mel-spectrogram generated by acoustic model still has gap to recording due to the difculty of prosody modeling."^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:altLabel "AcousticModel"^^xsd:string ;
    skos:skos_definition "A module in the TTS pipeline that aims to generate prosodic attributes according to variance prediction or predict acoustic features from linguistic features."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0003"^^xsd:string,
        "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0024"^^xsd:string,
        "CQ_S0_R1_0029"^^xsd:string,
        "CQ_S0_R1_0038"^^xsd:string,
        "CQ_S0_R1_0057"^^xsd:string,
        "CQ_S0_R1_0061"^^xsd:string,
        "CQ_S0_R1_0066"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0155"^^xsd:string,
        "CQ_S0_R1_0157"^^xsd:string,
        "CQ_S0_R1_0202"^^xsd:string,
        "CQ_S0_R1_0214"^^xsd:string .

:audio_codec a owl:Class ;
    rdfs:label "Audio Codec"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0043"^^xsd:string ;
    :hasEvidenceChunk "1910.05453_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "Comparison of PER on the TIMIT dev set for various audio codecs"^^xsd:string,
        "Comparison of PER on the TIMIT dev set for various audio codecs and vq-wav2vec k-means"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A mechanism for audio compression and representation that impacts recognition accuracy based on bitrate."^^xsd:string ;
