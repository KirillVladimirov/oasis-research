    :hasCQ "CQ_S0_R1_0067"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0096"^^xsd:string,
        "CQ_S0_R1_0148"^^xsd:string,
