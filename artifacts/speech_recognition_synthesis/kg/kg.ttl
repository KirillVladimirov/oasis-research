:tts_system a owl:Class ;
    rdfs:label "TTS System"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0124"^^xsd:string,
        "CQ_S0_R1_0168"^^xsd:string,
        "CQ_S0_R1_0217"^^xsd:string ;
    :hasEvidenceChunk "1702.07825_rag::chunk_002"^^xsd:string,
        "1803.09017_rag::chunk_001"^^xsd:string,
        "2002.01953_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "As text-to-speech (TTS) models have rapidly improved, there is a growing opportunity for a number of applications"^^xsd:string,
        "none of these systems solve the entire problem of TTS"^^xsd:string,
        "text to speech (TTS) systems can learn to convincingly mimic speakers across a wide range of acoustic and phonetic styles."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A system that solves the problem of converting text to speech, often utilizing parametric audio synthesis or transformer-based architectures."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0124"^^xsd:string,
