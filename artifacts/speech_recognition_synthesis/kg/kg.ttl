        "2111.02674_rag::chunk_000"^^xsd:string,
        "2204.10020_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Generative models like variational autoencoder (VAE) [8, 9], generative adversarial networks (GAN) [10, 11] or Flow [12] are actively explored for the VC task as well."^^xsd:string,
        "Voice conversion (VC) could be used to improve speech recognition systems in low-resource languages by using it to augment limited training data."^^xsd:string,
        "a cross-speaker style transfer method via voice conversion (VC) enables expressive TTS systems to be built"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "VoiceConversion"^^xsd:string ;
