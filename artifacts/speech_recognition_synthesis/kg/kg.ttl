:vocoder a owl:Class ;
    rdfs:label "Vocoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0003"^^xsd:string,
        "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0131"^^xsd:string,
        "CQ_S0_R1_0221"^^xsd:string ;
    :hasEvidenceChunk "1807.07281_rag::chunk_002"^^xsd:string,
        "1910.06711_rag::chunk_001"^^xsd:string,
        "2106.02297_rag::chunk_000"^^xsd:string,
        "2106.15561_rag::chunk_006"^^xsd:string,
        "2110.12612_rag::chunk_002"^^xsd:string,
        "2204.09934_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "A conditional waveform generation module (a.k.a. vocoder) adds the phase information and synthesizes a detailed waveform."^^xsd:string,
        "Vocoders generate waveform from either linguistic features or acoustic features"^^xsd:string,
        "conditional waveform generation module (a.k.a. vocoder) adds the phase information and synthesizes a detailed waveform"^^xsd:string,
        "recent works on neural vocoder have improved the quality of synthesized audio"^^xsd:string,
        "the WORLD vocoder (MORISE et al., 2016) introduces an in"^^xsd:string,
        "they actually depend on a traditional vocoder ( Morise et al. , 2016 ), the Grifn-Lim algorithm ( Grifn and Lim , 1984 ), or a separately trained neural vocoder"^^xsd:string,
        "vocoder only need to recover phase information given ground-truth spectrogram"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A conditional waveform generation module that adds phase information and synthesizes a detailed waveform."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0003"^^xsd:string,
        "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0111"^^xsd:string,
        "CQ_S0_R1_0131"^^xsd:string,
        "CQ_S0_R1_0221"^^xsd:string .

