:accuracy_level a owl:DatatypeProperty ;
    rdfs:label "Accuracy Level"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0098"^^xsd:string ;
    :hasEvidenceChunk "1905.11796_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "we observe a decrease in the level of accuracy on downstream tasks"^^xsd:string ;
    rdfs:domain :self_supervised_model ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "CQ_S0_R1_0098"^^xsd:string .

:achievesrealtimegeneration a owl:DatatypeProperty ;
    rdfs:label "achievesRealtimeGeneration"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0135"^^xsd:string ;
    :hasEvidenceChunk "1910.11480_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "the IAF student can achieve realtime generation of speech"^^xsd:string ;
    rdfs:domain :studentmodel ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "CQ_S0_R1_0135"^^xsd:string .

:acoustic_feature a owl:Class ;
    rdfs:label "Acoustic Feature"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0032"^^xsd:string ;
    :hasEvidenceChunk "2106.15561_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "predict the acoustic features from linguistic features"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Features predicted from linguistic representations to generate speech waveforms."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0032"^^xsd:string .

:acoustic_feature_enhancement a owl:Class ;
    rdfs:label "Acoustic Feature Enhancement"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0209"^^xsd:string ;
    :hasEvidenceChunk "1910.11905_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "We consider acoustic feature enhancement as a solution to this problem. In the past decade, deep learning based enhancement has made great progress."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A solution to challenges in speaker verification involving deep learning based processing of acoustic signals."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0209"^^xsd:string .

:acousticautoencoder a owl:Class ;
    rdfs:label "AcousticAutoencoder"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0051"^^xsd:string ;
    :hasEvidenceChunk "2307.07218_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "We design an acoustic autoencoder that separately compresses the prosody and timbre information into the latent space"^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:skos_definition "A component that separately compresses prosody and timbre information into a latent space."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0051"^^xsd:string .

:activelearning a owl:Class ;
    rdfs:label "ActiveLearning"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0102"^^xsd:string ;
    :hasEvidenceChunk "1612.02695_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Discriminative training allows seq2seq models to focus on the most informative features."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Active Learning"^^xsd:string ;
    skos:skos_definition "A machine learning approach where the system selects informative samples for training, often involving confidence-based metrics."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0102"^^xsd:string .

:addresses a owl:ObjectProperty ;
    rdfs:label "addresses"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0142"^^xsd:string ;
    :hasEvidenceChunk "2111.02674_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "One possible solution is to use data augmentation: available data is processed so that it has different characteristics from the original while preserving the content (words spoken), effectively giving more trainin"^^xsd:string ;
    rdfs:domain :data_augmentation ;
    rdfs:range :low_resource_setting ;
    skos:skos_definition "Data augmentation is used as a solution for scenarios with minimal training data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0142"^^xsd:string .

:adversarialloss a owl:Class ;
    rdfs:label "AdversarialLoss"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0085"^^xsd:string ;
    :hasEvidenceChunk "1910.11480_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "investigated ClariNet with adversarial loss as a hybrid approach of GAN and density distillation"^^xsd:string ;
    rdfs:subClassOf :lossfunction,
        owl:Thing ;
    skos:skos_definition "A loss component used in hybrid training approaches, often balanced with other losses using weight coefficients."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0085"^^xsd:string .

:affects a owl:ObjectProperty ;
    rdfs:label "affects"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0212"^^xsd:string,
        "CQ_S0_R1_0239"^^xsd:string ;
    :hasEvidenceChunk "1707.07167_rag::chunk_005"^^xsd:string,
        "1808.01410_rag::chunk_001"^^xsd:string,
        "2106.15561_rag::chunk_040"^^xsd:string ;
    :hasEvidenceText "Prosody includes low-level characteristics such as pitch, stress, breaks, and rhythm, and impacts speaking style"^^xsd:string,
        "The effect of the decoding beam width for the contentba"^^xsd:string,
        "The expressiveness, controllability and transferability of TTS models rely on better variation information modeling."^^xsd:string ;
    rdfs:domain :prosodyfeature ;
    skos:skos_definition "The relationship where prosodic characteristics influence the higher-level style and expressiveness of the output."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0212"^^xsd:string,
        "CQ_S0_R1_0239"^^xsd:string .

