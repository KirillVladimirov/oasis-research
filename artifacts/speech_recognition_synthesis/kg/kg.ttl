:attention_mechanism a owl:Class ;
    rdfs:label "Attention Mechanism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0020"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string ;
    :hasEvidenceChunk "1703.04783_rag::chunk_002"^^xsd:string,
        "1807.04978_rag::chunk_001"^^xsd:string,
        "2106.15561_rag::chunk_030"^^xsd:string,
        "2108.10447_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Attention based methods solve this problem by training a decoder which emits labels depending on previous ones."^^xsd:string,
        "Autoregressive TTS models rely on the attention mechanism [8,9] to align text and speech, typically using content based attention mechanism"^^xsd:string,
        "includes selection of the reference microphone using an attention mechanism."^^xsd:string,
        "leverage position information as the query to attend the key and value from the encoder"^^xsd:string ;
    rdfs:subClassOf :alignment_mechanism,
        owl:Thing ;
    skos:skos_definition "A module used in encoder-decoder architectures to emit labels depending on previous ones, addressing independence assumptions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0020"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string .

:attentionbasedmodel a owl:Class ;
    rdfs:label "AttentionBasedModel"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0127"^^xsd:string,
        "CQ_S0_R1_0227"^^xsd:string ;
    :hasEvidenceChunk "1706.02737_rag::chunk_000"^^xsd:string,
        "1706.02737_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Attention-based ASR does not explicitly separate each module, but it implicitly combines acoustic models, lexicon, and language models as encoder, attention, and decoder networks"^^xsd:string,
        "Compared with CTC, attention-based models make predictions conditioned on all the previous predictions, and thus can learn language."^^xsd:string,
        "attention-based methods use an attention mechanism to perform alignment between acoustic frames and recognized symbols"^^xsd:string,
        "attention-based models make predictions conditioned on all the previous predictions, and thus can learn language."^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:skos_definition "A model that uses an attention mechanism to perform alignment and makes predictions conditioned on all previous predictions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0127"^^xsd:string,
        "CQ_S0_R1_0227"^^xsd:string .

