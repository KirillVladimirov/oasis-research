    kg:inPaper <http://example.org/kg/paper/2204_10749_rag> ;
    kg:textSpan "Naming convention is E2E- { eos threshold value } columns: yt_long_yt_short_segmenter | wer_eos50_eos75_seg | state_wer_eos50_eos75 | seg_state_a_b1_fixed_10s | 20_05_99_8 | 5496_13_63 | 33_9_3965_b2_fixed_20s_18_22 | 51_3 | 5753_11_57 | 17_5_4048 row: B3: VAD; yt_long_yt_short_segmenter=18.16; wer_eos50_eos75_seg=260; state_wer_eos50_eos75=490; seg_state_a_b1_fixed_10s=95.2; 20_05_99_8=8396; 5496_13_63=11.46; 33_9_3965_b2_fixed_20s_18_22=460; 51_3=660; 5753_11_57=28.3; 17_5_4048=5689 row: E1: E" .

<http://example.org/kg/chunk/1711_01567_rag__chunk_005> a kg:Chunk ;
    kg:chunkId "1711.01567_rag::chunk_005" ;
    kg:docId "1711.01567_rag" ;
    kg:inPaper <http://example.org/kg/paper/1711_01567_rag> ;
    kg:textSpan "hypothesize that the initial encoder embedding is of poor quality and encouraging invariance at this stage through the critic gradients signicantly hinders seq-to-seq training. 6. CONCLUSION We introduced a GAN-based framework to train robust ASR models in a scalable, data-driven way, and showed that inducing invariance at the encoder embedding level considerably improves the recognition of simulated far-eld speech by vanilla seq-to-seq models. This method has effectively imbued the seq-to-seq e" .

