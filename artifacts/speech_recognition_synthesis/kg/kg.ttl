:data_augmentation a owl:Class ;
    rdfs:label "Data Augmentation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0011"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0142"^^xsd:string,
        "CQ_S0_R1_0196"^^xsd:string,
        "CQ_S0_R1_0207"^^xsd:string ;
    :hasEvidenceChunk "1904.08779_rag::chunk_000"^^xsd:string,
        "1904.08779_rag::chunk_001"^^xsd:string,
        "2110.02360_rag::chunk_003"^^xsd:string,
        "2111.02674_rag::chunk_001"^^xsd:string,
        "2204.10020_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Data augmentation has been proposed as a method to generate additional training data"^^xsd:string,
        "Data augmentation has been proposed as a method to generate additional training data for ASR."^^xsd:string,
        "Most recently, data augmentation techniques have been successfully applied in low-resource scenarios"^^xsd:string,
        "One possible solution is to use data augmentation: available data is processed so that it has different characteristics from the original while preserving the content"^^xsd:string,
        "SpecAugment: A Simple Data Augmentation Method for Automatic Speech Recognition"^^xsd:string,
        "We are thus able to apply SpecAugment online during training. SpecAugment consists of three kinds of deformations"^^xsd:string,
        "we propose a novel augmentation to improve pitch-shifting performance."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Data Augmentation Method"^^xsd:string,
        "Data Augmentation Technique"^^xsd:string,
        "DataAugmentation"^^xsd:string ;
    skos:skos_definition "A method to generate additional training data where available data is processed to have different characteristics while preserving content."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0011"^^xsd:string,
        "CQ_S0_R1_0046"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0142"^^xsd:string,
        "CQ_S0_R1_0196"^^xsd:string,
        "CQ_S0_R1_0207"^^xsd:string .

