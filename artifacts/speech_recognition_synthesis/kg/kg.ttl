        "CQ_S0_R1_0043"^^xsd:string .

:speaker_verification a owl:Class ;
    rdfs:label "Speaker Verification"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0006"^^xsd:string,
        "CQ_S0_R1_0045"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0177"^^xsd:string,
        "CQ_S0_R1_0196"^^xsd:string,
        "CQ_S0_R1_0226"^^xsd:string ;
    :hasEvidenceChunk "1705.09422_rag::chunk_002"^^xsd:string,
        "1710.10467_rag::chunk_006"^^xsd:string,
        "1710.10467_rag::chunk_007"^^xsd:string,
        "1710.10468_rag::chunk_000"^^xsd:string,
        "1904.03479_rag::chunk_001"^^xsd:string,
        "1912.02522_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Applications of speaker recognition are many and varied, ranging from authentication in high-security systems and forensic tests"^^xsd:string,
        "DNNs have been utilized as feature extractors which are then used to create speaker models for the SV process."^^xsd:string,
        "Enabling speaker verication on multiple keywords falls between TD-SV and TI-SV"^^xsd:string,
        "Speaker verication is an open-set recognition problem. An utterance is veried to be a certain speaker if their similarity exceeds a threshold."^^xsd:string,
        "Text-Dependent Speaker Verication"^^xsd:string,
        "speakers with an average of 4 . 5 enrollment utterances and 10 evaluation utterances per speaker."^^xsd:string,
        "train an LSTM-based text-independent speaker verication model"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "SpeakerVerification"^^xsd:string,
        "SpeakerVerificationSystem"^^xsd:string ;
    skos:skos_definition "A process or system (SV) used to verify the identity of a speaker, often utilizing deep neural networks as feature extractors to create speaker models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0006"^^xsd:string,
        "CQ_S0_R1_0045"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0177"^^xsd:string,
        "CQ_S0_R1_0196"^^xsd:string,
        "CQ_S0_R1_0226"^^xsd:string .

:speakingstyle a owl:Class ;
    rdfs:label "SpeakingStyle"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0205"^^xsd:string ;
    :hasEvidenceChunk "1803.09017_rag::chunk_000"^^xsd:string,
        "1808.01410_rag::chunk_001"^^xsd:string,
        "2301.13662_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Wang et al. [6] propose to use global style tokens to control and transfer global speaking styles."^^xsd:string,
        "speaking style , which describes higher-level charact"^^xsd:string,
        "style contains rich information, such as intention and emotion"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Speaking Style"^^xsd:string ;
    skos:skos_definition "The manner or characteristics of speech delivery, which can be controlled or transferred in speech synthesis."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0205"^^xsd:string .

:trainingdata a owl:Class ;
