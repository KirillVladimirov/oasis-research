        "2301.13662_rag::chunk_017"^^xsd:string ;
    :hasEvidenceText "control the styles in the synthetic speech, e.g. , Sigh tone in full of sad mood with some helpless feeling."^^xsd:string,
        "evaluate which synthesized speech is closer to the prompt in terms of semantic meaning in emotion and style."^^xsd:string,
        "synthesizing natural and high-quality speech from text"^^xsd:string ;
