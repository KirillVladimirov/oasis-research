    skos:skos_definition "A measure used to verify if an utterance belongs to a certain speaker, often calculated using specific metrics."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0238"^^xsd:string .

:specaugment a owl:Class ;
    rdfs:label "SpecAugment"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0011"^^xsd:string,
        "CQ_S0_R1_0028"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0207"^^xsd:string ;
    :hasEvidenceChunk "1904.08779_rag::chunk_000"^^xsd:string,
        "1904.08779_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "SpecAugment consists of three kinds of deformations of the log mel spectrogram."^^xsd:string,
        "SpecAugment converts ASR from an over-tting to an under-tting problem, and we were able to gain performance by using bigger networks and training longer."^^xsd:string,
        "SpecAugment: A Simple Data Augmentation Method for Automatic Speech Recognition"^^xsd:string ;
    rdfs:subClassOf :data_augmentation,
        :data_augmentation_method,
        owl:Thing ;
    skos:skos_definition "An augmentation technique that converts ASR from an over-fitting to an under-fitting problem by augmenting the training set using handcrafted policies."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0011"^^xsd:string,
        "CQ_S0_R1_0028"^^xsd:string,
        "CQ_S0_R1_0094"^^xsd:string,
        "CQ_S0_R1_0207"^^xsd:string .

