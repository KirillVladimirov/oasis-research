    :hasEvidenceText "Automatic Speech Recognition (ASR)"^^xsd:string,
        "Automatic Speech Recognition (ASR) is designed to automatically transcribe human speech into text."^^xsd:string,
        "Automatic speech recognition for under-resourced languages"^^xsd:string,
        "Eliminating the negative effect of non-stationary environmental noise is a long-standing research topic for automatic speech recognition"^^xsd:string,
        "Recently Transformer and Convolution neural network (CNN) based models have shown promising results in Automatic Speech Recognition (ASR), outperforming Recurrent neural networks (RNNs)."^^xsd:string,
        "SpecAugment: A Simple Data Augmentation Method for Automatic Speech Recognition"^^xsd:string,
        "The ultimate goal of robust ASR systems is to learn well the relationship between noisy speech and the word predictions"^^xsd:string,
        "improve speech recognition systems in low-resource languages"^^xsd:string ;
    rdfs:subClassOf :task,
        owl:Thing ;
    skos:altLabel "AutomaticSpeechRecognition"^^xsd:string ;
    skos:skos_definition "A technology (ASR) where Transformer and Convolution neural network based models have shown promising results, outperforming Recurrent neural networks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0028"^^xsd:string,
        "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0064"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0118"^^xsd:string,
        "CQ_S0_R1_0175"^^xsd:string .

