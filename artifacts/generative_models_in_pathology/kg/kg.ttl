:adapts a owl:ObjectProperty ;
    rdfs:label "adapts"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0143"^^xsd:string ;
    :hasEvidenceChunk "2505.10993_rag::chunk_013"^^xsd:string ;
    :hasEvidenceText "StainDiff [17] has adapted the cycle-consistency principle, enforcing structural preservation in unpaired stain transfer"^^xsd:string ;
    rdfs:domain :model ;
    rdfs:range :model ;
    skos:skos_definition "The process of adjusting a model to handle new stain transfer tasks or principles."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0143"^^xsd:string .

:addresses a owl:ObjectProperty ;
    rdfs:label "addresses"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0201"^^xsd:string ;
    :hasEvidenceChunk "2505.10993_rag::chunk_025"^^xsd:string ;
    :hasEvidenceText "recurrent retraining and monitoring to address data drift"^^xsd:string ;
    rdfs:domain :generative_model ;
    rdfs:range :datadrift ;
    skos:skos_definition "The process of using model-related techniques to mitigate the effects of shifting data distributions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0201"^^xsd:string .

:addressesscarcityin a owl:ObjectProperty ;
    rdfs:label "addressesScarcityIn"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0162"^^xsd:string ;
    :hasEvidenceChunk "2505.10993_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "remain indispensable, particularly in unsupervised learning and data-scarce scenarios"^^xsd:string ;
    rdfs:domain :unsupervisedlearning ;
    rdfs:range :model ;
    skos:skos_definition "The role of unsupervised methods in providing utility when data is limited."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0162"^^xsd:string .

:addressesscenario a owl:ObjectProperty ;
    rdfs:label "addressesScenario"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0022"^^xsd:string ;
    :hasEvidenceChunk "2505.10993_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "Recent generative models have significantly advanced synthetic pathology imaging, addressing challenges such as limited annotations, class imbalance, and domain shifts."^^xsd:string ;
    rdfs:domain :task ;
    rdfs:range :data_scarcity_scenario ;
    skos:skos_definition "Relates a generative augmentation method to the specific data scarcity challenge it is intended to mitigate."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0022"^^xsd:string .

:adversarial_loss a owl:Class ;
    rdfs:label "Adversarial Loss"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0126"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string ;
    :hasEvidenceChunk "2501.03592_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "train models by minimizing the adversarial loss function between the generator and the discriminator."^^xsd:string ;
    rdfs:subClassOf :metric,
        owl:Thing ;
    skos:altLabel "Adversarial Loss Function"^^xsd:string ;
    skos:skos_definition "A loss function minimized during iterative adversarial training between a generator and a discriminator to produce images similar to target domain images."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0126"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string .

:adversarial_manipulation a owl:Class ;
    rdfs:label "Adversarial Manipulation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0035"^^xsd:string ;
    :hasEvidenceChunk "2505.10993_rag::chunk_026"^^xsd:string ;
    :hasEvidenceText "models trained on synthetic distributions may be less robust to adversarial manipulations"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A type of robustness challenge or test where models are subjected to manipulated inputs to evaluate their stability."^^xsd:string ;
