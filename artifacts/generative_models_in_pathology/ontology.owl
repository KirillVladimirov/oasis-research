  <rdf:Description rdf:about="http://example.org/S0/R1#mode_collapse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mode Collapse</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A phenomenon in GANs where the model tends to produce frequent images independent of the underlying histological patterns, potentially interrupting the learning process.</skos:skos_definition>
