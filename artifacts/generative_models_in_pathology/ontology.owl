    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2411.15719_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We constructed a pathology-oriented dataset that encompasses a range of tasks including pathological image grading, classification typing, pathological image caption generation</hasEvidenceText>
