    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">These models are pretrained on repositories encompassing tens to hundreds of millions of cells, allowing them to capture complex transcriptional grammars</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#cellmask">
