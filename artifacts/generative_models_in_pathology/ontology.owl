    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A class of AI models, including GANs and diffusion models, used to produce realistic samples, descriptive captions, or cross-modal predictions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0155</hasCQ>
