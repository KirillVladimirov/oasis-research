    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">row: CycleGAN; lpips_29=0.43; fid_30=63.55; is_31=25.61; niqe_32=3.58; corr=0.91</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#distinguishes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
