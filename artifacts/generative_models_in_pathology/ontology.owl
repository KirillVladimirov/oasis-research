  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#edgepreservationconstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#entity"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EdgePreservationConstraint</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A constraint applied to ensure that structural boundaries and edges are maintained during the synthesis process.</skos:skos_definition>
