    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasComponent</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a Vision-Language Model to its constituent architectural parts like encoders.</skos:skos_definition>
