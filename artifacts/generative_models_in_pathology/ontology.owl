    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0137</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2502.07221_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Then the model is trained on PathCap [ 39 ] and our filtered Quilt-1M to learn how to associate these morphologies with high-level, multimodal diagnostic knowledge</hasEvidenceText>
  </rdf:Description>
