    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2507.04704_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial transcriptomics reveals distinct and conserved tumor core and edge architectures</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Models like Pix2Path synthesize pathology images from high-resolution spatial transcriptomics</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial transcriptomics technologies provide unprecedented opportunities to study biological systems by capturing gene expression profiles while preserving</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#wsi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
