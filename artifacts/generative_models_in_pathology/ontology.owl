    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2502.12183_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The independent test set was then used to validate both the LLMs and the human annotators information extraction performance.</hasEvidenceText>
