    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preserving the spatial context of gene expression patterns within histological structures</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#artifactregion">
