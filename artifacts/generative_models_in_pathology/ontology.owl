    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component within a vision-language model architecture responsible for processing visual information, often utilizing multimodal attention mechanisms.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0027</hasCQ>
