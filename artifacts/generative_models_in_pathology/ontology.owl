    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2408.07037_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project as its vision encoder and introduced a single randomly initialized cross-attention layer</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#influences">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#genomic_data"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#morphological_feature"/>
