    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the subtypes that occured more frequently in the dataset, such as well and moderately differentiated tubul</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_375">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
