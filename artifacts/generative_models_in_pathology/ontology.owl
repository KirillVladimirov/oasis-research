    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2411.15719_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FID [37] calculates the Wasserstein-2 (a.k.a Frechet) distance between multivariate Gaussians fitted to the embedding space of the Inception-v3 network of generated and real images.</hasEvidenceText>
  </rdf:Description>
