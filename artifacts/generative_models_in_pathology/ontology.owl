    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a discriminator, D ( x ), whose goal is to distinguish between real and generated samples.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#differentiatedsubtype">
