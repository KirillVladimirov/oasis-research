    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-cell foundation models</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Models pretrained on large repositories of cells to capture transcriptional grammars, though often lacking spatial integration.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0042</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0042</prov:wasDerivedFrom>
