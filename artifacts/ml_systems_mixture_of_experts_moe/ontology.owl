    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weighted Random Round-Robin</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A routing method that assigns weights inversely proportional to predicted loads to alleviate overload on hotspot GPUs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0031</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0031</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2509.25041_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">routing weights are assigned inversely proportional to the predicted loads, and tokens are dispatched via weighted random round-robin. This alleviates overload on hotspot GPUs</hasEvidenceText>
  </rdf:Description>
