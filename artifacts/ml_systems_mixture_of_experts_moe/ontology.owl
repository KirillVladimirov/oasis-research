    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A layer within a Mixture-of-Experts architecture that can contain both shared and expert-specific components.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0049</hasCQ>
