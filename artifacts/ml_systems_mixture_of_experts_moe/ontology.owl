    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FlashMoE a megakernel that integrates 2 all MoE computation and communication tasks into a single persistent GPU kernel</hasEvidenceText>
  </rdf:Description>
