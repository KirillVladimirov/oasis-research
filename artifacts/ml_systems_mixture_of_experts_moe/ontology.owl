    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2502.06643_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2505.05950_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Such processes operate like a pipeline with a few micro-batches concurrently processed</hasEvidenceText>
