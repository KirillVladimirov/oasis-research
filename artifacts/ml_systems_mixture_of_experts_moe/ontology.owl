    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mixture-of-Experts</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scalable and efficient architecture for training large neural networks by activating only a subset of parameters (experts) for each input.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0001</hasCQ>
