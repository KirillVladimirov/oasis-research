    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The phase in expert-parallelism occurring between the dispatch and combine all-to-all operations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0149</hasCQ>
