    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MoE differs from dense models</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_118">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
