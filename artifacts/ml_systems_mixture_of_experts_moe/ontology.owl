    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy where each GPU hosts a shard of each expert to compute partial token outputs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0126</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0126</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.08467_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">with MoEShard, each GPU takes all tokens as input and hosts a shard of each expert to compute partial token outputs</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#expertprocessing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
