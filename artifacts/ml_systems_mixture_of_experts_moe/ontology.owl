    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A performance metric used to evaluate MoE systems, often measured in tokens per second or at window boundaries during processing.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0026</hasCQ>
