    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of data transmission or reception in a distributed environment, such as A2A communication in MoE training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0083</hasCQ>
