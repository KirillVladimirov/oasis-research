    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typically, a token is routed to one or two experts in a policy that is referred to as top-1 or top-2 gating.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#addressesconstraintsof">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
