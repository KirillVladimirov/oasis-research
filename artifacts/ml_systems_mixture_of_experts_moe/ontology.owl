    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mixture-of-experts approach that eschews conventional sparse gating in favor of a soft assignment strategy.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0113</hasCQ>
