    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy for scaling the training and inference of MoE models across distributed devices by combining different parallel mapping forms.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0004</hasCQ>
