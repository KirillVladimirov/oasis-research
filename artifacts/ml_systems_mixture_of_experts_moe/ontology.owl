    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">they still suffer from inherent load imbalance and communication tail latency.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#executionschedule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
