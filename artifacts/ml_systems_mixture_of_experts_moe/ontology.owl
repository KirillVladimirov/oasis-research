    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2407.06204_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soft MoE, which eschews the conventional sparse and discrete gating mechanism in favor of a soft assignment strategy that merges tokens.</hasEvidenceText>
  </rdf:Description>
