    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">results in lower communication latency than TP and hybrid baselines</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">receiving more tokens than other GPUs, and thus has longer communication latency</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#moe_operator">
