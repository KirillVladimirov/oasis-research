    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An optimized implementation of the Mixture-of-Experts operator that batches routing decisions and expert computation into a single pass.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0029</hasCQ>
