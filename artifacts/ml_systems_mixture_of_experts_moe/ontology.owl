    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2508.18376_rag::chunk_016</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yield speedups across various deployment configurations, attributable to the reduction in computation volume achieved by our approach.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#expertusagefraction">
