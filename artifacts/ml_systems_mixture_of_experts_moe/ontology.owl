    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A flexible approach to expert management that may involve adaptive loading or removing limits to maintain accuracy.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0040</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0040</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2411.01433_rag::chunk_003</hasEvidenceChunk>
