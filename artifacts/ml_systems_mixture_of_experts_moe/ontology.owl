    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metric representing the time delay along the most time-consuming sequence of operations, often degraded by cache misses in MoE caching solutions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0032</hasCQ>
