    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Top-k Gating</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gating Function</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0003</hasCQ>
