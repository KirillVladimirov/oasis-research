    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mean initialization implies that the new experts are a few selected in the initial state</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_40">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/S0/R1#OntologyAxiom"/>
