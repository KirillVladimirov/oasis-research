:all_to_all_communication a owl:Class ;
    rdfs:label "All-to-All Communication"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0092"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string ;
    :hasEvidenceChunk "1qP3lsatCR_rag::chunk_002"^^xsd:string,
        "bjFhVbky5A_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "This involves two communication operations, namely the All-to-All scatter and All-to-All gather"^^xsd:string,
        "all-to-all communication constitutes an average of 45% of the total training time."^^xsd:string,
        "each token is sent to the device where the selected expert is located. The output from the expert is then sent back to the original device of the corresponding token. This involves two communication operations, namely the All-to-All"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "All-to-All communication"^^xsd:string ;
    skos:skos_definition "A communication operation in MoE systems where tokens are sent to devices hosting selected experts and results are returned to original devices."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0092"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string .

:mixture_of_experts a owl:Class ;
    rdfs:label "Mixture of Experts"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0019"^^xsd:string,
        "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0129"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string ;
    :hasEvidenceChunk "2502.19811_rag::chunk_003"^^xsd:string,
        "2504.05586_rag::chunk_003"^^xsd:string,
        "2505.11432_rag::chunk_001"^^xsd:string,
        "2506.14038_rag::chunk_000"^^xsd:string,
        "339caf45a6fa281cae8adc6465343464-Paper-Conference_rag::chunk_000"^^xsd:string,
        "stXtBqyTWX_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "An MoE consists of multiple, independent models ( i.e. , experts) and a gating function that assigns inputs to experts."^^xsd:string,
        "Each input token is assigned to one or more experts for computation, with assignments determined by various algorithms"^^xsd:string,
        "Mixture-of-Experts (MoE) architecture has been recently gaining enormous attention for the scaling up of LLMs while maintaining roughly constant FLOPs. By incorporating multiple expert networks and employing a sparse gating mechanism"^^xsd:string,
        "Sparse Mixture of Experts (MoE) models offer a scalable and efficient architecture for training large neural networks by activating only a subset of parameters (experts) for each input."^^xsd:string,
        "The Mixture-of-Expert (MoE) technique plays a crucial role in expanding the size of DNN model parameters."^^xsd:string,
        "leads to sub-linear scaling of FLOPs required as the model size increases"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Mixture-of-Expert"^^xsd:string,
        "Mixture-of-Experts"^^xsd:string ;
    skos:skos_definition "A scalable and efficient architecture for training large neural networks by activating only a subset of parameters (experts) for each input."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0019"^^xsd:string,
        "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0129"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string .

:routing_mechanism a owl:Class ;
    rdfs:label "Routing Mechanism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0087"^^xsd:string,
        "CQ_S0_R1_0117"^^xsd:string,
        "CQ_S0_R1_0143"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string ;
    :hasEvidenceChunk "2410.17954v1_rag::chunk_003"^^xsd:string,
        "T5nUQDrM4u_rag::chunk_021"^^xsd:string ;
    :hasEvidenceText "At the core of MoE is the routing mechanism that directs tokens to experts based on a softmax gating function."^^xsd:string,
        "Comparison of Expert Choice, Top-2 and Switch (Top-1) routing mechanisms"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "RoutingMechanism"^^xsd:string ;
    skos:skos_definition "A system or method used to direct tokens or data to specific experts or computational paths within a model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0087"^^xsd:string,
        "CQ_S0_R1_0117"^^xsd:string,
        "CQ_S0_R1_0143"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string .

:routing_strategy a owl:Class ;
    rdfs:label "Routing Strategy"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0134"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string ;
    :hasEvidenceChunk "2408.10681_rag::chunk_002"^^xsd:string,
        "9CqkpQExe2_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "The routing strategy is applied to select experts to be activated from N experts."^^xsd:string,
        "This routing strategy, executed via a learnable router (Fedus et al., 2022a; Du et al., 2022a), selectively assigns each token to a limited number of experts."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A mechanism, often executed via a learnable router, that selectively assigns inputs to a limited number of experts."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0134"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string .

