    :hasEvidenceText "severely underutilizing the expensive accelerator hardware."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Specialized hardware, such as GPUs, used to run MoE models which can face underutilization bottlenecks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0047"^^xsd:string .

