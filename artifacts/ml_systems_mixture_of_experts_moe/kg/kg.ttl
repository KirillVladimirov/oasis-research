        "CQ_S0_R1_0093"^^xsd:string,
        "CQ_S0_R1_0158"^^xsd:string,
        "CQ_S0_R1_0168"^^xsd:string ;
    :hasEvidenceChunk "2404.05019_rag::chunk_004"^^xsd:string,
        "2404.16914_rag::chunk_002"^^xsd:string,
        "2410.17954v1_rag::chunk_003"^^xsd:string,
        "2508.17467_rag::chunk_001"^^xsd:string,
        "B1ckMDqlg_rag::chunk_002"^^xsd:string,
        "uLpyWQPyF9_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "a trainable gating network which selects a sparse combination of the experts to process each input"^^xsd:string,
        "each input activates only a subset of experts (as determined by a gating network)"^^xsd:string,
        "incorporation of learnable gating networks, which efficiently allocate input tokens to different experts."^^xsd:string,
        "replaces the MLP with a set of experts (E1, E2, E3, E4) and a gating network (Gate)."^^xsd:string,
        "routing mechanism that directs tokens to experts based on a softmax gating function"^^xsd:string,
        "the Gating Network plays a key role, which calculates the weights of each expert based on the input data received from the previous layer, and then distributes the input data to the selected experts"^^xsd:string ;
    rdfs:subClassOf :model,
        owl:Thing ;
    skos:altLabel "GatingNetwork"^^xsd:string ;
    skos:skos_definition "A trainable mechanism that selects a sparse combination of experts to process each input, often using a softmax function to direct tokens."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0044"^^xsd:string,
        "CQ_S0_R1_0082"^^xsd:string,
        "CQ_S0_R1_0093"^^xsd:string,
        "CQ_S0_R1_0158"^^xsd:string,
        "CQ_S0_R1_0168"^^xsd:string .

