    prov:wasDerivedFrom "CQ_S0_R1_0236"^^xsd:string .

:saturationpoint a owl:Class ;
    rdfs:label "SaturationPoint"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0238"^^xsd:string ;
    :hasEvidenceChunk "2404.02852_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "E start and E max are two terms fitted to model the saturation, ensuring that the scaling behavior is bounded on both sides."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A boundary in scaling behavior where performance gains are constrained and no longer improve linearly with the addition of experts."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0238"^^xsd:string .

:scheduler a owl:Class ;
    rdfs:label "Scheduler"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0164"^^xsd:string ;
    :hasEvidenceChunk "2505.08944_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "scheduler can multiplex layers to prioritize execution of hot experts"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A component that manages the execution and multiplexing of expert layers on GPUs."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0164"^^xsd:string .

:scheduling_strategy a owl:Class ;
    rdfs:label "Scheduling Strategy"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0184"^^xsd:string ;
    :hasEvidenceChunk "2502.16927_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "leverages a fine-grained scheduling strategy to avoid bandwidth contention between All-to-All communication and All-Reduce communication."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A method to manage the timing and priority of communication tasks to avoid bandwidth contention."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0184"^^xsd:string .

:static_tensor_layout a owl:Class ;
    rdfs:label "Static Tensor Layout"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0061"^^xsd:string ;
    :hasEvidenceChunk "2508.13337_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Existing MoE training frameworks often rely on a dense and static tensor layout for MoE gating and dispatching"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A fixed data structure used for gating and dispatching that does not adapt to token distribution."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0061"^^xsd:string .

:straggler a owl:Class ;
    rdfs:label "Straggler"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0210"^^xsd:string ;
    :hasEvidenceChunk "2503.05066_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "the latency follows the Straggler Effect: the most burdened experts dictate the overall latency of the MoE layer"^^xsd:string ;
    rdfs:subClassOf :expert,
        owl:Thing ;
    skos:skos_definition "The most burdened experts or nodes that dictate the overall latency and performance of the system."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0210"^^xsd:string .

:stragglerproblem a owl:Class ;
    rdfs:label "StragglerProblem"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0054"^^xsd:string ;
    :hasEvidenceChunk "uLpyWQPyF9_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Scaling the number of experts exacerbates token load imbalance. This disparity leads to the straggler problem"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Straggler Problem"^^xsd:string ;
    skos:skos_definition "A performance issue in distributed training caused by disparities in token load imbalance when scaling the number of experts."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0013"^^xsd:string,
        "CQ_S0_R1_0054"^^xsd:string .

:swiglu a owl:Class ;
    rdfs:label "SwiGLU"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0071"^^xsd:string ;
    :hasEvidenceChunk "2407.00945_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "When applying SwiGLU [ 44 ], an additional weight matrix W 3 i is introduced for the activation function."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An activation function architecture used in FFNs that introduces an additional weight matrix."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0071"^^xsd:string .

:synchronization a owl:Class ;
    rdfs:label "Synchronization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0126"^^xsd:string ;
    :hasEvidenceChunk "2503.08467_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "All other sharding combinations would require synchronization between operations. For instance, if is split row-wise, the outputs of x must be summed point-wise across all GPU s."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The requirement for GPUs to coordinate or sum outputs between operations depending on the sharding combination."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0126"^^xsd:string .

:systemoverhead a owl:Class ;
    rdfs:label "SystemOverhead"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0114"^^xsd:string ;
    :hasEvidenceChunk "2511.16947_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "they inevitably introduce substantial system overheads when adjusting expert placements."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The computational or latency costs introduced by adjusting expert placements or rebalancing."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0114"^^xsd:string .

:task a owl:Class ;
    rdfs:label "Task"^^xsd:string ;
