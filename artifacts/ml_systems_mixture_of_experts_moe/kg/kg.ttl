:all_to_all_collective a owl:Class ;
    rdfs:label "All-to-All Collective"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0170"^^xsd:string,
        "CQ_S0_R1_0203"^^xsd:string ;
    :hasEvidenceChunk "2303.06182_rag::chunk_011"^^xsd:string,
        "2401.08383_rag::chunk_012"^^xsd:string ;
    :hasEvidenceText "First, we use an all-to-all collective to inform each device the size of the incoming tokens. Second, we use another all-to-all collective to perform the real token transfer."^^xsd:string,
        "In the vanilla expert parallelism, each MoE layer strictly requires two Alltoall collectives because tokens need to be gathered by their corresponding GPU"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "All-to-all Collective"^^xsd:string ;
    skos:skos_definition "A communication operation used to inform devices of incoming token sizes and perform the actual token transfer."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0170"^^xsd:string,
        "CQ_S0_R1_0203"^^xsd:string .

:capacityfactor a owl:Class ;
    rdfs:label "CapacityFactor"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0106"^^xsd:string,
        "CQ_S0_R1_0178"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string ;
    :hasEvidenceChunk "2503.05066_rag::chunk_007"^^xsd:string,
        "2503.05066_rag::chunk_009"^^xsd:string,
        "T5nUQDrM4u_rag::chunk_021"^^xsd:string ;
    :hasEvidenceText "For a capacity factor , the total proportion of dropped tokens is given by"^^xsd:string,
        "Performance comparison across different capacity factors and selection metrics"^^xsd:string,
        "capacity factor C = 1 , then the FLOPS is very similar to the original, dense model"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A parameter that determines the capacity constraints of experts in a Mixture-of-Experts model, influencing token dropping."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0106"^^xsd:string,
        "CQ_S0_R1_0178"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string .

