:expertreplica a owl:Class ;
    rdfs:label "ExpertReplica"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0048"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0114"^^xsd:string,
