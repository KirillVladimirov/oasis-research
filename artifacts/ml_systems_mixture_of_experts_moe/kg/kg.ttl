    :hasEvidenceChunk "2509.25041_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Node_Level Grouping Expert Affinity Matrix after Grouping"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A grouping method that organizes experts at the node level based on affinity matrices to optimize communication."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0028"^^xsd:string .

