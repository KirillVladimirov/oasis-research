    :hasCQ "CQ_S0_R1_0095"^^xsd:string ;
    :hasEvidenceChunk "339caf45a6fa281cae8adc6465343464-Paper-Conference_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Routing algorithms significantly influence MoE model training, impacting expert"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A rule or algorithm used to determine how tokens are assigned to experts in a Mixture-of-Experts model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0095"^^xsd:string .

:routinggate a owl:Class ;
