    :hasCQ "CQ_S0_R1_0068"^^xsd:string ;
    :hasEvidenceChunk "2304.11414_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "When a former stage nishes computing, intermediate hidden states are sent to the next stage via p2p communications and continue to process in a forward pass."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
