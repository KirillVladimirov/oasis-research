    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The structural design of MoE systems that manages training efficiency through various parallelization strategies."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0226"^^xsd:string .

:pipeline_parallelism_stage a owl:Class ;
