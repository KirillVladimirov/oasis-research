    skos:skos_definition "An optimized implementation of the Mixture-of-Experts operator that batches routing decisions and expert computation into a single pass."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0029"^^xsd:string,
        "CQ_S0_R1_0055"^^xsd:string .

:gating_network a owl:Class ;
    rdfs:label "Gating Network"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0044"^^xsd:string,
