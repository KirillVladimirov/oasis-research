:cachemiss a owl:Class ;
    rdfs:label "CacheMiss"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0221"^^xsd:string ;
    :hasEvidenceChunk "2504.05897_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "when a cache miss occurs, the CPU processes the corresponding expert computation instead of transferring the layer to the GPU"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A condition occurring during inference when an active expert is not found in the GPU buffer, triggering CPU execution or transfer."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0221"^^xsd:string .

:chain_of_experts a owl:Class ;
    rdfs:label "Chain-of-Experts"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0129"^^xsd:string ;
    :hasEvidenceChunk "2506.18945_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Under the same model depth and parameters, CoE enables iterative expert communication to offer more flexible expert choice compared to MoE."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A framework that utilizes shared parameters and iterative expert communication to offer flexible expert choice under the same parameter constraints as MoE."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0129"^^xsd:string .

:communicationstream a owl:Class ;
    rdfs:label "CommunicationStream"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0151"^^xsd:string ;
    :hasEvidenceChunk "2510.19470_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "The training process is first split into independent modeling of computing and communication streams"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A stream dedicated to handling communication operations, such as All-to-All, to enable overlapping with computation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0151"^^xsd:string .

:computation a owl:Class ;
    rdfs:label "Computation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0083"^^xsd:string,
        "CQ_S0_R1_0102"^^xsd:string ;
    :hasEvidenceChunk "2502.19811_rag::chunk_002"^^xsd:string,
