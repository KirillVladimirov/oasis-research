    :hasEvidenceChunk "2410.12247_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "ncclReduceScatter + all2all instead of ncclAllReduce . For combine stage, we use all2all + ncclAllGather instead of ncclAllReduce"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An alternative communication sequence used to reduce communication volume in MoE models."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0122"^^xsd:string .

:routingconstraint a owl:Class ;
