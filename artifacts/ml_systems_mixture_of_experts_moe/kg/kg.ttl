        "CQ_S0_R1_0224"^^xsd:string ;
    :hasEvidenceChunk "2505.03531_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "This enables a strategy where an excessively large intermediate state is split into multiple smaller states, with only a subset of them being selectively activated through gating."^^xsd:string,
        "an excessively large intermediate state is split into multiple smaller states, with only a subset of them being selectively activated through gating. Parameters corresponding to each partition is referred to as an expert"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    owl:disjointWith :coarsegrainedmoe ;
    skos:altLabel "Fine-Grained MoE"^^xsd:string ;
    skos:skos_definition "An architecture where an excessively large intermediate state is split into multiple smaller states, with only a subset selectively activated through gating."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0127"^^xsd:string,
        "CQ_S0_R1_0224"^^xsd:string .

