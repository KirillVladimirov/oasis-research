    :hasCQ "CQ_S0_R1_0192"^^xsd:string ;
    :hasEvidenceChunk "2506.07366_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "Latency of different prediction strategies and accuracies"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A method used to forecast system behavior or requirements to optimize performance metrics like latency."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0192"^^xsd:string .

:probability_distribution a owl:Class ;
    rdfs:label "Probability Distribution"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0161"^^xsd:string ;
    :hasEvidenceChunk "2408.10681_rag::chunk_016"^^xsd:string ;
    :hasEvidenceText "The probability of this distribution indicates the likelihood of assigning the token to each expert."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A distribution indicating the likelihood of assigning a specific token to each available expert."^^xsd:string ;
