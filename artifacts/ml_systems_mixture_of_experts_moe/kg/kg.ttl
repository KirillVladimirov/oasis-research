    :hasCQ "CQ_S0_R1_0236"^^xsd:string ;
    :hasEvidenceChunk "B1ckMDqlg_rag::chunk_003"^^xsd:string,
        "huy8g3iKy0_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "Let us denote by G ( x ) and E i ( x ) the output of the gating network"^^xsd:string,
        "The sparse router enables MoEs to scale, but it also presents a challenge, because the router does not receive a gradient update from experts that it does not activate"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
