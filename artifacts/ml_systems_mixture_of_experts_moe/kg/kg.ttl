    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The addition of null tokens to buffers to meet a predefined expert capacity or static tensor layout."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0061"^^xsd:string .

