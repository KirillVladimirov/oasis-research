:token_based_routing a owl:Class ;
    rdfs:label "Token-based Routing"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0022"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0137"^^xsd:string ;
    :hasEvidenceChunk "2306.00008_rag::chunk_005"^^xsd:string,
        "2407.06204_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "Other Advancements on Token-Choice Gating. Despite the implementation of gating heuristics and auxiliary expert-balancing loss functions"^^xsd:string,
        "Select Top-K"^^xsd:string,
        "Token-based routing vs. Expert-based routing."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A routing policy where tokens are assigned to experts, often involving selecting the top-K experts for each token."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0022"^^xsd:string,
        "CQ_S0_R1_0101"^^xsd:string,
        "CQ_S0_R1_0137"^^xsd:string .

:tokenworkload a owl:Class ;
    rdfs:label "TokenWorkload"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0086"^^xsd:string ;
    :hasEvidenceChunk "2506.07366_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "Figure 3 illustrates how expert duplication helps balance token workloads."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The set of tokens mapped to experts that must be processed, requiring distribution to avoid imbalance."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0086"^^xsd:string .

:top_k_routing a owl:Class ;
    rdfs:label "Top-K Routing"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0031"^^xsd:string,
        "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string ;
    :hasEvidenceChunk "2408.10681_rag::chunk_002"^^xsd:string,
        "9CqkpQExe2_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "The Top-K Routing (Shazeer et al. 2017) strategy is the most widely-used strategy, which always activates a fixed number of experts for each token."^^xsd:string,
        "The most common routing strategy is Top-K routing (Shazeer et al., 2017b). It selects the best-suited experts for each input"^^xsd:string,
        "The most common routing strategy is Top-K routing (Shazeer et al., 2017b). It selects the best-suited experts for each input based on preliminar"^^xsd:string ;
    rdfs:subClassOf :routing_strategy,
        owl:Thing ;
    skos:skos_definition "A common routing strategy that selects the best-suited experts for each input based on preliminary scores."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0031"^^xsd:string,
        "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0218"^^xsd:string .

:topkrouting a owl:Class ;
    rdfs:label "TopKRouting"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0051"^^xsd:string ;
    :hasEvidenceChunk "339caf45a6fa281cae8adc6465343464-Paper-Conference_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "choosing k experts with highest scores (top-k routing)"^^xsd:string ;
    rdfs:subClassOf :routingalgorithm,
        owl:Thing ;
    skos:skos_definition "A routing algorithm that chooses k experts with the highest scores."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0051"^^xsd:string .

:trafficmonitor a owl:Class ;
    rdfs:label "TrafficMonitor"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0169"^^xsd:string ;
    :hasEvidenceChunk "mixnet-sigcomm25_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "MixNets implementation contains a traffic monitor that keeps track of the traffic demands in EP to characterize subsequent all-to-all communications"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A component that tracks traffic demands to characterize communications in a network fabric."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0169"^^xsd:string .

:workloaddistribution a owl:Class ;
    rdfs:label "WorkloadDistribution"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0052"^^xsd:string ;
    :hasEvidenceChunk "2406.06563_rag::chunk_007"^^xsd:string ;
    :hasEvidenceText "facilitate a balanced distribution of workload across experts during training."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The allocation of computational tasks across different experts in a Mixture-of-Experts model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0052"^^xsd:string .

:zero_padding a owl:Class ;
    rdfs:label "Zero Padding"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0152"^^xsd:string ;
    :hasEvidenceChunk "uLpyWQPyF9_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "To meet this requirement, batches are typically zero-padded. The greater the load imbalance, the more zero padding is required to equalize batch sizes."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Placeholders used to equalize batch sizes when load imbalance occurs."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0152"^^xsd:string .

