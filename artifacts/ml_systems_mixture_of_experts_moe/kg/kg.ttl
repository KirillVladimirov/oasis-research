:Cls_3d_nmp a owl:Class ;
    rdfs:label "3D NMP"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0214"^^xsd:string ;
    :hasEvidenceChunk "2509.09420_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "these strategies are ill-suited for 3D NMP. As shown in Table I, TP incurs prohibitive communication overhead due to limited NoC bandwidth, while EP with replication exceeds the memory budget."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A hardware constraint environment where Expert Parallelism with replication may exceed memory budgets and Tensor Parallelism incurs prohibitive communication overhead."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0214"^^xsd:string .

:accelerator_hardware a owl:Class ;
