    :hasEvidenceChunk "2402.07033_rag::chunk_006"^^xsd:string,
        "2505.08944_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "blocks, each composed of an attention layer followed by a set of expert layers."^^xsd:string,
        "the GPU executes the expert layer"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Expert Layer"^^xsd:string ;
