        "2508.19373_rag::chunk_011"^^xsd:string,
        "2509.09420_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "HAP, a novel method that automatically selects hybrid parallel strategies for efficient inference."^^xsd:string,
        "This calls for a hybrid parallelism strategy tailored to 3D NMP constraints, balancing com"^^xsd:string,
        "hybrid parallel strategy of ZeRO-2 DP + EP"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Hybrid Parallelism Strategy"^^xsd:string ;
    skos:skos_definition "A method that automatically selects and combines different parallel strategies for efficient inference, specifically tailored to hardware constraints."^^xsd:string ;
