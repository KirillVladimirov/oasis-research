:expertcapacity a owl:Class ;
    rdfs:label "ExpertCapacity"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0178"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string ;
    :hasEvidenceChunk "2503.05066_rag::chunk_005"^^xsd:string,
        "2503.05066_rag::chunk_009"^^xsd:string,
        "2504.19925_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "expert capacity enforces MoE layers to discard overflowed tokens"^^xsd:string,
        "setting an expert capacity , which defines the maximum number of tokens each expert class can process"^^xsd:string,
        "when the load exceeds the capacity, experts must discard excess tokens to adhere to the constraint."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A constraint that enforces MoE layers to discard overflowed tokens when the load exceeds a predefined limit."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0178"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string .

:expertclass a owl:Class ;
    rdfs:label "ExpertClass"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0048"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0114"^^xsd:string ;
    :hasEvidenceChunk "2504.19925_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Each rank hosts a fixed number of expert slots , and each slot is assigned an expert class ."^^xsd:string,
        "each slot is assigned an expert class"^^xsd:string,
        "each slot is assigned an expert class . The set of ranks hosting the different expert classes form an expert parallel (EP) partition."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Expert Class"^^xsd:string ;
    skos:skos_definition "A specific category or type of expert within a Mixture-of-Experts model that can be assigned to slots on ranks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0048"^^xsd:string,
        "CQ_S0_R1_0086"^^xsd:string,
        "CQ_S0_R1_0114"^^xsd:string .

:expertlayer a owl:Class ;
    rdfs:label "ExpertLayer"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0012"^^xsd:string,
        "CQ_S0_R1_0069"^^xsd:string,
