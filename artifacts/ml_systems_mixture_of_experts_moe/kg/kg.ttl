        "2504.19925_rag::chunk_003"^^xsd:string,
        "2504.19925_rag::chunk_004"^^xsd:string,
        "2509.09420_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "Popular expert classes receive sufficient replicas to handle their token load"^^xsd:string,
        "adjusting each experts replication degree dynamically, in proportion to their popularity."^^xsd:string,
        "each expert class is replicated an equal number of times"^^xsd:string,
        "often replicating hot experts to improve load balance"^^xsd:string,
        "when allocating and placing expert replicas, Lazarus should not only consider the imbalanced workload"^^xsd:string ;
    rdfs:subClassOf :expert,
        owl:Thing ;
    skos:altLabel "Expert Replication"^^xsd:string,
        "Expert-Replication"^^xsd:string,
        "ExpertReplication"^^xsd:string ;
    skos:skos_definition "A strategy within expert parallelism where expert classes are copied multiple times, often to improve load balance or reduce communication overhead."^^xsd:string ;
