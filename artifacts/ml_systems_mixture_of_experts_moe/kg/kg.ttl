        "CQ_S0_R1_0069"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string .

:hybrid_parallel_strategy a owl:Class ;
    rdfs:label "Hybrid Parallel Strategy"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0107"^^xsd:string,
        "CQ_S0_R1_0160"^^xsd:string,
