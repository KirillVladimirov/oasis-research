    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computational models composed of multiple processing layers that learn representations of data with multiple levels of abstraction.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0069</hasCQ>
