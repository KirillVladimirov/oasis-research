    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1504.08083_rag::chunk_013</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1905.10854_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JMLRdropout_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch normalization regularizes the model</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">training a model from scratch</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dropout neural networks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accelerating the training of deep networks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNNenc-30</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VGG16</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Combining the predictions of many different models is a very successful way to reduce test errors</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the identity of the correctly classied examples per classier is independent</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Since our model learns to predict bounding boxes from data, it struggles to generalize to objects in new or unusual aspect ratios or congurations.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">our residual models have exactly the same depth, width, and number of parameters as the plain counterparts.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we re-train and re-test model M</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of 20 models of VGG-19 trained on CIFAR-100.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model combination nearly always improves the performance of machine learning methods.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#singleheadattention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#attentionhead"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SingleHeadAttention</rdfs:label>
    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-Head Attention</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An attention mechanism configuration utilizing only one head to reduce memory usage and computational overhead.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0059</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0221</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0059</prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0221</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1706.03762_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1911.11423_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total computational cost is similar to that of single-head attention with full dimensionality.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">By having a single attention head I stopped running out of memory.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we avoid a great deal of computation.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#translatesto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#model"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">translatesTo</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process where an RNN takes representations from a CNN to generate text.</skos:skos_definition>
