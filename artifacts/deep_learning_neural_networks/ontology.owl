    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Networks utilizing Rectified Linear Units as a nonlinearity to accelerate training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0128</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0128</prov:wasDerivedFrom>
