    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A general optimization algorithm used for training neural networks by receiving a function parameterized by theta and a loss function.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0238</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0238</prov:wasDerivedFrom>
