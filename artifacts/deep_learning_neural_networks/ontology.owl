    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deep-learning methods are representation-learning methods</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_151">
