    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">only the operation with the highest weight value (greater than 0) of each edge can be retained.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#residual_learning_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
