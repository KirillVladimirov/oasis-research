    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1710.05381_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The results conrm that the oversampling approach performs consistently better than undersampling approach across all scenarios.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The method that in most of the cases outperforms all others with respect to multi-class ROC AUC was oversampling.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Random minority oversampling</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oversampling emerged as the best method. It also showed notable improvement of performance over the baseline</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1. Random minority oversampling</hasEvidenceText>
  </rdf:Description>
