    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1703.09137_rag::chunk_021</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distinction between inject and merge architectures</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inject architectures are much more likely to re-generate captions wholesale from the training data and evince less vocabulary variation.</hasEvidenceText>
  </rdf:Description>
