    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Residual Learning Framework</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A framework designed to ease the training of deep networks by reformulating layers as learning residual functions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0174</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0174</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">He_Deep_Residual_Learning_CVPR_2016_paper_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We present a residual learning framework to ease the training of networks that are substantially deeper than those used previously.</hasEvidenceText>
  </rdf:Description>
