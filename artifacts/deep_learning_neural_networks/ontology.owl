    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representation-learning methods</skos:altLabel>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methods that allow a machine to be fed with raw data and to automatically discover the representations needed for detection or classification.</skos:skos_definition>
