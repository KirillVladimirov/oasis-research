    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a generative model is trained on a sub dataset whose size increases gradually.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#layer">
