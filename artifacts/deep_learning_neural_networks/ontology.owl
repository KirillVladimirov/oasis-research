  <rdf:Description rdf:about="http://example.org/S0/R1#rankingloss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#lossfunction"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RankingLoss</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A loss function used to score correct items above incorrect ones, often used in scenarios with positive and negative examples.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0117</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0117</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1510.00726_rag::chunk_018</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ranking losses In some settings, we are not given supervision in term of labels, but rather as pairs of correct and incorrect items x and x , and our goal is to score correct items above incorrect ones.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#hidden_layer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
