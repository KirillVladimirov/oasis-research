    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1710.05381_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deep-learning methods are representation-learning methods with multiple levels of representa tion, obtained by composing simple but non-linear modules that each transform the representation at one level</hasEvidenceText>
