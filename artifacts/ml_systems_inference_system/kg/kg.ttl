    :hasEvidenceText "Autoscaling LLM serving systems. To improve resource efficiency in LLM serving"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A strategy used to adjust resource provisioning in response to traffic changes."^^xsd:string ;
