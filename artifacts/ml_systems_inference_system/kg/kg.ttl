    skos:skos_definition "The process of moving Key-Value cache data between instances or memory pools, affecting latency metrics."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0135"^^xsd:string .

:llm_cold_start a owl:Class ;
    rdfs:label "LLM Cold Start"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0067"^^xsd:string,
        "CQ_S0_R1_0088"^^xsd:string ;
    :hasEvidenceChunk "2503.17707_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "the LLM inference service must go through the model loading stage before it can begin inference, a process known as LLM cold start."^^xsd:string ;
