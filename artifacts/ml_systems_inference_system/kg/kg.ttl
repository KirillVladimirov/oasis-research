    prov:wasDerivedFrom "CQ_S0_R1_0206"^^xsd:string .

:system_performance a owl:Class ;
    rdfs:label "System_Performance"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0123"^^xsd:string ;
    :hasEvidenceChunk "2025.findings-acl.952_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "its implication on system performance has not yet been studied"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The operational efficiency and computational throughput of the system deploying the model."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0123"^^xsd:string .

:taillatency a owl:Class ;
    rdfs:label "TailLatency"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0053"^^xsd:string ;
    :hasEvidenceChunk "2504.09285_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "maintain acceptable tail latency as the shorter prefill stage causes minimal contention."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The latency experienced by the 99th percentile of requests (P99), often sensitive to resource contention."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0053"^^xsd:string .

:te a owl:Class ;
    rdfs:label "TE"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0031"^^xsd:string ;
    :hasEvidenceChunk "2501.14417_rag::chunk_015"^^xsd:string ;
    :hasEvidenceText "the new TEs are announced to the cluster, and JEs direct requests to them."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A Transformer Engine or compute unit that can be pre-warmed and announced to a cluster."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0031"^^xsd:string .

:tensorparallelism a owl:Class ;
    rdfs:label "TensorParallelism"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0059"^^xsd:string,
        "CQ_S0_R1_0090"^^xsd:string,
        "CQ_S0_R1_0109"^^xsd:string,
        "CQ_S0_R1_0154"^^xsd:string ;
    :hasEvidenceChunk "2311.11514_rag::chunk_003"^^xsd:string,
        "2503.06433_rag::chunk_001"^^xsd:string,
        "2503.06433_rag::chunk_005"^^xsd:string,
        "2503.06433_rag::chunk_006"^^xsd:string,
        "2509.16495_rag::chunk_000"^^xsd:string,
        "2510.11938_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "H EX G EN allows each pipeline parallel stage to be assigned with a different number of layers and tensor model parallel degrees"^^xsd:string,
        "InfiniBand) for efficient tensor parallelism. The result is a paradoxical scenario: individual GPUs are abundant, but cohesive GPU clusters are scarce, fundamentally undermining communicationintensive parallelism strategies."^^xsd:string,
        "TP shards weights"^^xsd:string,
        "Tensor parallelism (TP) is the state-of-the-art method for reducing LLM response latency, however GPU communications reduces combined token throughput."^^xsd:string,
        "Tensor parallelism often exhibits significantly"^^xsd:string,
        "frequent all-reduce operations at each layer"^^xsd:string ;
    rdfs:subClassOf :parallelismstrategy,
        owl:Thing ;
    skos:altLabel "Tensor Model Parallelism"^^xsd:string,
        "Tensor Parallelism"^^xsd:string ;
    skos:skos_definition "A model-level parallelization method for reducing LLM response latency, though it may reduce combined token throughput due to GPU communications."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0016"^^xsd:string,
        "CQ_S0_R1_0059"^^xsd:string,
        "CQ_S0_R1_0090"^^xsd:string,
        "CQ_S0_R1_0109"^^xsd:string,
        "CQ_S0_R1_0154"^^xsd:string .

:throughput a owl:Class ;
    rdfs:label "Throughput"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0117"^^xsd:string,
        "CQ_S0_R1_0143"^^xsd:string ;
    :hasEvidenceChunk "2312.05385_rag::chunk_000"^^xsd:string,
        "2508.08446_rag::chunk_010"^^xsd:string,
        "2511.04791_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "achieves a throughput of 7,913 tokens/s"^^xsd:string,
        "ensuring high throughput given many requests"^^xsd:string,
        "throughput (measured in tokens/sec or requests/sec)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A performance metric measuring the volume of requests or tokens processed per unit of time."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0117"^^xsd:string,
        "CQ_S0_R1_0143"^^xsd:string .

:timetofirsttoken a owl:Class ;
    rdfs:label "TimeToFirstToken"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0214"^^xsd:string ;
    :hasEvidenceChunk "2410.18038_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "produces the first output token, whose latency is called time-to-first-token (TTFT)."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The latency metric associated with the production of the first output token during the prefill phase."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0214"^^xsd:string .

:tokenbatch a owl:Class ;
    rdfs:label "TokenBatch"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0227"^^xsd:string ;
    :hasEvidenceChunk "2510.08544_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "In the compute-bound prefill phase, all tokens in the input prompt are processed in parallel"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A collection of input tokens processed in parallel during the prefill or decode phases of inference."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0227"^^xsd:string .

:traditionalattentionalgorithm a owl:Class ;
    rdfs:label "TraditionalAttentionAlgorithm"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0050"^^xsd:string ;
    :hasEvidenceChunk "2309.06180_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "Unlike the traditional attention algorithms, PagedAttention allows storing continuous keys and values in non-contiguous memory space."^^xsd:string ;
    rdfs:subClassOf :algorithm,
        owl:Thing ;
    skos:skos_definition "Attention algorithms that typically rely on contiguous memory allocation for keys and values."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0050"^^xsd:string .

:user_feedback_signal a owl:Class ;
    rdfs:label "User Feedback Signal"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0212"^^xsd:string ;
    :hasEvidenceChunk "2510.03283_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "derived from implicit user feedback signals. A common approach is to use preference-based supervision"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Implicit or explicit data points extracted from live inference interactions used for model alignment and supervision."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0212"^^xsd:string .

:userexperience a owl:Class ;
    rdfs:label "UserExperience"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0124"^^xsd:string ;
    :hasEvidenceChunk "2410.14257_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "user experience in streaming services is influenced by waiting times without information to process"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The perceived quality of service influenced by waiting times and information availability during streaming."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0124"^^xsd:string .

:virtual_address a owl:Class ;
    rdfs:label "Virtual Address"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0018"^^xsd:string ;
    :hasEvidenceChunk "2511.11729_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "The physical addresses of these blocks are mapped to the virtual addresses used by the inference services KV cache"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An address space used by inference services that is mapped to physical memory blocks."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0018"^^xsd:string .

:virtualaddressspace a owl:Class ;
    rdfs:label "VirtualAddressSpace"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0221"^^xsd:string ;
    :hasEvidenceChunk "2505.04021_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "serving engines reserve only virtual address space"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A logical memory abstraction reserved by serving engines to decouple memory management from physical hardware."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0221"^^xsd:string .

:workload a owl:Class ;
    rdfs:label "Workload"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0099"^^xsd:string ;
    :hasEvidenceChunk "2408.15792_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "A burst of submission is a workload in which users submit lots of requests to the LLM server suddenly"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The set of requests submitted to a system, which may exhibit specific patterns such as burstiness."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0099"^^xsd:string .

