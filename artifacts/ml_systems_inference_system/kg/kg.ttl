:inferenceengine a owl:Class ;
    rdfs:label "InferenceEngine"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0017"^^xsd:string,
        "CQ_S0_R1_0075"^^xsd:string,
        "CQ_S0_R1_0078"^^xsd:string,
        "CQ_S0_R1_0081"^^xsd:string,
        "CQ_S0_R1_0187"^^xsd:string ;
    :hasEvidenceChunk "2406.17565_rag::chunk_004"^^xsd:string,
        "2406.17565_rag::chunk_005"^^xsd:string,
        "2504.07494_rag::chunk_011"^^xsd:string,
        "2504.14775_rag::chunk_009"^^xsd:string,
        "2507.06608_rag::chunk_017"^^xsd:string,
        "2510.03283_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Each inference engine runs over one or multiple AI servers"^^xsd:string,
        "MACE, a hybrid execution framework that co-optimizes fine-tuning and inference on shared edge GPU resources."^^xsd:string,
        "Nexus achieves 550% lower makespan than vLLM and SGLang"^^xsd:string,
        "The inference engine can use memory block APIs to allocate fixed-size memory blocks for storing KV cache or other data."^^xsd:string,
        "the inference engine assigns GPU workers to efficiently process the scheduled batch of requests. In each iteration, the workers perform a pass over the model parameters to generate one output token"^^xsd:string,
        "vLLM (v0.8.1) as the fastest inference engines for pipeline parallelism."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Inference Engine"^^xsd:string ;
    skos:skos_definition "A component responsible for assigning GPU workers to process scheduled batches of requests and generating output tokens."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0017"^^xsd:string,
        "CQ_S0_R1_0075"^^xsd:string,
        "CQ_S0_R1_0078"^^xsd:string,
        "CQ_S0_R1_0081"^^xsd:string,
        "CQ_S0_R1_0187"^^xsd:string .

:inferencetask a owl:Class ;
    rdfs:label "InferenceTask"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0167"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string ;
    :hasEvidenceChunk "2407.12391_rag::chunk_009"^^xsd:string,
        "2504.20828_rag::chunk_003"^^xsd:string,
        "2509.13201_rag::chunk_016"^^xsd:string ;
    :hasEvidenceText "Each inference task carries a batch size of 100 claims (thus 100 inferences) by default."^^xsd:string,
        "LLM inference tasks"^^xsd:string,
        "interrupting ongoing decode operations to serve new prefill requests"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A request or operation within an LLM inference system, such as prefill or decode operations."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0167"^^xsd:string,
        "CQ_S0_R1_0199"^^xsd:string .

:inferenceworkload a owl:Class ;
    rdfs:label "InferenceWorkload"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
        "CQ_S0_R1_0128"^^xsd:string,
        "CQ_S0_R1_0161"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string,
        "CQ_S0_R1_0229"^^xsd:string ;
    :hasEvidenceChunk "2411.16102_rag::chunk_004"^^xsd:string,
        "2504.11750_rag::chunk_001"^^xsd:string,
        "2504.11750_rag::chunk_003"^^xsd:string,
        "2508.20274_rag::chunk_005"^^xsd:string,
        "2511.02248_rag::chunk_001"^^xsd:string,
        "2511.10753_rag::chunk_005"^^xsd:string ;
    :hasEvidenceText "AI inference costs increasingly exceed training costs, with potentially up to 90% AI-related costs attributed to inference due to its repeated execution"^^xsd:string,
        "Evolving diversity of inference workloads"^^xsd:string,
        "LLM inference workloads rely heavily on xPUs memory capacity to accommodate two key data structures: model parameters and the KV-Cache."^^xsd:string,
        "Serving online inference workloads of large generative models such as large language models (LLMs)"^^xsd:string,
        "emerging latency-sensitive inference workloads"^^xsd:string,
        "inference scales with user demand, posing unique challenges for performance optimization and cost efficiency in data centers."^^xsd:string,
        "latency-sensitive inference workload"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Inference Workload"^^xsd:string ;
    skos:skos_definition "A computational task involving the execution of a trained model to process user requests, often characterized by latency sensitivity and specific token processing phases."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0041"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
        "CQ_S0_R1_0128"^^xsd:string,
        "CQ_S0_R1_0161"^^xsd:string,
        "CQ_S0_R1_0186"^^xsd:string,
        "CQ_S0_R1_0229"^^xsd:string .

:kv_cache_management a owl:Class ;
    rdfs:label "KV Cache Management"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0058"^^xsd:string,
        "CQ_S0_R1_0149"^^xsd:string ;
    :hasEvidenceChunk "2412.03131_rag::chunk_011"^^xsd:string,
        "2502.12574_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "In this section, we describe DiffKVs memory management mechanism which efficiently supports the three levels of differentiation in the KV cache."^^xsd:string,
        "Lossy KV Cache Management Evit KV cache can reduce memory usage and computational complexity."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "KV Cache Management Technique"^^xsd:string ;
    skos:skos_definition "Methods or mechanisms used to manage key-value cache memory, particularly to address bottlenecks and fragmentation."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0058"^^xsd:string,
        "CQ_S0_R1_0149"^^xsd:string .

:kv_cache_quantization a owl:Class ;
    rdfs:label "KV_Cache_Quantization"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0123"^^xsd:string ;
    :hasEvidenceChunk "2503.24000_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "These approaches reduce the size of KV cache by using low bits (e.g., INT8) to represent the original full precision (e.g., FP16)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A technique that reduces the size of the KV cache by using low bits to represent original full precision data."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0123"^^xsd:string .

:kvtransfer a owl:Class ;
    rdfs:label "KVTransfer"^^xsd:string ;
