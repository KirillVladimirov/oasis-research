:prefillstage a owl:Class ;
    rdfs:label "PrefillStage"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0065"^^xsd:string,
        "CQ_S0_R1_0117"^^xsd:string,
        "CQ_S0_R1_0139"^^xsd:string ;
    :hasEvidenceChunk "2308.16369_rag::chunk_006"^^xsd:string,
        "2503.20552_rag::chunk_001"^^xsd:string,
        "2512.03416_rag::chunk_004"^^xsd:string ;
