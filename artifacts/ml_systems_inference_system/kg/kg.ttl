    rdfs:subClassOf :compression_technique,
        :compressionmethod,
        owl:Thing ;
    skos:skos_definition "A technique for compressing models by selectively eliminating parameters to streamline the model and make it more efficient."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0093"^^xsd:string,
        "CQ_S0_R1_0151"^^xsd:string .

