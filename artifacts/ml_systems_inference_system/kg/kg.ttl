:accelerates a owl:ObjectProperty ;
    rdfs:label "accelerates"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0125"^^xsd:string ;
    :hasEvidenceChunk "2508.17219_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "is crucial to accelerate multi-turn interactions and requests with shared prefixes."^^xsd:string ;
    rdfs:domain :sharedprefixcache ;
    rdfs:range :multiturninteraction ;
    skos:skos_definition "The action of increasing the speed or efficiency of multi-turn conversational exchanges."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0125"^^xsd:string .

:acceptancerate a owl:DatatypeProperty ;
    rdfs:label "acceptanceRate"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0111"^^xsd:string ;
    :hasEvidenceChunk "2503.05096_rag::chunk_009"^^xsd:string,
        "2503.05096_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "Acceptance Rate"^^xsd:string,
        "denotes the probability that the draft token of the request is accepted."^^xsd:string ;
    rdfs:domain :speculativedecoding ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "CQ_S0_R1_0111"^^xsd:string .

