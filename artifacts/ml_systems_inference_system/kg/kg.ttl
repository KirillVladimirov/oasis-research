:accelerator a owl:Class ;
    rdfs:label "Accelerator"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0195"^^xsd:string ;
    :hasEvidenceChunk "2503.18599_rag::chunk_006"^^xsd:string,
        "2503.18599_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "the LLM accelerators [ 53 , 83 ]. Despite the industrys growing demand for large-scale LLM inference, current memory technologies struggle to meet both capacity and bandwidth requirements"^^xsd:string,
        "the accelerator can utilize only a few cores, resulting in high latency"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Hardware used for LLM inference, which may be equipped with different memory technologies like LPDDR or HBM."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0049"^^xsd:string,
        "CQ_S0_R1_0195"^^xsd:string .

