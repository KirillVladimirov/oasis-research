        "CQ_S0_R1_0144"^^xsd:string,
        "CQ_S0_R1_0159"^^xsd:string,
        "CQ_S0_R1_0175"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string,
        "CQ_S0_R1_0183"^^xsd:string .

