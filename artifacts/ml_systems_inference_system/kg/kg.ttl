:acquisitionfunction a owl:Class ;
    rdfs:label "AcquisitionFunction"^^xsd:string ;
    rdfs:subClassOf :method,
        owl:Thing .

:attention_kernel a owl:Class ;
    rdfs:label "Attention Kernel"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0165"^^xsd:string ;
    :hasEvidenceChunk "2025.findings-acl.952_rag::chunk_007"^^xsd:string,
        "2410.02367_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "implementing such a kernel with linear memory complexity is challenging."^^xsd:string,
        "kernel inspired by FlashAttention-style tiling."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A computational kernel designed to perform attention operations, often optimized for memory efficiency or throughput."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0165"^^xsd:string .

:autoscaler a owl:Class ;
    rdfs:label "Autoscaler"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0007"^^xsd:string ;
    :hasEvidenceChunk "2501.08090_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "The global autoscaler scales LLM serving instances based on the incoming request"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A system component that scales serving instances based on metrics like incoming requests or workload changes."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0007"^^xsd:string .

:availabilityzone a owl:Class ;
    rdfs:label "AvailabilityZone"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0129"^^xsd:string ;
    :hasEvidenceChunk "2411.01438_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "dynamically selects zones from available zones. Let be all enabled zones with the required instance type"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Distinct locations within a region designed to be isolated from failures in other zones."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0129"^^xsd:string .

:batching a owl:Class ;
    rdfs:label "Batching"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0148"^^xsd:string,
        "CQ_S0_R1_0208"^^xsd:string ;
    :hasEvidenceChunk "2508.01989_rag::chunk_005"^^xsd:string,
        "2511.06724_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "batch multiple inference requests, particularly for the decode phase."^^xsd:string,
        "batching does not improve throughput for T2I model serving. T2I models are highly compute-bound."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "BatchingMethod"^^xsd:string ;
    skos:skos_definition "A technique in inference serving systems used to improve throughput, though its effectiveness varies depending on whether models are compute-bound."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0148"^^xsd:string,
        "CQ_S0_R1_0208"^^xsd:string .

:batchingmethod a owl:Class ;
    rdfs:label "BatchingMethod"^^xsd:string ;
    rdfs:subClassOf :batching,
        :trainingprocedure,
        owl:Thing .

:coldstartlatency a owl:Class ;
    rdfs:label "ColdStartLatency"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0105"^^xsd:string,
        "CQ_S0_R1_0207"^^xsd:string ;
    :hasEvidenceChunk "2503.17707_rag::chunk_004"^^xsd:string,
        "2505.14468_rag::chunk_014"^^xsd:string ;
    :hasEvidenceText "a process known as LLM cold start"^^xsd:string,
        "higher cumulative cold-start latency than inference"^^xsd:string,
        "the LLM inference service must go through the model loading stage before it can begin inference, a process known as LLM cold start."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The delay or time required for a service to go through the model loading stage before it can begin inference."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0105"^^xsd:string,
        "CQ_S0_R1_0207"^^xsd:string .

:communicationoverhead a owl:Class ;
    rdfs:label "CommunicationOverhead"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0059"^^xsd:string,
        "CQ_S0_R1_0109"^^xsd:string,
        "CQ_S0_R1_0228"^^xsd:string ;
    :hasEvidenceChunk "2311.03703_rag::chunk_001"^^xsd:string,
        "2503.06433_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "CUs must send their outputs downstream, often via a slow and contended data channel, so we need to minimize communication overhead"^^xsd:string,
        "communication overhead the primary bottleneck"^^xsd:string,
        "communication overhead the primary bottleneck."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The additional time or data transfer costs incurred when sending outputs between compute units in a distributed system."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0059"^^xsd:string,
        "CQ_S0_R1_0109"^^xsd:string,
        "CQ_S0_R1_0228"^^xsd:string .

:compression_technique a owl:Class ;
    rdfs:label "Compression Technique"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0151"^^xsd:string ;
    :hasEvidenceChunk "2412.18934_rag::chunk_009"^^xsd:string ;
    :hasEvidenceText "To address this challenge, researchers have proposed various compression techniques"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Methods proposed to address the challenge of deploying models on accelerators by reducing their size or computational demand."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0151"^^xsd:string .

:dataset a owl:Class ;
    rdfs:label "Dataset"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing .

:decode_task a owl:Class ;
    rdfs:label "Decode Task"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0028"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string ;
    :hasEvidenceChunk "2511.21862_rag::chunk_003"^^xsd:string,
        "2512.03416_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "For Decode tasks on latency-strict nodes, we leverage the performance model to dynamically select Decode batch requests, ensuring that Decode latency consistently meets SLO constraints."^^xsd:string,
        "ongoing decoding tasks"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "An operation in LLM inference that generates subsequent tokens, often subject to strict latency constraints."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0028"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string .

:dequantizationoperation a owl:Class ;
    rdfs:label "DequantizationOperation"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0233"^^xsd:string ;
    :hasEvidenceChunk "2504.15299_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "This dequantization operation introduces significant runtime overhead, typically accounting for 20%-70% of the entire inference process."^^xsd:string,
        "the weight-only quantization approach requires the online transformation of quantized weights into the same data type as the activation"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "Dequantization Operation"^^xsd:string ;
    skos:skos_definition "The process of transforming quantized weights back into a standard data type, which can introduce significant runtime overhead."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0054"^^xsd:string,
        "CQ_S0_R1_0233"^^xsd:string .

:disaggregatedarchitecture a owl:Class ;
    rdfs:label "DisaggregatedArchitecture"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0053"^^xsd:string,
        "CQ_S0_R1_0204"^^xsd:string ;
    :hasEvidenceChunk "2508.19559_rag::chunk_003"^^xsd:string,
        "2511.21862_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "Decode is highly sensitive to per-step latency and cannot be blocked by long operations, which is why it must be decoupled from Prefill."^^xsd:string,
