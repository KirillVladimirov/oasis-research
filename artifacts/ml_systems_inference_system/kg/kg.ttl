    rdfs:label "affectsPerformance"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0097"^^xsd:string ;
    :hasEvidenceChunk "2511.04791_rag::chunk_001"^^xsd:string ;
    :hasEvidenceText "improving resource utilization and throughput (measured in tokens/sec or requests/sec) benefits from larger batch sizes. Balancing this tradeoff is central"^^xsd:string ;
    rdfs:domain :batchingstrategy ;
