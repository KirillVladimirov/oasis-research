:kvcache a owl:Class ;
    rdfs:label "KVCache"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0050"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0194"^^xsd:string,
        "CQ_S0_R1_0214"^^xsd:string,
        "CQ_S0_R1_0239"^^xsd:string ;
    :hasEvidenceChunk "2309.06180_rag::chunk_001"^^xsd:string,
        "2401.11181_rag::chunk_003"^^xsd:string,
        "2502.07903_rag::chunk_004"^^xsd:string,
        "2504.07494_rag::chunk_008"^^xsd:string,
        "2504.11816_rag::chunk_003"^^xsd:string,
        "2507.11507_rag::chunk_000"^^xsd:string,
        "2509.06261_rag::chunk_003"^^xsd:string ;
    :hasEvidenceText "KV cache [ 27 , 49 ] was introduced as a key mechanism to reduce inference latency: it stores intermediate results from previously generated tokens to avoid recomputing tensor values."^^xsd:string,
        "Memory-Intensive KV Cache Usage It has been recognized that KV caches tend to consume"^^xsd:string,
        "The prefill phase outputs the first token and generates the key and value cache (KV cache) for future decoding"^^xsd:string,
        "They maintain a KV cache that stores keyvalue pairs for all previously processed tokens at each layer."^^xsd:string,
        "generating the first token and KV cache"^^xsd:string,
        "the computed Key and Value tensors are stored in the GPU memory as a Key-Value Cache (KV Cache) to alleviate computational overhead"^^xsd:string,
        "these states consist of the key and value tensors associated with the attention mechanism, commonly referred to as KV cache"^^xsd:string,
        "these states consist of the key and value tensors associated with the attention mechanism, commonly referred to as KV cache [ 41 ], which represent the context from earlier tokens"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A storage mechanism for key-value pairs of previously processed tokens used during attention layer operations."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0008"^^xsd:string,
        "CQ_S0_R1_0010"^^xsd:string,
        "CQ_S0_R1_0050"^^xsd:string,
        "CQ_S0_R1_0103"^^xsd:string,
        "CQ_S0_R1_0141"^^xsd:string,
        "CQ_S0_R1_0194"^^xsd:string,
        "CQ_S0_R1_0214"^^xsd:string,
        "CQ_S0_R1_0239"^^xsd:string .

:latency a owl:Class ;
    rdfs:label "Latency"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0112"^^xsd:string,
        "CQ_S0_R1_0115"^^xsd:string,
        "CQ_S0_R1_0143"^^xsd:string ;
    :hasEvidenceChunk "2312.05385_rag::chunk_000"^^xsd:string,
        "2504.09590_rag::chunk_001"^^xsd:string,
        "2504.09590_rag::chunk_004"^^xsd:string,
        "2511.04791_rag::chunk_005"^^xsd:string,
        "2511.21862_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "Prefill latency under an 8K budget violates TBT SLOs despite full utilization."^^xsd:string,
        "delivering low-latency responses to support interactive applications"^^xsd:string,
        "denote the static runtime overhead latency of a Prefill and a Decode iteration, respectively."^^xsd:string,
        "preemptive scheduling effectively reduces normalized latency (Fig. 3a) by minimizing the overall queuing time"^^xsd:string,
        "this serving goal is also measured by two metrics: time to first token (TTFT) and time per output token (TPOT)"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "The time taken to process an iteration or request, often constrained by a fixed budget or Service Level Objective (SLO)."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0112"^^xsd:string,
        "CQ_S0_R1_0115"^^xsd:string,
        "CQ_S0_R1_0143"^^xsd:string .

:service_level_objective a owl:Class ;
    rdfs:label "Service Level Objective"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0157"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string ;
    :hasEvidenceChunk "2410.14257_rag::chunk_006"^^xsd:string,
        "2511.02248_rag::chunk_000"^^xsd:string ;
    :hasEvidenceText "By defining SLOs, providers establish observable thresholds to proactively assess compliance with user expectations"^^xsd:string,
        "Service Level Objectives (SLOs, in Section 3) are the metrics that directly represent the token delivery state of a request."^^xsd:string,
        "balancing user-facing SLOs (e.g., time-to-first-token, time-between-tokens) with provider goals of efficiency and cost reduction"^^xsd:string ;
    rdfs:subClassOf :lossfunction,
        owl:Thing ;
    skos:skos_definition "Metrics that directly represent the token delivery state of a request and establish observable thresholds to assess compliance with user expectations."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0157"^^xsd:string,
        "CQ_S0_R1_0201"^^xsd:string .

:slo a owl:Class ;
    rdfs:label "SLO"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0039"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0132"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string ;
    :hasEvidenceChunk "2501.08090_rag::chunk_004"^^xsd:string,
        "2503.13737_rag::chunk_009"^^xsd:string,
        "2504.09285_rag::chunk_013"^^xsd:string ;
    :hasEvidenceText "Each LLM serving request has two key latency requirements: (a) time to first token (TTFT): the time required to complete the prefill step and generate the first token, and (b) inter-token latency (ITL)"^^xsd:string,
        "These two latency requirements together form the service-level objective (SLO)"^^xsd:string,
        "the inference time of a batch needs to satisfy the minimum SLO of the requests in a batch ( SLO min )."^^xsd:string,
        "the red dashed horizontal line marks the latency service-level objective, 30 ms for the short context and 50 ms for the long one."^^xsd:string ;
    rdfs:subClassOf :latencyrequirement,
        owl:Thing ;
    skos:skos_definition "A service-level objective for LLM serving requests, typically consisting of requirements for time to first token and inter-token latency."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0039"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0132"^^xsd:string,
        "CQ_S0_R1_0193"^^xsd:string .

