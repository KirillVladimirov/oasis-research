    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PipelineParallelism</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ParallelismStrategy</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0109</hasCQ>
