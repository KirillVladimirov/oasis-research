    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An approach to memory management that initiates data migration or offloading before preemption occurs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0069</hasCQ>
