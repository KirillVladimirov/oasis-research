    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">906419cd502575b617cc489a1a696a67-Paper-Conference_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serving Heterogeneous LoRA Adapters in Distributed LLM Inference Systems</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">swapping adapters by adding and subtracting LoRA weights from the base model</hasEvidenceText>
  </rdf:Description>
