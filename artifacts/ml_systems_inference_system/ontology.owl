    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">These include response time metrics such as TTFT, TBT, and TPOT</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_520">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
