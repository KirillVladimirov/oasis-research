    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The set of requests submitted to a system, which may exhibit specific patterns such as burstiness.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0099</hasCQ>
