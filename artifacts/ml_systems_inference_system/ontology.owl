    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process to move LLM inference between instances with minimal user interruption and resource overhead.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0021</prov:wasDerivedFrom>
