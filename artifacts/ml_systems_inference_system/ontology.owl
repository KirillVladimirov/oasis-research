  <rdf:Description rdf:about="http://example.org/S0/R1#impactstaillatency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#schedulingpolicy"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#request"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impactsTailLatency</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship describing how a specific scheduling strategy affects the 99th percentile latency of requests.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0099</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0099</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2409.15104_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FIFO [ 19 , 23 ] can cause head-of-line blocking, where long inputs delay short ones. Our measurements (in 3) show that long inputs can increase the 99th percentile</hasEvidenceText>
  </rdf:Description>
