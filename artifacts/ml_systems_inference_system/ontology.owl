    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2504.10724_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Early-Exit LLMs (EE-LLMs) are promising variants of LLMs that enable high throughput inference by allowing tokens to exit at specific intermediate layers during the forward pass if their probability meets a predefined confidence threshold.</hasEvidenceText>
  </rdf:Description>
