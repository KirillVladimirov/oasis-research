    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A form of parallelism that allows each pipeline stage to be assigned different tensor model parallel degrees to accommodate GPU heterogeneity.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0154</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0154</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2311.11514_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support of asymmetric tensor model parallelism and pipeline parallelism. Essentially, H EX G EN allows each pipeline parallel stage to be assigned with a different number of layers and tensor model parallel degrees</hasEvidenceText>
  </rdf:Description>
