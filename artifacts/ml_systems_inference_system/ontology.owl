    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A temporal dependency where the prefill phase is prevented from beginning until the encoding of multimodal data is complete.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0237</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0237</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2509.24381_rag::chunk_007</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">it strictly enforces a dependency that the prefill phase cannot start until all multimodal data has been fully encoded</hasEvidenceText>
  </rdf:Description>
