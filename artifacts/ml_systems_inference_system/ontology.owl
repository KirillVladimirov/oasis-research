    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A configuration defining how computations are distributed across devices, often involving data, tensor, or pipeline parallelism.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0024</hasCQ>
