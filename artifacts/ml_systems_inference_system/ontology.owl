    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hardware used for LLM inference, which may be equipped with different memory technologies like LPDDR or HBM.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0049</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0195</hasCQ>
