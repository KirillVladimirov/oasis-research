    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A deployment of multiple server instances used to run model replicas and handle workloads.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0116</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0116</prov:wasDerivedFrom>
