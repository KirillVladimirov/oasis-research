    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system architecture where components like prefill and decode stages are decoupled to manage latency and resource demands.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0065</hasCQ>
