    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a parallelism strategy to its primary performance constraint.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0059</hasCQ>
