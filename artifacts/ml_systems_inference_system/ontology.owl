    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2406.17565_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2407.12391_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PagedAttention-based alternatives of vLLM, FlashAttention-2 and FlashInfer</hasEvidenceText>
