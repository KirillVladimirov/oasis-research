    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.17707_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the LLM inference service must go through the model loading stage before it can begin inference, a process known as LLM cold start.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#kvcache">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
