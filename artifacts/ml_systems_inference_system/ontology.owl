    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2508.19559_rag::chunk_002</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coordination mechanisms to manage interdependent components like prefill and decode pools, which must be scaled in a balanced manner.</hasEvidenceText>
  </rdf:Description>
