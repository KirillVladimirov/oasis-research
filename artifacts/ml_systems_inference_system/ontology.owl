    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A component that manages frequency adjustments and resource scaling, often running in privileged mode.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0048</hasCQ>
