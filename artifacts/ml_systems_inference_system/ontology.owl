    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0047</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.05096_rag::chunk_014</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The confidence prior verifier achieves request-level speculative length control indirectly by prioritizing the verification of draft tokens anticipated to have a higher acceptance rate</hasEvidenceText>
  </rdf:Description>
