    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2501.14417_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we only consider inter-GPU communication in our evaluation, which uses direct remote memory access</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">benefiting significantly from a large-scaled-up domain with high-bandwidth interconnects.</hasEvidenceText>
  </rdf:Description>
