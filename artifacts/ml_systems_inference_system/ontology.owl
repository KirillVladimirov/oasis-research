    <axiomLhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BottleneckStage</axiomLhs>
    <axiomRhs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PartitionStage</axiomRhs>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0030</hasCQ>
