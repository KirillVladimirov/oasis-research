    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specialized caching mechanism designed for Vision-Language models to evict insignificant visual tokens based on language instructions.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0180</hasCQ>
