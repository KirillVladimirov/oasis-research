    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generation Phase</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sequential phase of LLM inference that processes one token at a time, often limiting parallelization.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0049</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0049</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.18599_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the generation phase processes only one token from the previous iteration, making it highly sequential process that limits parallelization.</hasEvidenceText>
  </rdf:Description>
