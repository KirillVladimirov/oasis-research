    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the draft model, denoted as M D , is the one that proposes candidate tokens which are later being verified by the target model.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#llm_verification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
