  <rdf:Description rdf:about="http://example.org/S0/R1#compute_saturation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:resource="http://example.org/S0/R1#batch"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compute saturation</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A state where further increasing the batch size does not improve computational efficiency, shifting the objective to memory capacity utilization.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0009</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2511.21862_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If saturation is reached, it means that further increasing the batch size will not improve computational efficiency. In this case, the objective shifts to fully utilizing memory capacity</hasEvidenceText>
  </rdf:Description>
