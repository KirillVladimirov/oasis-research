    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low-Rank Adaptation (Lo</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heterogeneous LoRA adapters with varying ranks</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">swapping adapters by adding and subtracting LoRA weights from the base model</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">merging the adapter with the model parameters.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LoRA adapters with domain-specific knowledge improve the Qwen-VLs accuracy on target tasks.</hasEvidenceText>
  </rdf:Description>
