    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2412.03131_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025.findings-acl.952_rag::chunk_000</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">State-of-the-art KV cache compression techniques, such as quantization and pruning</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantization can be achieved for KV cache compression while preserving accuracy</hasEvidenceText>
  </rdf:Description>
