    <owl:disjointWith rdf:resource="http://example.org/S0/R1#spotreplica"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OnDemandReplica</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cloud instance replica that is continuously available but associated with higher operational costs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0213</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0213</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2411.01438_rag::chunk_008</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using a fixed pool of on-demand replicas is unnecessary and costly when spot replicas are available.</hasEvidenceText>
  </rdf:Description>
