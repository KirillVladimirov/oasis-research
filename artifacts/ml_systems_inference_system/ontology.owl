    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Individual data samples where the model fails to achieve satisfactory performance due to compression impacts.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0216</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0216</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.24000_rag::chunk_015</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LLM practitioners lack insightful guidance on when KV cache compression fails to achieve satisfactory performance. To bridge such a gap, we explore the negative performance impact on individual samples.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#controller">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
