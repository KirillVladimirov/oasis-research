    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A value assigned to a request representing its relative importance, used to derive latency SLOs or determine scheduling sequence.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0185</hasCQ>
