    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instances dedicated to the prefill phase of LLM inference, optimized for specific compute and memory demands.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0082</hasCQ>
