    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique used to accelerate inference by using smaller models or speculative trees to predict outputs.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0042</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0042</prov:wasDerivedFrom>
