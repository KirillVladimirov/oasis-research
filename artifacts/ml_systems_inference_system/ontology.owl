    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the RPS is scaled to 10 requests/sec to emulate a traffic burst.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#multimodalinput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
