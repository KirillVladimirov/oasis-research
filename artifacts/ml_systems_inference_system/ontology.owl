    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">providing a strong signal for our VL-Cache to evict insignificant visual tokens.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#ondemandreplica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
