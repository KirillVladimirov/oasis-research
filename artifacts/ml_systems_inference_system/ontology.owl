    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An environment where multiple clients or tenants share underlying hardware resources, often with limited visibility into hardware topology.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0196</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0196</prov:wasDerivedFrom>
