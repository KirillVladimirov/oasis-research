    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A deployment mode where LoRA matrices are computed dynamically during inference without merging weights into the base model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0181</hasCQ>
