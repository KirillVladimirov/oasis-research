    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">normalized queueing delays of short requests with and without the presence of long requests.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#on_fly_computation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
