    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2503.06433_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In contrast, pipeline parallelism partitions the model into sequential stages</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#isappliedto">
