    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A request characterized by a long context that can cause head-of-line blocking for other requests in a queue.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0121</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0235</hasCQ>
