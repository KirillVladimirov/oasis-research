    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A burst of submission is a workload in which users submit lots of requests to the LLM server suddenly</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#greedy_decoding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
