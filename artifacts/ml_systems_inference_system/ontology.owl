    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unlike the traditional attention algorithms, PagedAttention allows storing continuous keys and values in non-contiguous memory space.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#adapterrank">
