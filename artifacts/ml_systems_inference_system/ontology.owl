    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">906419cd502575b617cc489a1a696a67-Paper-Conference_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2511.22880_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2401.11240_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2411.00915_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VaLoRA identifies its LoRA adapter, dispatches it to the adapter, then generates a response</hasEvidenceText>
