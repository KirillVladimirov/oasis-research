    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2512.03416_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">concurrency-based policies, which track the number of requests actively in the queue</hasEvidenceText>
