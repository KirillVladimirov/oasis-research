    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To study the impact of long requests on head-of-line blocking under a FIFO scheduling strategy</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#schedulingpolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
