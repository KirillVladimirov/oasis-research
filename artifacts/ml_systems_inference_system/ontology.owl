    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">encompassing those supporting greedy decoding ( 6.1 ) and speculative sampling ( 6.2 ) in LLM inference.</hasEvidenceText>
  </rdf:Description>
