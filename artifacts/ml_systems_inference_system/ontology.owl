    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship describing how quantization levels impact the precision or accuracy of the model.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0123</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0123</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2025.findings-acl.952_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">further pushing the quantization limit to under 4-bit, e.g., 2-bit, 18507 leads to major performance loss.</hasEvidenceText>
  </rdf:Description>
