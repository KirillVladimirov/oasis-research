    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optionally restrict candidates using top- [15] or top- [23] filtering</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#inferenceefficiency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
