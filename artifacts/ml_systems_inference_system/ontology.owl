    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Techniques that involve tuning a small fraction of parameters to adapt pre-trained models to specific tasks.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0155</hasCQ>
