    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific cycle or round in the active learning process where a subset of examples is labeled.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0108</hasCQ>
