    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optimal uncertainty threshold</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#influencesstabilityvia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/S0/R1#querybatchsize"/>
    <rdfs:range rdf:resource="http://example.org/S0/R1#trainingiterationcount"/>
