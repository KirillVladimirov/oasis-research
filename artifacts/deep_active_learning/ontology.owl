    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wasserstein distance is widely used for computing distribution distance</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">select points that minimize the Wasserstein distance</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#updates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
