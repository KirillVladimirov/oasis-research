    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metric used to determine which samples should be queried based on their uncertainty ranking.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0123</hasCQ>
