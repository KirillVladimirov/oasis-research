    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">199-0420_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">199-0420_rag::chunk_011</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">try to improve the winner model to accelerate its convergence. We term these two characteristics as exploration and exploitation</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the improvement of winner models should be preferred later.</hasEvidenceText>
  </rdf:Description>
