    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A naive acquisition function that selects data points uniformly at random from the pool set.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0022</hasCQ>
