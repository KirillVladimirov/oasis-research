    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasConvergenceSpeed</rdfs:label>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0072</hasCQ>
