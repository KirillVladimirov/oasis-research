    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0080</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">22-2203.13450v3_rag::chunk_016</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">22-2203.13450v3_rag::chunk_009</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">26-2009.00236v2_rag::chunk_022</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enhancing methods might not work well on all tasks</hasEvidenceText>
