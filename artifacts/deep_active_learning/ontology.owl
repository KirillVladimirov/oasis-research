    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">this querying strategy has implicitly considered the label diversity (also veried in Table 2) by formulating a K -center problem</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#uncertainty_threshold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
