    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">49-1904.00370v3_rag::chunk_006</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">introduced novel active learners that do not require prior knowledge</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The goal of the active learner is to train the most label-efcient model by iteratively querying a xed sampling budget</hasEvidenceText>
