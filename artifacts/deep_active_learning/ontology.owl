    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The high-dimensional space where data points are represented and compared for similarity.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0051</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0051</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">60-2022.findings-emnlp.235_rag::chunk_003</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquiring contrastive data points that are similar in the model feature space but differ in models predictive likelihoods.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_35">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
