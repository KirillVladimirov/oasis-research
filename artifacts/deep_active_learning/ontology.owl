    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">40-1702.07956v5_rag::chunk_001</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAAL algorithm. The learner synthesizes samples for querying using GAN.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#trainingset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
