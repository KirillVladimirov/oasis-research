    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relationship where the choice of batch size affects the performance trajectory and stability of the learning process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0075</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0075</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">136-2110.14171v1_rag::chunk_012</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The curves demonstrate that the performance of smaller batch sizes (5 or 10) is superior to that of large batch sizes (50 or 100), especially in the early rounds of training</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#sdalalgorithm">
