    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">56-2011.04194v3_rag::chunk_010</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The budget at each acquisition cycle is xed</hasEvidenceText>
