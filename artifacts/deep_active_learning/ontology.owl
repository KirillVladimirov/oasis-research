    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operatesWithBatchSize</rdfs:label>
    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an active learning method to the specific size of the data batches it processes.</skos:skos_definition>
