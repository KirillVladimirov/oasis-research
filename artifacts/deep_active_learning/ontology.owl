    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">virtual data instance to be augmented</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">providing virtual data instances to train models.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#performs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
