    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The preference for improving winner models or focusing on high-performing candidates later in the learning process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0071</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0136</hasCQ>
