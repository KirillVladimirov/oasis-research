    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A distance metric used for computing distribution distance, often employed in active learning to select representative points.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0037</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0037</prov:wasDerivedFrom>
