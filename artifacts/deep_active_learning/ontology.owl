    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique used to group data points into clusters to ensure diversity in the selection process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0226</prov:wasDerivedFrom>
