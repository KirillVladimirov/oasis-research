    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An active learning approach where a model selects unlabeled examples that it cannot classify with certainty to be labeled and used for re-training.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0028</hasCQ>
