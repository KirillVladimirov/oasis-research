    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A constraint or limit, often set upfront, on the resources available for learning or data labeling.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0034</hasCQ>
