    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">113-2111.02275v2_rag::chunk_005</hasEvidenceChunk>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">102-2203.07034v1_rag::chunk_004</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We focus on using epistemic uncertainty to identify the most informative points for label acquisition.</hasEvidenceText>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">These methods favour points that lie close to the decision boundary, but as they rely entirely on the predicted class likelihoods</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#costsensitivelossfunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
