    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAAL, as an exploitation scheme, performs even better in combination with an exploration scheme.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#Axiom_48">
