    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A method that combines multiple models to obtain a more powerful model or to estimate prediction uncertainty.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0026</hasCQ>
