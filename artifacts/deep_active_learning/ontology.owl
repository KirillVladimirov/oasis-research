    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An active learning approach where the learner is supplied with a collection of unlabeled and labeled samples to select the best instances to query.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0025</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0033</hasCQ>
