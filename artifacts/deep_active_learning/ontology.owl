    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methods where label querying can be performed only after the model updating in each iteration.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0116</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0116</prov:wasDerivedFrom>
