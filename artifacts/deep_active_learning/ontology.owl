    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Logits or predictions generated by a superior model from a previous iteration used as a consistency regularizer.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0134</hasCQ>
