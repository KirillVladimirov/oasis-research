    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A variant of the loss function designed to handle class imbalance during the learning or selection process.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0112</prov:wasDerivedFrom>
    <hasEvidenceChunk rdf:datatype="http://www.w3.org/2001/XMLSchema#string">28-s10994-023-06454-2_rag::chunk_016</hasEvidenceChunk>
    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">introduced a costsensitive variant of the loss function, for dealing with class-imbal</hasEvidenceText>
  </rdf:Description>
