    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A boundary in the input space that separates different classes, often targeted by active learning strategies to reduce annotations.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0138</hasCQ>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0177</hasCQ>
