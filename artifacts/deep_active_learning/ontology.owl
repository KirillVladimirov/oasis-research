    <skos:skos_definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A framework where the goal is to achieve better performance with relatively fewer but representative training samples.</skos:skos_definition>
    <hasCQ rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0153</hasCQ>
    <prov:wasDerivedFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CQ_S0_R1_0153</prov:wasDerivedFrom>
