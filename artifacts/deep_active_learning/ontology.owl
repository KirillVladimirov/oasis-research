    <hasEvidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">only 1-10 examples per class are labeled each round.</hasEvidenceText>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/S0/R1#sampleselectionbiascorrectionstrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
