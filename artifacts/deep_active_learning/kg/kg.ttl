:active_learning_scenario a owl:Class ;
    rdfs:label "Active Learning Scenario"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0005"^^xsd:string,
        "CQ_S0_R1_0021"^^xsd:string ;
    :hasEvidenceChunk "24-active-survey_rag::chunk_002"^^xsd:string,
        "26-2009.00236v2_rag::chunk_004"^^xsd:string,
        "28-s10994-023-06454-2_rag::chunk_004"^^xsd:string ;
    :hasEvidenceText "AL approaches can be divided into membership query synthesis [ 10 , 113 ], stream-based selective sampling [ 41 , 118 ] and pool-based [ 131 ] AL from application scenarios"^^xsd:string,
        "Active learning can be broadly categorized into three macro scenarios, based on how the unlabeled instances are supplied to the learner and then selected to be labeled by an oracle."^^xsd:string,
        "Numerous strategies are possible for different active learning scenarios. At the highest level, this corresponds to the broader framework of how the queries are posed to the learner."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A high-level categorization of different methods for approaching active learning based on how unlabeled instances are supplied and selected."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0005"^^xsd:string,
        "CQ_S0_R1_0021"^^xsd:string .

:activelearningquery a owl:Class ;
    rdfs:label "ActiveLearningQuery"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0207"^^xsd:string ;
    :hasEvidenceChunk "193-0314_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "physical capability to respond to active learning queries as measured by the number of queries that are made"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A request issued to an oracle for a label or observation in an active learning system."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0207"^^xsd:string .

:bald a owl:Class ;
    rdfs:label "BALD"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0022"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0125"^^xsd:string,
        "CQ_S0_R1_0139"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string ;
    :hasEvidenceChunk "113-2111.02275v2_rag::chunk_007"^^xsd:string,
        "26-2009.00236v2_rag::chunk_009"^^xsd:string,
        "35-1703.02910v1_rag::chunk_007"^^xsd:string,
        "48-1904.11643v1_rag::chunk_006"^^xsd:string ;
    :hasEvidenceText "BALD represents an irreducible measure of uncertainty. That is, BALD will be high"^^xsd:string,
        "I ( ; | , ) used in BALD is to estimate the mutual information between model parameters and model predictions."^^xsd:string,
        "In Bayesian Active Learning by Disagreement (BALD) scheme ( Houlsby et al. , 2011 ), the most informative sample x is selected"^^xsd:string,
        "In Bayesian Active Learning by Disagreement (BALD) scheme ( Houlsby et al. , 2011 ), the most informative sample x is selected from the (unlabeled) pool data D pool"^^xsd:string,
        "resulting in a computationally tractable estimator approximating the BALD acquisition function."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "Bayesian Active Learning by Disagreement, a scheme where samples are selected by maximizing the difference between the entropy of the predictive distribution and the expected entropy of the model's predictions."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0001"^^xsd:string,
        "CQ_S0_R1_0022"^^xsd:string,
        "CQ_S0_R1_0100"^^xsd:string,
        "CQ_S0_R1_0125"^^xsd:string,
        "CQ_S0_R1_0139"^^xsd:string,
        "CQ_S0_R1_0185"^^xsd:string .

:batch a owl:Class ;
