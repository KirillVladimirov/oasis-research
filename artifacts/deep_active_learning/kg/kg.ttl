:activelearningcycle a owl:Class ;
    rdfs:label "ActiveLearningCycle"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
        "CQ_S0_R1_0133"^^xsd:string ;
    :hasEvidenceChunk "149-2204.07965v1_rag::chunk_005"^^xsd:string,
        "20-2211.14819v2_rag::chunk_003"^^xsd:string,
        "42-1802.09841v1_rag::chunk_002"^^xsd:string ;
    :hasEvidenceText "In a cycle of active learning, the rst step is to get the optimal deep model using existing labeled data. Then, the most valuable batch from the unlabeled pool is selected"^^xsd:string,
        "The main principle of active learning methods lies in iteratively building the training set: the iterative process alternates between training the classier on the current labeled training set"^^xsd:string,
        "These three steps execute in a loop and each iteration is viewed as a cycle (or stage)."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A repetitive process in deep active learning aimed at improving model performance through iterative labeling and training."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0097"^^xsd:string,
        "CQ_S0_R1_0122"^^xsd:string,
