        "CQ_S0_R1_0165"^^xsd:string,
        "CQ_S0_R1_0216"^^xsd:string .

:batch_mode_deepal a owl:Class ;
    rdfs:label "Batch Mode DeepAL"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0043"^^xsd:string,
        "CQ_S0_R1_0067"^^xsd:string ;
    :hasEvidenceChunk "26-2009.00236v2_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "Batch Mode DeepAL (BMDAL). The batch-based query strategy is the foundation of DeepAL. The one-by-one sample query strategy in traditional AL is inefficient and not applicable to DeepAL"^^xsd:string,
        "Batch Mode DeepAL (BMDAL). The batch-based query strategy is the foundation of DeepAL. The one-by-one sample query strategy in traditional AL is inefficient and not applicable to DeepAL, so it is replaced by batch-based query strategy."^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:skos_definition "A query strategy foundation for Deep Active Learning that replaces one-by-one sample queries with batch-based selections for efficiency."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0043"^^xsd:string,
        "CQ_S0_R1_0067"^^xsd:string .

