:cold_start_problem a owl:Class ;
    rdfs:label "Cold Start Problem"^^xsd:string ;
    :hasCQ "CQ_S0_R1_0056"^^xsd:string,
        "CQ_S0_R1_0106"^^xsd:string,
        "CQ_S0_R1_0147"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string,
        "CQ_S0_R1_0195"^^xsd:string ;
    :hasEvidenceChunk "127-1909.03585v1_rag::chunk_010"^^xsd:string,
        "179-2210.02442v1_rag::chunk_000"^^xsd:string,
        "180-2205.11320v3_rag::chunk_001"^^xsd:string,
        "51-1910.07153v2_rag::chunk_008"^^xsd:string ;
    :hasEvidenceText "It may be due to the cold start problem encountered when K 0 = 50."^^xsd:string,
        "a phenomenon sometimes termed \"cold start\" [ 8 , 49 , 16 , 50 , 23 ]. When the budget contains only a few examples, they struggle to improve the models performance"^^xsd:string,
        "active learning fails to select data as efciently as random selection at the rst few choices. We ident"^^xsd:string,
        "the cold start problem can be further aggravated. Treating samples of all classes equally often leads to selecting samples that are likely to be similar or highly correlated, and thus are not representative"^^xsd:string ;
    rdfs:subClassOf :entity,
        owl:Thing ;
    skos:altLabel "ColdStartProblem"^^xsd:string ;
    skos:skos_definition "A challenge in active learning where initial sample selection leads to non-representative or highly correlated data, often aggravated by how classes are treated."^^xsd:string ;
    prov:wasDerivedFrom "CQ_S0_R1_0056"^^xsd:string,
        "CQ_S0_R1_0106"^^xsd:string,
        "CQ_S0_R1_0147"^^xsd:string,
        "CQ_S0_R1_0180"^^xsd:string,
        "CQ_S0_R1_0195"^^xsd:string .

