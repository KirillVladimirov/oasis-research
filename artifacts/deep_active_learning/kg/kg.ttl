    :hasCQ "CQ_S0_R1_0102"^^xsd:string,
        "CQ_S0_R1_0165"^^xsd:string,
        "CQ_S0_R1_0216"^^xsd:string ;
    :hasEvidenceChunk "53-2020.emnlp-main.638_rag::chunk_010"^^xsd:string ;
    :hasEvidenceText "Choosing a batch of diverse examples is often better than choosing one containing very similar and perhaps redundant examples."^^xsd:string,
        "all strategies select examples from the same unlabeled set U while using outputs from the same BERT model. We measure two batch properties"^^xsd:string ;
    rdfs:subClassOf :entity,
