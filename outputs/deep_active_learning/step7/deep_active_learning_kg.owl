  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks aimed at monitoring and updating deployed models.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModelMaintenance</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BayesianUncertaintyBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#BayesianActiveLearning"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents Bayesian active learning methods that use uncertainty for acquisition.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: The child represents a specific acquisition strategy (uncertainty-based) within Bayesian active learning rather than a fundamentally distinct ontological type. Such strategy details are better modeled as properties or annotations on instances of BayesianActiveLearning. Given zero usage and the goal to keep the hierarchy flat, it should be deprecated rather than maintained as a separate subclass.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BayesianUncertaintyBasedActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NaturalLanguageProcessing">
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the general task area of natural language processing.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NaturalLanguageProcessing</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SlopeOfLearningCurve">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: A very specific derived statistic of a learning curve; too fine-grained for the core hierarchy and can be treated as an attribute or computed feature of a PerformanceCurve instead of a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Alternative summary statistic of a learning curve, but not essential to keep as a separate class given the choice of AreaUnderBudgetCurve as the canonical AL performance metric and the goal of minimizing classes.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the slope of a learning curve as a summary statistic.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SlopeOfLearningCurve</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OracleAnnotation">
  <rdfs:subClassOf rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OracleAnnotation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents methods that request labels from an oracle annotator.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Describes interaction/labeling protocol rather than a distinct algorithmic method type; currently unused and quite specific, so it is removed to avoid over-fragmentation.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#GOptimalityCriterion">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Specific G-optimality criterion; unused and overly fine-grained for the current ontology needs. Deprecate and rely on the general AlphabeticOptimalityCriteria class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents G-optimality criteria from optimal design.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GOptimalityCriterion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataSelectionGranularityMetric">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics about the granularity of data selection units.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSelectionGranularityMetric</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DeepActiveLearningTaxonomy">
  <rdfs:subClassOf rdf:resource="#ActiveLearningTaxonomy"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearningTaxonomy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly narrow specialization of ActiveLearningTaxonomy (restricted to deep methods). This distinction can be modeled via properties or annotations rather than a dedicated subclass, in line with the goal of keeping the hierarchy flat.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents taxonomies specifically for deep active learning methods.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PoolBasedDeepActiveLearningProtocols">
  <rdfs:subClassOf rdf:resource="#PoolBasedSampling"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoolBasedDeepActiveLearningProtocols</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: The child refers to experimental protocols related to pool-based deep active learning rather than a distinct subtype of the method itself. It is meta-level and not a core conceptual specialization of the parent. To keep the ontology compact and focused on method types, this class should be deprecated rather than maintained as a separate subclass or merged as a synonym.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents experimental protocols for pool-based deep active learning.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#NeuralMachineTranslation">
  <rdfs:subClassOf rdf:resource="#MachineTranslation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents neural-network-based machine translation tasks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeuralMachineTranslation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PrognosticPrediction">
