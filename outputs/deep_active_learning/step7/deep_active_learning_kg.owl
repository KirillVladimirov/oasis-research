<owl:Class rdf:about="#InfiniteInputSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents an idealized infinite input space for theoretical analysis.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: InfiniteInputSpace is an unused, overly specific variant of InputSpace (distinguished only by cardinality). This detail is better captured via properties or annotations rather than a separate class, so the class is deprecated.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InfiniteInputSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LabelStatistics">
  <rdfs:subClassOf rdf:resource="#LabelStatistics"/>
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents number of labeled samples at a given iteration.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into LabelStatistics</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into NumberOfLabeledSamplesMetric</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics counting labeled samples.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics summarizing label distribution statistics.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabeledSampleCountMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelStatistics</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NumberOfLabeledSamplesMetric</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#SubjectCohortDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets built around subject cohorts, such as patient groups.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Specific to cohort-based (often medical) studies; cohort membership is better treated as metadata and relations on subjects and datasets.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SubjectCohortDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VideoRecognitionTask">
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:subClassOf rdf:resource="#VideoRecognitionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Narrow, unused specialization of VisionTask; temporal/video variants can be modeled later via properties or more focused subclasses only if needed. For now, prune to keep the task hierarchy compact.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into VideoRecognitionTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks for recognizing actions or activities in videos.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents human activity recognition tasks in video data.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VideoRecognitionTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VideoActivityRecognition</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#LabeledDatasetSplit">
  <rdfs:subClassOf rdf:resource="#DataSplit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabeledDatasetSplit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Unused specialization of DataSplit; labeled status can be modeled more compactly via a property (e.g., isLabeled or labelStatus) rather than separate subclasses. Minimizing classes favors deprecating this.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents labeled subsets from a dataset split.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#FriedmanTestFamily">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents families of non-parametric statistical tests.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into NonParametricTests</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents non-parametric Friedman test statistics.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NonParametricTests</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FriedmanTestFamily</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#AVIRISIndianPinesDataset">
