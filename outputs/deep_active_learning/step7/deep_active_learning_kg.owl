<owl:Class rdf:about="#EfficientCganActiveLearning">
  <rdfs:subClassOf rdf:resource="#GAALMethod"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EfficientCganActiveLearning</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents CGAN-based efficient active learning strategies.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a very specific CGAN-based efficient strategy, likely corresponding to a particular method variant from a paper. This level of granularity is unnecessary for the ontology and can be removed to keep the hierarchy flat; the general concept is already covered by the parent GenerativeAdversarialActiveLearning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Specific algorithm variant (Efficient CGAN-based active learning) with no competency question usage. To minimize redundancy, model such methods at the level of the generic parent class GenerativeAdversarialActiveLearning rather than separate named subclasses.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

