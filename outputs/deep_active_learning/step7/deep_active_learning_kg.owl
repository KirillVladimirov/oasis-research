  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents D-optimality criteria from optimal design.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DOptimalityCriterion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LabelingBudget">
  <rdfs:subClassOf rdf:resource="#LabelingBudget"/>
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into AnnotationBudgetConstraint</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into BudgetConstraint</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on the fraction or number of labels that can be acquired.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints reflecting operation under very low labeling budgets.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on the total annotation budget.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a particular regime (very low budget) rather than a qualitatively different kind of constraint. This level (e.g., low/medium/high) is better captured via attributes/values on AnnotationBudgetConstraint rather than separate classes. Mark as deprecated to avoid ontology bloat.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into AnnotationBudget</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic budget constraints on labeling or computation.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents explicit constraints on budget for annotation in experiments.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BudgetConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationBudget</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelingBudget</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowBudgetRegimeConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationBudgetConstraint</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#FundusImages">
  <rdfs:subClassOf rdf:resource="#MedicalImagingData"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Vague and modality/anatomy-based category (“datasets of retinal fundus images”) that blurs image-type vs dataset-type modeling; not clearly required as a separate ontology class compared to specific named datasets and thus can be removed to keep the hierarchy clean.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets of retinal fundus images.</rdfs:comment>
