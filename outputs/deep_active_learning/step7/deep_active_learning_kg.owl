</owl:Class>

<owl:Class rdf:about="#HyperspectralRemoteSensingData">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HyperspectralRemoteSensingData</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents hyperspectral remote sensing image datasets.</rdfs:comment>
