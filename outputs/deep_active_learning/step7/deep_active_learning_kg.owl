  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into QuerySet</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a batch of queries issued in one iteration.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the set of instances selected as queries.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QueryBatch</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuerySet</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#MeanSquaredError">
  <rdfs:subClassOf rdf:resource="#LossFunction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MeanSquaredError</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents mean squared error loss.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataDrivenQueryStrategy">
  <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataDrivenQueryStrategy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents query strategies driven by data structure or distribution.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AnnotationRoundsConstraint">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Number of annotation rounds is a detailed protocol parameter that can be modeled as a property of an experiment rather than a separate constraint class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on the number of annotation rounds in active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationRoundsConstraint</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DomainAdaptationSegmentation">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Describes a learning scenario (domain adaptation) rather than a fundamentally different segmentation task type. This is better captured as a setting or property rather than as a subclass of SegmentationTask.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks under domain adaptation scenarios.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DomainAdaptationSegmentation</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#LabelEfficiency">
  <rdfs:subClassOf rdf:resource="#LabelEfficiency"/>
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelingEfficiencyMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelEfficiency</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents numeric metrics for labeling efficiency.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents how efficiently labels are used to achieve performance.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into LabelEfficiency</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SupervisedLossMetric">
  <rdfs:subClassOf rdf:resource="#LossFunction"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Redundant with SupervisedLoss and not used; the distinction between loss and metric is not modeled consistently in this ontology and can be handled via properties instead of extra classes.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics derived from supervised loss values.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SupervisedLossMetric</rdfs:label>
</owl:Class>

