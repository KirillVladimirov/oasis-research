  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a scenario/setting rather than a task type; misaligned with the Task hierarchy and unused, so it should be redesigned under a Scenario/Setting branch instead of kept here.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic tasks defined on streaming data scenarios.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InfoVAEModel">
  <rdfs:subClassOf rdf:resource="#VariationalAutoencoder"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InfoVAEModel</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: InfoVAE is a specific variant of a Variational Autoencoder, not a general synonym. Given the goal to keep the ontology flat, its zero usage, and the parent already representing VAE models in general, this fine-grained model variant is unnecessarily specific and can be removed rather than modeled as a separate subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents InfoVAE variants used in active learning.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#VariationalAutoencoder">
