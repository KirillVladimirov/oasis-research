<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://deep_active_learning"
         xmlns="http://deep_active_learning#">

<owl:Ontology rdf:about="http://deep_active_learning"/>

<owl:ObjectProperty rdf:about="#datasetHasDomain">
  <rdfs:domain rdf:resource="#Dataset"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">datasetHasDomain</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a dataset to its application domain (e.g., medical imaging, NLP, vision).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#metricEvaluatesTask">
  <rdfs:domain rdf:resource="#Metric"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a metric to the task whose performance it measures.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metricEvaluatesTask</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#acquisitionStrategyOperatesOnDataset">
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:domain rdf:resource="#ActiveLearning"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquisitionStrategyOperatesOnDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates the unlabeled pool or dataset on which an acquisition strategy selects queries.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taskHasDomain">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">taskHasDomain</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a task to its domain (e.g., MedicalImagingDomain, NaturalLanguageProcessingDomain).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#acquisitionStrategyUsesMetric">
  <rdfs:domain rdf:resource="#ActiveLearning"/>
  <rdfs:range rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquisitionStrategyUsesMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an acquisition strategy to the metric it optimizes or relies on (e.g., uncertainty or representativeness).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#activeLearningLoopUsesStrategy">
  <rdfs:range rdf:resource="#ActiveLearning"/>
  <rdfs:domain rdf:resource="#ActiveLearningLoop"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an active learning loop to the acquisition strategy it employs.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activeLearningLoopUsesStrategy</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodProducesModel">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a learning method to the resulting model object (e.g., classifier or segmentor).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodProducesModel</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#datasetUsedForTask">
  <rdfs:domain rdf:resource="#Dataset"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a dataset is used to instantiate or study a task.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">datasetUsedForTask</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodEvaluatedByMetric">
  <rdfs:range rdf:resource="#Metric"/>
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a method to metrics used to evaluate its performance.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodEvaluatedByMetric</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#metricSensitiveToConstraint">
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:domain rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a metric’s value or applicability depends on a given constraint.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metricSensitiveToConstraint</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taskConstrainedBy">
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:domain rdf:resource="#Annotation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">taskConstrainedBy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a task operates under a particular constraint.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#modelInducesUncertaintyMetric">
  <rdfs:domain rdf:resource="#OtherConcept"/>
  <rdfs:range rdf:resource="#ModelUncertainty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a model to the uncertainty metric derived from its predictions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modelInducesUncertaintyMetric</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodUsesPretrainedModel">
  <rdfs:range rdf:resource="#Method"/>
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method uses another method as a pretrained model or backbone.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodUsesPretrainedModel</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodSolvesTask">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a method to the task or problem it is designed to solve.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodSolvesTask</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodTestedOnDataset">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodTestedOnDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method is evaluated or tested on a particular dataset.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodComposedOfComponent">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodComposedOfComponent</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents that a complex method is composed of sub-methods or modules.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodSubjectToConstraint">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodSubjectToConstraint</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method must satisfy or is analyzed under a given constraint.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#annotatorProvidesLabelsForDataset">
  <rdfs:domain rdf:resource="#OtherConcept"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that an annotator or oracle provides labels for a given dataset.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">annotatorProvidesLabelsForDataset</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodTrainedOnDataset">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodTrainedOnDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method is trained using a particular dataset.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#activeLearningLoopQueriesOracle">
  <rdfs:domain rdf:resource="#ActiveLearningLoop"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activeLearningLoopQueriesOracle</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an active learning loop to its oracle or annotator concept.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#QuantifiesUncertainty">
  <rdfs:domain rdf:resource="#Entropy"/>
  <rdfs:range rdf:resource="#Uncertainty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Margin"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuantifiesUncertainty</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a predictive entropy-based metric to the uncertainty it is intended to quantify in a model’s predictions or acquisition strategy. This property captures that predictive entropy is a specific metric used to operationalize or measure uncertainty in deep active learning.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#GuidedByUncertainty">
  <rdfs:domain rdf:resource="#Annotation"/>
  <rdfs:range rdf:resource="#Uncertainty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GuidedByUncertainty</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an annotation process to the uncertainty estimate or signal used to select which data items (images, slices, patches, regions) are annotated in a deep active learning setup. This property captures that annotations are focused on samples identified as informative based on model prediction uncertainty.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#AnnotatesTask">
  <rdfs:domain rdf:resource="#Annotation"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotatesTask</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an Annotation to the Task it is created to support in a deep active learning setting (e.g., classification, segmentation, translation). This captures that annotations are produced and budgeted with respect to a specific learning or evaluation task.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#BasedOnUncertainty">
  <rdfs:domain rdf:resource="#BALD"/>
  <rdfs:range rdf:resource="#Uncertainty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BasedOnUncertainty</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a Bayesian active learning strategy to the notion of uncertainty it exploits for selecting informative samples. This property indicates that the acquisition method’s criterion is derived from or fundamentally depends on model uncertainty (e.g., Bayesian or predictive uncertainty).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAnnotation">
  <rdfs:domain rdf:resource="#Dataset"/>
  <rdfs:range rdf:resource="#Annotation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasAnnotation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a dataset to the annotations that have been collected for its samples, for example under a given annotation budget in a deep active learning protocol. This captures that parts of the dataset are labeled through human or automated annotation processes.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesUncertaintyMetric">
  <rdfs:domain rdf:resource="#BALD"/>
  <rdfs:range rdf:resource="#Entropy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">usesUncertaintyMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an active learning acquisition function to an uncertainty metric that it uses to define or compute its acquisition score. In this context, BayesianActiveLearningByDisagreement uses the predictive entropy metric as part of its mutual-information-based acquisition criterion.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#AppliedToDataset">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AppliedToDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a task to a dataset on which that task is defined, studied, or evaluated in a deep active learning setting. This captures cases such as a classification or segmentation task being carried out on a specific benchmark dataset. It is intended for experimental or study-specific task instances rather than abstract task types.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#UsesUncertaintyMeasure">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Uncertainty"/>
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UsesUncertaintyMeasure</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a task in a deep active learning protocol to the notion(s) of uncertainty it relies on for scoring or selecting samples (e.g., uncertainty-based or uncertainty-driven acquisition). This captures that the task’s acquisition or decision process is explicitly based on model uncertainty as an informativeness criterion.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#RequestsAnnotation">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Annotation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RequestsAnnotation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a deep active learning method to the annotations it triggers or relies on being obtained. A Method requests Annotation when it selects samples to be labeled, models annotation time or cost, or otherwise depends on human-provided labels as part of its acquisition strategy.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#UsedForParsing">
  <rdfs:domain rdf:resource="#Annotation"/>
  <rdfs:range rdf:resource="#Parsing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UsedForParsing</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an annotation to a parsing task or parser that it is created for or used to train, adapt, or evaluate. This captures that annotations (e.g., syntactic or semantic labels) provide supervision specifically for parsing in deep active learning workflows.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#computedOnDataset">
  <rdfs:domain rdf:resource="#Uncertainty"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">computedOnDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an Uncertainty (e.g., uncertainty scores, distributions, or measures) to the Dataset whose samples were used to compute it in a deep active learning setting. This captures that uncertainty-based methods evaluate model uncertainty with respect to particular datasets or data pools. The property can also be reused for other uncertainty computations tied to specific datasets.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#BatchVariantOfAcquisitionFunction">
  <rdfs:domain rdf:resource="#BatchBALD"/>
  <rdfs:range rdf:resource="#BALD"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchVariantOfAcquisitionFunction</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a batch deep active learning acquisition method to the underlying single-point acquisition function that it generalizes or is derived from. For example, BatchBALD is a batch variant of the BALD acquisition function, using joint mutual information over batches instead of independent per-point scoring.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#EvaluatedWithMetric">
  <rdfs:domain rdf:resource="#Dataset"/>
  <rdfs:range rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EvaluatedWithMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a dataset to a metric that is used to evaluate or quantify performance, similarity, or selection quality on that dataset in a deep active learning context. This includes both evaluation metrics (e.g., accuracy, Dice score) and distance/similarity metrics applied over samples from the dataset.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#SelectedUsingInformativenessMetric">
  <rdfs:domain rdf:resource="#Annotation"/>
  <rdfs:range rdf:resource="#Entropy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SelectedUsingInformativenessMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an Annotation to the uncertainty-based informativeness metric (such as a PredictiveEntropyMetric) that was used to rank and select the example or region to be annotated. This captures that the creation of the annotation was driven by scores computed by that metric in an active learning query step.</rdfs:comment>
</owl:ObjectProperty>

<owl:Class rdf:about="#Dataset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root dataset class used as anchor for all concrete datasets and dataset subsets.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OtherConcept">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OtherConcept</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for structural, statistical, and domain concepts that are not tasks, methods, metrics, datasets, or explicit constraints.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Metric">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for evaluation and scoring measures.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Task">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for learning, annotation, and optimization tasks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Task</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:subClassOf rdf:resource="#Method"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningStrategy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningMethod</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionStrategy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents strategies for acquiring new instances to label in active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents methods whose primary purpose is to perform active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ActiveLearning</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ActiveLearningMethod</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents high-level strategies that guide active learning behavior.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Too generic and better modeled as a component (query strategy) of an active learning method rather than a subclass; no usage.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the general active learning methodology and process.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningLoop">
  <rdfs:subClassOf rdf:resource="#ActiveLearningLoop"/>
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ActiveLearningIteration</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Describes the generic process/loop structure, not a specific method family; better modeled as a process pattern, not as a subclass of ActiveLearningMethod.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a single cycle of query selection, annotation, and model update in active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the iterative loop procedure of selecting, labeling, and retraining in active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents one iteration of the active learning loop.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents the process/loop view of active learning rather than a distinct method category. This process notion is not essential for distinguishing methods and can be modeled procedurally if needed, so the class is deprecated to reduce clutter.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ActiveLearningLoop</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningIteration</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningLoop</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningCycle</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Method">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for algorithms, procedures, and learning methods.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Constraint">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for resource, data, and setting constraints.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constraint</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Annotation">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents annotation objects linking data to labels or structures.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annotation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ModelUncertainty">
  <rdfs:subClassOf rdf:resource="#Uncertainty"/>
  <rdfs:subClassOf rdf:resource="#ModelUncertainty"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific uncertainty metrics used in acquisition.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Vague, redundant with the general parent UncertaintyMetric; unused in CQs and not tied to a specific computable metric.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Vague and generic; conceptually overlaps with UncertaintyMetric and is unused in CQs, so it adds no essential distinction.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into UncertaintyMeasure</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics that quantify model predictive uncertainty.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: The child represents a measurement/metric concept rather than a clear semantic specialization of the parent concept of uncertainty itself, and it is completely unused (0 CQs, 0 answers). To keep the ontology flat and avoid conflating measures with the abstract concept, it is better to deprecate this subclass; if needed, a dedicated Metric/Measure hierarchy can host such classes in the future.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into UncertaintyMetric</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics that quantify uncertainty.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty associated with individual predictions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictionUncertainty</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModelUncertainty</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyMeasure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Entropy">
  <rdfs:subClassOf rdf:resource="#ModelUncertainty"/>
  <rdfs:subClassOf rdf:resource="#Entropy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents prediction entropy used as an uncertainty score.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents Shannon entropy used as an uncertainty measure.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into Entropy</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Vague grouping category for entropy-derived measures; adds an extra hierarchy layer without current usage. Specific metrics like Entropy and VoteEntropy suffice.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty measures derived from entropy.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into EntropyBasedUncertainty</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific numeric predictive entropy measures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents predictive entropy metrics.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into PredictionEntropy</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic entropy-based uncertainty scores.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into PredictiveEntropy</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into EntropyMeasure</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic entropy-based measures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overlaps strongly with Entropy, which already covers Shannon entropy as an uncertainty measure and is actually used in CQs; keeping both would be confusing, so the more specific, unused variant is removed.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics that compute entropy-based scores.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictiveEntropyMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entropy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictionEntropy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EntropyMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EntropyBasedUncertainty</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictiveEntropy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EntropyMeasure</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EntropyUncertainty</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Uncertainty">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uncertainty</rdfs:label>
