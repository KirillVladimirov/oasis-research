</owl:Class>

<owl:Class rdf:about="#StationarityAssumption">
  <rdfs:subClassOf rdf:resource="#StationarityAssumption"/>
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents assumptions that data distribution is stationary over time.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: A broad modeling assumption common to many ML settings; for simplicity, focus on explicit non-stationary/streaming constraints instead of modeling the default stationary case as its own class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints requiring a stationary data distribution.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into StationarityAssumption</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StationarityAssumption</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StationaryDataDistribution</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#WilcoxonSignedRanksTest">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WilcoxonSignedRanksTest</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the Wilcoxon signed-ranks test statistic.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OnlineActiveLearningTaxonomy">
  <rdfs:subClassOf rdf:resource="#ActiveLearningTaxonomy"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OnlineActiveLearningTaxonomy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents taxonomies for online or streaming active learning scenarios.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Both classes are unused and model specific sub-taxonomies of ActiveLearningTaxonomy. Given the ontology’s focus on deep active learning, DeepActiveLearningTaxonomy is retained as the canonical specialization, while OnlineActiveLearningTaxonomy is deprecated to minimize rarely used, highly specific taxonomy variants.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific to online/streaming scenarios. The scenario can be captured as contextual metadata or properties on instances of ActiveLearningTaxonomy rather than a separate subclass, to avoid unnecessary proliferation of taxonomy classes.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningTaxonomy">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents taxonomical structures used to categorize active learning approaches.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningTaxonomy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DisagreementBasedCriterion">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:subClassOf rdf:resource="#DisagreementBasedCriterion"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisagreementBasedActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisagreementBasedSelection</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisagreementBasedQueryRules</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisagreementBasedCriterion</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents selection methods based on model disagreement.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents criteria to quantify disagreement for active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents an implementation/detail level (rule-based formulations) rather than a major conceptual subtype of disagreement-based active learning. Overly specific and unused; better modeled, if needed, via properties or implementation patterns rather than as a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods driven by disagreement between models or hypotheses.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DisagreementBasedCriterion</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: A criterion (measure of disagreement) is a different ontological kind from the active learning method itself and is too fine-grained for this hierarchy. Given no usage and the goal of a flat, clean ontology, this should be removed or reintroduced later in a dedicated criteria/metrics branch if needed.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DisagreementBasedActiveLearning</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents rule-based formulations of disagreement-based querying.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DatasetFractionConstraint">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Essentially a particular way to express an annotation budget (fraction of a dataset); better represented via properties attached to AnnotationBudget rather than a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints that limit which fraction of a dataset can be labeled.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DatasetFractionConstraint</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DataStreamScenario">
