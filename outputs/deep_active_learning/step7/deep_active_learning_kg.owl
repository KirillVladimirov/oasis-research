  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PointCloudSemanticSegmentationTask</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents semantic segmentation tasks on 3D point cloud data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SubsetOfObjectsDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SubsetOfObjectsDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a particular kind of subset; a single generic subset class (or subset relation) is sufficient and avoids redundant specializations.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents subsets of objects extracted from larger datasets.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#3DMedicalImageSegmentation">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
