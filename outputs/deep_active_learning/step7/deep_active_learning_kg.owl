  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3DMedicalImageSegmentationBenchmarks</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalImageDataset</rdfs:label>
