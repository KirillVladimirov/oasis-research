<owl:Class rdf:about="#LabeledSourceData">
  <rdfs:subClassOf rdf:resource="#LabeledSet"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: The child class refers to individual labeled source-domain examples, while the parent refers to datasets (collections). This is a granularity distinction that is better modeled via instances or a separate modeling pattern rather than as a closely named subclass. Given zero usage and to avoid confusion between nearly identical labels, the subclass is deprecated rather than kept or treated as an alias.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents labeled source-domain examples.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabeledSourceData</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

