<owl:Class rdf:about="#PointCloudDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PointCloudDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: 3D point cloud is a data modality; to prevent many modality-specific dataset classes, model this via modality features on Dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets consisting of 3D point clouds.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CosineDistanceMetric">
  <rdfs:subClassOf rdf:resource="#DistanceMetric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CosineDistanceMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Both subclasses of DistanceMetric are currently unused (num_cqs=0). To minimize class proliferation, retain a single representative concrete metric (L2DistanceMetric) and deprecate CosineDistanceMetric as an unnecessary fine-grained distinction for the current ontology scope.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents cosine-distance based metrics.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#QuerySet">
