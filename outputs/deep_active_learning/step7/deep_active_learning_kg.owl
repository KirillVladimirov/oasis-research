  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents criteria based on sample representativeness.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into RepresentativenessMetric</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics quantifying representativeness.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic representativeness measures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents representativeness metrics at sample level.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a selection/decision criterion rather than a metric itself; it is conceptually different from the parent and should live in a separate criterion/strategy hierarchy rather than under RepresentativenessMetric.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#GANModel">
  <rdfs:subClassOf rdf:resource="#GANModel"/>
  <rdfs:subClassOf rdf:resource="#GenerativeModel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GANModel</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GenerativeAdversarialNetworks</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GenerativeAdversarialNetwork</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: GAN is a specific type of deep generative model. Given zero usage and a goal of minimizing classes, collapse to the more general DeepGenerativeModel and drop the specific architecture distinction.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into GANModel</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a specific GAN-based generative model.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents GAN-based methods considered as a family.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into GenerativeAdversarialNetwork</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generative adversarial network architectures.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GenerativeModel">
  <rdfs:subClassOf rdf:resource="#Method"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GenerativeModel</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: A generative model is more naturally a Model than a Method; at this level it does not clearly specialize Method and would be better relocated to a model hierarchy, so it is deprecated here to keep the Method branch clean.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generative models that capture data distributions.</rdfs:comment>
</owl:Class>

