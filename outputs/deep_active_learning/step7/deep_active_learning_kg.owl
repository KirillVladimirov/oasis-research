  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ImageSegmentationTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks whose goal is to segment images or volumes into meaningful regions.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks operating on 3D data such as volumes or point clouds.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks that operate at pixel or voxel level.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents general 2D image segmentation tasks.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into SegmentationTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep-learning-based active learning tasks for segmentation.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks specifically in the medical imaging domain.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific combination of method (deep learning) and learning paradigm (active learning) with the task type. These aspects are better modeled via properties or separate axes rather than a dedicated subclass of SegmentationTask.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PixelLevelSegmentation</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveSegmentation</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageSegmentationTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SegmentationTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ThreeDSegmentationTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalImageSegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VisionTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ActiveLearningTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents computer vision tasks such as classification, detection, and segmentation.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks with explicit clinical relevance or use.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks that involve crawling the web to collect data.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks in natural language processing and related language technologies.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks whose primary focus is to study or apply active learning methods.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks related to analysis of medical images, including classification, segmentation, and reconstruction.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClinicalTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalImageAnalysisTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WebCrawlingTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LanguageTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VisionTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DeepLearningTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks that primarily involve deep learning models.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Refers to the solution method (deep learning) rather than the task itself; this dimension should be modeled via algorithm/model classes, not task subclasses.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepLearningTask</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#InterAnnotatorVariability">
  <rdfs:subClassOf rdf:resource="#AnnotationVariabilityConstraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents variability within a single annotator over time.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into InterAnnotatorVariability</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents variability of annotations across different annotators.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IntraAnnotatorVariability</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InterAnnotatorVariability</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AnnotationVariabilityConstraint">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Inter-annotator variability is one aspect of label quality and can be represented within LabelQualityConstraint without a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints related to variability between annotators.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationVariabilityConstraint</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#RetinalVesselSegmentation">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RetinalBloodVesselSegmentation</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RetinalVesselSegmentation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks of retinal vessels in ophthalmoscopy or fundus images.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks focused on segmenting retinal blood vessels.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into RetinalVesselSegmentation</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: This is effectively a redundant synonym of RetinalVesselSegmentation; in retinal imaging, the vessels of interest are blood vessels. Keep only one retinal vessel segmentation subclass to avoid duplication.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#NaturalImageDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NaturalImageDataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: ‘Natural image’ is a broad domain/modality label that fits better as a property than as its own subclass; avoids proliferation of many such domain labels.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets of natural images.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#RedundantAnnotations">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RedundantAnnotations</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on repeated annotations for the same example.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Semantically similar to RedundantLabelingConstraint and better handled via annotation budget and label-quality modeling rather than a dedicated class.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#OutOfDistributionData">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OutOfDistributionData</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: In-/out-of-distribution status is contextual and task-dependent; better modeled as an attribute or annotation relative to a reference distribution, not as a static dataset subtype.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets containing out-of-distribution samples.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CoreSetStrategy">
  <rdfs:subClassOf rdf:resource="#CoreSetStrategy"/>
  <rdfs:subClassOf rdf:resource="#RepresentativenessBasedSampling"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into CoreSetStrategy</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific implementation-focused subclass (concrete algorithmic implementations) with no usage; not needed for the high-level strategy ontology.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents concrete algorithmic implementations of core-set active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the selection process for core-set based methods.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into CoreSetSelection</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents strategies that select core-sets approximating the data distribution.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods based on core-set selection.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoreSetStrategy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoreSetSelection</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoreSetActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoreSetActiveLearningMethod</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#RepresentativenessBasedSampling">
  <rdfs:subClassOf rdf:resource="#RepresentativenessBasedSampling"/>
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that emphasize sample representativeness.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Representativeness-based methods strongly overlap with diversity/density notions already captured by DiversityBasedActiveLearning and DensityBasedActiveLearning. To avoid a fine-grained but redundant split, this class is deprecated in favor of those broader categories.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents sampling methods focusing on representativeness.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into RepresentativenessBasedActiveLearning</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedSampling</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedActiveLearning</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#MachineTranslation">
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents machine translation tasks between languages.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Distinct NLP task but currently unused (num_cqs=0) and not required by existing competency questions. Deprecating avoids unnecessary task-specific proliferation; can be reintroduced later if needed.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MachineTranslation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SemiSupervisedActiveLearningFramework">
  <rdfs:subClassOf rdf:resource="#ActiveLearningFramework"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents frameworks combining semi-supervised learning and active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Semi-supervised variants of active learning frameworks are a methodological specialization and are unused (num_cqs=0). This distinction is not essential at the ontology level; model such details via properties or documentation rather than a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Combines semi-supervised learning with active learning, but this is better modeled by associating methods/algorithms with an ActiveLearningFramework instance rather than introducing a dedicated subclass. Concept is too specific for the top-level framework hierarchy and currently unused.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SemiSupervisedActiveLearningFramework</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningFramework">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:subClassOf rdf:resource="#ActiveLearningFramework"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents complete frameworks that orchestrate active learning components.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ActiveLearningFramework</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Refers to full frameworks/systems orchestrating components, not to a distinct type of method; better modeled separately from ActiveLearningMethod subclasses.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: ‘Framework’ refers to an architectural or software-level packaging of active learning methods rather than a distinct method type. Since process/architecture distinctions are not modeled elsewhere and this class is unused, it is deprecated for compactness.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents general-purpose frameworks for deep active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GeneralPurposeDeepActiveLearningFramework</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningFramework</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ColonoscopyFrameData">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents video data from colonoscopy procedures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents individual video frames from colonoscopy videos.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Again overly specific to a particular medical procedure and representation; prefer properties on a generic Dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ColonoscopyVideoData</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Very domain-specific; can be captured as medical video modality plus procedure type in metadata rather than a distinct class.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ColonoscopyFrameData</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ColonoscopyVideoData</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#KLDivergence">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:subClassOf rdf:resource="#KLDivergence"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents KL divergence as used in active learning metrics.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents KL divergence metrics.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into KullbackLeiblerDivergence</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KullbackLeiblerDivergence</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KLDivergence</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QueryFunction">
  <rdfs:subClassOf rdf:resource="#Method"/>
  <rdfs:subClassOf rdf:resource="#QueryFunction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuerySelection</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QueryFunction</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuerySelectionMethod</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into QuerySelection</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents functions that map candidate instances to acquisition scores.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the process of selecting queries based on scoring functions.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into QueryFunction</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific query selection algorithms.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DeepLearningMedicalImageAnalysis">
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks that apply deep learning to medical image analysis problems.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: This class distinguishes tasks by implementation method (deep learning) rather than task type; such method-specific subclasses can be modeled via properties instead of separate classes to keep the hierarchy simple.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepLearningMedicalImageAnalysis</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ExpectedErrorReduction">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents selection methods that approximate expected error reduction.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedErrorReduction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MarginBasedUncertainty">
  <rdfs:subClassOf rdf:resource="#ModelUncertainty"/>
  <rdfs:subClassOf rdf:resource="#MarginBasedUncertainty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MarginBasedUncertainty</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MarginBasedUncertaintyMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into MarginBasedUncertainty</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents numeric margin-based uncertainty metrics.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty metrics defined through decision margins.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#QuadraticFormLeverage">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuadraticFormLeverage</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents leverage scores computed via quadratic forms.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UnlabeledDatasetSplit">
  <rdfs:subClassOf rdf:resource="#DataSplit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnlabeledDatasetSplit</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Unused specialization of DataSplit; unlabeled status is better captured via a property on DataSplit. Keeping this separate class is not essential for the domain and adds redundancy.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents unlabeled subsets from a dataset split.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DataSplit">
  <rdfs:subClassOf rdf:resource="#DatasetSlice"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents logical splits of datasets into train, validation, or test parts.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSplit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DatasetSlice">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents subslices or partitions of a dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents another notion of subset/partition; the generic DataSubsets class plus appropriate properties (e.g., isPartitionOf) is sufficient and less redundant.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DatasetSlice</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ImageNetDataset">
  <rdfs:subClassOf rdf:resource="#ImageClassificationDatasets"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the ImageNet dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: ImageNetDataset is a specific dataset instance rather than a necessary ontology class. The more general and reusable concept is ImageClassificationBenchmarks, under which specific datasets can be modeled as instances or external references. Keeping only the generic benchmark class minimizes redundancy while preserving essential distinctions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageNetDataset</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ImageClassificationDatasets">
  <rdfs:subClassOf rdf:resource="#ImageClassificationDatasets"/>
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents benchmark datasets for image classification.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets used for image classification benchmarks.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Task-specific usage (image classification) is better captured as a property of a Dataset rather than a subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ImageClassificationDatasets</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageClassificationBenchmarks</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageClassificationDatasets</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

