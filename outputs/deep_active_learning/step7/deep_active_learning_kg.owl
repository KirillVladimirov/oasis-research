<owl:Class rdf:about="#RepresentativenessMetric">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:subClassOf rdf:resource="#RepresentativenessMetric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedCriterion</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessMeasure</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SampleRepresentativenessMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessMetric</rdfs:label>
