  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID19Diagnosis</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents COVID-19 diagnosis tasks using medical imaging data.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Highly specific to a single disease and scenario; better represented via disease/condition properties linked to a more general medical image diagnosis or classification task.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ACDCSegmentationTask">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the specific ACDC cardiac MRI segmentation benchmark task.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: This refers to a very specific benchmark/dataset (ACDC cardiac MRI). Such dataset-level tasks are too narrow for the ontology class hierarchy and are better modeled as instances or metadata rather than subclasses.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACDCSegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SignTest">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents sign test metrics.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SignTest</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#HighBudgetRegime">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific scenario (high budget) that is better modeled as a value or setting of an annotation budget, not as its own constraint class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents settings with relatively high available annotation budgets.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HighBudgetRegime</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#TrainingSet">
  <rdfs:subClassOf rdf:resource="#TrainingSet"/>
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TrainingSet</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TrainingDataset</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into TrainingDataset</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the dataset used for training a model.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the training set subset of a dataset.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComputationalConstraint">
  <rdfs:subClassOf rdf:resource="#ComputationalConstraint"/>
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComputationalEfficiencyConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComputationalCostConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComputationalConstraint</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ComputationalConstraint</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents general computational resource constraints.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ComputationalCostConstraint</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on computational cost of active learning procedures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints emphasizing efficiency of computation.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DomainAdaptationActiveLearningSetting">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks combining domain adaptation and active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Describes a specific experimental setting (domain adaptation in active learning), not a task; better modeled as a configuration or scenario, so it is deprecated.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DomainAdaptationActiveLearningSetting</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningEvaluationFramework">
  <rdfs:subClassOf rdf:resource="#ActiveLearningFramework"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents frameworks designed to evaluate active learning methods.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Special-purpose evaluation frameworks are a non-critical specialization of ActiveLearningFramework and are unused (num_cqs=0). To keep the ontology compact, do not introduce a separate subclass; instead, reuse the more general ActiveLearningFramework/GeneralPurposeDeepActiveLearningFramework as needed.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Describes a specific use case (evaluation) rather than a fundamentally different kind of framework. This can be captured via a purpose/role property on ActiveLearningFramework instances instead of a dedicated subclass. No usage evidence supports keeping a separate class.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningEvaluationFramework</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#EdgeBasedEntropy">
  <rdfs:subClassOf rdf:resource="#Entropy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EdgeBasedEntropy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: EdgeBasedEntropy is a very specific subtype of EntropyMetric with no recorded usage; to keep the hierarchy flat and avoid over-specialization, it should be deprecated rather than maintained as a separate subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents entropy metrics computed over image edges or boundaries.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#UnlabeledDataStream">
  <rdfs:subClassOf rdf:resource="#DataStream"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnlabeledDataStream</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents unlabeled data arriving in a stream.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LabelScarcityConstraint">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelScarcityConstraint</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints modeling scarcity of labeled data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#L2DistanceMetric">
  <rdfs:subClassOf rdf:resource="#L2DistanceMetric"/>
  <rdfs:subClassOf rdf:resource="#DistanceMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into L2DistanceMetric</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Synonymous with Euclidean distance (L2 norm); redundant alongside EuclideanDistance and not needed as a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents Euclidean L2 distance metrics.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents L2 distance metrics.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">L2DistanceMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EuclideanL2DistanceMetric</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ExpertAnnotationEffort">
  <rdfs:subClassOf rdf:resource="#AnnotationEffort"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Too narrow special case of AnnotationEffortConstraint (limited to expert annotators) without evidence of distinct, frequent use. To keep the hierarchy flat, model such distinctions via properties or annotations rather than a dedicated subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents annotation effort constraints when using expert annotators.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpertAnnotationEffort</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AnnotationEffort">
  <rdfs:subClassOf rdf:resource="#AnnotationEffort"/>
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents explicit constraints on human annotation effort.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into AnnotationEffort</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints that model human annotation effort.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationEffort</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationEffortConstraint</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CleanInDistributionData">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents clean in-distribution data without outliers or noise.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: ‘Clean’ and ‘in-distribution’ are quality/context attributes of a dataset, not fundamental ontological categories; should be represented via properties.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CleanInDistributionData</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SelectionBias">
  <rdfs:subClassOf rdf:resource="#SelectionBias"/>
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints that arise from biased data collections.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into SelectionBias</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints or problems induced by biased selection of training data.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataBiasConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SelectionBias</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RepresentativenessBasedActiveLearningTaxonomy">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents taxonomies that categorize active learning methods by representativeness.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: This denotes a taxonomy about representativeness-based methods rather than a method type itself. It is meta-level, unused, and adds little modeling value at this stage, so it is deprecated.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Meta-level class about taxonomies rather than concrete methods; too indirect as a subclass of ActiveLearningMethod.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedActiveLearningTaxonomy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TyrogueDataset">
  <rdfs:subClassOf rdf:resource="#ImageClassificationDatasets"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the Tyrogue dataset used in some AL benchmarks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TyrogueDataset</rdfs:label>
</owl:Class>

