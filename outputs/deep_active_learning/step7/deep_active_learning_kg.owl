  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningPerformance</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics focusing on performance in active learning contexts.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly broad and informal label for performance in active learning; better represented by concrete metrics such as AreaUnderBudgetCurve. Unused, so removed for compactness.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CombinedMTHTDataset">
