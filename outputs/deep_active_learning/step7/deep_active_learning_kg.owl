  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowResourceSettingConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowResourceSetting</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RealWorldTasks">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents real-world application tasks considered in the active learning literature.</rdfs:comment>
