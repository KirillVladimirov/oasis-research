  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a more specific variety of TestSet; this nuance can be expressed via properties on TestSet rather than a separate subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a hold-out test set for evaluation.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HoldoutTestSet</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#EOptimalityCriterion">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Another specific alphabetic optimality variant with no demonstrated usage. Deprecating in favor of the more general AlphabeticOptimalityCriteria keeps the ontology compact while still representing the family of criteria.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents E-optimality criteria from optimal design.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EOptimalityCriterion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MinimalVarianceCriterion">
