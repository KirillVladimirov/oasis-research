  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific (ties together online setting, active learning, linear regression, and likely algorithm choice); should be reintroduced, if needed, as a combination of simpler concepts rather than a dedicated class.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OnlineActiveLinearRegression</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#BayesianDataAugmentation">
