  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition strategies using expected gradient length as a signal.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedGradientLengthAcquisition</rdfs:label>
</owl:Class>

