  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DensityBasedSampling</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DensityBasedAcquisitionMethod</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DensityBasedAcquisition</rdfs:label>
</owl:Class>

