<owl:Class rdf:about="#DeepActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:subClassOf rdf:resource="#DeepActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: This describes the default case of deep active learning (no transfer learning) and thus does not introduce a meaningful new concept. Keeping it would duplicate the parent semantics and add noise.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Hybrid sampling procedures are a fine-grained design choice within deep active learning, better modeled as algorithmic details or properties. As a separate class it is overly specific and unused.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DeepActiveLearningMethod</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents strategic formulations of deep active learning approaches.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DeepActiveLearning</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods operating in batch mode.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents hybrid sampling procedures within deep active learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods that leverage transfer learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods grounded in Bayesian principles.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: This is an application domain specialization (medical imaging) of the parent. Such domain-specific variants are too narrow for the core ontology and can be captured via application/task properties instead.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep neural active learning methods using approximate Bayesian inference.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning settings without transfer learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into BayesianDeepActiveLearning</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods designed for data streams.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods tailored to medical imaging tasks.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods built on deep neural networks.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific deep active learning algorithms.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Batch mode is a minor configuration detail of deep active learning, not a major conceptual category. With no usage, it is better modeled as a property/attribute rather than a separate class.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearningForMedicalImaging</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepBayesianActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepTransferActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HybridDeepActiveLearningSampling</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepBatchModeActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearningStrategy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BayesianDeepActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearningMethod</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StreamingDeepActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearningWithoutTransfer</rdfs:label>
</owl:Class>

