  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic batch-based active learning procedures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that acquire instances in batches.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents methods that issue batch queries to the oracle.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into BatchQuerySelection</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into BatchModeActiveLearning</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents algorithms that select batches of queries per iteration.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchModeActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchActiveLearning</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchModeQuerySelection</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchQuerySelection</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchBasedQuerying</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PerformanceEstimation">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Describes a process rather than a concrete metric; concept is vague and unused, so it should be removed to avoid modeling confusion.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics estimating performance from limited labels.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Focuses on estimating performance from limited labels, which is more of a methodological aspect of how a metric is obtained than a distinct kind of performance metric; too specialized for the core hierarchy.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PerformanceEstimation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PerformanceMetric">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictivePerformance</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PerformanceMetric</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModelPerformanceMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics summarizing overall model performance.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Redundant generic label for model performance metrics; the parent class ModelPerformanceMetric already covers this notion. No usage, so safe to prune.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic performance metrics.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ModelPerformanceMetric</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Vague, non-metric-specific notion of performance; overlaps with the general ModelPerformanceMetric class and adds no essential distinction.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents performance on predicting labels or outputs.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ChestXrayPneumoniaClassificationTask">
  <rdfs:subClassOf rdf:resource="#MedicalImageClassificationTask"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents pneumonia classification tasks on chest X-ray images.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific classification task (pneumonia on chest X-ray). This should be modeled using attributes of MedicalImageClassificationTask (disease, organ, modality) instead of a separate subclass, to keep the hierarchy flat and general.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific leaf task class with zero usage; adequately covered by the existing parent MedicalImageClassificationTask and can be modeled via properties (modality, disease) instead of dedicated classes.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ChestXrayPneumoniaClassificationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ComputationalCostMetric">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics quantifying computational cost.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ComputationalCostMetric</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StaticDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents static datasets that do not evolve over time.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StaticDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CosineSimilarity">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CosineSimilarity</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents cosine similarity between feature vectors.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SegmentationPerformance">
  <rdfs:subClassOf rdf:resource="#SegmentationPerformance"/>
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics for evaluating segmentation quality.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific performance metrics used for segmentation, such as Dice or IoU.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into SegmentationPerformance</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SegmentationPerformance</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SegmentationPerformanceMetric</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PredictivePerformanceMetric">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictivePerformanceMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Described as numeric predictors of future performance, which blurs the line between meta-features and evaluation metrics and is overly niche; better modeled elsewhere rather than as a core subclass of ModelPerformanceMetric.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents numeric predictors of future performance.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Semantically redundant with the parent ModelPerformanceMetric; no evidence of distinct use, so the extra layer is unnecessary.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningErrorMetric">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningErrorMetric</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics focused on error in active learning experiments.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HybridQueryStrategy">
  <rdfs:subClassOf rdf:resource="#HybridQueryStrategy"/>
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into HybridActiveLearningStrategy</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Hybrid strategies combine multiple criteria (e.g., uncertainty + diversity). This can be modeled via properties or multiple classification of individual methods without a dedicated hybrid superclass. To keep the hierarchy lean, this generic hybrid class is deprecated.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents query strategies that integrate heterogeneous signals.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents methods that combine multiple selection criteria, e.g., uncertainty and diversity.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents sampling strategies that combine different acquisition cues.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into HybridQueryStrategy</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HybridActiveLearningStrategy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HybridQueryStrategy</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HybridSamplingStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Autoencoder">
  <rdfs:subClassOf rdf:resource="#DeepGenerativeModel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autoencoder</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents autoencoder models used for representation learning or data generation.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DeepGenerativeModel">
  <rdfs:subClassOf rdf:resource="#DeepGenerativeModel"/>
  <rdfs:subClassOf rdf:resource="#GenerativeModel"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DeepGenerativeModel</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep learning-based generative models.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Too close to the parent concept and only adds implementation detail (deep learning–based) without a clear, widely needed distinction; also unused in queries, so it can be removed to keep the hierarchy flatter.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the family of deep generative modeling approaches.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepGenerativeModels</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepGenerativeModel</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyEstimator">
  <rdfs:subClassOf rdf:resource="#Method"/>
  <rdfs:subClassOf rdf:resource="#UncertaintyEstimator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyEstimationTechnique</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyEstimationMethod</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyEstimator</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: An "Estimator" is a component/object that produces uncertainty estimates, not itself a technique. As a subclass of UncertaintyEstimationTechnique this is conceptually mismatched and currently unused; better modeled separately under a component/algorithm class if needed.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into UncertaintyEstimationMethod</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into UncertaintyEstimationTechnique</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific methods for estimating uncertainty in models.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents components that output uncertainty estimates for predictions.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents computational techniques used to estimate predictive or parameter uncertainty.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SemanticParsingTask">
  <rdfs:subClassOf rdf:resource="#Parsing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks that map natural language to machine-interpretable meaning representations.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SemanticParsingTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClassificationTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where the goal is to assign discrete labels to instances.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ClassificationTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents general image classification tasks.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents classification tasks on data streams arriving over time.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StreamingClassificationTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClassificationTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageClassificationTask</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#CancerStaging">
  <rdfs:subClassOf rdf:resource="#DiseaseDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CancerStaging</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks that stage the progression of cancer.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VaeAcganModel">
  <rdfs:subClassOf rdf:resource="#DeepGenerativeModel"/>
  <rdfs:subClassOf rdf:resource="#VaeAcganModel"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents VAE-ACGAN models specifically used for query synthesis.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents combined VAE-ACGAN generative models.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into VaeAcganModel</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Very specific architectural variant (combined VAE-ACGAN) with no recorded usage. Overly granular relative to the general DeepGenerativeModel class; better modeled, if needed, as an instance or via properties rather than its own subclass.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VaeAcganGenerativeModel</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VaeAcganModel</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#OracleLabeledDataset">
  <rdfs:subClassOf rdf:resource="#LabeledSet"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Unused and overspecific subclass; provenance of labels (oracle vs pseudo) can be modeled via a property (e.g., hasLabelSource) on LabeledDataset instead of separate classes.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets whose labels were obtained from an oracle annotator.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OracleLabeledDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SmallDatasets">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents small-scale datasets typically used in low-data studies.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Dataset size is a quantitative attribute, not a distinct ontological class; keep as metadata on Dataset instead.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SmallDatasets</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#MultilingualSemanticParsingTask">
  <rdfs:subClassOf rdf:resource="#SemanticParsingTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents semantic parsing tasks across multiple languages.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Multilingual semantic parsing is a contextual/property-level variation (language coverage) of SemanticParsingTask rather than a fundamentally different task type. Given zero usage and a goal to keep the hierarchy flat, this specialization should be modeled via language-related properties instead of a separate subclass.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MultilingualSemanticParsingTask</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#ImageRegion">
  <rdfs:subClassOf rdf:resource="#ImageRegion"/>
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImagePatches</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImagePatchData</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageRegion</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents collections of small image patches.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Being composed of patches is a structural attribute of the data, not a fundamentally different kind of dataset; encode via properties instead.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ImagePatchData</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ImageRegion</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets consisting of image patches.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents spatial regions cut from larger images.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: ImageRegion describes a spatial region cut from an image, which is an individual region concept rather than a dataset, and thus does not cleanly specialize ImagePatchData. It is also unused and semantically misaligned with the parent, so it should be removed rather than merged.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#NonStationaryDataDistribution">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NonStationaryDataDistribution</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints acknowledging that data distributions change over time.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a violation/non-holding of the stationarity assumption rather than a fundamentally separate constraint type. This can be modeled as a property (e.g., assumption validity) on StationarityAssumption or on DataDistribution. The class is also unused (num_cqs=0), so it is deprecated to keep the ontology compact.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DeepImageSegmentation">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepImageSegmentation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: DeepImageSegmentation differs from ImageSegmentationTask only by implementation approach (deep learning vs other methods). The ontology should model tasks independently of specific solution techniques. This subclass adds method-specific detail rather than a distinct task type and has no usage, so it is better deprecated than kept as a separate subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep-learning-based image segmentation tasks.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DataSubsets">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic subsets of datasets.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSubsets</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MRIModality">
  <rdfs:subClassOf rdf:resource="#MRIImaging"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MRIModality</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents MRI modality-specific dataset views.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: MRIModality represents modality-specific views of MRI imaging datasets, which is better modeled as a property or attribute (e.g., T1, T2, fMRI) of MRIImaging datasets rather than a distinct subclass. It does not introduce a clearly distinct, broadly useful conceptual category beyond the parent MRIImaging class.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MRIImaging">
  <rdfs:subClassOf rdf:resource="#MedicalImagingData"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MRIImaging</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets comprising MRI imaging data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VideoSegment">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Video segments are better treated as data items or a structural property of the dataset (segmentation strategy) rather than a separate Dataset subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segments or clips extracted from videos.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VideoSegment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ProductionLineSensors">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ProductionLineSensors</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Highly domain-specific (industrial sensor) data; favor modeling domain and sensor type as attributes of a generic Dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets containing sensor readings from production lines.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#VariationRatio">
  <rdfs:subClassOf rdf:resource="#ModelUncertainty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VariationRatio</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents variation-ratio based uncertainty metrics.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PerformanceBudgetCurve">
  <rdfs:subClassOf rdf:resource="#PerformanceCurve"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a specific type of performance curve (performance vs. labeling budget) that can be modeled using the more general PerformanceCurve class plus properties for the x-axis or budget dimension. Given zero usage and the goal of a flat ontology, this specialization is unnecessary.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents curves tracing performance versus labeling budget.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PerformanceBudgetCurve</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PerformanceCurve">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents performance curves such as learning curves or budget curves.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a curve object rather than a specific metric, but is modeled under ModelPerformanceMetric. Given no usage and the presence of AreaUnderBudgetCurve as the primary curve-based metric, this class is pruned.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PerformanceCurve</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StreamingObservationTargetFraction">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on the fraction of streaming observations that can be labeled.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Very specific numerical constraint on labeling fraction in streaming; better modeled as a property/value under AnnotationBudget or related constraints.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StreamingObservationTargetFraction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StableReliablePerformance">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics evaluating stability and reliability of performance.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Vague, overlaps with general robustness and reliability notions; better modeled via properties (e.g., variance, worst-case) of existing metrics rather than as a separate subclass.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Informal, qualitative notion (stability/reliability) rather than a clearly defined metric; unused and too vague to justify a dedicated class.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StableReliablePerformance</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#LowLabelRegime">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents settings where only a small number of labels are available.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Essentially a scenario name for label scarcity; this is better captured by LabelScarcityConstraint rather than a separate regime class.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LowLabelRegime</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BayesianGenerativeActiveDeepLearning">
  <rdfs:subClassOf rdf:resource="#GenerativeActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods that are both generative and Bayesian.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific intersection of generative, Bayesian, and deep active learning; no usage and adds complexity without clear ontology-level benefit. Better modeled via properties or multiple inheritance elsewhere if needed.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BayesianGenerativeActiveDeepLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TechnicalTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TechnicalTask</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Label is vague and does not denote a clear, reusable task type; no usage, so it is removed rather than merged.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks focusing on technical system properties or algorithmic goals.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DataStream">
  <rdfs:subClassOf rdf:resource="#DataStream"/>
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataStreamDataset</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RealDataStream</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataStream</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Distinguishing real-world vs synthetic data streams is better modeled via properties (e.g., has_source_type) rather than a dedicated subclass; current usage is zero and the notion is orthogonal to the core dataset hierarchy.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents real-world data streams.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DataStreamDataset</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets that are realized as data streams.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic data streams for streaming learning.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DataStream</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DetectionTask">
  <rdfs:subClassOf rdf:resource="#DetectionTask"/>
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BoundingBoxAnnotation</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DetectionTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ObjectCenterAnnotation</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ObjectClassificationAndDetectionTask</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ObjectDetectionTask</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DetectionTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where annotations are object center points.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into ObjectDetectionTask</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents combined classification and detection tasks in vision.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where annotations are bounding boxes around objects.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents object detection tasks in images or videos.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks focused solely on detecting object instances.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#AlphabeticOptimalityCriteria">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the family of A-, D-, E-, and G-optimality criteria.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AlphabeticOptimalityCriteria</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataScarcityConstraint">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints reflecting limited data availability, especially labels.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overlaps heavily with LabelScarcityConstraint; to keep the hierarchy flat, represent label/data scarcity with the latter, more focused class.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataScarcityConstraint</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AreaUnderBudgetCurve">
  <rdfs:subClassOf rdf:resource="#PerformanceMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the area under a budget-performance curve.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AreaUnderBudgetCurve</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MarginBasedAcquisitionStrategy">
  <rdfs:subClassOf rdf:resource="#QueryStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition strategies that use classification margins as uncertainty criteria.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MarginBasedAcquisitionStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ROSISPaviaDataset">
