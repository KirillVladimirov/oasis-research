  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: High-level, unused (num_cqs=0) and can be captured via supervision-type properties on LossFunction rather than dedicated classes; not essential for distinguishing specific DAL methods.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents losses computed from labeled data.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DownstreamTask">
