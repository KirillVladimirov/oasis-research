</owl:Class>

<owl:Class rdf:about="#LabelingCost">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:subClassOf rdf:resource="#LabelingCost"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents annotation cost linked to particular workers in crowdsourcing.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into AnnotationCostConstraint</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into AnnotationCost</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints where annotation cost varies across instances or labels.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into WorkerAnnotationCost</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Too specific to a particular setting (per-worker cost in crowdsourcing) and unused; this can be modeled via properties or metadata on AnnotationCostConstraint rather than as a separate class.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on cost per label acquisition.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents explicit constraints modeling annotation cost.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints associated with the cost of annotation.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationCostConstraint</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationCost</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HeterogeneousAnnotationCost</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WorkerAnnotationCost</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelingCost</rdfs:label>
</owl:Class>

