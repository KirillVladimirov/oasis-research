  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into InformativenessMetric</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic informativeness measures.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into InformativenessScore</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics quantifying sample informativeness.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InformativenessScore</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InformativenessMeasure</rdfs:label>
