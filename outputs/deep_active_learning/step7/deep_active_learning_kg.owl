  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the Pneumonia-MNIST chest X-ray dataset.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AnnotationAction">
  <rdfs:subClassOf rdf:resource="#Method"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents atomic annotation actions taken by annotators.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents fine-grained annotation steps by annotators, which is more of a workflow/event notion than a core methodological subclass; unused and overly granular, so deprecated.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationAction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiseaseDiagnosis">
  <rdfs:subClassOf rdf:resource="#DiseaseDiagnosis"/>
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiseaseDiagnosis</rdfs:label>
