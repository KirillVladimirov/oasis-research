  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints arising from medical annotation workflows.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalAnnotationConstraints</rdfs:label>
