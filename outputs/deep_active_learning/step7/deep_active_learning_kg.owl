  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents large datasets lacking labels.</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
