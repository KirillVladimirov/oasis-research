</owl:Class>

<owl:Class rdf:about="#AOptimalDesign">
  <rdfs:subClassOf rdf:resource="#AOptimalDesign"/>
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AOptimalDesign</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AOptimalityCriterion</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into AOptimalityCriterion</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents A-optimality criteria from optimal design.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Very specific alphabetic optimality criterion; no competency questions or answers use it. For a compact ontology, represent alphabetic optimality generically via AlphabeticOptimalityCriteria and drop unused fine-grained variants.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics specific to A-optimal design objectives.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RepresentationLearningBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that operate in learned representation spaces.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Representation-learning-based active learning is a narrower design pattern, largely subsumed within modern DeepActiveLearning techniques. Given the goal of a compact ontology and the presence of DeepActiveLearning as a broader key class, this extra specialization is deprecated.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentationLearningBasedActiveLearning</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#InteractiveMedicalImageSegmentation">
