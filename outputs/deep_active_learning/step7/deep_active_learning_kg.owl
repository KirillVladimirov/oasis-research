  <rdfs:subClassOf rdf:resource="#LossFunction"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Generic and unused (num_cqs=0); supervision type is better modeled as an attribute of LossFunction rather than separate classes in a compact ontology.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents losses computed from unlabeled data.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnsupervisedLoss</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#LossFunction">
  <rdfs:subClassOf rdf:resource="#Metric"/>
