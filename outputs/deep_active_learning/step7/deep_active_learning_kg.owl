  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents topology or structure optimization tasks solved under constraints.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TopologyStructureOptimizationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PseudoLabeledDataset">
  <rdfs:subClassOf rdf:resource="#LabeledSet"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets with labels assigned via pseudo-labeling.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Unused and overspecific subclass; provenance of labels (oracle vs pseudo) should be captured via a label-source property on LabeledDataset rather than separate subclasses.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PseudoLabeledDataset</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#NaturalImageData">
  <rdfs:subClassOf rdf:resource="#NaturalImageDataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents natural image data points.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: NaturalImageData represents individual data points, not datasets; modeling it as a subclass of NaturalImageDataset is conceptually incorrect. It is also unused. To keep the ontology clean and avoid conflating datasets with instances, deprecate this subclass rather than merging it into the dataset concept.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NaturalImageData</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DatasetCollection">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: A collection of datasets is better modeled via relationships (e.g., hasPart) between Datasets rather than a separate subclass of Dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a collection or suite of datasets.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DatasetCollection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AnnotationProcess">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks describing the annotation of data by humans or oracles.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnnotationProcess</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AcquisitionLatency">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints on latency incurred by acquisition strategies.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Narrow aspect of computational/temporal cost that can be captured within ComputationalCostConstraint and RealTimeConstraint without its own class.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionLatency</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#DeepActiveLearningBenchmark">
  <rdfs:subClassOf rdf:resource="#DatasetCollection"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Overly specific subset of benchmark collections (those compiled in survey-based studies), with no usage. Not a broadly important specialization of DatasetCollection, so it is removed to avoid unnecessary hierarchy complexity.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents benchmark collections compiled in survey-based studies.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into DeepActiveLearningBenchmark</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents collections of datasets used to benchmark deep active learning methods.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Too domain-specific and unused; represents a particular use case of dataset collections (benchmarking deep active learning methods) rather than a generally needed ontological distinction. Flattened to keep the hierarchy simple.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SurveyBasedActiveLearningBenchmarks</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveLearningBenchmark</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

