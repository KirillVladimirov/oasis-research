  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SubsetOfObjectsDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataSubsets">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic subsets of datasets.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSubsets</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StaticDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents static datasets that do not evolve over time.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StaticDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QuerySet">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
