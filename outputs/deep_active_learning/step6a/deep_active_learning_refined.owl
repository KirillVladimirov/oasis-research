  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyBasedActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyBasedCriterion">
  <rdfs:subClassOf rdf:resource="#UncertaintyBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents quantitative criteria used to rank instances by uncertainty.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyBasedCriterion</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyBasedBatchAcquisition">
  <rdfs:subClassOf rdf:resource="#UncertaintyBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents batch acquisition methods based primarily on uncertainty scores.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyBasedBatchAcquisition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyDrivenAcquisition">
  <rdfs:subClassOf rdf:resource="#UncertaintyBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition methods whose objective is informed by uncertainty.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyDrivenAcquisition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyBasedObjective">
  <rdfs:subClassOf rdf:resource="#UncertaintyBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents objective functions that use uncertainty to guide active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyBasedObjective</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyInformationBasedMethod">
  <rdfs:subClassOf rdf:resource="#UncertaintyBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents methods that combine uncertainty with information-based criteria.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyInformationBasedMethod</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyEstimationTechnique">
  <rdfs:subClassOf rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents computational techniques used to estimate predictive or parameter uncertainty.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyEstimationTechnique</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyEstimationMethod">
  <rdfs:subClassOf rdf:resource="#UncertaintyEstimationTechnique"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific methods for estimating uncertainty in models.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyEstimationMethod</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyEstimator">
  <rdfs:subClassOf rdf:resource="#UncertaintyEstimationTechnique"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents components that output uncertainty estimates for predictions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyEstimator</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiversityBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that explicitly promote diversity in selected batches.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiversityBasedActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiversityBasedSelection">
  <rdfs:subClassOf rdf:resource="#DiversityBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents selection procedures whose primary goal is to ensure diversity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiversityBasedSelection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiversityBasedDeepActiveLearning">
  <rdfs:subClassOf rdf:resource="#DiversityBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep active learning methods emphasizing diversity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiversityBasedDeepActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiversityBasedAcquisition">
  <rdfs:subClassOf rdf:resource="#DiversityBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition procedures that enforce diversity among queries.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiversityBasedAcquisition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiversityAwareSelection">
  <rdfs:subClassOf rdf:resource="#DiversityBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents selection methods explicitly aware of redundancy and diversity trade-offs.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiversityAwareSelection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DiversityAwareBatchSelection">
  <rdfs:subClassOf rdf:resource="#DiversityBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents batch selection procedures combining informativeness and diversity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiversityAwareBatchSelection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RegionBasedDiversityAwareActiveLearning">
  <rdfs:subClassOf rdf:resource="#DiversityBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents region-based active learning methods that also enforce diversity.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RegionBasedDiversityAwareActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RepresentativenessBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that emphasize sample representativeness.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RepresentativenessBasedSampling">
  <rdfs:subClassOf rdf:resource="#RepresentativenessBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents sampling methods focusing on representativeness.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedSampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RepresentativenessBasedActiveLearningTaxonomy">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents taxonomies that categorize active learning methods by representativeness.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentativenessBasedActiveLearningTaxonomy</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deprecated: Represents a meta-level taxonomy/organizational construct rather than a concrete active learning method; keeping only the method class yields a cleaner, more reusable ontology. The taxonomy concept is mis-modeled as an ActiveLearningMethod and is better handled via annotation or external classification schemes rather than as a separate OWL class.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RepresentationLearningBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that operate in learned representation spaces.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentationLearningBasedActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ExpectedErrorReduction">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents selection methods that approximate expected error reduction.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedErrorReduction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ExpectedModelChangeActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods driven by expected model change scores.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedModelChangeActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ExpectedModelChangeMethod">
  <rdfs:subClassOf rdf:resource="#ExpectedModelChangeActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents concrete algorithms that implement expected model change selection.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedModelChangeMethod</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ExpectedModelChangeSampling">
  <rdfs:subClassOf rdf:resource="#ExpectedModelChangeActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents sampling procedures based on expected gradient or parameter changes.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedModelChangeSampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ExpectedGradientLengthAcquisition">
  <rdfs:subClassOf rdf:resource="#ExpectedModelChangeActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition strategies using expected gradient length as a signal.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ExpectedGradientLengthAcquisition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PoolBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents pool-based active learning setups where queries are drawn from a static unlabeled pool.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoolBasedActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PoolBasedSampling">
  <rdfs:subClassOf rdf:resource="#PoolBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic pool-based sampling strategies.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoolBasedSampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PoolBasedDeepActiveLearning">
  <rdfs:subClassOf rdf:resource="#PoolBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents pool-based active learning methods built on deep models.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoolBasedDeepActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PoolBasedDeepActiveLearningProtocols">
  <rdfs:subClassOf rdf:resource="#PoolBasedDeepActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents experimental protocols for pool-based deep active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoolBasedDeepActiveLearningProtocols</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PoolBasedUncertaintySampling">
  <rdfs:subClassOf rdf:resource="#PoolBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty sampling strategies applied in a pool-based setting.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoolBasedUncertaintySampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StreamBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
