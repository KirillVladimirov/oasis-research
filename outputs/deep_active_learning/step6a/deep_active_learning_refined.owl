<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://deep_active_learning"
         xmlns="http://deep_active_learning#">

<owl:Ontology rdf:about="http://deep_active_learning"/>

<owl:ObjectProperty rdf:about="#methodSolvesTask">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a method to the task or problem it is designed to solve.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodSolvesTask</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodEvaluatedByMetric">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a method to metrics used to evaluate its performance.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodEvaluatedByMetric</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#metricEvaluatesTask">
  <rdfs:domain rdf:resource="#Metric"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a metric to the task whose performance it measures.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metricEvaluatesTask</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodTrainedOnDataset">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method is trained using a particular dataset.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodTrainedOnDataset</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodTestedOnDataset">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method is evaluated or tested on a particular dataset.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodTestedOnDataset</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#datasetUsedForTask">
  <rdfs:domain rdf:resource="#Dataset"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a dataset is used to instantiate or study a task.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">datasetUsedForTask</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taskConstrainedBy">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a task operates under a particular constraint.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">taskConstrainedBy</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodSubjectToConstraint">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method must satisfy or is analyzed under a given constraint.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodSubjectToConstraint</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#metricSensitiveToConstraint">
  <rdfs:domain rdf:resource="#Metric"/>
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a metric’s value or applicability depends on a given constraint.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metricSensitiveToConstraint</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#acquisitionStrategyUsesMetric">
  <rdfs:domain rdf:resource="#AcquisitionStrategy"/>
  <rdfs:range rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an acquisition strategy to the metric it optimizes or relies on (e.g., uncertainty or representativeness).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquisitionStrategyUsesMetric</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#acquisitionStrategyOperatesOnDataset">
  <rdfs:domain rdf:resource="#AcquisitionStrategy"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates the unlabeled pool or dataset on which an acquisition strategy selects queries.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquisitionStrategyOperatesOnDataset</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#activeLearningLoopUsesStrategy">
  <rdfs:domain rdf:resource="#ActiveLearningLoop"/>
  <rdfs:range rdf:resource="#AcquisitionStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an active learning loop to the acquisition strategy it employs.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activeLearningLoopUsesStrategy</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#activeLearningLoopQueriesOracle">
  <rdfs:domain rdf:resource="#ActiveLearningLoop"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an active learning loop to its oracle or annotator concept.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activeLearningLoopQueriesOracle</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#annotatorProvidesLabelsForDataset">
  <rdfs:domain rdf:resource="#OtherConcept"/>
  <rdfs:range rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that an annotator or oracle provides labels for a given dataset.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">annotatorProvidesLabelsForDataset</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodProducesModel">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a learning method to the resulting model object (e.g., classifier or segmentor).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodProducesModel</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#modelInducesUncertaintyMetric">
  <rdfs:domain rdf:resource="#OtherConcept"/>
  <rdfs:range rdf:resource="#UncertaintyMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates a model to the uncertainty metric derived from its predictions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modelInducesUncertaintyMetric</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#datasetHasDomain">
  <rdfs:domain rdf:resource="#Dataset"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a dataset to its application domain (e.g., medical imaging, NLP, vision).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">datasetHasDomain</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taskHasDomain">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a task to its domain (e.g., MedicalImagingDomain, NaturalLanguageProcessingDomain).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">taskHasDomain</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodUsesPretrainedModel">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that a method uses another method as a pretrained model or backbone.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodUsesPretrainedModel</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#methodComposedOfComponent">
  <rdfs:domain rdf:resource="#Method"/>
  <rdfs:range rdf:resource="#Method"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents that a complex method is composed of sub-methods or modules.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methodComposedOfComponent</rdfs:label>
</owl:ObjectProperty>

<owl:Class rdf:about="#Method">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for algorithms, procedures, and learning methods.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Method</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Task">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for learning, annotation, and optimization tasks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Task</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Metric">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for evaluation and scoring measures.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metric</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Dataset">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dataset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root dataset class used as anchor for all concrete datasets and dataset subsets.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Constraint">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for resource, data, and setting constraints.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constraint</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AcquisitionStrategy">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents strategies for acquiring new instances to label in active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningLoop">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the iterative loop procedure of selecting, labeling, and retraining in active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningLoop</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OtherConcept">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Root class for structural, statistical, and domain concepts that are not tasks, methods, metrics, datasets, or explicit constraints.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OtherConcept</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyMetric">
  <rdfs:subClassOf rdf:resource="#UncertaintyMeasure"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific uncertainty metrics used in acquisition.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyMetric</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ActiveLearningTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks whose primary focus is to study or apply active learning methods.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActiveLearningTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MedicalImageAnalysisTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks related to analysis of medical images, including classification, segmentation, and reconstruction.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalImageAnalysisTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SegmentationTask">
  <rdfs:subClassOf rdf:resource="#MedicalImageAnalysisTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks whose goal is to segment images or volumes into meaningful regions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MedicalImageSegmentationTask">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks specifically in the medical imaging domain.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalImageSegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ThreeDSegmentationTask">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks operating on 3D data such as volumes or point clouds.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ThreeDSegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ImageSegmentationTask">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents general 2D image segmentation tasks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageSegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PixelLevelSegmentation">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks that operate at pixel or voxel level.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PixelLevelSegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DeepActiveSegmentation">
  <rdfs:subClassOf rdf:resource="#SegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep-learning-based active learning tasks for segmentation.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepActiveSegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#3DMedicalImageSegmentation">
  <rdfs:subClassOf rdf:resource="#MedicalImageSegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents 3D medical image segmentation tasks such as CT or MRI volume segmentation.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3DMedicalImageSegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InteractiveMedicalImageSegmentation">
  <rdfs:subClassOf rdf:resource="#MedicalImageSegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents interactive segmentation tasks where a user iteratively refines medical image segmentations.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InteractiveMedicalImageSegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#WholeSlidePathologySegmentation">
  <rdfs:subClassOf rdf:resource="#MedicalImageSegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation of whole-slide pathology images.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WholeSlidePathologySegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RetinalBloodVesselSegmentation">
  <rdfs:subClassOf rdf:resource="#MedicalImageSegmentationTask"/>
  <owl:equivalentClass rdf:resource="#RetinalVesselSegmentation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks focused on segmenting retinal blood vessels.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RetinalBloodVesselSegmentation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merged into RetinalVesselSegmentation</rdfs:comment>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#RetinalVesselSegmentation">
  <rdfs:subClassOf rdf:resource="#MedicalImageSegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents segmentation tasks of retinal vessels in ophthalmoscopy or fundus images.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RetinalVesselSegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ACDCSegmentationTask">
  <rdfs:subClassOf rdf:resource="#MedicalImageSegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the specific ACDC cardiac MRI segmentation benchmark task.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACDCSegmentationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DeepLearningMedicalImageAnalysis">
  <rdfs:subClassOf rdf:resource="#MedicalImageAnalysisTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks that apply deep learning to medical image analysis problems.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepLearningMedicalImageAnalysis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DeepImageSegmentation">
  <rdfs:subClassOf rdf:resource="#ImageSegmentationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents deep-learning-based image segmentation tasks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeepImageSegmentation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MedicalImageClassificationTask">
  <rdfs:subClassOf rdf:resource="#MedicalImageAnalysisTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents classification tasks on medical images such as disease presence detection.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalImageClassificationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BreastCancerHistopathologyClassificationTask">
  <rdfs:subClassOf rdf:resource="#MedicalImageClassificationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents breast cancer classification tasks on histopathology images.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BreastCancerHistopathologyClassificationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ChestXrayPneumoniaClassificationTask">
  <rdfs:subClassOf rdf:resource="#MedicalImageClassificationTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents pneumonia classification tasks on chest X-ray images.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ChestXrayPneumoniaClassificationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PulmonaryNoduleDetection">
  <rdfs:subClassOf rdf:resource="#MedicalImageAnalysisTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents detection tasks of pulmonary nodules in medical imaging.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PulmonaryNoduleDetection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#COVID19Diagnosis">
  <rdfs:subClassOf rdf:resource="#MedicalImageAnalysisTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents COVID-19 diagnosis tasks using medical imaging data.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID19Diagnosis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BoundingBoxAnnotation">
  <rdfs:subClassOf rdf:resource="#DetectionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where annotations are bounding boxes around objects.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BoundingBoxAnnotation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DetectionTask">
  <rdfs:subClassOf rdf:resource="#VisionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents object detection tasks in images or videos.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DetectionTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ObjectCenterAnnotation">
  <rdfs:subClassOf rdf:resource="#DetectionTask"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where annotations are object center points.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ObjectCenterAnnotation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ImageClassificationTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents general image classification tasks.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ImageClassificationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClassificationTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where the goal is to assign discrete labels to instances.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClassificationTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RegressionTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents tasks where the goal is to predict continuous outputs.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RegressionTask</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VisionTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents computer vision tasks such as classification, detection, and segmentation.</rdfs:comment>
