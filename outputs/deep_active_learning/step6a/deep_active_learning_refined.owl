  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchAw areStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NonBatchAwareStrategy">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
