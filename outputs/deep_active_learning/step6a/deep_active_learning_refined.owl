  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StreamBasedSelectiveSampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataStreamActiveLearning">
  <rdfs:subClassOf rdf:resource="#StreamBasedActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods specifically designed for streaming data scenarios.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataStreamActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BatchModeActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents active learning methods that acquire instances in batches.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchModeActiveLearning</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BatchActiveLearning">
  <rdfs:subClassOf rdf:resource="#BatchModeActiveLearning"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents generic batch-based active learning procedures.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchActiveLearning</rdfs:label>
