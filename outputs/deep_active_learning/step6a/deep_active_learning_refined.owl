  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents classic uncertainty sampling strategies in active learning.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintySampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyBasedStrategies">
  <rdfs:subClassOf rdf:resource="#UncertaintyBasedAcquisitionStrategy"/>
