  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QuerySet</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#QueryBatch">
  <rdfs:subClassOf rdf:resource="#QuerySet"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a batch of queries issued in one iteration.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QueryBatch</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SubjectCohortDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets built around subject cohorts, such as patient groups.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SubjectCohortDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TargetDataset">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents datasets from the target domain in domain adaptation.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TargetDataset</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DatasetSlice">
  <rdfs:subClassOf rdf:resource="#Dataset"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents subslices or partitions of a dataset.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DatasetSlice</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataSplit">
  <rdfs:subClassOf rdf:resource="#DatasetSlice"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents logical splits of datasets into train, validation, or test parts.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSplit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LabeledDatasetSplit">
  <rdfs:subClassOf rdf:resource="#DataSplit"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents labeled subsets from a dataset split.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabeledDatasetSplit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UnlabeledDatasetSplit">
  <rdfs:subClassOf rdf:resource="#DataSplit"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents unlabeled subsets from a dataset split.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UnlabeledDatasetSplit</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DatasetFractionConstraint">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents constraints that limit which fraction of a dataset can be labeled.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DatasetFractionConstraint</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InfiniteInputSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents an idealized infinite input space for theoretical analysis.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InfiniteInputSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#InputSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the space of possible input instances.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InputSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SampleSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a probabilistic sample space over inputs and labels.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SampleSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a generic data space in which instances lie.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DataSpaceConcept">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents conceptual descriptions of the data space.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSpaceConcept</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#FeatureSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents feature spaces in which inputs are embedded.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FeatureSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RepresentationSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents learned representation spaces.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RepresentationSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#HypothesisSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the space of hypotheses or models considered by a learner.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HypothesisSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VersionSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the subset of hypotheses consistent with observed data.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VersionSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LabelSpace">
  <rdfs:subClassOf rdf:resource="#OtherConcept"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the space of possible labels.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LabelSpace</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Uncertainty">
  <rdfs:subClassOf rdf:resource="#Metric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the general concept of uncertainty used in metrics.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uncertainty</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyMeasure">
  <rdfs:subClassOf rdf:resource="#Uncertainty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics that quantify uncertainty.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyMeasure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ModelUncertainty">
  <rdfs:subClassOf rdf:resource="#UncertaintyMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents metrics that quantify model predictive uncertainty.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ModelUncertainty</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PredictionUncertainty">
  <rdfs:subClassOf rdf:resource="#UncertaintyMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty associated with individual predictions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictionUncertainty</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PredictionEntropy">
  <rdfs:subClassOf rdf:resource="#UncertaintyMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents prediction entropy used as an uncertainty score.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictionEntropy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PredictiveEntropy">
  <rdfs:subClassOf rdf:resource="#PredictionEntropy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents predictive entropy metrics.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictiveEntropy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PredictiveEntropyMetric">
  <rdfs:subClassOf rdf:resource="#PredictionEntropy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific numeric predictive entropy measures.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PredictiveEntropyMetric</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Entropy">
  <rdfs:subClassOf rdf:resource="#UncertaintyMetric"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents Shannon entropy used as an uncertainty measure.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entropy</rdfs:label>
