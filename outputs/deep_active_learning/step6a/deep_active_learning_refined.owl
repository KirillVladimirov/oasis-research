  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty sampling based on least confident predictions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LeastConfidenceStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MarginSamplingStrategy">
  <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty sampling based on the margin between top class probabilities.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MarginSamplingStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LeastConfidenceSampling">
  <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents strategies selecting instances with lowest prediction confidence.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LeastConfidenceSampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BALD">
  <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents Bayesian Active Learning by Disagreement (BALD) based selection criteria.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BALD</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BALDMethod">
  <rdfs:subClassOf rdf:resource="#BALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents methods implementing the BALD acquisition principle.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BALDMethod</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BayesianActiveLearningByDisagreement">
  <rdfs:subClassOf rdf:resource="#BALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the classical BALD acquisition method defined via mutual information.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BayesianActiveLearningByDisagreement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BALDAcquisitionFunction">
  <rdfs:subClassOf rdf:resource="#BALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition functions that implement BALD-based mutual information scoring.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BALDAcquisitionFunction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BALDMu tualInformationAcquisition">
  <rdfs:subClassOf rdf:resource="#BALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents BALD-style acquisition functions explicitly formulated via mutual information.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BALDMu tualInformationAcquisition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BALDAcquisitionStrategy">
  <rdfs:subClassOf rdf:resource="#BALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents acquisition strategies that are specific instantiations of the BALD principle.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BALDAcquisitionStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BatchBALD">
  <rdfs:subClassOf rdf:resource="#BALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the BatchBALD acquisition method that selects an informative batch jointly.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchBALD</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BatchBALDMethod">
  <rdfs:subClassOf rdf:resource="#BatchBALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific algorithmic instantiations of BatchBALD.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchBALDMethod</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BatchBALDAcquisition">
  <rdfs:subClassOf rdf:resource="#BatchBALD"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the acquisition procedure associated with BatchBALD.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BatchBALDAcquisition</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintyBasedActiveLearning">
  <rdfs:subClassOf rdf:resource="#ActiveLearningMethod"/>
