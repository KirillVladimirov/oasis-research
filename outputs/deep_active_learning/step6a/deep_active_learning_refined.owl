<owl:Class rdf:about="#AcquisitionFunction">
  <rdfs:subClassOf rdf:resource="#AcquisitionStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents mathematical acquisition functions that score candidate instances.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionFunction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AcquisitionFunctionMethod">
  <rdfs:subClassOf rdf:resource="#AcquisitionFunction"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents specific methodological implementations of acquisition functions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionFunctionMethod</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AcquisitionStep">
  <rdfs:subClassOf rdf:resource="#AcquisitionStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents the procedural step of acquiring labeled data in an active learning cycle.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionStep</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AcquisitionObjective">
  <rdfs:subClassOf rdf:resource="#AcquisitionStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents optimization objectives underlying acquisition strategies.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AcquisitionObjective</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#UncertaintySampling">
