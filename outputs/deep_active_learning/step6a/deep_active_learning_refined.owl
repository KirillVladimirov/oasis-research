  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UncertaintyBasedStrategies</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PureUncertaintySampling">
  <rdfs:subClassOf rdf:resource="#UncertaintySampling"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents uncertainty sampling without additional diversity or structure constraints.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PureUncertaintySampling</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LeastConfidenceStrategy">
